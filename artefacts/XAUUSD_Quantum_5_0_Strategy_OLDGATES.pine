forecastZ = input.float(2.0, "Forecast Band (Z multiple of ATR)", minval=1.0, maxval=3.0, step=0.1, group="V17 PREDICTIVE ENHANCEMENTS")
showStatsEngine = input.bool(true, "Statistical Engines", group=grpModules)

grpLayout = "LAYOUT"
dashMode = input.string("Auto", "Dash Mode", options=["Auto", "Desktop", "Tablet", "MobileLand", "MobilePort"], group=grpLayout)
mobileOverride = input.bool(false, "☰ Mobile Layout", group=grpLayout, tooltip="Force mobile-optimized dashboard for phones/tablets")
textSize = input.string("Auto", "Text Size", options=["Auto", "Small", "Medium", "Large"], group=grpLayout)
density = input.string("Standard", "Density", options=["Compact", "Standard", "Spacious"], group=grpLayout)
debugMode = input.bool(false, "Debug Mode (Show All Scores)", group=grpLayout)

grpRisk = "RISK MANAGEMENT"
riskPercent = input.float(1.0, "Risk % per Trade", minval=0.1, maxval=2.0, step=0.1, group=grpRisk, tooltip="Capped at 2%: 5-loss streak at 2% = -10% drawdown; at 5% = -25%. Prop firm 8-12% drawdown limits require 2% max per trade under normal conditions.")
pointValue = input.float(100, "Value per Point per Lot (USD)", minval=1, group=grpRisk)
// Transaction cost model — affects backtest metrics, NOT signal generation
useDDBreaker = input.bool(false, "Max Drawdown Signal Breaker", group=grpRisk, tooltip="When enabled, blocks new signals if historical max drawdown (oMaxDD, previous bar) exceeds the threshold below.")
maxDdPct = input.float(12.0, "Max DD % Before Signal Block", minval=5.0, maxval=40.0, step=1.0, group=grpRisk)
// F-A02 + F-A05 — calibrated-probability entry gate. Full rationale sits at the gate
// itself (search "CALIBRATED-PROBABILITY ENTRY GATE"). Default ON at the neutral 0.50
// boundary; set useCalGate=false to restore the previous behaviour exactly.
useCalGate = input.bool(true, "Gate entries on calibrated probability", group=grpRisk, tooltip="Vetoes an entry when the CALIBRATED probability in the trade's direction is below the floor below. This is what wires the Platt/WLS calibration -- and through it the weighted evidence score bullScore, where trend, structure, flow, macro and liquidity converge -- into the decision. Before this, both terminated in dashboard strings and gated nothing. INERT until a real Platt fit exists AND the effective OOS sample reaches 10, so a cold engine never blocks trades. IMPORTANT: F-037 still applies. The IS/OOS boundary slides and the history is development-contaminated, so how WELL this probability is calibrated is NOT established. Enabling this means deciding to act on that statistic.")
calGateMinP = input.float(0.50, "  Min calibrated P in trade direction", minval=0.0, maxval=0.95, step=0.01, group=grpRisk, tooltip="0.50 is the only non-arbitrary default: the natural decision boundary of a probability -- do not take a trade the calibrated model puts below even odds in that direction. Any higher value is a judgement you are making, not a fitted parameter. Raising it above 0.50 also vetoes range-dominant setups, whose calibrated probability is exactly 0.50 in both directions.")
spreadCost = input.float(0.3, "Spread Cost (points)", minval=0.0, maxval=5.0, step=0.1, group=grpRisk, tooltip="XAUUSD typical spread 0.2-0.5pts. Quoted spread is already the round-trip cost of crossing the book; slippage is applied per side.")
slippagePts = input.float(0.2, "Slippage (points)", minval=0.0, maxval=2.0, step=0.1, group=grpRisk, tooltip="1-tick slippage ~0.1pts, applied on entry AND exit.")
// P0-CAL-003 (reviewer item 3): these three are BROKER/INSTRUMENT CONFIGURATION, not
// universal constants. The defaults are mid-range retail ECN XAUUSD figures and are
// ASSUMPTIONS, not truth. They drive the selector's cost model (_costATR -> analog
// expectancy -> negative-expectancy veto), and the twins' strategy() constants are
// DERIVED from them, so changing any one here obliges you to recompute the declaration
// constants per the derivation in the twin headers.
commissionL = input.float(7.0, "Commission per Lot (USD, round turn) [BROKER CONFIG]", minval=0.0, maxval=50.0, step=0.5, group=grpRisk, tooltip="Per-lot commission. 0 for spread-only brokers; ~$5-15 for ECN.")

grpClean = "CHART CLEANUP"
cleanInstitutional = input.bool(false, "Clean Institutional Appearance", group=grpClean)
professionalMode = input.bool(false, "Professional Execution Mode", group=grpClean)
holdoutRatio = input.float(0.20, "Holdout Ratio (OOS validation)", minval=0.0, maxval=0.5, step=0.05, group=grpRisk)
useNewsSuppress = input.bool(false, "Suppress Signals on News Events", group=grpRisk, tooltip="Blocks signals during FOMC/NFP windows")
newsSession = input.session("", "News Event Window (UTC)", group=grpRisk, tooltip="Session during which signals are suppressed, e.g. 1300-1500:4 for FOMC Wednesdays. Leave empty to disable.")

grpCore = "CORE"
ema20Len = input.int(20, "EMA20", group=grpCore)
ema100Len = input.int(100, "EMA100", group=grpCore)
ema200Len = input.int(200, "EMA200", group=grpCore)
atrLen = input.int(14, "ATR Base", group=grpCore)
adxLen = input.int(14, "ADX", group=grpCore)
adxThreshold = input.int(25, "ADX Threshold", minval=10, maxval=50, group=grpCore)
rsiLen = input.int(14, "RSI Length", minval=2, maxval=50, group=grpCore)
internalPivotLen = input.int(2, "Internal Pivot Len (fast)", minval=1, maxval=5, group=grpCore)
swingPivotLen = input.int(5, "Swing Pivot Len (major)", minval=3, maxval=10, group=grpCore)
recentBarsLen = input.int(120, "Signal Lookback Bars", minval=50, maxval=500, group=grpCore)
structWindow = input.int(8, "Structure signal validity (bars)", minval=1, maxval=40, group=grpCore, tooltip="Q5.8: how long a BOS/CHoCH/MSS stays actionable after it fires. A structure break creates a directional bias that persists until invalidated — it is not a one-bar event. Set 1 to restore the old same-bar-only behaviour.")
// CHANGE ID: F-012 — minval 50 -> 51. Trend terms use STRICT inequalities so bull+bear
// <= 100, and BUY/SELL mutual exclusivity requires 2*threshold > 100. At 50 both sides
// could reach 50 simultaneously, making shouldBuy and shouldSell both true; _confDirLabel
// tests shouldBuy first, so SELL was SILENTLY MASKED. 51 makes 2T = 102 > 100.
trendThreshold = input.int(60, "Trend Score Threshold", minval=51, maxval=90, step=5, group=grpCore)
volClimaxPerc = input.int(95, "Volume Climax Percentile", minval=90, maxval=99, step=1, group=grpCore)
eqAtrMult = input.float(0.25, "EQ Tolerance (ATR mult)", minval=0.05, maxval=1.0, step=0.05, group=grpCore)
volLookback = input.int(50, "Volume Climax Lookback", minval=20, maxval=100, group=grpCore)
fvgMaxBars = input.int(30, "FVG Max Bars", minval=10, maxval=100, group=grpCore)
obMaxBars = input.int(20, "OB Max Bars", minval=10, maxval=50, group=grpCore)
liqProxMult = input.float(1.5, "Liq Proximity (ATR)", minval=0.5, maxval=4.0, step=0.1, group=grpCore)
// P2-CAL-003: the round-number magnet grid was HARDCODED at 50.0 in two places (the
// stop-cluster nudge and the RN take-profit candidate). 50 is a sound WEEKLY/DAILY gold
// level but is poorly scaled to a 5M system: the next 50-level sits ~25 points away on
// average, which is ~8x a typical 5M ATR(~3). It clears the _tpMinD gate but sorts LAST
// among candidates, so it is selected only when the liquidity map is nearly empty — i.e.
// largely inert as an intraday magnet, while the 10-levels traders actually defend
// intraday are invisible to the engine. Exposed as an input rather than silently
// retuned: the default is UNCHANGED at 50.0 so this edit alters no existing behaviour.
// Consider 10.0 (or 25.0) for 5M once the A/B baseline exists to measure against —
// changing it without that baseline is guesswork, not calibration.
rnGrid = input.float(50.0, "Round-Number Grid (points)", minval=1.0, maxval=100.0, step=1.0, group=grpCore, tooltip="Spacing of round-number magnets. 50 suits daily/weekly gold; 10 is closer to intraday 5M behaviour.")
minMatchQ = input.int(0, "Min Analog Match Quality (0=auto)", minval=0, maxval=90, group=grpCore, tooltip="Q5.2: hard floor on STATE similarity (0-100) for analog matches, on top of the adaptive threshold.")
grpRK = "RISK LIMITS"
useRiskLimits = input.bool(true, "Enable account-state risk limits", group=grpRK, tooltip="Q5.6: virtual-R self-tracking. The indicator cannot see your broker account — it tracks the outcome of ITS OWN signals (entry at signal, resolved at SL or TP1, SL assumed first if both hit in one bar). Treat as a discipline aid, not a substitute for broker-side limits.")
maxDailyLossR = input.float(3.0, "Daily loss limit (R, 0=off)", minval=0.0, maxval=20.0, step=0.5, group=grpRK)
maxTradesDay  = input.int(4, "Max signals per day (0=off)", minval=0, maxval=50, group=grpRK)
maxConsecLoss = input.int(3, "Consecutive-loss halt (0=off)", minval=0, maxval=20, group=grpRK)
lockoutBars   = input.int(0, "Cooldown bars (0=until next session day)", minval=0, maxval=500, group=grpRK)
tqMinScore = input.int(55, "Min Trade Quality (0=off)", minval=0, maxval=90, group=grpCore, tooltip="R6.0: BUY/SELL signals below this Trade Quality Score display as NO TRADE and suppress alerts.")

grpV11 = "V11 INTELLIGENCE"
dispMult = input.float(2.5, "Displacement Multiplier", minval=1.5, maxval=5.0, step=0.1, group=grpV11)
macroTF = input.timeframe("60", "Macro Correlation Timeframe", group=grpV11)

grpV17 = "V17 PREDICTIVE ENHANCEMENTS"
dxyRocLen = input.int(10, "DXY Momentum ROC Length (bars)", minval=5, maxval=30, group=grpV17)
useRsiDivFilter = input.bool(false, "RSI Divergence Filter", group=grpV17)
znRocLen = input.int(10, "ZN1 Rate Pressure ROC Length", minval=5, maxval=20, group=grpV17)
yieldSymbol = input.symbol("TVC:US10Y", "Yield Symbol (use TVC:US10Y for yield, ZN1! for futures price)", group=grpV17)
invertYield = input.bool(false, "Invert Yield Logic (enable for ZN1! futures price)", group=grpV17)
dxySymbol = input.symbol("TVC:DXY", "DXY Symbol", group=grpV17)
silverSymbol = input.symbol("OANDA:XAGUSD", "Silver Symbol", group=grpV17)

// ===== COMEX FUTURES CONFIRMATION (GC) ========================================
// WHY: XAUUSD here is a CFD. Its `volume` is a TICK COUNT (price updates), not contracts,
// and its price is one broker's feed. COMEX GC is the centralised, exchange-traded gold
// market with real traded volume. The question this layer answers — and which nothing else
// in the system can — is: "is this move confirmed by the main gold market, or is it only
// visible on my CFD feed?" A breakout GC confirms is participation; one it ignores is much
// more likely a CFD-side liquidity sweep.
// THE 10-MINUTE DELAY, AND WHY IT DOES NOT BREAK THIS. CME data is free on TradingView with
// a 10-minute delay (real-time is a separate paid entitlement). That would be fatal for a
// TRIGGER. It is not fatal for a DIRECTIONAL AGREEMENT test read on CONFIRMED bars with a
// ONE-BAR LAG: everything below uses [1], so the value is always a fully-closed GC bar and
// the delay is absorbed on 15M and above. On 5M a 10-min delay exceeds two bars, so the
// layer self-disables below gcMinTfSec rather than silently reading stale data.
// SCOPE: DIRECTION and VOLUME only. GC PRICE LEVELS ARE DELIBERATELY NOT IMPORTED — futures
// trade at a carry basis above spot that drifts daily, so a GC level is not a spot level.
// This contributes a macro VOTE and a confirmation flag. It is never a trigger on its own.
gcSymbol = input.symbol("COMEX:GC1!", "COMEX Gold Futures (blank=off)", group=grpV17, tooltip="Centralised gold futures used for CONFIRMATION only. Direction and volume are read with a one-bar lag so free 10-minute-delayed CME data is safe. Price levels are never imported (futures carry a drifting basis vs spot).")
gcMinTfSec = input.int(900, "  Min chart TF for GC (seconds)", minval=300, maxval=14400, step=300, group=grpV17, tooltip="Below this the 10-minute CME delay exceeds a bar or two and the layer disables itself. 900 = 15M.")
gcVolMult = input.float(1.2, "  Volume-expansion threshold", minval=1.0, maxval=3.0, step=0.1, group=grpV17)

// ===== OPEN INTEREST — DAILY CONVICTION =======================================
// OI is the number of contracts still open. Unlike volume (which counts activity) it says
// whether money is ENTERING or LEAVING. Paired with price it separates a trend backed by
// new positioning from one that is merely someone closing out:
//   price up + OI up    = new longs        -> genuine participation
//   price up + OI down  = short covering   -> weak, tends to fade
//   price down + OI up  = new shorts       -> genuine downtrend
//   price down + OI down= long liquidation -> exhaustion
// VERIFIED CONSTRAINT: for traditional futures TradingView serves OI on DAILY BARS ONLY
// (intraday OI exists for crypto derivatives only). So this can never be an intraday
// trigger. It is requested on "D" and used purely as a slow CONVICTION multiplier on the
// regime read — which is the correct use for a daily series on a 15M chart anyway.
// Being daily also makes it immune to the 10-minute CME delay.
// Scored, not binary: it nudges conviction, it does not gate entries.
oiSymbol = input.symbol("COMEX:GC1!_OI", "Open Interest symbol (blank=off)", group=grpV17, tooltip="TradingView OI ticker format is <id>_OI. DAILY bars only for traditional futures, so this is a slow conviction input and never an intraday trigger.")

// ===== CFTC COT POSITIONING — WEEKLY, DELAY-PROOF =============================
// THE ONLY NON-PRICE INPUT IN THIS SYSTEM. Every other macro source — DXY, yields, SPX,
// EURUSD, silver, TIPS, and now GC — is a PRICE series, so they share a common factor and
// add less independent information than their count suggests. COT is actual POSITIONING
// reported by the CFTC: how many contracts each participant class is holding. That is
// orthogonal to price by construction, which is exactly what a correlated evidence vector
// needs and cannot get from another chart.
// Gold's CFTC code is 088691. Data is weekly, reflecting Tuesday's close and published
// Friday, so it carries an inherent reporting lag of several days.
// THAT LAG IS WHY THIS IS A REGIME INPUT AND NEVER A TRIGGER. A weekly, days-late series
// cannot time a 15M entry and must not be asked to. What it CAN do is tell you whether
// speculative positioning is crowded — and crowded positioning is where reversals happen.
// Read as a PERCENTILE of its own history, not an absolute: "net long" means nothing
// without knowing whether that is high or low for this market.
cotEnable = input.bool(false, "CFTC COT positioning (weekly)", group=grpV17, tooltip="Managed-money net positioning as a percentile of its own history. Weekly CFTC data (Tuesday close, published Friday) — a REGIME/crowding input, never an entry trigger. OFF by default: enable after the baseline so its effect is measurable.")
cotLen = input.int(52, "  Percentile lookback (weeks)", minval=13, maxval=260, group=grpV17)
cotExtreme = input.int(85, "  Crowding percentile", minval=60, maxval=99, group=grpV17, tooltip="Above this (or below 100-this) positioning is treated as crowded, which historically raises reversal risk rather than confirming trend.")

// ===== US2Y — CURVE DEPTH =====================================================
// The system already reads US10Y. Adding the 2-year gives the SHAPE of the curve, not just
// its level, and the 2y10y spread is the standard read on whether the market is pricing
// policy tightening (curve flattening) or easing (steepening) — the single macro variable
// gold is most sensitive to. Cheap: one series, one derived spread.
// Used as REGIME CONTEXT ONLY. It does not add a macro vote, so the 6/7-source pool and its
// threshold are untouched and this cannot shift the gate.
y2Symbol = input.symbol("TVC:US02Y", "US 2Y Yield (blank=off)", group=grpV17, tooltip="With US10Y this gives the 2y10y curve spread — steepening favours gold, flattening pressures it. Context only, adds no macro vote.")
eurusdSymbol = input.symbol("OANDA:EURUSD", "EURUSD Symbol", group=grpV17)
spxSymbol = input.symbol("SP:SPX", "S&P 500 Symbol", group=grpV17)
tipsSymbol = input.symbol("TVC:US10Y", "TIPS/Real-Yield Symbol (blank=off)", group=grpV17, tooltip="Q5.5: default changed from the unprefixed US10YTIPS (which errored on many feeds) to TVC:US10Y. For a true real-yield proxy use FRED:DFII10 if your plan has it, or blank this field to disable the feed. ignore_invalid_symbol protects the math regardless.")

grpV19c = "V19 CORRELATION"
corrShortLen = input.int(30, "Corr Short Window", minval=10, maxval=50, group=grpV19c)
corrMedLen = input.int(60, "Corr Medium Window", minval=30, maxval=100, group=grpV19c)
corrLongLen = input.int(120, "Corr Long Window", minval=60, maxval=200, group=grpV19c)

grpHist = "HISTORICAL ANALOG"
histWAdx = input.int(30, "ADX Similarity Weight (%)", minval=5, maxval=50, step=5, group=grpHist)
histWAtr = input.int(25, "ATR Similarity Weight (%)", minval=5, maxval=50, step=5, group=grpHist)
histWHtf = input.int(25, "HTF Similarity Weight (%)", minval=5, maxval=50, step=5, group=grpHist)
histWStr = input.int(5, "Struct Similarity Weight (%)", minval=0, maxval=20, step=5, group=grpHist)
histWLiq = input.int(5, "Liq Similarity Weight (%)", minval=0, maxval=20, step=5, group=grpHist)
histWMr = input.int(5, "MR Similarity Weight (%)", minval=0, maxval=20, step=5, group=grpHist)
histWCor = input.int(5, "Corr Similarity Weight (%)", minval=0, maxval=20, step=5, group=grpHist)
histWSess = input.int(5, "Session Similarity Weight (%)", minval=0, maxval=20, step=5, group=grpHist)
histWReg = input.int(5, "Regime Similarity Weight (%)", minval=0, maxval=20, step=5, group=grpHist)

// CORE ENGINE
ema20 = ta.ema(close, ema20Len)
ema100 = ta.ema(close, ema100Len)
ema200 = ta.ema(close, ema200Len)
atr = ta.atr(atrLen)
[diplus, diminus, adxVal] = ta.dmi(adxLen, adxLen)
// Q5.0-S8: hysteretic ADX gate for BOS validity — ON above adxThreshold, OFF below
// adxThreshold-2, so a 1-point ADX wobble no longer flips signal eligibility.
var bool adxGate = false
adxGate := adxGate ? adxVal > adxThreshold - 2 : adxVal > adxThreshold
vwapVal = ta.vwap(hlc3)
// Q5.3-A8: VIX risk-state feed (daily, na-guarded; display-only, not a vote).
// Q5.4: VIX feed switched CBOE -> TVC (CBOE symbols are access-restricted on some
// plans and error at add-time despite ignore_invalid_symbol). Exposed as an input;
// leave blank to disable the feed entirely.
string vixSymbol = input.symbol("TVC:VIX", "VIX Symbol (blank=off)", group=grpCore)
float vixD = vixSymbol != "" ? request.security(vixSymbol, "D", close[1], barmerge.gaps_off, barmerge.lookahead_off, ignore_invalid_symbol=true) : na
// Q5.1-B: institutional anchor set — weekly and monthly VWAPs join the daily anchor
// as trend references and trade-plan candidate levels.
float wVwapVal = ta.vwap(hlc3, timeframe.change("1W"))
float mVwapVal = ta.vwap(hlc3, timeframe.change("1M"))
// VWAP standard deviation bands — volatility-adjusted distance metric
// NOTE: bands are a 20-bar stdev of (close - VWAP), not volume-weighted VWAP variance.
float vwapSd = ta.stdev(close - vwapVal, 20)
float vwapUpper2 = vwapVal + vwapSd * 2.0
float vwapLower2 = vwapVal - vwapSd * 2.0
// VWAP slope (10-bar change) and acceleration (slope rate-of-change)
float vwapSlope = vwapVal - nz(vwapVal[10], vwapVal)
float vwapAccel = vwapSlope - nz(vwapSlope[5], vwapSlope)
// VWAP rejection: price touched ±2σ band then closed back on VWAP side
bool vwapRejectBull = low <= vwapLower2 and close > vwapVal
// Bollinger Bands (20,2)
float bbBasis = ta.sma(close, 20)
float bbDev = ta.stdev(close, 20) * 2.0
rsiVal = ta.rsi(close, rsiLen)
volSma20 = ta.sma(volume, 20)
highVolume = not na(volume) and volume > volSma20
recentBars = bar_index > last_bar_index - recentBarsLen
// Winsorized gold return: clamp extreme gaps (±5%) to prevent Z-score distortion after gap opens
float _rawGoldRet = safeDiv(close, nz(close[1], close)) - 1
// Q5.0-S6: TF-scaled winsorization (±6 sigma, prev-bar window; ±5% hard outer bound).
float _retClampW = math.min(math.max(nz(ta.stdev(_rawGoldRet, 100)[1], 0.0) * 6.0, 0.002), 0.05)
goldRet = math.min(math.max(_rawGoldRet, -_retClampW), _retClampW)

// HTF TREND STACK — 5M / 15M / 1H / 4H / 1D (zero repaint via [1])
// R5.3-L4: mid EMA aligned 50 -> 100 so every trend engine in the system uses the same
// 20/100/200 definition (the chart-level engine already did). NOTE: this shifts the HTF
// bull/bear gates — expect somewhat slower HTF regime flips than R5.2.
[htf5mClose, htf5mEma20, htf5mEma100M, htf5mEma200] = request.security(syminfo.tickerid, "5", [close[1], ta.ema(close[1], 20), ta.ema(close[1], 100), ta.ema(close[1], 200)], barmerge.gaps_off, barmerge.lookahead_off)
[htf15mClose, htf15mEma20, htf15mEma100M, htf15mEma200] = request.security(syminfo.tickerid, "15", [close[1], ta.ema(close[1], 20), ta.ema(close[1], 100), ta.ema(close[1], 200)], barmerge.gaps_off, barmerge.lookahead_off)
[htf1hClose, htf1hEma20, htf1hEma100M, htf1hEma200] = request.security(syminfo.tickerid, "60", [close[1], ta.ema(close[1], 20), ta.ema(close[1], 100), ta.ema(close[1], 200)], barmerge.gaps_off, barmerge.lookahead_off)
[htf4hClose, htf4hEma20, htf4hEma100M, htf4hEma200] = request.security(syminfo.tickerid, "240", [close[1], ta.ema(close[1], 20), ta.ema(close[1], 100), ta.ema(close[1], 200)], barmerge.gaps_off, barmerge.lookahead_off)
[htf1dClose, htf1dEma20, htf1dEma100M, htf1dEma200] = request.security(syminfo.tickerid, "D", [close[1], ta.ema(close[1], 20), ta.ema(close[1], 100), ta.ema(close[1], 200)], barmerge.gaps_off, barmerge.lookahead_off)

// ---- NY Session-based Daily / Weekly OHLC (17:00 ET close → next day open) ----
// ASSUMPTION: chart symbol's exchange timezone is America/New_York (true for OANDA XAUUSD).
// On UTC+2/+3 server-time feeds the rollover below becomes 17:00 SERVER time — verify per broker.
int msInDay = 86400000
// Exchange TZ offset from UTC — bar-time arithmetic avoids timezone string issues
// 17:00 exchange-local in UTC ms from midnight
// CHANGE ID: F-033 | NY-day anchor bound to the EXCHANGE timezone instead of New York.
// DEFECT. `hour`/`minute` with no timezone argument return EXCHANGE time, so this resolved
// to "17:00 in whatever timezone the feed reports" -- not 17:00 New York. On a feed whose
// exchange timezone is UTC (common for spot metals/FX), the NY-day rollover fired at
// 17:00 UTC = 13:00 EDT, four hours early, cutting PDH/PDL through the middle of the New
// York session. PWH/PWL and CDH/CDL inherit it: both key off crossedNYDay.
// SECOND DEFECT, same line. There was no DST handling here at all, while the session
// shading block below IS explicitly DST-aware (usIsDST). Two blocks in one file, both
// about New York time, disagreeing on whether DST exists.
// FIX. Read the clock in "America/New_York" explicitly. The offset then comes from the
// IANA zone, so DST is handled by the calendar rather than by arithmetic that has to be
// maintained: the boundary lands on 21:00 UTC in EDT and 22:00 UTC in EST, which is
// exactly the convention F-005 documents. The exchange-timezone dependency is removed
// entirely, so the levels no longer change meaning when the feed's timezone does.
// The final ((x % d) + d) % d normalises the result -- Pine's % can return a negative.
int _nyMsOfDay  = hour(time, "America/New_York") * 3600000 + minute(time, "America/New_York") * 60000
int _nyOffsetMs = _nyMsOfDay - int(time % msInDay)
int nyCloseDayMs = ((17 * 3600000 - _nyOffsetMs) % msInDay + msInDay) % msInDay
var float nyDailyHigh = na
var float nyDailyLow = na
var float prevNyDailyHigh = na
var float prevNyDailyLow = na
var float nyWeeklyHigh = na
var float nyWeeklyLow = na
var float prevNyWeeklyHigh = na
var float prevNyWeeklyLow = na
bool crossedNYDay = false
if not na(time[1])
    int tMod = time % msInDay
    int t1Mod = time[1] % msInDay
    if tMod > t1Mod
        crossedNYDay := t1Mod < nyCloseDayMs and tMod >= nyCloseDayMs
    else
        // R5-F16 wrap case: boundary crossed if it lies after the previous bar's time-of-day
        // OR before/at the current bar's time-of-day (handles boundaries near midnight and
        // weekend gaps spanning the boundary).
        // CHANGE ID: F-004 — was `t1Mod <= nyCloseDayMs`, now STRICT `<`.
        // The two branches disagreed: the non-wrap branch above already uses strict `<` on
        // the previous bar, this one used `<=`. A bar that OPENS EXACTLY on the boundary has
        // already consumed the rollover; if the NEXT bar wraps past midnight, `<=` fired a
        // SECOND time on t1Mod == nyCloseDayMs, so the NY "day" reset twice and PDH/PDL
        // collapsed to the extremes of the 2-hour 22:00->00:00 stub.
        // Triggers only when the boundary is itself a bar boundary AND boundary+barLength
        // lands on midnight -> 2H charts under EST (22:00+2h), and 3H charts under EDT
        // (21:00+3h). SEASONAL: the affected timeframe MOVES with US DST, which is why this
        // presented as "PDH/PDL changes on different timeframes" rather than a clean break.
        // Measured: 11 rollovers per 6 days instead of 6. 5M/15M/1H were never affected.
        // Strict `<` still fires the weekend-gap case this branch exists for (Fri 21:00 ->
        // Sun 22:00 = true, regression-tested).
        crossedNYDay := t1Mod < nyCloseDayMs or tMod >= nyCloseDayMs
// R5.2-C1: the weekly boundary is crossed by the SUNDAY open bar (market is closed
// Fri 17:00 ET -> Sun 17:00 ET), so checking the crossing bar's own UTC day for Friday
// could never be true and PWH/PWL never rolled. The correct test: the PREVIOUS bar was
// the last Friday bar. Robust across DST and server-time offsets.
// CHANGE ID: P1-LVL-002 | Timeframe robustness of the NY-anchored rollover.
// FINDING (simulated across 1M/5M/15M/1H/4H/D/W): the boundary detector is correct on
// every INTRADAY timeframe and on D. On W and above it degenerates twice over:
//  (a) tMod == t1Mod on every bar (bar times are a whole number of days apart), so the
//      wrap-case `t1Mod <= C or tMod >= C` is a tautology -> crossedNYDay fires EVERY
//      bar. On D that is harmless and in fact correct (prev bar = prev day). On W it
//      makes "PDH/PDL" silently mean PREVIOUS WEEK's high/low under a daily label.
//  (b) crossedNYWeek additionally required the previous bar to be a Friday. Weekly bars
//      open Sunday/Monday, so that test is NEVER true -> PWH/PWL never rolled and stayed
//      na forever (measured: 0 week-rollovers over 700 simulated days on W).
// FIX: on D-and-above use timeframe.change("1W"), which resolves the weekly boundary off
// the exchange calendar and is correct on D, W and MN alike (verified). Intraday keeps
// the NY 17:00-Friday anchor, which is the more precise trading convention and is
// already correct there — so no intraday behaviour changes.
bool _tfDayPlus = timeframe.in_seconds() >= 86400
bool crossedNYWeek = _tfDayPlus ? timeframe.change("1W") : (crossedNYDay and dayofweek(nz(time[1], time), "UTC") == dayofweek.friday)
if na(nyDailyHigh)
    // FIX (PDH/PDL): the previous-session values were seeded from the FIRST BAR of
    // the loaded range, so before any real rollover PDH and PDL both displayed that
    // single bar's high/low — a fabricated "previous day" that is not a previous day
    // at all, and on a freshly-loaded chart sits right on top of current price.
    // They now start as na, so the lines/labels are simply absent until the first
    // genuine NY-session rollover populates them with a real completed session.
    // The current-session accumulators still seed from this bar, which is correct.
    nyDailyHigh := high
    nyDailyLow := low
    nyWeeklyHigh := high
    nyWeeklyLow := low
else if crossedNYDay
    prevNyDailyHigh := nyDailyHigh
    prevNyDailyLow := nyDailyLow
    nyDailyHigh := high
    nyDailyLow := low
    if crossedNYWeek
        prevNyWeeklyHigh := nyWeeklyHigh
        prevNyWeeklyLow := nyWeeklyLow
        nyWeeklyHigh := high
        nyWeeklyLow := low
else
    // FIX (PDH/PDL): nz(x) with NO second argument returns 0.0 for an na float.
    // If nyDailyLow/nyWeeklyLow were ever na when this branch ran, math.min(0.0, low)
    // would latch the running LOW to 0.0 permanently — and since PDL is seeded from
    // that value at the next rollover, PDL would then read 0 (or an absurd level) and
    // never recover. The highs had the mirror-image risk: math.max(0.0, high) silently
    // discards a legitimately tracked high on the first such bar. Supplying the
    // current bar as the fallback makes each accumulator degrade to "this bar only"
    // instead of to zero, which is the correct neutral behaviour.
    nyDailyHigh := math.max(nz(nyDailyHigh, high), high)
    nyDailyLow := math.min(nz(nyDailyLow, low), low)
    nyWeeklyHigh := math.max(nz(nyWeeklyHigh, high), high)
    nyWeeklyLow := math.min(nz(nyWeeklyLow, low), low)

chartTFSeconds = timeframe.in_seconds()
// L7 (accepted, not changed): the 5M/15M request.security calls above still execute on
// higher-TF charts where their results are discarded via the htf*Available gates below.
// Making them conditional requires dynamic_requests=true, which changes Pine's request
// scheduling semantics; the runtime cost of the unconditional calls is minor and the
// gates guarantee correctness.
// HTF availability uses < so the chart's own TF is excluded from the 5-TF stack.
htf5mAvailable = chartTFSeconds < 300
htf15mAvailable = chartTFSeconds < 900
htf1hAvailable = chartTFSeconds < 3600
htf4hAvailable = chartTFSeconds < 14400
htf1dAvailable = chartTFSeconds < 86400

htfTrendScore(htfClose, htfEma20, htfEma100M, htfEma200) =>
    if na(htfClose)
        50
    else
        score = 0
        score += (not na(htfEma200) and htfClose > htfEma200) ? 40 : 0
        score += (not na(htfEma20) and not na(htfEma100M) and htfEma20 > htfEma100M) ? 40 : 0
        score += (not na(htfEma20) and htfClose > htfEma20) ? 20 : 0
        score

htf5mScore = htf5mAvailable ? htfTrendScore(htf5mClose, htf5mEma20, htf5mEma100M, htf5mEma200) : 50
htf15mScore = htf15mAvailable ? htfTrendScore(htf15mClose, htf15mEma20, htf15mEma100M, htf15mEma200) : 50
htf1hScore = htf1hAvailable ? htfTrendScore(htf1hClose, htf1hEma20, htf1hEma100M, htf1hEma200) : 50
htf4hScore = htf4hAvailable ? htfTrendScore(htf4hClose, htf4hEma20, htf4hEma100M, htf4hEma200) : 50
htf1dScore = htf1dAvailable ? htfTrendScore(htf1dClose, htf1dEma20, htf1dEma100M, htf1dEma200) : 50
htf5mBull = htf5mScore >= 60
htf5mBear = htf5mScore <= 40
htf15mBull = htf15mScore >= 60
htf15mBear = htf15mScore <= 40
htf1hBull = htf1hScore >= 60
htf1hBear = htf1hScore <= 40
htf4hBull = htf4hScore >= 60
htf4hBear = htf4hScore <= 40
htf1dBull = htf1dScore >= 60
htf1dBear = htf1dScore <= 40
// Alignment = slower 4 TFs (15m, 1h, 4h, 1D)
htfAlignmentLong = (htf15mBull ? 1 : 0) + (htf1hBull ? 1 : 0) + (htf4hBull ? 1 : 0) + (htf1dBull ? 1 : 0)
htfAlignmentShort = (htf15mBear ? 1 : 0) + (htf1hBear ? 1 : 0) + (htf4hBear ? 1 : 0) + (htf1dBear ? 1 : 0)
htfBullScoreGate = htfAlignmentLong >= 2
htfBearScoreGate = htfAlignmentShort >= 2
htfFullLong = (htf5mBull ? 1 : 0) + (htf15mBull ? 1 : 0) + (htf1hBull ? 1 : 0) + (htf4hBull ? 1 : 0) + (htf1dBull ? 1 : 0)
htfFullShort = (htf5mBear ? 1 : 0) + (htf15mBear ? 1 : 0) + (htf1hBear ? 1 : 0) + (htf4hBear ? 1 : 0) + (htf1dBear ? 1 : 0)

// R5-F6: EWMA volatility block removed — it was never consumed downstream and its
// "0.5-day half-life" comment was wrong (lambda=0.94 => ~11-bar half-life).

// ADAPTIVE ATR REGIME ENGINE — smooth transition (no discontinuity)
float atrTrending = ta.atr(7)
float atrRanging = ta.atr(21)
// Regime strength: 0 = full ranging, 1 = full trending
// ADX <= threshold-5 → 0.0 | ADX >= threshold+5 → 1.0 | linear blend between
float regimeStrength = math.min(math.max((adxVal - (adxThreshold - 5)) / 10.0, 0.0), 1.0)
_rawAdaptiveATR = showAdaptiveATR ? (atrRanging * (1.0 - regimeStrength) + atrTrending * regimeStrength) : atr
adaptiveATR = math.max(nz(_rawAdaptiveATR, ta.tr), close * 0.0001)
atrPercentile = ta.percentrank(adaptiveATR, 50)

// Stationarity guard: variance ratio test (short-term vs long-term variance)
// Ratio > 3.0 suggests non-stationary regime → rolling statistics may be unreliable
// R5-F19: now consumed by confidenceScore.
float _varShort = ta.variance(goldRet, 10)
float _varLong = ta.variance(goldRet, 50)

// MEAN REVERSION ANALYSIS (Part 7)
// Z-score of returns (100-period, walk-forward) with Cornish-Fisher adjustment
float retMean100 = ta.sma(goldRet[1], 100)
float retStd100 = ta.stdev(goldRet[1], 100)
float retZScoreRaw = retStd100 > 0.0 ? (goldRet - retMean100) / retStd100 : 0.0
f_regimeEngine() =>
    // ═══════════════ R6.0 ADAPTIVE MARKET REGIME ENGINE ═══════════════
    // Classifies every bar into a named regime using PERCENTILE-BASED (self-adapting)
    // thresholds, then publishes multipliers consumed downstream: SL sizing, BOS volume
    // requirement, liquidity proximity window, forecast horizon, size guidance, and a
    // confidence cap. Priority: ABNORMAL > COMPRESS > EXPANSION > STRONG > WEAK > RANGE.
    float bbWidthRel = bbBasis > 0 ? bbDev / bbBasis : 0.0
    float bbWidthPct = ta.percentrank(bbWidthRel, 100)
    float adxPct = ta.percentrank(adxVal, 200)
    float atrSma100R = ta.sma(adaptiveATR, 100)
    // Q5.1-A: known-schedule macro windows (Pine has no calendar feed; time-based windows
    // are the ceiling). NFP = first Friday; CPI = day 10-15 weekday; both 8:30 ET releases
    // covered by a 12:15-14:00 UTC window (valid under either DST state).
    int _hU5 = hour(time, "UTC")
    int _mU5 = minute(time, "UTC")
    int _tmU5 = _hU5 * 60 + _mU5
    int _dowU5 = dayofweek(time, "UTC")
    int _domU5 = dayofmonth(time, "UTC")
    bool _newsNFP = _dowU5 == dayofweek.friday and _domU5 <= 7
    bool _newsCPI = _domU5 >= 10 and _domU5 <= 15 and _dowU5 >= dayofweek.monday and _dowU5 <= dayofweek.friday
    bool newsWindow = (_newsNFP or _newsCPI) and _tmU5 >= 735 and _tmU5 <= 840
    bool regAbnormal = newsWindow or math.abs(retZScoreRaw) > 3.0 or (atrSma100R > 0 and adaptiveATR > atrSma100R * 2.5)
    bool regCompression = not regAbnormal and bbWidthPct <= 20 and adxVal < 20
    bool regExpansion = not regAbnormal and not regCompression and ((bbWidthPct > 25 and nz(bbWidthPct[3], 50.0) <= 20) or (atrPercentile >= 80 and adxVal > nz(adxVal[5], adxVal)))
    bool regStrongTrend = not regAbnormal and not regCompression and not regExpansion and adxVal > adxThreshold and adxPct >= 70
    bool regWeakTrend = not regAbnormal and not regCompression and not regExpansion and not regStrongTrend and adxVal > adxThreshold
    string volTag = atrPercentile >= 80 ? "HV" : atrPercentile <= 20 ? "LV" : "NV"
    string mktRegime = regAbnormal ? "ABNORMAL" : regCompression ? "COMPRESS" : regExpansion ? "EXPANSION" : regStrongTrend ? "STRONG TR" : regWeakTrend ? "WEAK TR" : "RANGE"
    // Multipliers: discrete regime base x continuous volatility adjustment (+/-10%).
    float regSLMult = (regAbnormal ? 2.0 : regExpansion ? 1.8 : regStrongTrend ? 1.5 : regWeakTrend ? 1.4 : regCompression ? 1.1 : 1.2) * (0.9 + atrPercentile / 500.0)
    regSLMult := math.min(math.max(regSLMult, 1.0), 2.2)
    float regBOSMult = atrPercentile >= 80 ? 1.20 : atrPercentile <= 20 ? 0.85 : 1.0 // BOS volume requirement scale
    float regLiqMult = atrPercentile >= 80 ? 1.30 : atrPercentile <= 20 ? 0.80 : 1.0 // liquidity proximity window scale
    float regHorizonMult = regCompression or regAbnormal ? 0.7 : regExpansion or regStrongTrend ? 1.2 : 1.0
    float regSizeMult = regAbnormal ? 0.5 : atrPercentile >= 80 ? 0.75 : 1.0 // position-size guidance haircut
    int regConfCap = regAbnormal ? 60 : 100 // never show high confidence in news-like conditions
    int effForecastBars = math.max(4, int(math.round(forecastBars * regHorizonMult)))
    // Q5.2-F6: empirical 6-state regime transition matrix (confirmed bars).
    [regAbnormal, regCompression, regExpansion, regStrongTrend, regWeakTrend, volTag, mktRegime, regSLMult, regBOSMult, regLiqMult, regSizeMult, regConfCap, effForecastBars]
[regAbnormal, regCompression, regExpansion, regStrongTrend, regWeakTrend, volTag, mktRegime, regSLMult, regBOSMult, regLiqMult, regSizeMult, regConfCap, effForecastBars] = f_regimeEngine()
// ═══════════════ END REGIME ENGINE ═══════════════
// Rolling skewness and excess kurtosis for Cornish-Fisher adjustment (manual)
float _r100 = goldRet[1]
float _m2 = ta.sma(_r100 * _r100, 100) * 100.0
float _m3 = ta.sma(_r100 * _r100 * _r100, 100) * 100.0
float _m4 = ta.sma(_r100 * _r100 * _r100 * _r100, 100) * 100.0
float _n = 100.0 // must match ta.sma() lookback length above
float _mu = retMean100
float _v = math.max(_m2 / _n - _mu * _mu, 0.000001)
float _sd = math.sqrt(_v)
bool _cfValid = bar_index > 100
float retSkew = _cfValid ? (_m3 / _n - 3.0 * _mu * _m2 / _n + 2.0 * _mu * _mu * _mu) / (_sd * _sd * _sd) : 0.0
float retKurt = _cfValid ? (_m4 / _n - 4.0 * _mu * _m3 / _n + 6.0 * _mu * _mu * _m2 / _n - 3.0 * _mu * _mu * _mu * _mu) / (_v * _v) - 3.0 : 0.0
// Q5.0-S7: CF expansion inputs clamped to the monotone-validity region.
float retSkewC = math.min(math.max(retSkew, -1.0), 1.0)
// Cornish-Fisher expansion: Zcf = Z + (Z²-1)S/6 + (Z³-3Z)K/24 − (2Z³-5Z)S²/36
float _z2 = retZScoreRaw * retZScoreRaw
float _z3 = _z2 * retZScoreRaw
float retZScore = _cfValid and math.abs(retSkew) < 1.5 and math.abs(retKurt) < 7.0 ? retZScoreRaw + (_z2 - 1.0) * retSkewC / 6.0 + (_z3 - 3.0 * retZScoreRaw) * (math.min(math.max(retKurt, -1.0), 3.0)) / 24.0 - (2.0 * _z3 - 5.0 * retZScoreRaw) * retSkewC * retSkewC / 36.0 : retZScoreRaw

// Distance from VWAP, EMAs in ATR terms (mean reversion gauges)
float distVwapATR = adaptiveATR > 0 ? (close - vwapVal) / adaptiveATR : 0.0
// Composite mean reversion score (-100 to +100)
float distEma20ATR = adaptiveATR > 0 ? (close - ema20) / adaptiveATR : 0.0
float distEma100ATR = adaptiveATR > 0 ? (close - ema100) / adaptiveATR : 0.0
float distEma200ATR = adaptiveATR > 0 ? (close - ema200) / adaptiveATR : 0.0
float mrComposite = math.min(math.max((distVwapATR * 30.0) + (distEma20ATR * 25.0) + (distEma100ATR * 25.0) + (distEma200ATR * 20.0) + (retZScore * 15.0), -100), 100)
// MR score components for evidence engine

regimeTrending = adxVal > adxThreshold
regimeRanging = adxVal <= adxThreshold and adxVal > 15
regimeDead = adxVal <= 15

// SESSION ENGINE — Precise DST Calculations
// US DST: 2nd Sunday of March → 1st Sunday of November
// EU DST: last Sunday of March → last Sunday of October
hourUTC = hour(time, "UTC")
_dom = dayofmonth(time, "UTC")
_mon = month(time, "UTC")
_yr = year(time, "UTC")
_dow = dayofweek(time, "UTC")
// Day-of-month of the first Sunday of current month via modular arithmetic
int _thisSunDom = _dom - ((_dow - 1 + 7) % 7)
int _firstSunDom = _thisSunDom - 7 * int((_thisSunDom - 1) / 7)
if _firstSunDom < 1
    _firstSunDom := _firstSunDom + 7
// --- US DST boundaries ---
var int usDstStartDom = 8
var int usDstEndDom = 1
var int _lastUsDstYr = 0
if _yr != _lastUsDstYr
    usDstStartDom := 8
    usDstEndDom := 1
    _lastUsDstYr := _yr
if _mon == 3
    usDstStartDom := _firstSunDom + 7 // 2nd Sunday of March
if _mon == 11
    usDstEndDom := _firstSunDom // 1st Sunday of November
bool usIsDST = (_mon > 3 and _mon < 11) or (_mon == 3 and _dom >= usDstStartDom) or (_mon == 11 and _dom < usDstEndDom)
// --- EU/London DST boundaries ---
// Progressive: tracks last Sunday via math.max on each Sunday of the month
var int euDstStartDom = 25
var int euDstEndDom = 25
var int _lastEuDstYr = 0
if _yr != _lastEuDstYr
    euDstStartDom := 25
    euDstEndDom := 25
    _lastEuDstYr := _yr
if _mon == 3 and _dow == 1
    euDstStartDom := math.max(euDstStartDom, _dom) // last Sunday of March
if _mon == 10 and _dow == 1
    euDstEndDom := math.max(euDstEndDom, _dom) // last Sunday of October
bool euIsDST = (_mon > 3 and _mon < 10) or (_mon == 3 and _dom >= euDstStartDom) or (_mon == 10 and _dom < euDstEndDom)

// Session hours in UTC
// London open fixed 07:00 UTC (captures pre-open activity; note: 1h early in winter)
int londonOpen = 7
int londonClose = euIsDST ? 16 : 17
int nyOpen = usIsDST ? 14 : 15
inAsian = hourUTC >= 0 and hourUTC < londonOpen
inLondon = hourUTC >= londonOpen and hourUTC < londonClose
inNY = hourUTC >= nyOpen and hourUTC < (usIsDST ? 20 : 21)
// Q5.0-S5: London killzones follow EU DST (07 UTC summer / 08 UTC winter) via the
// existing EU-DST tracker. Session classification keeps the documented fixed hours.
int effLondonOpen = euIsDST ? 7 : 8
inLondonKZ = hourUTC >= effLondonOpen + 1 and hourUTC < effLondonOpen + 4
inLondonFixKZ = hourUTC >= effLondonOpen + 3 and hourUTC < effLondonOpen + 4
inNYKZ = hourUTC >= nyOpen and hourUTC < nyOpen + 3
inLondonCloseKZ = hourUTC >= londonClose - 1 and hourUTC < londonClose
inKillzone = inLondonKZ or inNYKZ or inLondonCloseKZ or inLondonFixKZ

sessionQuality = 0
// Regime-aware session weights: trending → KZ/NY heavier, ranging → London heavier
sessionQuality += inKillzone ? int((30.0 + regimeStrength * 20.0)) : inLondon or inNY ? int((25.0)) : inAsian ? int((10.0)) : 0
sessionQuality += inLondonFixKZ ? int((25.0 - regimeStrength * 10.0)) : 0
sessionQuality += inNYKZ ? int((10.0 + regimeStrength * 10.0)) : 0
sessionQuality += (not inAsian or inLondonKZ) ? int((10.0)) : 0
sessionQuality += (inLondon and not inLondonKZ) ? int((10.0 - regimeStrength * 5.0)) : 0
sessionQuality := math.min(int(math.round(sessionQuality / (80.0) * 100.0)), 100)
f_sessionIntel() =>
    // ═══════════════ R6.0 SESSION INTELLIGENCE ═══════════════
    // Per-session-class rolling statistics (Asian=0, London=1, NY=2), confirmed bars only.
    // avg range = EWMA (a~0.1, ~ last 20 sessions); manipulation = swept the PREVIOUS
    // session's extreme intra-session but closed back inside; continuation = session closed
    // beyond 50% of its own range from its open (directional session).
    int sessId = inAsian ? 0 : inLondon ? 1 : inNY ? 2 : 3
    var int curSessId = -1
    var float sesHi = na
    var float sesLo = na
    var float sesOpenPx = na
    var float prevSesHi = na
    var float prevSesLo = na
    var bool sesManip = false
    var float[] sessRngAvg = array.from(0.0, 0.0, 0.0)
    var int[] sessCnt = array.from(0, 0, 0)
    var int[] sessManipCnt = array.from(0, 0, 0)
    var int[] sessContCnt = array.from(0, 0, 0)
    if barstate.isconfirmed
        if sessId != curSessId
            if curSessId >= 0 and curSessId <= 2 and not na(sesHi)
                float _rngS = sesHi - sesLo
                int _cS = array.get(sessCnt, curSessId)
                array.set(sessRngAvg, curSessId, _cS == 0 ? _rngS : array.get(sessRngAvg, curSessId) * 0.9 + _rngS * 0.1)
                array.set(sessCnt, curSessId, _cS + 1)
                if sesManip
                    array.set(sessManipCnt, curSessId, array.get(sessManipCnt, curSessId) + 1)
                if _rngS > 0 and math.abs(close[1] - sesOpenPx) / _rngS > 0.5
                    array.set(sessContCnt, curSessId, array.get(sessContCnt, curSessId) + 1)
            prevSesHi := sesHi
            prevSesLo := sesLo
            curSessId := sessId
            sesHi := high
            sesLo := low
            sesOpenPx := open
            sesManip := false
        else
            sesHi := math.max(nz(sesHi, high), high)
            sesLo := math.min(nz(sesLo, low), low)
            if not na(prevSesHi) and not na(prevSesLo) and ((high > prevSesHi and close < prevSesHi) or (low < prevSesLo and close > prevSesLo))
                sesManip := true
    float sessAvgRange = curSessId >= 0 and curSessId <= 2 ? array.get(sessRngAvg, curSessId) : na
    float sessExpansionPct = not na(sessAvgRange) and sessAvgRange > 0 and not na(sesHi) ? (sesHi - sesLo) / sessAvgRange * 100.0 : na
    int _sessN = curSessId >= 0 and curSessId <= 2 ? array.get(sessCnt, curSessId) : 0
    float sessManipProb = _sessN >= 5 ? array.get(sessManipCnt, curSessId) * 100.0 / _sessN : na
    float sessContProb = _sessN >= 5 ? array.get(sessContCnt, curSessId) * 100.0 / _sessN : na
    [sessId, curSessId, sesHi, sesLo, sesOpenPx, prevSesHi, prevSesLo, sesManip, sessExpansionPct, sessManipProb, sessContProb]
[sessId, curSessId, sesHi, sesLo, sesOpenPx, prevSesHi, prevSesLo, sesManip, sessExpansionPct, sessManipProb, sessContProb] = f_sessionIntel()
// ═══════════════ END SESSION INTELLIGENCE ═══════════════

// Session volume accumulators — per-session EWMA for anomaly detection (α=0.01, ~100 bar half-life)

// Session-aware confidence multipliers — XAUUSD-specific (heuristic)
float sessionConfMult = 1.0
if inKillzone
    sessionConfMult := inNYKZ ? 1.15 : inLondonKZ ? 1.10 : 1.05
else if inLondon
    sessionConfMult := 1.05
else if inNY
    sessionConfMult := 1.08
else if inAsian
    sessionConfMult := 0.92
// Session-adaptive spread: XAUUSD spread varies significantly by session
// D-006: P1-CAL-001 PROPAGATED. This ladder was left at the pre-fix values here while the
// Master was corrected, so the SELECTOR and the SCORER used different session economics.
// old 0.25/0.20/0.30/0.50 -> new 0.18/0.22/0.30/0.50 (Master's values, unchanged).
// The original ordering was INVERTED against liquidity: killzone is the London/NY overlap,
// the deepest and tightest window of the gold day, yet it was charged MORE (0.25) than
// plain NY (0.20) — and because killzone is tested FIRST a killzone bar never reached the
// cheaper tier. Cost now falls monotonically with liquidity depth.
// MASKED AT THE DEFAULT: _sessSpread = max(floor, spreadCost), so at spreadCost=0.3 every
// floor <=0.3 is dominated and both files collapse to 0.30 — which is why the cost
// invariant passed and the divergence stayed invisible. Below spreadCost 0.25 they differ
// by up to 0.07 points. Propagating the value, NOT retuning it.
float _sessSpread = inKillzone ? math.max(0.18, spreadCost) : inNY ? math.max(0.22, spreadCost) : inLondon ? math.max(0.30, spreadCost) : math.max(0.50, spreadCost)


// MACRO DATA FEEDS (zero repaint via [1], invalid symbols tolerated)
[_rawDXY, _rawDXYFast, _rawDXYSlow, _rawDXYRoc, _rawDXYRSI] = request.security(dxySymbol, macroTF, [close[1], ta.ema(close[1], 10), ta.ema(close[1], 20), ta.roc(close[1], dxyRocLen), ta.rsi(close[1], rsiLen)], barmerge.gaps_off, barmerge.lookahead_off, ignore_invalid_symbol=true)
[_rawYield, _rawYieldFast, _rawYieldSlow, _rawYieldRoc] = request.security(yieldSymbol, macroTF, [close[1], ta.ema(close[1], 10), ta.ema(close[1], 20), ta.roc(close[1], znRocLen)], barmerge.gaps_off, barmerge.lookahead_off, ignore_invalid_symbol=true)
[_rawSilver, _rawSilverEMA, _silverRSI] = request.security(silverSymbol, timeframe.period, [close[1], ta.ema(close[1], 20), ta.rsi(close[1], rsiLen)], barmerge.gaps_off, barmerge.lookahead_off, ignore_invalid_symbol=true)
[_rawEURUSD, _rawEURFast, _rawEURSlow, _rawEURRoc] = request.security(eurusdSymbol, timeframe.period, [close[1], ta.ema(close[1], 10), ta.ema(close[1], 20), ta.roc(close[1], dxyRocLen)], barmerge.gaps_off, barmerge.lookahead_off, ignore_invalid_symbol=true)
[_rawSPX, _rawSPXFast, _rawSPXSlow] = request.security(spxSymbol, timeframe.period, [close[1], ta.ema(close[1], 10), ta.ema(close[1], 20)], barmerge.gaps_off, barmerge.lookahead_off, ignore_invalid_symbol=true)
// PRE-EXISTING GAP CLOSED: the tipsSymbol input advertises "(blank=off)" but the call had
// no guard, so blanking it would have errored the script. Same fix as the new layers.
[_rawTIPS, _rawTIPSFast, _rawTIPSSlow] = request.security(tipsSymbol != "" ? tipsSymbol : syminfo.tickerid, macroTF, [close[1], ta.ema(close[1], 10), ta.ema(close[1], 20)], barmerge.gaps_off, barmerge.lookahead_off, ignore_invalid_symbol=true)

var float cachedDXY = na
var float cachedYield = na
var float cachedSilver = na
var float cachedEURUSD = na
var float cachedSPX = na
var float cachedTIPS = na
var int dxyStaleCount = 0
var int yieldStaleCount = 0
var int silverStaleCount = 0
var int eurusdStaleCount = 0
var int spxStaleCount = 0
var int tipsStaleCount = 0
if not na(_rawDXY)
    cachedDXY := _rawDXY
    dxyStaleCount := 0
else
    dxyStaleCount := dxyStaleCount + 1
if not na(_rawYield)
    cachedYield := _rawYield
    yieldStaleCount := 0
else
    yieldStaleCount := yieldStaleCount + 1
if not na(_rawSilver)
    cachedSilver := _rawSilver
    silverStaleCount := 0
else
    silverStaleCount := silverStaleCount + 1
if not na(_rawEURUSD)
    cachedEURUSD := _rawEURUSD
    eurusdStaleCount := 0
else
    eurusdStaleCount := eurusdStaleCount + 1
if not na(_rawSPX)
    cachedSPX := _rawSPX
    spxStaleCount := 0
else
    spxStaleCount := spxStaleCount + 1
if not na(_rawTIPS)
    cachedTIPS := _rawTIPS
    tipsStaleCount := 0
else
    tipsStaleCount := tipsStaleCount + 1
int MACRO_STALE_MAX = 2
dxyClose = cachedDXY
yieldClose = cachedYield
silverClose = cachedSilver
eurusdClose = cachedEURUSD
spxClose = cachedSPX
tipsClose = cachedTIPS
dxyValid = not na(dxyClose) and not na(_rawDXYFast) and not na(_rawDXYSlow) and dxyStaleCount < MACRO_STALE_MAX
yieldValid = not na(yieldClose) and not na(_rawYieldFast) and not na(_rawYieldSlow) and yieldStaleCount < MACRO_STALE_MAX
silverValid = not na(silverClose) and not na(_rawSilverEMA) and silverStaleCount < MACRO_STALE_MAX
eurusdValid = not na(eurusdClose) and not na(_rawEURFast) and not na(_rawEURSlow) and eurusdStaleCount < MACRO_STALE_MAX
spxValid = not na(spxClose) and not na(_rawSPXFast) and not na(_rawSPXSlow) and spxStaleCount < MACRO_STALE_MAX
tipsValid = not na(tipsClose) and not na(_rawTIPSFast) and not na(_rawTIPSSlow) and tipsStaleCount < MACRO_STALE_MAX

dxyEMAFast = _rawDXYFast
dxyEMASlow = _rawDXYSlow
yieldEMAFast = _rawYieldFast
yieldEMASlow = _rawYieldSlow
eurusdEMAFast = _rawEURFast
eurusdEMASlow = _rawEURSlow
spxEMAFast = _rawSPXFast
spxEMASlow = _rawSPXSlow
tipsEMAFast = _rawTIPSFast
tipsEMASlow = _rawTIPSSlow
silverEMA = _rawSilverEMA
dxyBull = dxyValid and dxyClose > dxyEMAFast and dxyEMAFast > dxyEMASlow
dxyBear = dxyValid and dxyClose < dxyEMAFast and dxyEMAFast < dxyEMASlow
_yieldUp = yieldValid and yieldClose > yieldEMAFast and yieldEMAFast > yieldEMASlow
_yieldDown = yieldValid and yieldClose < yieldEMAFast and yieldEMAFast < yieldEMASlow
yieldRising = invertYield ? _yieldDown : _yieldUp
yieldFalling = invertYield ? _yieldUp : _yieldDown
eurusdBull = eurusdValid and eurusdClose > eurusdEMAFast and eurusdEMAFast > eurusdEMASlow
eurusdBear = eurusdValid and eurusdClose < eurusdEMAFast and eurusdEMAFast < eurusdEMASlow
spxBull = spxValid and spxClose > spxEMAFast and spxEMAFast > spxEMASlow
spxBear = spxValid and spxClose < spxEMAFast and spxEMAFast < spxEMASlow
tipsRising = tipsValid and tipsClose > tipsEMAFast and tipsEMAFast > tipsEMASlow
tipsFalling = tipsValid and tipsClose < tipsEMAFast and tipsEMAFast < tipsEMASlow
silverBull = silverValid and silverClose > silverEMA
silverBear = silverValid and silverClose < silverEMA


// ----- US2Y and the 2y10y curve ------------------------------------------------
float _y2 = y2Symbol != "" ? request.security(y2Symbol, macroTF, close[1], barmerge.gaps_off, barmerge.lookahead_off, ignore_invalid_symbol=true) : na
bool y2Valid = y2Symbol != "" and not na(_y2) and not na(_rawYield)
// Spread in yield points. Rising = steepening = historically gold-supportive.
float curve2s10s = y2Valid ? _rawYield - _y2 : na
bool curveSteepening = y2Valid and not na(curve2s10s[1]) and curve2s10s > curve2s10s[1]
string curveState = not y2Valid ? "" : "  2s10s" + str.tostring(curve2s10s, "#.##") + (curveSteepening ? "^" : "v")

// ----- COT positioning (weekly, crowding percentile) ---------------------------
// Managed Money net = non-commercial long minus short, CFTC legacy report, gold 088691.
// DEPLOY GUARD — the most important one in this build. The COT tickers were constructed
// from documented convention and have NEVER been confirmed against a live TradingView feed.
// Previously they were requested UNCONDITIONALLY, so shipping COT "off" did NOT protect
// anything: an unresolvable symbol would have broken the ENTIRE script on load, taking the
// whole dashboard down over a disabled optional feature.
// Now the request only names the COT symbols when the user has explicitly enabled the
// layer; otherwise it requests the chart's own ticker, which always resolves. cotValid
// already requires cotEnable, so the fallback value is never consumed.
// CONSEQUENCE: with cotEnable=false (the default) this build cannot fail on COT symbols.
// When you DO enable it, verify the symbols resolve — if they don't, that is the moment
// the error appears, isolated to a deliberate action rather than at load time.
string _cotL = cotEnable ? "COT:088691_F_L_ALL_NC_L" : syminfo.tickerid
string _cotS = cotEnable ? "COT:088691_F_L_ALL_NC_S" : syminfo.tickerid
float _cotNetRaw = cotEnable ? request.security(_cotL, "W", close[1], barmerge.gaps_off, barmerge.lookahead_off, ignore_invalid_symbol=true) - request.security(_cotS, "W", close[1], barmerge.gaps_off, barmerge.lookahead_off, ignore_invalid_symbol=true) : na
bool cotValid = cotEnable and not na(_cotNetRaw)
// Percentile rank of current net positioning within its own lookback — the absolute
// contract count is meaningless without that context.
// F-032: hoisted out of the ternary so ta.percentrank is evaluated on every calculation.
// Kept identical to the Master -- the twins must not diverge in feature semantics.
float _cotPctRaw = ta.percentrank(_cotNetRaw, cotLen)
float cotPct = cotValid ? _cotPctRaw : na
bool cotCrowdedLong = cotValid and cotPct >= cotExtreme
bool cotCrowdedShort = cotValid and cotPct <= (100 - cotExtreme)
// CONTRARIAN AT EXTREMES, neutral otherwise. Crowded longs = elevated reversal risk, which
// is a CAUTION on longs rather than a short signal — hence a conviction damper, not a vote.
int cotRegime = not cotValid ? 0 : cotCrowdedLong ? -1 : cotCrowdedShort ? 1 : 0
string cotState = not cotValid ? "" : "  COT" + str.tostring(int(nz(cotPct, 50))) + (cotCrowdedLong ? "!LONG-CROWD" : cotCrowdedShort ? "!SHORT-CROWD" : "")

// ----- Open Interest conviction (daily, delay-immune) --------------------------
[_oiNow, _oiPrev] = request.security(oiSymbol != "" ? oiSymbol : syminfo.tickerid, "D", [close[1], close[2]], barmerge.gaps_off, barmerge.lookahead_off, ignore_invalid_symbol=true)
bool oiValid = oiSymbol != "" and not na(_oiNow) and not na(_oiPrev) and _oiPrev > 0
float oiChgPct = oiValid ? (_oiNow - _oiPrev) / _oiPrev * 100.0 : na
bool oiRising = oiValid and oiChgPct > 0.0
// Daily price direction, taken on the SAME daily series so the two are aligned.
float _dC1 = request.security(syminfo.tickerid, "D", close[1], barmerge.gaps_off, barmerge.lookahead_off)
float _dC2 = request.security(syminfo.tickerid, "D", close[2], barmerge.gaps_off, barmerge.lookahead_off)
bool _dUp = not na(_dC1) and not na(_dC2) and _dC1 > _dC2
// +1 genuine participation, -1 closing-out move, 0 unknown.
int oiConviction = not oiValid or na(_dC1) or na(_dC2) ? 0 : (_dUp and oiRising) ? 1 : (not _dUp and oiRising) ? -1 : 0
string oiState = not oiValid ? "OI —" : (_dUp and oiRising) ? "OI NEW-LONG" : (not _dUp and oiRising) ? "OI NEW-SHORT" : (_dUp and not oiRising) ? "OI COVER" : "OI LIQ"


// ----- GC futures confirmation layer -------------------------------------------
// All series taken at [1] (previous, fully-closed GC bar) so nothing here can read a
// partially-formed or delayed current bar.
bool gcEnabled = gcSymbol != "" and chartTFSeconds >= gcMinTfSec
// DEPLOY GUARD: the input advertises "blank=off", but request.security() with an empty
// symbol is a runtime error — the ternary is what actually makes "off" safe. Falls back to
// the chart's own ticker, which always resolves; gcEnabled is false in that case so nothing
// downstream consumes it. OI and US2Y already had this guard; GC did not.
[_gcC, _gcEma, _gcVol, _gcVolAvg, _gcT] = request.security(gcSymbol != "" ? gcSymbol : syminfo.tickerid, timeframe.period, [close[1], ta.ema(close[1], 20), volume[1], ta.sma(volume[1], 20), time[1]], barmerge.gaps_off, barmerge.lookahead_off, ignore_invalid_symbol=true)
// INSTRUMENT SANITY CHECK (reviewer point 4). ignore_invalid_symbol protects symbol
// RESOLUTION; it does NOT prove the ticker is the intended instrument. A script that loads
// cleanly can still be logically wrong — gcSymbol pointing at silver, an equity or DXY
// resolves perfectly and then feeds nonsense into a macro vote.
// Gold futures carry a basis versus spot, but a BOUNDED one: contango has never approached
// 5% of spot. A different instrument is off by orders of magnitude (silver ~99%, an equity
// ~96%). So a 5% band separates "gold futures" from "not gold" without importing the level.
// This compares MAGNITUDES ONLY as a sanity test — no GC price enters any calculation, and
// the basis-neutrality of the EMA comparison is untouched.
// Fails CLOSED: an implausible symbol makes gcValid false, so the layer disables itself
// exactly as if the symbol were missing, rather than voting on bad data.
// ===== GC_DATA_INTEGRITY — consolidated gate ==================================
// Reviewer's requirement: bad data must make the layer UNAVAILABLE, never bullish or
// bearish. Each check below can only DISABLE; none can flip a direction. Fails closed.
//   1 RESOLVED   ignore_invalid_symbol returns na for an unresolvable ticker
//   2 FINITE/+   guards na and non-positive prices (a bad feed can return 0)
//   3 FRESH      GC's last closed bar must be within 3 chart bars of ours. This is what
//                catches a STALE feed — e.g. a delayed entitlement on a timeframe where
//                the delay exceeds a bar, or a futures session closed while spot trades.
//                Stale data is the dangerous case precisely because it looks valid.
//   4 PLAUSIBLE  catastrophic wrong-instrument detector ONLY. The 5% band is NOT a model
//                of the true futures/spot basis and must never be cited as one — gold
//                contango has never approached 5%, while a wrong instrument is off by
//                orders of magnitude.
bool gcResolved  = not na(_gcC) and not na(_gcEma) and not na(_gcVol)
bool gcFinite    = gcResolved and _gcC > 0 and _gcVol >= 0
bool gcFresh     = gcResolved and not na(_gcT) and (time - _gcT) <= (chartTFSeconds * 3 * 1000)
bool gcPlausible = gcFinite and not na(close) and close > 0 and math.abs(_gcC - close) / close <= 0.05
bool gcValid = gcEnabled and gcResolved and gcFinite and gcFresh and gcPlausible
// Named failure reason — a silent disable is how a feature becomes an unnoticed orphan.
string gcFailWhy = not gcEnabled ? "" : not gcResolved ? "!UNRESOLVED" : not gcFinite ? "!BADPRICE" : not gcFresh ? "!STALE" : not gcPlausible ? "!SYMBOL?" : ""
// ===== UNIVERSAL DATA-SOURCE STATUS SEMANTICS (reviewer §10) ==================
// Same vocabulary for every external source: 0=VALID 1=UNAVAILABLE 2=STALE 3=INVALID.
// INVARIANT: a non-zero status can only DISABLE a layer, never supply a direction.
int GC_STATUS   = gcValid ? 0 : not gcEnabled ? 1 : not gcResolved ? 1 : not gcFinite ? 3 : not gcFresh ? 2 : 3
int OI_STATUS   = oiValid ? 0 : oiSymbol == "" ? 1 : (na(_oiNow) or na(_oiPrev)) ? 1 : 3
int US2Y_STATUS = y2Valid ? 0 : 1
int COT_STATUS  = cotValid ? 0 : 1
// Direction: GC vs its own 20-EMA — a self-referential test, so the spot/futures basis
// cancels and never enters the comparison.
bool gcBull = gcValid and _gcC > _gcEma
bool gcBear = gcValid and _gcC < _gcEma
// Real traded-contract expansion, the thing CFD tick-volume cannot tell you.
bool gcVolExp = gcValid and not na(_gcVolAvg) and _gcVolAvg > 0 and _gcVol > _gcVolAvg * gcVolMult
// DIVERGENCE = the two markets disagree on direction. Spot side uses the same 20-EMA test
// on the same timeframe, so the comparison is like-for-like.
bool _spotBull = close[1] > ta.ema(close[1], 20)
bool gcConfirmsBull = gcValid and gcBull and _spotBull
bool gcConfirmsBear = gcValid and gcBear and not _spotBull
bool gcDiverges = gcValid and (gcBull != _spotBull)
// Strongest state: agreement PLUS real contract expansion behind it.
bool gcStrongBull = gcConfirmsBull and gcVolExp
bool gcStrongBear = gcConfirmsBear and gcVolExp
string gcState = gcFailWhy != "" ? "GC" + gcFailWhy : not gcValid ? "GC —" : gcDiverges ? "GC DIV" : gcStrongBull ? "GC ++" : gcStrongBear ? "GC --" : gcConfirmsBull ? "GC +" : gcConfirmsBear ? "GC -" : "GC ~"

macroBullVotes = (gcConfirmsBull ? 1 : 0) + (dxyBear ? 1 : 0) + (yieldFalling ? 1 : 0) + (spxBull ? 1 : 0) + (eurusdBull ? 1 : 0) + (silverBull ? 1 : 0) + (tipsFalling ? 1 : 0)
macroBearVotes = (gcConfirmsBear ? 1 : 0) + (dxyBull ? 1 : 0) + (yieldRising ? 1 : 0) + (spxBear ? 1 : 0) + (eurusdBear ? 1 : 0) + (silverBear ? 1 : 0) + (tipsRising ? 1 : 0)
// THRESHOLD SCALED WITH THE VOTE POOL — this is a correctness detail, not tuning.
// The macro gate was 3-of-6 (50%). Adding GC as a 7th source while leaving the threshold
// at 3 would have made it 3-of-7 (43%) — a SILENT LOOSENING of a risk gate, and exactly
// the kind of drive-by behaviour change this project has been removing.
// The threshold now tracks the pool. Half of 7 is 3.5, so it cannot be held at exactly
// 50%: 3-of-7 is 43% (looser than before), 4-of-7 is 57% (tighter). 4 is chosen
// DELIBERATELY because for a risk gate, rounding toward tighter is the safe direction —
// the failure mode of being marginally too strict is a missed trade, of being too loose is
// an unfiltered one. This is a rounding choice made explicit, not a performance tune.
// With GC disabled the pool is 6, the threshold is 3, and behaviour is bit-identical
// to before this feature existed.
// POLICY-DRIVEN, NOT HAND-SET (reviewer §10). The threshold is now DERIVED from the pool
// by a stated rule instead of a lookup table, so ANY future vote addition rescales itself
// and no one has to remember to bump a constant. Policy: ceil(pool / 2) — a strict majority,
// rounding UP because for a risk gate the safe rounding direction is stricter.
//   pool 6 -> 3 (50%)   pool 7 -> 4 (57%)   pool 8 -> 4 (50%)   pool 9 -> 5 (56%)
// Verify by hand: math.ceil(6/2)=3 reproduces the original gate exactly, so with GC off
// behaviour is bit-identical to the pre-GC build.
int _macroPool = 6 + (gcValid ? 1 : 0)
int _macroNeed = int(math.ceil(_macroPool / 2.0))
macroBull = macroBullVotes >= _macroNeed
macroBear = macroBearVotes >= _macroNeed
dxyROC = dxyValid ? nz(_rawDXYRoc, 0.0) : 0.0
dxyMomBull = dxyROC > 0.15
dxyMomBear = dxyROC < -0.15
znROC = yieldValid ? nz(_rawYieldRoc, 0.0) : 0.0
eurusdROC = eurusdValid ? nz(_rawEURRoc, 0.0) : 0.0
// R5.1: ratePressure redefined as yield momentum only — the old znROC+eurusdROC sum mixed two
// series with OPPOSITE gold implications (yields up = bearish, EURUSD up = bullish), making the
// composite uninterpretable. Renamed Up/Down; wired into macro momentum (msRate) below.
ratePressure = znROC
ratePressureUp = ratePressure > 0.1
ratePressureDown = ratePressure < -0.1
goldBarDir = close > close[1] ? 1 : close < close[1] ? -1 : 0
// Correlation breakdown: weighted by move magnitude (units are heuristic)
// Exponential decay of breakdown signal

silverRet = silverValid and not na(silverClose[1]) ? safeDiv(silverClose, silverClose[1]) - 1 : na
dxyRet = dxyValid and not na(dxyClose[1]) ? safeDiv(dxyClose, dxyClose[1]) - 1 : na
yieldRet = yieldValid and not na(yieldClose[1]) ? safeDiv(yieldClose, yieldClose[1]) - 1 : na
eurRet = eurusdValid and not na(eurusdClose[1]) ? safeDiv(eurusdClose, eurusdClose[1]) - 1 : na
spxRet = spxValid and not na(spxClose[1]) ? safeDiv(spxClose, spxClose[1]) - 1 : na
tipsRet = tipsValid and not na(tipsClose[1]) ? safeDiv(tipsClose, tipsClose[1]) - 1 : na
_ccGoldDXY_30 = ta.correlation(goldRet, dxyRet, corrShortLen)
_ccGoldDXY_60 = ta.correlation(goldRet, dxyRet, corrMedLen)
_ccGoldDXY_120 = ta.correlation(goldRet, dxyRet, corrLongLen)
_ccGoldYld_30 = ta.correlation(goldRet, yieldRet, corrShortLen)
_ccGoldYld_60 = ta.correlation(goldRet, yieldRet, corrMedLen)
_ccGoldYld_120 = ta.correlation(goldRet, yieldRet, corrLongLen)
_ccGoldSlv_30 = ta.correlation(goldRet, silverRet, corrShortLen)
_ccGoldSlv_60 = ta.correlation(goldRet, silverRet, corrMedLen)
_ccGoldSlv_120 = ta.correlation(goldRet, silverRet, corrLongLen)
_ccGoldSPX_30 = ta.correlation(goldRet, spxRet, corrShortLen)
_ccGoldSPX_60 = ta.correlation(goldRet, spxRet, corrMedLen)
_ccGoldSPX_120 = ta.correlation(goldRet, spxRet, corrLongLen)
_ccGoldEUR_30 = ta.correlation(goldRet, eurRet, corrShortLen)
_ccGoldEUR_60 = ta.correlation(goldRet, eurRet, corrMedLen)
_ccGoldEUR_120 = ta.correlation(goldRet, eurRet, corrLongLen)
_ccGoldTIPS_30 = ta.correlation(goldRet, tipsRet, corrShortLen)
_ccGoldTIPS_60 = ta.correlation(goldRet, tipsRet, corrMedLen)
_ccGoldTIPS_120 = ta.correlation(goldRet, tipsRet, corrLongLen)
corrGoldDXY_30 = dxyValid ? _ccGoldDXY_30 : na
corrGoldDXY_60 = dxyValid ? _ccGoldDXY_60 : na
corrGoldDXY_120 = dxyValid ? _ccGoldDXY_120 : na
corrGoldYld_30 = yieldValid ? _ccGoldYld_30 : na
corrGoldYld_60 = yieldValid ? _ccGoldYld_60 : na
corrGoldYld_120 = yieldValid ? _ccGoldYld_120 : na
corrGoldSlv_30 = silverValid ? _ccGoldSlv_30 : na
corrGoldSlv_60 = silverValid ? _ccGoldSlv_60 : na
corrGoldSlv_120 = silverValid ? _ccGoldSlv_120 : na
corrGoldSPX_30 = spxValid ? _ccGoldSPX_30 : na
corrGoldSPX_60 = spxValid ? _ccGoldSPX_60 : na
corrGoldSPX_120 = spxValid ? _ccGoldSPX_120 : na
corrGoldEUR_30 = eurusdValid ? _ccGoldEUR_30 : na
corrGoldEUR_60 = eurusdValid ? _ccGoldEUR_60 : na
corrGoldEUR_120 = eurusdValid ? _ccGoldEUR_120 : na
corrGoldTIPS_30 = tipsValid ? _ccGoldTIPS_30 : na
corrGoldTIPS_60 = tipsValid ? _ccGoldTIPS_60 : na
corrGoldTIPS_120 = tipsValid ? _ccGoldTIPS_120 : na
avgCorrDXY = (nz(corrGoldDXY_30) + nz(corrGoldDXY_60) + nz(corrGoldDXY_120)) / 3.0
avgCorrYld = (nz(corrGoldYld_30) + nz(corrGoldYld_60) + nz(corrGoldYld_120)) / 3.0
avgCorrSlv = (nz(corrGoldSlv_30) + nz(corrGoldSlv_60) + nz(corrGoldSlv_120)) / 3.0
avgCorrSPX = (nz(corrGoldSPX_30) + nz(corrGoldSPX_60) + nz(corrGoldSPX_120)) / 3.0
avgCorrEUR = (nz(corrGoldEUR_30) + nz(corrGoldEUR_60) + nz(corrGoldEUR_120)) / 3.0
avgCorrTIPS = (nz(corrGoldTIPS_30) + nz(corrGoldTIPS_60) + nz(corrGoldTIPS_120)) / 3.0
stabDXY = math.abs(nz(corrGoldDXY_30) - nz(corrGoldDXY_120))
stabYld = math.abs(nz(corrGoldYld_30) - nz(corrGoldYld_120))
stabSlv = math.abs(nz(corrGoldSlv_30) - nz(corrGoldSlv_120))
stabSPX = math.abs(nz(corrGoldSPX_30) - nz(corrGoldSPX_120))
stabEUR = math.abs(nz(corrGoldEUR_30) - nz(corrGoldEUR_120))
stabTIPS = math.abs(nz(corrGoldTIPS_30) - nz(corrGoldTIPS_120))
float _numStab = 0.0
_numStab := dxyValid ? _numStab + 1.0 : _numStab
_numStab := yieldValid ? _numStab + 1.0 : _numStab
_numStab := silverValid ? _numStab + 1.0 : _numStab
_numStab := spxValid ? _numStab + 1.0 : _numStab
_numStab := eurusdValid ? _numStab + 1.0 : _numStab
_numStab := tipsValid ? _numStab + 1.0 : _numStab
avgStability = _numStab > 0 ? (stabDXY + stabYld + stabSlv + stabSPX + stabEUR + stabTIPS) / _numStab : 0.0

// Inverse t-distribution quantile via Cornish-Fisher expansion from normal
// (Abramowitz-Stegun 26.2.23 + Fisher expansion). Accurate to ~1% for df>=8.
tInv(float p, int df) =>
    // Normal quantile (Abramowitz-Stegun 26.2.23)
    float q = p > 0.5 ? 1.0 - p : p
    float t = math.sqrt(-2.0 * math.log(q))
    float c0 = 2.515517
    float c1 = 0.802853
    float c2 = 0.010328
    float d1 = 1.432788
    float d2 = 0.189269
    float d3 = 0.001308
    float z = t - (c0 + c1 * t + c2 * t * t) / (1.0 + d1 * t + d2 * t * t + d3 * t * t * t)
    // R5.2-H1: sign was inverted (upper quantile returned negative), which made every
    // _corrSigXX threshold negative and forced corrWinScore onto its rs*10 fallback —
    // the entire t-dist/Bonferroni machinery (R5-F9) was dead code.
    z := p > 0.5 ? z : -z
    // Fisher expansion: t(df) ≈ z + (z³+z)/(4·df) + (5z⁵+16z³+3z)/(96·df²)
    if df > 2
        float z2 = z * z
        float z3 = z2 * z
        float z5 = z3 * z2
        z := z + (z3 + z) / (4.0 * df)
        z := z + (5.0 * z5 + 16.0 * z3 + 3.0 * z) / (96.0 * df * df)
    z

// Per-window correlation significance thresholds
// R5-F9: Bonferroni-corrected for 18 simultaneous tests (6 assets x 3 windows).
float _pUpper = 1.0 - (0.05 / 18.0) / 2.0 // two-tailed → upper quantile at 1-α'/2
int _df30 = math.max(corrShortLen - 2, 1)
int _df60 = math.max(corrMedLen - 2, 1)
int _df120 = math.max(corrLongLen - 2, 1)
float _t30 = tInv(_pUpper, _df30)
float _t60 = tInv(_pUpper, _df60)
float _t120 = tInv(_pUpper, _df120)
float _corrSig30 = _t30 / math.sqrt(_df30 + _t30 * _t30)
float _corrSig60 = _t60 / math.sqrt(_df60 + _t60 * _t60)
float _corrSig120 = _t120 / math.sqrt(_df120 + _t120 * _t120)

// Score a single window's correlation against its own threshold (sign: +1 expects positive corr, -1 expects negative)
corrWinScore(float r, float sig, float sign) =>
    float rs = r * sign
    float norm = sig > 0 ? rs / sig : rs * 10.0
    50.0 + 45.0 * math.min(1.0, math.max(-1.0, norm))

corrHealthMW(float r30, float r60, float r120, float sig30, float sig60, float sig120, float sign) =>
    (corrWinScore(r30, sig30, sign) + corrWinScore(r60, sig60, sign) + corrWinScore(r120, sig120, sign)) / 3.0

corrHealthDXY = dxyValid ? corrHealthMW(nz(corrGoldDXY_30), nz(corrGoldDXY_60), nz(corrGoldDXY_120), _corrSig30, _corrSig60, _corrSig120, -1.0) : 0.0
corrHealthYld = yieldValid ? corrHealthMW(nz(corrGoldYld_30), nz(corrGoldYld_60), nz(corrGoldYld_120), _corrSig30, _corrSig60, _corrSig120, invertYield ? 1.0 : -1.0) : 0.0
corrHealthSlv = silverValid ? corrHealthMW(nz(corrGoldSlv_30), nz(corrGoldSlv_60), nz(corrGoldSlv_120), _corrSig30, _corrSig60, _corrSig120, 1.0) : 0.0
corrHealthSPX = spxValid ? corrHealthMW(nz(corrGoldSPX_30), nz(corrGoldSPX_60), nz(corrGoldSPX_120), _corrSig30, _corrSig60, _corrSig120, 1.0) : 0.0
corrHealthEUR = eurusdValid ? corrHealthMW(nz(corrGoldEUR_30), nz(corrGoldEUR_60), nz(corrGoldEUR_120), _corrSig30, _corrSig60, _corrSig120, 1.0) : 0.0
corrHealthTIPS = tipsValid ? corrHealthMW(nz(corrGoldTIPS_30), nz(corrGoldTIPS_60), nz(corrGoldTIPS_120), _corrSig30, _corrSig60, _corrSig120, -1.0) : 0.0
float _numValid = 0.0
_numValid := dxyValid ? _numValid + 1.0 : _numValid
_numValid := yieldValid ? _numValid + 1.0 : _numValid
_numValid := silverValid ? _numValid + 1.0 : _numValid
_numValid := spxValid ? _numValid + 1.0 : _numValid
_numValid := eurusdValid ? _numValid + 1.0 : _numValid
_numValid := tipsValid ? _numValid + 1.0 : _numValid
avgCorrHealth = _numValid > 0 ? (corrHealthDXY + corrHealthYld + corrHealthSlv + corrHealthSPX + corrHealthEUR + corrHealthTIPS) / _numValid : 0.0

_wDXYr = math.min(math.abs(avgCorrDXY) * 100, 30)
_wYldr = math.min(math.abs(avgCorrYld) * 100, 30)
_wSlvr = math.min(math.abs(avgCorrSlv) * 100, 25)
_wSPXr = spxValid ? math.min(math.abs(avgCorrSPX) * 100, 15) : 0.0 // R5.1: adaptive by |corr| like the other assets (wires avgCorrSPX)
_wEURr = eurusdValid ? 20.0 : 0.0
_wTIPSr = math.min(math.abs(avgCorrTIPS) * 100, 25)
_wTot = _wDXYr + _wYldr + _wSlvr + _wSPXr + _wEURr + _wTIPSr
wDXY = _wTot > 0 ? _wDXYr / _wTot * 100 : 30.0
wYld = _wTot > 0 ? _wYldr / _wTot * 100 : 25.0
wSlv = _wTot > 0 ? _wSlvr / _wTot * 100 : 20.0
wSPX = _wTot > 0 ? _wSPXr / _wTot * 100 : 15.0
wEUR = _wTot > 0 ? _wEURr / _wTot * 100 : 20.0
wTIPS = _wTot > 0 ? _wTIPSr / _wTot * 100 : 10.0
msDXY = dxyValid ? (dxyBear ? wDXY : dxyBull ? -wDXY : 0.0) : 0.0
msYld = yieldValid ? (yieldFalling ? wYld : yieldRising ? -wYld : 0.0) : 0.0
msSPX = spxValid ? (spxBull ? wSPX : spxBear ? -wSPX : 0.0) : 0.0
msEUR = eurusdValid ? (eurusdBull ? wEUR : eurusdBear ? -wEUR : 0.0) : 0.0
msSlv = silverValid ? (silverClose > silverEMA ? wSlv : silverClose < silverEMA ? -wSlv : 0.0) : 0.0
msTIPS = tipsValid ? (tipsFalling ? wTIPS : tipsRising ? -wTIPS : 0.0) : 0.0
msMom = dxyValid ? (dxyMomBear ? 10.0 : dxyMomBull ? -10.0 : 0.0) : 0.0
// R5.1: rate/FX momentum wired into the macro score (yield ROC falling = gold-bullish;
// EURUSD ROC rising = gold-bullish). Clamp below keeps the composite in [-100, 100].
msRate = (yieldValid ? (ratePressureDown ? 5.0 : ratePressureUp ? -5.0 : 0.0) : 0.0) + (eurusdValid ? (eurusdROC > 0.15 ? 5.0 : eurusdROC < -0.15 ? -5.0 : 0.0) : 0.0)
macroStrengthScore = int(math.max(math.min(msDXY + msYld + msSPX + msEUR + msSlv + msTIPS + msMom + msRate, 100), -100))
// Confidence = data availability (30%) + correlation health (50%) + score stability (20%)
float _macroStDev = nz(ta.stdev(macroStrengthScore, 20), 50.0)
macroStrengthConf = int(math.round((((dxyValid ? 1 : 0) + (yieldValid ? 1 : 0) + (silverValid ? 1 : 0) + (spxValid ? 1 : 0) + (eurusdValid ? 1 : 0) + (tipsValid ? 1 : 0)) / 6.0) * 30.0 + avgCorrHealth * 0.50 + (1.0 - math.min(_macroStDev / 100.0, 1.0)) * 20.0))
// macroStrengthScore is an ordinal composite (−100 to +100), NOT a probability.

// WEIGHTED TREND ENGINE
bullTrendScore = 0
bullTrendScore += close > ema200 ? 20 : 0
bullTrendScore += ema20 > ema100 ? 20 : 0
// Q6.9 (plan item 11): DI de-duplication. Three of six terms tested
// diplus>diminus, and evFlowBull is that same comparison at full weight — so one
// indicator drove ~25% of the blend while the weight table claimed 20%/15% for two
// "independent" factors. One ADX-qualified DI term is retained (most informative);
// the bare duplicate and the volume-DI hybrid are replaced by EMA-slope and
// price-vs-EMA20 terms, which are price-structure evidence flow does not supply.
// Total remains 100.
bullTrendScore += ema20 > ema20[3] ? 20 : 0
bullTrendScore += diplus > diminus and adxVal > adxThreshold ? 20 : 0
bullTrendScore += close > ema100 ? 10 : 0
bullTrendScore += highVolume and close > ema20 ? 10 : 0
bearTrendScore = 0
bearTrendScore += close < ema200 ? 20 : 0
bearTrendScore += ema20 < ema100 ? 20 : 0
bearTrendScore += ema20 < ema20[3] ? 20 : 0
bearTrendScore += diminus > diplus and adxVal > adxThreshold ? 20 : 0
bearTrendScore += close < ema100 ? 10 : 0
bearTrendScore += highVolume and close < ema20 ? 10 : 0
bullTrend = bullTrendScore >= trendThreshold
bearTrend = bearTrendScore >= trendThreshold

// DUAL STRUCTURE ENGINE — Internal (fast) + Swing (major)
pivotHigh = ta.pivothigh(high, internalPivotLen, internalPivotLen)
pivotLow = ta.pivotlow(low, internalPivotLen, internalPivotLen)
var float activeResistance = na
var float activeSupport = na
var float lastBrokenRes = na
var float lastBrokenSup = na
bosResistanceSnap = activeResistance
bosSupportSnap = activeSupport
if not na(pivotHigh)
    if not na(activeResistance)
        lastBrokenRes := activeResistance
    activeResistance := pivotHigh
if not na(pivotLow)
    if not na(activeSupport)
        lastBrokenSup := activeSupport
    activeSupport := pivotLow
swingPivotHigh = ta.pivothigh(high, swingPivotLen, swingPivotLen)
swingPivotLow = ta.pivotlow(low, swingPivotLen, swingPivotLen)
var float swingActiveResistance = na
var float swingActiveSupport = na
var float swingLastBrokenRes = na
var float swingLastBrokenSup = na
swingBosResSnap = swingActiveResistance
swingBosSupSnap = swingActiveSupport
if not na(swingPivotHigh)
    if not na(swingActiveResistance)
        swingLastBrokenRes := swingActiveResistance
    swingActiveResistance := swingPivotHigh
if not na(swingPivotLow)
    if not na(swingActiveSupport)
        swingLastBrokenSup := swingActiveSupport
    swingActiveSupport := swingPivotLow

// ENHANCED BOS DETECTION (evaluated BEFORE breakout state updates)
bodySize = math.abs(close - open)
candleRange = high - low
bodyPct = candleRange > 0 ? bodySize / candleRange * 100.0 : 0.0
float breakBuffer = adaptiveATR * 0.15
float strongBody = adaptiveATR * 0.30
bool strongVol = not na(volume) and volume > volSma20 * 1.20 * regBOSMult // R6.0: BOS volume requirement scales with volatility regime
intBullBOS = not na(bosResistanceSnap) and close > bosResistanceSnap and close[1] <= bosResistanceSnap[1] and bosResistanceSnap != lastBrokenRes and adxGate and (close - bosResistanceSnap) > breakBuffer and bodySize > strongBody and bodyPct > 70 and strongVol
intBearBOS = not na(bosSupportSnap) and close < bosSupportSnap and close[1] >= bosSupportSnap[1] and bosSupportSnap != lastBrokenSup and adxGate and (bosSupportSnap - close) > breakBuffer and bodySize > strongBody and bodyPct > 70 and strongVol
swingBullBOS = not na(swingBosResSnap) and close > swingBosResSnap and close[1] <= swingBosResSnap[1] and swingBosResSnap != swingLastBrokenRes and adxGate and (close - swingBosResSnap) > breakBuffer and bodySize > strongBody and bodyPct > 70 and strongVol
swingBearBOS = not na(swingBosSupSnap) and close < swingBosSupSnap and close[1] >= swingBosSupSnap[1] and swingBosSupSnap != swingLastBrokenSup and adxGate and (swingBosSupSnap - close) > breakBuffer and bodySize > strongBody and bodyPct > 70 and strongVol
bullBOS = intBullBOS or swingBullBOS
bearBOS = intBearBOS or swingBearBOS

// Breakout state update (after BOS evaluation so snap != lastBrokenRes works)
if not na(activeResistance) and close > activeResistance and close[1] <= activeResistance[1] and not na(volume) and volume > volSma20
    lastBrokenRes := activeResistance
    activeResistance := na
if not na(activeSupport) and close < activeSupport and close[1] >= activeSupport[1] and not na(volume) and volume > volSma20
    lastBrokenSup := activeSupport
    activeSupport := na
if not na(swingActiveResistance) and close > swingActiveResistance and close[1] <= swingActiveResistance[1] and not na(volume) and volume > volSma20
    swingLastBrokenRes := swingActiveResistance
    swingActiveResistance := na
if not na(swingActiveSupport) and close < swingActiveSupport and close[1] >= swingActiveSupport[1] and not na(volume) and volume > volSma20
    swingLastBrokenSup := swingActiveSupport
    swingActiveSupport := na

// CHOCH / MSS — HH/HL/LH/LL Sequential Classification
var float seqHigh1 = na
var float seqHigh2 = na
var float seqHigh3 = na
var float seqLow1 = na
var float seqLow2 = na
var float seqLow3 = na
var int seqLastBar = -999
if not na(pivotHigh) or not na(pivotLow)
    if not na(pivotHigh)
        seqHigh3 := seqHigh2
        seqHigh2 := seqHigh1
        seqHigh1 := pivotHigh
    if not na(pivotLow)
        seqLow3 := seqLow2
        seqLow2 := seqLow1
        seqLow1 := pivotLow
    seqLastBar := bar_index
bool seqValid = not na(seqHigh1) and not na(seqHigh2) and not na(seqHigh3) and not na(seqLow1) and not na(seqLow2) and not na(seqLow3)
bool hl = seqValid and seqLow1 > seqLow2
bool lh = seqValid and seqHigh1 < seqHigh2
bool barSpaceOk = (bar_index - seqLastBar) >= 3
float pivotAtrDist = not na(adaptiveATR) ? adaptiveATR * 0.5 : na
bool atrDistOkBull = hl and not na(seqLow1) and not na(seqLow2) and not na(pivotAtrDist) and math.abs(seqLow1 - seqLow2) >= pivotAtrDist
bool atrDistOkBear = lh and not na(seqHigh1) and not na(seqHigh2) and not na(pivotAtrDist) and math.abs(seqHigh1 - seqHigh2) >= pivotAtrDist
bool priorBullSeq = seqValid and seqHigh2 > seqHigh3 and seqLow2 > seqLow3
bool priorBearSeq = seqValid and seqHigh2 < seqHigh3 and seqLow2 < seqLow3
chochLabelBull = priorBearSeq and hl and barSpaceOk and atrDistOkBull
chochLabelBear = priorBullSeq and lh and barSpaceOk and atrDistOkBear
mssLabelBull = chochLabelBull and (seqValid and seqHigh1 > seqHigh2) and barSpaceOk and atrDistOkBull
mssLabelBear = chochLabelBear and (seqValid and seqLow1 < seqLow2) and barSpaceOk and atrDistOkBear
// Edge-triggered events with exponential decay so evidence fades over ~4-5 bars
chochEventBull = chochLabelBull and not chochLabelBull[1]
chochEventBear = chochLabelBear and not chochLabelBear[1]
mssEventBull = mssLabelBull and not mssLabelBull[1]
mssEventBear = mssLabelBear and not mssLabelBear[1]
var float chochBullScore = 0.0
var float chochBearScore = 0.0
var float mssBullScore = 0.0
var float mssBearScore = 0.0
chochBullScore := chochEventBull ? 15.0 : chochBullScore * 0.85
chochBearScore := chochEventBear ? 15.0 : chochBearScore * 0.85
mssBullScore := mssEventBull ? 15.0 : mssBullScore * 0.85
mssBearScore := mssEventBear ? 15.0 : mssBearScore * 0.85
bool chochActiveBull = chochBullScore > 7.5
bool chochActiveBear = chochBearScore > 7.5
bool mssActiveBull = mssBullScore > 7.5
bool mssActiveBear = mssBearScore > 7.5

// IMPROVED DISPLACEMENT — ATR hysteresis: 2.5x enter / 1.5x hold
// R5-F17: dead 0.5x exit branch removed (anything below hold already deactivates).
// Note: "hold" is evaluated on SUBSEQUENT bars' bodies; replace with a bar-count TTL
// if time-based persistence is intended instead.
float _dispEnter = adaptiveATR * dispMult
float _dispHold = adaptiveATR * (dispMult * 0.6)
bool _dispRawUp = showDisplacement and bodySize > _dispEnter and close > open and close > high[1] and candleRange > 0 and bodyPct > 70 and not na(volume) and volume > volSma20 * 1.30
bool _dispRawDown = showDisplacement and bodySize > _dispEnter and close < open and close < low[1] and candleRange > 0 and bodyPct > 70 and not na(volume) and volume > volSma20 * 1.30
var bool displacementUpActive = false
var bool displacementDownActive = false
if _dispRawUp
    displacementUpActive := true
else if bodySize <= _dispHold
    displacementUpActive := false
if _dispRawDown
    displacementDownActive := true
else if bodySize <= _dispHold
    displacementDownActive := false
displacementUp = _dispRawUp or displacementUpActive
displacementDown = _dispRawDown or displacementDownActive
// ═══════════════ Q5.8 STRUCTURE EVENT WINDOW (timeliness fix) ═══════════════
// PROBLEM FOUND: bullBOS/bearBOS are strictly MOMENTARY — they require the crossing
// bar itself (close > snap AND close[1] <= snap[1]) plus five same-bar qualifiers
// (ADX gate, break buffer, body size, body %, volume). The decision then demanded
// that this ONE bar also coincide with bullTrend + HTF + session + news + DD state.
// A point event AND-ed with continuous states = the opportunity is lost unless
// everything aligns on that exact bar — and the "!= lastBroken" guard means the same
// level never re-triggers. That is the mechanical cause of prolonged WAIT.
// ALSO FOUND: CHoCH and MSS never triggered entries at all — only BOS or displacement
// were in the trigger set, despite both being computed and scored.
// FIX (standard market practice): a structure break establishes a directional bias
// that stays actionable for structWindow bars and is invalidated early if price
// closes back through the breaking candle's opposite extreme.
var int bullStructBar = na
var float bullStructInval = na
var string bullStructType = ""
var int bearStructBar = na
var float bearStructInval = na
var string bearStructType = ""
bool _bullStructTrig = bullBOS or (mssActiveBull and not mssActiveBull[1]) or (chochActiveBull and not chochActiveBull[1])
bool _bearStructTrig = bearBOS or (mssActiveBear and not mssActiveBear[1]) or (chochActiveBear and not chochActiveBear[1])
if _bullStructTrig
    bullStructBar := bar_index
    bullStructInval := low
    bullStructType := bullBOS ? "BOS" : mssActiveBull and not mssActiveBull[1] ? "MSS" : "CHoCH"
if _bearStructTrig
    bearStructBar := bar_index
    bearStructInval := high
    bearStructType := bearBOS ? "BOS" : mssActiveBear and not mssActiveBear[1] ? "MSS" : "CHoCH"
// Early invalidation: price closed back through the breaking candle's far side.
if not na(bullStructInval) and close < bullStructInval
    bullStructBar := na
if not na(bearStructInval) and close > bearStructInval
    bearStructBar := na
bool bullStructActive = not na(bullStructBar) and bar_index - bullStructBar <= structWindow
bool bearStructActive = not na(bearStructBar) and bar_index - bearStructBar <= structWindow
int bullStructAge = bullStructActive ? bar_index - bullStructBar : -1
int bearStructAge = bearStructActive ? bar_index - bearStructBar : -1
// ═══════════════ END STRUCTURE EVENT WINDOW ═══════════════

// PIVOT-BASED RSI DIVERGENCE
var float pivotRsiHigh = na
var float pivotPriceHigh = na
var float pivotRsiLow = na
var float pivotPriceLow = na
if not na(pivotHigh)
    pivotRsiHigh := rsiVal
    pivotPriceHigh := pivotHigh
if not na(pivotLow)
    pivotRsiLow := rsiVal
    pivotPriceLow := pivotLow
bullRsiDiv = useRsiDivFilter and not na(pivotPriceLow) and not na(pivotRsiLow) and not na(pivotRsiLow[1]) and not na(pivotPriceLow[1]) ? (pivotPriceLow < pivotPriceLow[1] and pivotRsiLow > pivotRsiLow[1]) : true
bearRsiDiv = useRsiDivFilter and not na(pivotPriceHigh) and not na(pivotRsiHigh) and not na(pivotRsiHigh[1]) and not na(pivotPriceHigh[1]) ? (pivotPriceHigh > pivotPriceHigh[1] and pivotRsiHigh < pivotRsiHigh[1]) : true

// EQH / EQL
eqTolerance = adaptiveATR * eqAtrMult
var float swingHigh1 = na
var float swingHigh2 = na
var float swingLow1 = na
var float swingLow2 = na
if not na(pivotHigh)
    swingHigh2 := swingHigh1
    swingHigh1 := pivotHigh
if not na(pivotLow)
    swingLow2 := swingLow1
    swingLow1 := pivotLow
equalHighs = not na(swingHigh1) and not na(swingHigh2) and math.abs(swingHigh1 - swingHigh2) <= eqTolerance
equalLows = not na(swingLow1) and not na(swingLow2) and math.abs(swingLow1 - swingLow2) <= eqTolerance

// VOLUME CLIMAX — Relative Volume vs same-hour average
// R5-F7: same-hour average is warm-up cumulative mean for the first 20 observations,
// then EWMA (alpha=0.05, ~20-obs memory ~ 20 trading days per hour slot) so the
// baseline tracks the CURRENT volume regime instead of an unbounded all-history mean.
var float[] volByHour = array.new_float(24, 0.0)
var int[] volHourCount = array.new_int(24, 0)
int currHour = hour(time, "UTC")
if barstate.isconfirmed
    float prevAvg = array.get(volByHour, currHour)
    int prevCount = array.get(volHourCount, currHour)
    float _alphaVol = prevCount < 20 ? 1.0 / (prevCount + 1) : 0.05
    float newAvg = prevAvg + _alphaVol * (nz(volume, 0.0) - prevAvg)
    array.set(volByHour, currHour, newAvg)
    array.set(volHourCount, currHour, math.min(prevCount + 1, 100000))
float relVol = volume / math.max(array.get(volByHour, currHour), 1.0)
float prRelVol = ta.percentrank(relVol, volLookback)
float prRawVol = ta.percentrank(volume, volLookback)
float volPercentile = array.get(volHourCount, currHour) >= 20 ? prRelVol : prRawVol
climaxUp = showClimax and recentBars and volPercentile >= volClimaxPerc and close > open
climaxDown = showClimax and recentBars and volPercentile >= volClimaxPerc and close < open

// FAIR VALUE GAPS
fvgDetected = showFVG and barstate.isconfirmed and ((high[2] < low[0] and low[0] - high[2] > adaptiveATR * 0.3) or (low[2] > high[0] and low[2] - high[0] > adaptiveATR * 0.3))
var float fvgHighUpper = na
var float fvgLowLower = na
var int fvgBarIndex = -1
var float fvgVolPctAtDetect = na
var bool fvgActive = false
var bool fvgWasBullish = false
// R5.2-C2: three fixes. (1) Bearish gap bounds were [low[0], high[2]] — the entire
// 3-bar envelope — instead of the imbalance [high[0], low[2]]. (2) fvgWasBullish was
// set on the BEARISH condition (bullish FVG/BISI is low[0] > high[2]). (3) Because
// the flag was inverted, each gap type got the opposite type's mitigation test, which
// was trivially true — every FVG self-mitigated within a bar. Mitigation now requires
// a LATER bar to trade strictly back into the gap interior.
if fvgDetected and not fvgActive
    float gapLow = high[2]
    float gapHigh = low[0]
    if low[2] > high[0]
        gapLow := high[0]
        gapHigh := low[2]
    if gapLow < gapHigh
        fvgHighUpper := gapHigh
        fvgLowLower := gapLow
        fvgBarIndex := bar_index
        fvgVolPctAtDetect := volPercentile
        fvgActive := true
        fvgWasBullish := low[0] > high[2]
fvgActive := fvgActive and bar_index - fvgBarIndex <= fvgMaxBars
fvgMitigated = fvgActive and bar_index > fvgBarIndex and ((fvgWasBullish and low < fvgHighUpper) or (not fvgWasBullish and high > fvgLowLower))
if fvgMitigated
    fvgActive := false

// ORDER BLOCK DETECTION — ICT standard: candle before displacement + multi-OB tracking + mitigation
var float obBullLow = na
var float obBullHigh = na
var float obBearLow = na
var float obBearHigh = na
var int obBullBar = -1
var int obBearBar = -1
var bool obBullActive = false
var bool obBearActive = false
var bool obBullMitigated = false
var bool obBearMitigated = false
var float obBullMitPct = 0.0
var float obBearMitPct = 0.0
// Multi-OB history queue (last 5 each)
var float[] obBullHighA = array.new_float()
var float[] obBullLowA = array.new_float()
var float[] obBearHighA = array.new_float()
var float[] obBearLowA = array.new_float()
var int[] obBullBarA = array.new_int()
var int[] obBearBarA = array.new_int()
var bool[] obBullMitA = array.new_bool()
var bool[] obBearMitA = array.new_bool()
int obMaxQueue = 5
// Detect displacement onset: first bar of a displacement candle
bool dispOnsetUp = displacementUp and not displacementUp[1]
bool dispOnsetDown = displacementDown and not displacementDown[1]
if showOB and dispOnsetDown and not obBearActive
    obBearHigh := high[1]
    obBearLow := low[1]
    obBearBar := bar_index
    obBearActive := true
    obBearMitigated := false
    obBearMitPct := 0.0
    array.unshift(obBearHighA, high[1])
    array.unshift(obBearLowA, low[1])
    array.unshift(obBearBarA, bar_index)
    array.unshift(obBearMitA, false)
if showOB and dispOnsetUp and not obBullActive
    obBullHigh := high[1]
    obBullLow := low[1]
    obBullBar := bar_index
    obBullActive := true
    obBullMitigated := false
    obBullMitPct := 0.0
    array.unshift(obBullHighA, high[1])
    array.unshift(obBullLowA, low[1])
    array.unshift(obBullBarA, bar_index)
    array.unshift(obBullMitA, false)
// Reversal OB: Failed bullish displacement
bool failedBullDisp = showOB and not obBearActive and displacementUp[1] and not displacementUp and close < open[1] and close < (high[1] + low[1]) / 2
if failedBullDisp
    obBearHigh := high[1]
    obBearLow := low[1]
    obBearBar := bar_index
    obBearActive := true
    obBearMitigated := false
    obBearMitPct := 0.0
    array.unshift(obBearHighA, high[1])
    array.unshift(obBearLowA, low[1])
    array.unshift(obBearBarA, bar_index)
    array.unshift(obBearMitA, false)
// Reversal OB: Failed bearish displacement
bool failedBearDisp = showOB and not obBullActive and displacementDown[1] and not displacementDown and close > open[1] and close > (high[1] + low[1]) / 2
if failedBearDisp
    obBullHigh := high[1]
    obBullLow := low[1]
    obBullBar := bar_index
    obBullActive := true
    obBullMitigated := false
    obBullMitPct := 0.0
    array.unshift(obBullHighA, high[1])
    array.unshift(obBullLowA, low[1])
    array.unshift(obBullBarA, bar_index)
    array.unshift(obBullMitA, false)
// Cap queues
while array.size(obBullHighA) > obMaxQueue
    array.pop(obBullHighA)
    array.pop(obBullLowA)
    array.pop(obBullBarA)
    array.pop(obBullMitA)
while array.size(obBearHighA) > obMaxQueue
    array.pop(obBearHighA)
    array.pop(obBearLowA)
    array.pop(obBearBarA)
    array.pop(obBearMitA)
// OB expiry
obBullActive := obBullActive and bar_index - obBullBar <= obMaxBars
obBearActive := obBearActive and bar_index - obBearBar <= obMaxBars
// OB invalidation (price beyond by 0.3 ATR — zone fully breached)
if obBullActive and close < obBullLow - adaptiveATR * 0.3
    obBullActive := false
if obBearActive and close > obBearHigh + adaptiveATR * 0.3
    obBearActive := false
// OB mitigation detection (price enters the OB zone)
if obBullActive and not obBullMitigated
    float obRange = obBullHigh - obBullLow
    if obRange > 0 and close <= obBullHigh and close >= obBullLow
        obBullMitPct := math.min(100.0, (obBullHigh - close) / obRange * 100.0)
        if obBullMitPct >= 50.0
            obBullMitigated := true
if obBearActive and not obBearMitigated
    float obRange = obBearHigh - obBearLow
    if obRange > 0 and close <= obBearHigh and close >= obBearLow
        obBearMitPct := math.min(100.0, (close - obBearLow) / obRange * 100.0)
        if obBearMitPct >= 50.0
            obBearMitigated := true
// Update mitigation status in history queues
int _obBullSz = array.size(obBullHighA)
if _obBullSz > 0
    for i = 0 to _obBullSz - 1
        float h = array.get(obBullHighA, i)
        float l = array.get(obBullLowA, i)
        int b = array.get(obBullBarA, i)
        if not array.get(obBullMitA, i) and bar_index - b <= obMaxBars
            float rng = h - l
            if rng > 0 and close <= h and close >= l and (h - close) / rng * 100.0 >= 50.0
                array.set(obBullMitA, i, true)
int _obBearSz = array.size(obBearHighA)
if _obBearSz > 0
    for i = 0 to _obBearSz - 1
        float h = array.get(obBearHighA, i)
        float l = array.get(obBearLowA, i)
        int b = array.get(obBearBarA, i)
        if not array.get(obBearMitA, i) and bar_index - b <= obMaxBars
            float rng = h - l
            if rng > 0 and close <= h and close >= l and (close - l) / rng * 100.0 >= 50.0
                array.set(obBearMitA, i, true)
// Remove fully expired OBs from queues
int _obBullSz2 = array.size(obBullHighA)
if _obBullSz2 > 0
    int i = _obBullSz2 - 1
    while i >= 0
        if bar_index - array.get(obBullBarA, i) > obMaxBars
            array.remove(obBullHighA, i)
            array.remove(obBullLowA, i)
            array.remove(obBullBarA, i)
            array.remove(obBullMitA, i)
        i := i - 1
int _obBearSz2 = array.size(obBearHighA)
if _obBearSz2 > 0
    int i = _obBearSz2 - 1
    while i >= 0
        if bar_index - array.get(obBearBarA, i) > obMaxBars
            array.remove(obBearHighA, i)
            array.remove(obBearLowA, i)
            array.remove(obBearBarA, i)
            array.remove(obBearMitA, i)
        i := i - 1

var float[] srResLevels = array.new_float()
var float[] srResStrengths = array.new_float()
var float[] srSupLevels = array.new_float()
var float[] srSupStrengths = array.new_float()
// SMT DIVERGENCE — Gold vs Silver (correlated pair), pivot-based
goldRSI = rsiVal
bool smtDataValid = showSMT and silverValid and not na(goldRSI) and not na(_silverRSI)
var float goldRsiAtLastLow = na
var float silverRsiAtLastLow = na
var float goldRsiAtLastHigh = na
var float silverRsiAtLastHigh = na
if not na(pivotLow)
    goldRsiAtLastLow := rsiVal
    silverRsiAtLastLow := _silverRSI
if not na(pivotHigh)
    goldRsiAtLastHigh := rsiVal
    silverRsiAtLastHigh := _silverRSI
// Bull SMT: gold makes lower low, but gold RSI makes higher low AND > silver RSI
bool smtBullRaw = smtDataValid and not na(pivotLow) and not na(pivotLow[1]) and pivotLow < pivotLow[1] and goldRsiAtLastLow > goldRsiAtLastLow[1] and goldRsiAtLastLow > silverRsiAtLastLow
// Bear SMT: gold makes higher high, but gold RSI makes lower high AND < silver RSI
bool smtBearRaw = smtDataValid and not na(pivotHigh) and not na(pivotHigh[1]) and pivotHigh > pivotHigh[1] and goldRsiAtLastHigh < goldRsiAtLastHigh[1] and goldRsiAtLastHigh < silverRsiAtLastHigh
smtBullPair = smtBullRaw and (goldBarDir[1] < 0 or rsiVal[1] > _silverRSI[1])
smtBearPair = smtBearRaw and (goldBarDir[1] > 0 or rsiVal[1] < _silverRSI[1])

// REGIME ENGINE
// R5-F20: clamped at 100 (ADX>83 in high-vol could previously exceed the scale).
regimeScore = int(math.min(math.round((adxVal / 100.0) * (atrPercentile > 70 ? 1.2 : 1.0) * 100.0), 100))
volRegime = atrPercentile > 70 ? 100 : atrPercentile > 40 ? 60 : 30
structureRegime = (htfAlignmentLong >= 2 or htfAlignmentShort >= 2) ? 100 : (htfAlignmentLong >= 1 or htfAlignmentShort >= 1) ? 60 : 30
// OI CONVICTION applied to the macro regime score. Deliberately a SMALL nudge (+/-10 on a
// 0-100 scale), not a gate: OI is a DAILY series being read on an intraday chart, so it is
// slow context. It can strengthen or soften a regime read that other evidence already
// established; it can never create one. Clamped so it cannot push the score out of range.
// oiConviction is +1 when price and OI rise together (new money) and -1 when price falls
// while OI rises (new shorts) — both signs mean "genuine participation", so the term
// reinforces whichever direction the macro vote already found rather than adding direction
// of its own. 0 when OI is unavailable, which makes the whole layer a no-op when off.
_macroRegimeBase = (macroBull or macroBear) ? 100 : (macroBullVotes >= 2 or macroBearVotes >= 2) ? 60 : 30
macroRegime = math.max(0, math.min(100, _macroRegimeBase + (oiConviction != 0 and (macroBull or macroBear) ? 10 : oiConviction != 0 ? 5 : 0)))
sessionRegime = sessionQuality >= 60 ? 100 : sessionQuality >= 30 ? 60 : 30
// F-021: threshold on the UNROUNDED composite; the rounded int stays for display.
// Rounding before the >= 70 / >= 40 tests made the real boundaries 69.5 and 39.5.
// Kept identical to the Master -- the A/B scorers must not diverge in feature semantics.
float regimeCompositeRaw = (regimeScore * 0.30) + (volRegime * 0.15) + (structureRegime * 0.20) + (macroRegime * 0.20) + (sessionRegime * 0.15)
regimeComposite = int(math.round(regimeCompositeRaw))
// Regime thresholds (70/40): heuristic breakpoints on 0-100 composite.
bool strongTrend = regimeCompositeRaw >= 70
bool moderateTrend = regimeCompositeRaw >= 40 and regimeCompositeRaw < 70
bool weakTrend = regimeCompositeRaw < 40

// VOLUME DELTA — directional bar-volume proxy (buying vs selling pressure)
float volDelta = close > open ? volume : close < open ? -volume : 0.0
float volDelta50 = math.sum(volDelta, 50)

// F-A07: every level this block produces is marked with a trailing "°" where it appears
// as a trade-plan basis (_slN and _tpNms inside f_tradePlan). The `barstate.islast` guard
// below means these values do not exist on historical bars, so a "°" basis is one a
// backtest could never have reproduced. Relax that guard and those markers must be removed.
// VOLUME PROFILE — price-level volume distribution (100-bar lookback)
// F-A01 PARITY FIX. This arm previously carried ONLY the declarations below: vpocPrice,
// vahPrice and valPrice were declared `na` and never assigned, because the computation
// block was absent from this file entirely (vpBuckets/bucketSize: 12 references in the
// Master, 0 here). Both were still CONSUMED by the stop-loss candidate array (_slC) and
// the take-profit candidate array (_tpLvls), whose loops guard with `if not na(_lv)` --
// so the value-area and POC candidates were skipped silently rather than erroring.
// The Master's block is reproduced below VERBATIM so the twins compute the same levels
// from the same code. NOTE the guard is `barstate.islast`: in the Master too these
// values exist only on the chart's final bar, so this port changes almost nothing on
// historical bars -- its purpose is structural parity, not a change in backtest results.
// The live-vs-history asymmetry that guard creates is recorded separately as F-A07 and
// is deliberately NOT changed here (making it per-bar is a performance decision that
// needs a measured runtime baseline, which does not yet exist).
int vpLookback = 100
int vpBuckets = 40
var float[] vpVolumes = array.new_float(40, 0.0)
var float[] vpPrices = array.new_float(40, 0.0)
var float vpocPrice = na
var float vahPrice = na
var float valPrice = na
var float vaRatio = 0.0
var string vaPos = "—"
float vpHigh = ta.highest(high, vpLookback)
float vpLow = ta.lowest(low, vpLookback)
var int vpRefresh = 0
if barstate.islast and barstate.isconfirmed and not perfMode
    float bucketSize = (vpHigh - vpLow) / vpBuckets
    if vpRefresh % 5 == 0
        for i = 0 to vpBuckets - 1
            array.set(vpVolumes, i, 0.0)
        if bucketSize > 0.0
            for i = 0 to vpBuckets - 1
                array.set(vpPrices, i, vpLow + bucketSize * (i + 0.5))
            for i = 0 to vpLookback - 1
                float bp = (high[i] + low[i] + close[i]) / 3.0
                float bv = nz(volume[i], 0.0)
                int midB = int((bp - vpLow) / bucketSize)
                midB := math.max(0, math.min(midB, vpBuckets - 1))
                array.set(vpVolumes, midB, array.get(vpVolumes, midB) + bv)
            float maxV = 0.0
            int vpocIdx = 0
            for i = 0 to vpBuckets - 1
                float v = array.get(vpVolumes, i)
                if v > maxV
                    maxV := v
                    vpocIdx := i
            vpocPrice := array.get(vpPrices, vpocIdx)
            float totalV = array.sum(vpVolumes)
            float targetV = totalV * 0.70
            float cumV = maxV
            int vaLow = vpocIdx
            int vaHigh = vpocIdx
            while cumV < targetV and (vaLow > 0 or vaHigh < vpBuckets - 1)
                float vBelow = vaLow > 0 ? array.get(vpVolumes, vaLow - 1) : -1.0
                float vAbove = vaHigh < vpBuckets - 1 ? array.get(vpVolumes, vaHigh + 1) : -1.0
                if vAbove >= vBelow and vaHigh < vpBuckets - 1
                    vaHigh += 1
                    cumV += vAbove
                else if vaLow > 0
                    vaLow -= 1
                    cumV += vBelow
                else
                    break
            vahPrice := array.get(vpPrices, vaHigh)
            valPrice := array.get(vpPrices, vaLow)
            float vpRange = vpHigh - vpLow
            vaRatio := totalV > 0.0 and vpRange > 0.0 ? (vahPrice - valPrice) / vpRange * 100.0 : 0.0
            vaPos := close > vahPrice ? "▲" : close < valPrice ? "▼" : "●"
    vpRefresh += 1
// Session volume modeling — per-session rolling averages for anomaly detection

// ORDER FLOW — CVD (proxy-based)
var float cvd = 0.0
// Tick-rule refinement: use close vs close[1] as tiebreaker when close == open
float _barDir = close > open ? 1.0 : close < open ? -1.0 : close > close[1] ? 0.5 : close < close[1] ? -0.5 : 0.0
float barDelta = _barDir * volume
cvd := cvd + barDelta
float cvdEma20 = ta.ema(cvd, 20)
float cvdEma100 = ta.ema(cvd, 100)
bool cvdBull = cvdEma20 > cvdEma100

// LIQUIDITY POOL TRACKING — previous period extremes (last completed candle only)
[monthlyH, monthlyL] = request.security(syminfo.tickerid, "M", [high[1], low[1]], gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
var float poolPdH = na
var float poolPdL = na
var float poolPwH = na
var float poolPwL = na
var float poolPmH = na
var float poolPmL = na
var float poolEqH = na
var float poolEqL = na
// P1-LVL-002 (b): above D a "previous DAY" extreme does not exist — the detector
// resolves to the previous BAR, i.e. the previous week/month, which would be published
// under a PDH/PDL label and consumed as such by the liquidity-destination scorer and the
// trade-plan SL/TP candidate arrays. Publishing na is the honest result: every consumer
// is already na-guarded (liqAvail counts non-na pools; _slC/_tpLvls skip na entries), so
// the levels simply drop out of the map instead of carrying a wrong label. No effect on
// D or any intraday timeframe, where these are correct.
bool _tfAboveD = chartTFSeconds > 86400
poolPdH := _tfAboveD ? na : prevNyDailyHigh
poolPdL := _tfAboveD ? na : prevNyDailyLow
// P1-LVL-002 (c): the same argument one period up. Above W a "previous WEEK" extreme is
// undefined — the detector resolves to the previous BAR (a month), which would publish a
// previous-month level under a PWH/PWL label while PMH/PML publish that same level
// correctly, i.e. a duplicated level under two different names. Suppressed to na.
bool _tfAboveW = chartTFSeconds > 604800
poolPwH := _tfAboveW ? na : prevNyWeeklyHigh
poolPwL := _tfAboveW ? na : prevNyWeeklyLow
poolPmH := monthlyH
poolPmL := monthlyL
poolEqH := equalHighs ? math.max(swingHigh1, swingHigh2) : na
poolEqL := equalLows ? math.min(swingLow1, swingLow2) : na
// Liquidity run detections
bool ranPdH = not na(poolPdH) and close > poolPdH
bool ranPdL = not na(poolPdL) and close < poolPdL
bool ranPwH = not na(poolPwH) and close > poolPwH
bool ranPwL = not na(poolPwL) and close < poolPwL
bool ranPmH = not na(poolPmH) and close > poolPmH
bool ranPmL = not na(poolPmL) and close < poolPmL
bool ranEqH = not na(poolEqH) and close > poolEqH
bool ranEqL = not na(poolEqL) and close < poolEqL
// Liquidity level verification — availability + staleness
// R5-F22: strict hierarchy monotonicity check removed (PDH>PWH is routine early-week,
// so it penalized healthy states). Its budget was folded into availability.
int liqAvail = (not na(poolPdH) ? 1 : 0) + (not na(poolPdL) ? 1 : 0) + (not na(poolPwH) ? 1 : 0) + (not na(poolPwL) ? 1 : 0) + (not na(poolPmH) ? 1 : 0) + (not na(poolPmL) ? 1 : 0)
// R5.3-L6: "staleness" check removed — it flagged PDH/PDL as stale whenever price had
// traded beyond them, i.e. it penalized liqHealth precisely when liquidity was
// successfully run, fighting the run bonus on the next line. Its 20-point budget is
// folded into the availability tiers (same pattern as R5-F22).
int liqHealthScore = 0
liqHealthScore += liqAvail >= 6 ? 80 : liqAvail >= 4 ? 60 : liqAvail >= 2 ? 35 : 0
liqHealthScore += ranPdH or ranPdL or ranPwH or ranPwL or ranPmH or ranPmL ? 20 : 0

// Current Day High / Low — NY session (resets at 17:00 ET)
var float cdh = na
var float cdl = na
if crossedNYDay
    cdh := high
    cdl := low
else
    // CHANGE ID: P0-LVL-001 | FILE: Master (Visuals already correct — this was a
    // cross-file PARITY BREAK: the companion drew CDL correctly while the engine
    // computed 0.0). Identical defect class to the one already documented and fixed
    // for nyDailyLow ~1,200 lines above, but missed here.
    // OLD: nz(cdl) with NO second argument returns 0.0 for an na float. cdh/cdl are
    // seeded na, and on bar 0 crossedNYDay is false (the `not na(time[1])` guard keeps
    // it false), so this else-branch runs first with cdl still na ->
    // math.min(0.0, low) = 0.0, LATCHED until the first genuine NY rollover.
    // IMPACT: cdl feeds _slC (stop candidate, harmless — 0.0 fails the _slLoB/_slHiB
    // band and the Q5.7 R-clamp) AND _tpLvls (short TP candidate, NOT harmless — a
    // 0.0 level passes _dT >= _tpMinD and can be selected as TP3 labelled "CDL" when
    // fewer than three nearer candidates exist, which is precisely the sparse
    // warm-up window where cdl is still 0.0). Result: a printed TP of 0.00 and
    // corrupted tpRR3.
    // NEW: supply the current bar as fallback so each accumulator degrades to "this
    // bar only" rather than to zero — same remedy as the nyDailyLow fix.
    cdh := math.max(nz(cdh, high), high)
    cdl := math.min(nz(cdl, low), low)

// S/R LEVELS TABLE PLOT — draws from dedicated arrays, color-coded per side
var line[] srLines = array.new_line()
// V26 ENGINE 1: STRUCTURE PERSISTENCE SCORE
// Measures directional continuation after BOS/CHOCH (HH+HL after bull BOS, LH+LL after bear BOS)
var float structPersistEntryHigh = na
var float structPersistEntryLow = na
var bool structPersistIsBull = false
var int structPersistBars = 0
var float structScore = 0.0
var float structPersistPeak = na
var float structPersistTrough = na
if bullBOS
    structPersistEntryHigh := close
    structPersistEntryLow := low
    structPersistIsBull := true
    structPersistBars := 1
    structPersistPeak := high
    structPersistTrough := low
else if bearBOS
    structPersistEntryHigh := high
    structPersistEntryLow := close
    structPersistIsBull := false
    structPersistBars := 1
    structPersistPeak := high
    structPersistTrough := low
else
    // R5.3-L5: the counter previously advanced only on bars making BOTH a new HH and a
    // new HL simultaneously (rare), so the bar-count tier of structScore almost never
    // left the lowest bucket, and the "not newHL" reset fired on nearly every bar.
    // Persistence now means: bars elapsed since the BOS while structure stays intact —
    // intact = price has not broken back through the BOS-origin protective level
    // (entry low for bull, entry high for bear). Peak/trough still ratchet for the
    // distance component.
    if not na(structPersistEntryHigh)
        if structPersistIsBull
            if high > structPersistPeak
                structPersistPeak := high
            if low > structPersistTrough
                structPersistTrough := low
            if low >= structPersistEntryLow
                structPersistBars := structPersistBars + 1
            else
                structPersistEntryHigh := na
                structPersistBars := 0
        else
            if high < structPersistPeak
                structPersistPeak := high
            if low < structPersistTrough
                structPersistTrough := low
            if high <= structPersistEntryHigh
                structPersistBars := structPersistBars + 1
            else
                structPersistEntryHigh := na
                structPersistBars := 0
if structPersistBars > 0
    float dr = structPersistIsBull and structPersistEntryLow > 0 ? safeDiv((close - structPersistEntryLow), adaptiveATR) : not structPersistIsBull and structPersistEntryHigh > 0 ? safeDiv((structPersistEntryHigh - close), adaptiveATR) : 0.0
    int spBars = structPersistBars
    int spDist = dr >= 2.0 ? 35 : dr >= 1.0 ? 25 : dr >= 0.5 ? 15 : 0
    int spAdx = adxVal > adxThreshold ? 20 : 0
    // structScore: ordinal evidence index for structural persistence. Bucket thresholds heuristic.
    structScore := (spBars >= 12 ? 45 : spBars >= 8 ? 35 : spBars >= 4 ? 25 : 15) + spDist + spAdx
else
    structScore := nz(structScore[1]) > 0 ? nz(structScore[1]) * 0.5 : 0.0

// V27 ENGINE 2: LIQUIDITY DESTINATION RANKING V2
// Score = Pool Weight x Distance Score x HTF Alignment x Session Weight x Trend Weight
float liqPWtPDH = 1.50
float liqPWtPDL = 1.50
float liqPWtPWH = 1.25
float liqPWtPWL = 1.25
float liqPWtPMH = 1.10
float liqPWtPML = 1.10
float liqPWtEQH = 1.00
float liqPWtEQL = 1.00
liqDistPDH = not na(poolPdH) ? math.abs(close - poolPdH) : 1e10
liqDistPDL = not na(poolPdL) ? math.abs(close - poolPdL) : 1e10
liqDistPWH = not na(poolPwH) ? math.abs(close - poolPwH) : 1e10
liqDistPWL = not na(poolPwL) ? math.abs(close - poolPwL) : 1e10
liqDistPMH = not na(poolPmH) ? math.abs(close - poolPmH) : 1e10
liqDistPML = not na(poolPmL) ? math.abs(close - poolPmL) : 1e10
liqDistEQH = not na(poolEqH) ? math.abs(close - poolEqH) : 1e10
liqDistEQL = not na(poolEqL) ? math.abs(close - poolEqL) : 1e10
float effLiqProx = liqProxMult * regLiqMult // R6.0: proximity window widens in high vol, tightens in low vol
liqDistScore(dist, atrM) => atrM > 0 ? math.max(100.0 - safeDiv(dist, atrM) * safeDiv(100.0, effLiqProx), 0.0) : 0.0
float liqDS_PDH = liqDistPDH < adaptiveATR * effLiqProx ? liqDistScore(liqDistPDH, adaptiveATR) : 0.0
float liqDS_PDL = liqDistPDL < adaptiveATR * effLiqProx ? liqDistScore(liqDistPDL, adaptiveATR) : 0.0
float liqDS_PWH = liqDistPWH < adaptiveATR * effLiqProx ? liqDistScore(liqDistPWH, adaptiveATR) : 0.0
float liqDS_PWL = liqDistPWL < adaptiveATR * effLiqProx ? liqDistScore(liqDistPWL, adaptiveATR) : 0.0
float liqDS_PMH = liqDistPMH < adaptiveATR * effLiqProx ? liqDistScore(liqDistPMH, adaptiveATR) : 0.0
float liqDS_PML = liqDistPML < adaptiveATR * effLiqProx ? liqDistScore(liqDistPML, adaptiveATR) : 0.0
float liqDS_EQH = liqDistEQH < adaptiveATR * effLiqProx ? liqDistScore(liqDistEQH, adaptiveATR) : 0.0
float liqDS_EQL = liqDistEQL < adaptiveATR * effLiqProx ? liqDistScore(liqDistEQL, adaptiveATR) : 0.0
// HTF alignment factor
liqHTFMatch(poolIsBull) => (poolIsBull and htfBullScoreGate) ? 1.3 : (poolIsBull and htfAlignmentLong >= 1) ? 1.15 : (poolIsBull and htfBearScoreGate) ? 0.7 : (poolIsBull and htfAlignmentShort >= 1) ? 0.85 : (not poolIsBull and htfBearScoreGate) ? 1.3 : (not poolIsBull and htfAlignmentShort >= 1) ? 1.15 : (not poolIsBull and htfBullScoreGate) ? 0.7 : (not poolIsBull and htfAlignmentLong >= 1) ? 0.85 : 1.0
// Session weight: killzone = 1.3, London/NY = 1.15, Asian/OFF = 0.8
float liqSessionWt = inKillzone ? 1.3 : (inLondon or inNY) ? 1.15 : 0.8
// Trend weight: aligned with pool direction = 1.2, neutral = 1.0, opposing = 0.7
liqTrendWt(poolIsBull) => (poolIsBull and bullTrend) ? 1.2 : (not poolIsBull and bearTrend) ? 1.2 : (poolIsBull and bearTrend) ? 0.7 : (not poolIsBull and bullTrend) ? 0.7 : 1.0
float liqScorePDH = liqDS_PDH > 0 ? liqPWtPDH * liqDS_PDH * liqHTFMatch(true) * liqSessionWt * liqTrendWt(true) : 0.0
float liqScorePDL = liqDS_PDL > 0 ? liqPWtPDL * liqDS_PDL * liqHTFMatch(false) * liqSessionWt * liqTrendWt(false) : 0.0
float liqScorePWH = liqDS_PWH > 0 ? liqPWtPWH * liqDS_PWH * liqHTFMatch(true) * liqSessionWt * liqTrendWt(true) : 0.0
float liqScorePWL = liqDS_PWL > 0 ? liqPWtPWL * liqDS_PWL * liqHTFMatch(false) * liqSessionWt * liqTrendWt(false) : 0.0
float liqScorePMH = liqDS_PMH > 0 ? liqPWtPMH * liqDS_PMH * liqHTFMatch(true) * liqSessionWt * liqTrendWt(true) : 0.0
float liqScorePML = liqDS_PML > 0 ? liqPWtPML * liqDS_PML * liqHTFMatch(false) * liqSessionWt * liqTrendWt(false) : 0.0
float liqScoreEQH = liqDS_EQH > 0 ? liqPWtEQH * liqDS_EQH * liqHTFMatch(true) * liqSessionWt * liqTrendWt(true) : 0.0
float liqScoreEQL = liqDS_EQL > 0 ? liqPWtEQL * liqDS_EQL * liqHTFMatch(false) * liqSessionWt * liqTrendWt(false) : 0.0
// Rank by composite score + compute secondary
string liqDestLabel = "—"
int liqDestScore = 0
float liqDestDist = 1e10
int liqDestScoreSecondary = 0
// TOKEN RECLAMATION (no feature change): liqMaxScore was one nested-max chain and
// liqSecondScore was recomputed by EIGHT more chains, one per branch, each taking the max
// of all scores EXCEPT the selected one. "Max excluding the winner" IS the second-highest,
// so a single sorted copy yields both — identical semantics including ties, because when
// two scores tie at the maximum the excluded-max and the sorted [1] are the same value.
// Replaces ~190 lexical tokens of O(n^2) chains with ~30, and the eight per-branch
// assignments are gone (the branches still set label/score/dist exactly as before).
float[] _liqAll = array.from(liqScorePDH, liqScorePDL, liqScorePWH, liqScorePWL, liqScorePMH, liqScorePML, liqScoreEQH, liqScoreEQL)
array.sort(_liqAll, order.descending)
float liqMaxScore = array.get(_liqAll, 0)
float liqSecondScore = array.get(_liqAll, 1)
if liqMaxScore >= 25
    if liqScorePDH >= liqMaxScore
        liqDestLabel := "PDH"
        liqDestScore := int(math.round(liqScorePDH))
        liqDestDist := liqDistPDH
    else if liqScorePDL >= liqMaxScore
        liqDestLabel := "PDL"
        liqDestScore := int(math.round(liqScorePDL))
        liqDestDist := liqDistPDL
    else if liqScorePWH >= liqMaxScore
        liqDestLabel := "PWH"
        liqDestScore := int(math.round(liqScorePWH))
        liqDestDist := liqDistPWH
    else if liqScorePWL >= liqMaxScore
        liqDestLabel := "PWL"
        liqDestScore := int(math.round(liqScorePWL))
        liqDestDist := liqDistPWL
    else if liqScorePMH >= liqMaxScore
        liqDestLabel := "PMH"
        liqDestScore := int(math.round(liqScorePMH))
        liqDestDist := liqDistPMH
    else if liqScorePML >= liqMaxScore
        liqDestLabel := "PML"
        liqDestScore := int(math.round(liqScorePML))
        liqDestDist := liqDistPML
    else if liqScoreEQH >= liqMaxScore
        liqDestLabel := "EQH"
        liqDestScore := int(math.round(liqScoreEQH))
        liqDestDist := liqDistEQH
    else
        liqDestLabel := "EQL"
        liqDestScore := int(math.round(liqScoreEQL))
        liqDestDist := liqDistEQL
    // Secondary target
    if liqSecondScore >= liqMaxScore * 0.5
        if liqScorePDH > 0 and liqScorePDH >= liqSecondScore and liqDestLabel != "PDH"
            liqDestScoreSecondary := int(math.round(liqScorePDH))
        else if liqScorePDL > 0 and liqScorePDL >= liqSecondScore and liqDestLabel != "PDL"
            liqDestScoreSecondary := int(math.round(liqScorePDL))
        else if liqScorePWH > 0 and liqScorePWH >= liqSecondScore and liqDestLabel != "PWH"
            liqDestScoreSecondary := int(math.round(liqScorePWH))
        else if liqScorePWL > 0 and liqScorePWL >= liqSecondScore and liqDestLabel != "PWL"
            liqDestScoreSecondary := int(math.round(liqScorePWL))
        else if liqScorePMH > 0 and liqScorePMH >= liqSecondScore and liqDestLabel != "PMH"
            liqDestScoreSecondary := int(math.round(liqScorePMH))
        else if liqScorePML > 0 and liqScorePML >= liqSecondScore and liqDestLabel != "PML"
            liqDestScoreSecondary := int(math.round(liqScorePML))
        else if liqScoreEQH > 0 and liqScoreEQH >= liqSecondScore and liqDestLabel != "EQH"
            liqDestScoreSecondary := int(math.round(liqScoreEQH))
        else if liqScoreEQL > 0 and liqScoreEQL >= liqSecondScore and liqDestLabel != "EQL"
            liqDestScoreSecondary := int(math.round(liqScoreEQL))
// Destination confidence: difference between primary and secondary

// ---- Liquidity Destination Probability (Part 9) ----
// liqReachScore: ordinal composite (0–100), heuristic pool proximity model.
float liqReachScore = 50.0
if liqMaxScore > 0
    float baseScore = 50.0
    bool destIsBull = liqDestLabel == "PDH" or liqDestLabel == "PWH" or liqDestLabel == "PMH" or liqDestLabel == "EQH"
    baseScore += (destIsBull and bullTrend) or (not destIsBull and bearTrend) ? 12.0 : 0.0
    baseScore += (destIsBull and htfBullScoreGate) or (not destIsBull and htfBearScoreGate) ? 10.0 : 0.0
    baseScore += macroStrengthScore > 0 and destIsBull ? 8.0 : macroStrengthScore < 0 and not destIsBull ? 8.0 : 0.0
    baseScore += regimeComposite >= 70 ? 8.0 : regimeComposite >= 40 ? 4.0 : 0.0
    // Distance penalty: closer = higher probability
    float distPenalty = adaptiveATR > 0 and liqDestDist < 1e10 ? math.min(liqDestDist / (adaptiveATR * 3.0) * 30.0, 30.0) : 15.0
    baseScore := baseScore - distPenalty
    liqReachScore := math.min(math.max(baseScore, 5.0), 95.0)
// Liquidity sweep detection: price touched a known liquidity level and reversed
liqSweepBear = (not na(poolPdH) and high >= poolPdH and close < poolPdH) or (not na(poolPwH) and high >= poolPwH and close < poolPwH) or (not na(poolPmH) and high >= poolPmH and close < poolPmH)
liqSweepBull = (not na(poolPdL) and low <= poolPdL and close > poolPdL) or (not na(poolPwL) and low <= poolPwL and close > poolPwL) or (not na(poolPmL) and low <= poolPmL and close > poolPmL)

// V26 ENGINE 3: MTF CONFLUENCE ENGINE
mtfVotesBull = 0
mtfVotesBull += htf5mBull ? 1 : 0
mtfVotesBull += htf15mBull ? 1 : 0
mtfVotesBull += htf1hBull ? 1 : 0
mtfVotesBull += htf4hBull ? 1 : 0
mtfVotesBear = 0
mtfVotesBear += htf5mBear ? 1 : 0
mtfVotesBear += htf15mBear ? 1 : 0
mtfVotesBear += htf1hBear ? 1 : 0
mtfVotesBear += htf4hBear ? 1 : 0
macroVotesBull = macroBullVotes
macroVotesBear = macroBearVotes
mtfConfluenceBull = mtfVotesBull + macroVotesBull
mtfConfluenceBear = mtfVotesBear + macroVotesBear
// R5.2-M4: max votes = 4 (MTF) + 6 (macro) = 10, not 9 (score previously reached ±111).
mtfConfluenceScore = int(math.round((mtfConfluenceBull - mtfConfluenceBear) / 10.0 * 100.0))
mtfConfluenceMag = math.abs(mtfConfluenceScore)
mtfAgreementHigh = mtfConfluenceMag >= 60
mtfAgreementMed = mtfConfluenceMag >= 30 and mtfConfluenceMag < 60
mtfAgreementLow = mtfConfluenceMag < 30

// V26 ENGINE 4: MACRO INTELLIGENCE ENGINE
macroIntelConf = macroStrengthConf
macroIntelValid = dxyValid or yieldValid or spxValid or eurusdValid or silverValid
// Macro label thresholds (±40/±15) — heuristic bins.

// V27 ENGINE 5: BIAS SCORES (ordinal evidence-weighted, NOT probabilities)
biasStructBull = bullTrend ? 30 : chochBullScore
biasStructBear = bearTrend ? 30 : chochBearScore
biasLiqBull = (bullBOS or displacementUp) ? 20 : chochBullScore * (10.0 / 15.0)
biasLiqBear = (bearBOS or displacementDown) ? 20 : chochBearScore * (10.0 / 15.0)
biasMacroBull = macroBull ? 25 : 0
biasMacroBear = macroBear ? 25 : 0
biasHTFBull = htfBullScoreGate ? 25 : (htfAlignmentLong >= 1 ? 10 : 0)
biasHTFBear = htfBearScoreGate ? 25 : (htfAlignmentShort >= 1 ? 10 : 0)
biasMomBull = bullRsiDiv ? 15 : 0
biasMomBear = bearRsiDiv ? 15 : 0
// R5-F10: session quality is direction-NEUTRAL — it strengthens whichever directional
// case exists (and argues against RANGE) but must not itself pick a side.
biasSessBull = sessionQuality >= 50 ? 15 : sessionQuality >= 30 ? 8 : 3
biasSessBear = sessionQuality >= 50 ? 15 : sessionQuality >= 30 ? 8 : 3
bullBiasScore = biasStructBull + biasLiqBull + biasMacroBull + biasHTFBull + biasMomBull + biasSessBull
bearBiasScore = biasStructBear + biasLiqBear + biasMacroBear + biasHTFBear + biasMomBear + biasSessBear
rangeBiasScore = (regimeRanging ? 40 : 0) + (regimeDead ? 50 : 0) + (mtfAgreementLow ? 30 : 0) + (not macroBull and not macroBear and macroIntelValid ? 20 : 0) + (sessionQuality < 30 ? 15 : 0) + (avgStability > 0.3 ? 15 : 0)
// Three-way BULL/BEAR/RANGE comparison (max 130 each side)
biasRegimeCall = rangeBiasScore >= bullBiasScore and rangeBiasScore >= bearBiasScore ? "RANGE" : bullBiasScore >= bearBiasScore ? "BULL" : "BEAR"
bool rangeDominant = biasRegimeCall == "RANGE"

// V27 ENGINE 6: CONFIDENCE SCORE — equal-weight base from 5 independent dimensions
confStruct = structureRegime >= 80 ? 100 : structureRegime >= 50 ? 60 : structureRegime >= 20 ? 30 : 10
confMTF = int(math.round(math.max(htfFullLong, htfFullShort) * 100.0 / 5.0))
confLiquidity = 0
confLiquidity += bullBOS or bearBOS ? 25 : 0
confLiquidity += fvgActive or obBullActive or obBearActive ? 25 : 0
confLiquidity += (ranPdH or ranPdL or ranPwH or ranPwL or ranEqH or ranEqL) ? 25 : 0
confLiquidity += liqDestScore >= 50 ? 25 : 0
confMacro = macroIntelConf >= 60 ? 100 : macroIntelConf >= 30 ? 60 : macroIntelConf >= 10 ? 30 : 10
confSession = sessionRegime >= 80 ? 100 : sessionRegime >= 50 ? 60 : sessionRegime >= 20 ? 30 : 10
// Confidence Score: ordinal evidence-weighted composite (NOT a calibrated probability).
// Regime-dependent weights use a WINDOWED regime estimate (5-bar majority) to break the
// same-bar feedback loop.
float _regSumStrong = (strongTrend[1] ? 1 : 0) + (strongTrend[2] ? 1 : 0) + (strongTrend[3] ? 1 : 0) + (strongTrend[4] ? 1 : 0) + (strongTrend[5] ? 1 : 0)
float _regSumWeak = (weakTrend[1] ? 1 : 0) + (weakTrend[2] ? 1 : 0) + (weakTrend[3] ? 1 : 0) + (weakTrend[4] ? 1 : 0) + (weakTrend[5] ? 1 : 0)
bool _useWindowedStrong = _regSumStrong >= 3.0
bool _useWindowedWeak = _regSumWeak >= 3.0
float cwStruct = _useWindowedStrong ? 25 : _useWindowedWeak ? 15 : 20
float cwMtf = _useWindowedStrong ? 30 : _useWindowedWeak ? 10 : 20
float cwLiq = 20.0
float cwMacro = _useWindowedStrong ? 15 : _useWindowedWeak ? 25 : 20
float cwSess = _useWindowedStrong ? 10 : _useWindowedWeak ? 30 : 20
float cwTotal = cwStruct + cwMtf + cwLiq + cwMacro + cwSess
confidenceScore = int(math.round((confStruct * cwStruct + confMTF * cwMtf + confLiquidity * cwLiq + confMacro * cwMacro + confSession * cwSess) / cwTotal))
// Apply session-aware confidence multiplier
confidenceScore := int(math.min(math.round(confidenceScore * sessionConfMult), 100))
// R6.0: never present high confidence in news-like/abnormal conditions.
confidenceScore := int(math.min(confidenceScore, regConfCap))
// Multiple-comparison awareness: count aligned structural signals
int _bullSignals = (bullBOS ? 1 : 0) + (displacementUp ? 1 : 0) + (mssActiveBull ? 1 : 0) + (chochActiveBull ? 1 : 0) + (smtBullPair ? 1 : 0) + (liqSweepBull ? 1 : 0) + (vwapRejectBull ? 1 : 0)
int _bearSignals = (bearBOS ? 1 : 0) + (displacementDown ? 1 : 0) + (mssActiveBear ? 1 : 0) + (chochActiveBear ? 1 : 0) + (smtBearPair ? 1 : 0) + (liqSweepBear ? 1 : 0) + ((high >= vwapUpper2 and close < vwapVal) ? 1 : 0)
int _maxAgree = math.max(_bullSignals, _bearSignals)
bool _pipelineConflict = _bullSignals > 0 and _bearSignals > 0
bool _lowAgreement = _maxAgree < 2
if _lowAgreement
    confidenceScore := int(confidenceScore * 0.75)
// R5-F19: stationarity guard wired in — when short-window variance >= 3x long-window
// variance, rolling statistics are unreliable, so confidence is discounted.
if not (_varLong > 0 and _varShort / _varLong < 3.0)
    confidenceScore := int(confidenceScore * 0.85)
// EI label thresholds (85/65/40) — heuristic bins.
string confLabel = confidenceScore >= 85 ? "EXTREME" : confidenceScore >= 65 ? "HIGH" : confidenceScore >= 40 ? "MEDIUM" : "LOW"
// EI = Evidence Index (ordinal composite, 0-100). Not a probability or confidence interval.
// Adaptive confidence gate: strong directional trend evidence lowers the bar from 60 to 45
float _confThresh = math.max(bullTrendScore, bearTrendScore) >= 70 ? 45.0 : 60.0
regimeConfHigh = confidenceScore >= _confThresh

// STATISTICAL EVIDENCE ENGINE (Part 5) — 8 evidence streams, normalized per direction
float evTrendBull = bullTrendScore
float evTrendBear = bearTrendScore
float evStructBull = na(structScore) ? 50.0 : chochBullScore > 0 ? math.max(structScore, 55.0) : structScore
float evStructBear = na(structScore) ? 50.0 : chochBearScore > 0 ? math.max(100.0 - structScore, 55.0) : 100.0 - structScore
float evFlowBull = diplus > diminus ? safeDiv(diplus, diplus + diminus) * 100.0 : 30.0
float evFlowBear = diminus > diplus ? safeDiv(diminus, diplus + diminus) * 100.0 : 30.0
float evMacroBull = macroStrengthScore > 0 ? macroStrengthScore : 0.0
float evMacroBear = macroStrengthScore < 0 ? math.abs(macroStrengthScore) : 0.0
// Q6.3: liquidity evidence is now CONTINUOUS (was a 60/30 binary toggle inside an
// otherwise continuous 10-factor blend). Score = share of total destination pull on
// each side, mapped to the same [30, 60] range so weights need no retuning;
// 45 = balanced. A marginal 51/49 tilt no longer scores identically to a 95/5 rout.
float _liqUpPull = liqScorePDH + liqScorePWH + liqScorePMH + liqScoreEQH
float _liqDnPull = liqScorePDL + liqScorePWL + liqScorePML + liqScoreEQL
float _liqPullTot = _liqUpPull + _liqDnPull
float evLiqBull = _liqPullTot > 0 ? 30.0 + 30.0 * (_liqUpPull / _liqPullTot) : 45.0
float evLiqBear = _liqPullTot > 0 ? 30.0 + 30.0 * (_liqDnPull / _liqPullTot) : 45.0
// CHANGE ID: F-001 — sessionQuality measures session LIQUIDITY and carries NO directional
// information, yet the polarity-swapped branches injected up to 3.0 raw score points of
// bull-bear delta with a +29.7pt discontinuity across sq 49->50, and wSession is the one
// weight with no kMod so it never attenuated. Both sides now identical, so the term
// contributes CONFIDENCE and cancels exactly in (bullScore - bearScore). 0.65 is the
// midpoint of the old 0.8/0.5 pair, preserving overall evidence magnitude while removing
// only the directional component. Same remedy as the R5.2-H2 correlation-health fix.
// INVARIANT: evSessionBull == evSessionBear for every sessionQuality in [0,100].
float evSessionBull = sessionQuality * 0.65
float evSessionBear = sessionQuality * 0.65
// R5.2-H2: correlation health is direction-NEUTRAL — a breakdown (regime decoupling)
// is not bear evidence. The old asymmetry (bear = 100 - health when health < 40)
// acted as a latent short bias exactly during decoupling rallies, which for gold are
// often the strongest up-moves. Both sides now receive the same value (cancels in the
// bull/bear normalization); breakdown instead feeds rangeEvidence below.
float evCorrBull = avgCorrHealth >= 40 ? avgCorrHealth : 30.0
float evCorrBear = avgCorrHealth >= 40 ? avgCorrHealth : 30.0
float evMrBull = (mrComposite <= -30 ? math.min(math.abs(mrComposite), 100) : 10.0)
float evMrBear = (mrComposite >= 30 ? math.min(math.abs(mrComposite), 100) : 10.0)
// Weighted aggregate with regime-aware modulation (sum preserved: +0.10 -0.04 -0.03 +0.02 -0.05 = 0)
float wBaseTrend = 0.20
float wBaseStruct = 0.18
float wBaseFlow = 0.15
float wBaseMacro = 0.15
float wBaseLiq = 0.12
float wBaseSession = 0.10
float wBaseCorr = 0.05
float wBaseMR = 0.05
float kMod = (regimeStrength - 0.5) * 2.0 // -1 (range) to +1 (trend)
float wTrend = wBaseTrend + kMod * 0.10
float wStruct = wBaseStruct - kMod * 0.04
float wFlow = wBaseFlow
float wMacro = wBaseMacro
float wLiq = wBaseLiq
float wSession = wBaseSession - kMod * 0.03
float wCorr = wBaseCorr + kMod * 0.02
float wMR = wBaseMR - kMod * 0.05
float rawBullScore = evTrendBull * wTrend + evStructBull * wStruct + evFlowBull * wFlow + evMacroBull * wMacro + evLiqBull * wLiq + evSessionBull * wSession + evCorrBull * wCorr + evMrBull * wMR
float rawBearScore = evTrendBear * wTrend + evStructBear * wStruct + evFlowBear * wFlow + evMacroBear * wMacro + evLiqBear * wLiq + evSessionBear * wSession + evCorrBear * wCorr + evMrBear * wMR
// Independent ranging evidence score (not just residual)
float rangeEvidence = 0.0
rangeEvidence := adxVal < 20 ? 40.0 : adxVal < 25 ? 25.0 : 0.0
bool insideBar = high <= high[1] and low >= low[1]
rangeEvidence := rangeEvidence + (insideBar ? 20.0 : 0.0)
float atrSma = ta.sma(adaptiveATR, 20)
float atrRatio = atrSma > 0.0 ? adaptiveATR / atrSma : 1.0
rangeEvidence := rangeEvidence + (atrRatio < 0.85 ? 20.0 : atrRatio < 1.0 ? 10.0 : 0.0)
float emaSpread = adaptiveATR > 0 ? math.abs(ema20 - ema100) / adaptiveATR : 0.0
rangeEvidence := rangeEvidence + (emaSpread < 0.5 ? 15.0 : emaSpread < 1.0 ? 8.0 : 0.0)
// R5.2-H2: correlation breakdown (valid feeds, low health) argues for uncertainty/range,
// not for a direction. _numValid guard: no data is not the same as breakdown.
rangeEvidence := rangeEvidence + (_numValid > 0 and avgCorrHealth < 40 ? 10.0 : 0.0)
rangeEvidence := math.min(rangeEvidence, 100.0)
// Regime-based range base for blended normalization
float regimeRangeBase = regimeTrending ? 10.0 : regimeRanging ? 30.0 : 45.0
// Normalize to sum 100%: blend evidence + range + regime, then normalize once
float totalRawScore = rawBullScore + rawBearScore
float rawBull = totalRawScore > 0 ? rawBullScore / totalRawScore * 100.0 : 50.0
float rawBear = totalRawScore > 0 ? rawBearScore / totalRawScore * 100.0 : 50.0
float rangeResidual = 100.0 - rawBull - rawBear
float rangeBlended = (rangeResidual * 0.70) + (rangeEvidence * 0.20) + (regimeRangeBase * 0.10)
float rTotal = rawBull + rawBear + rangeBlended
float bullScore = 0.0
float bearScore = 0.0
float rangeScore = 0.0
if rTotal > 0
    bullScore := math.round(rawBull / rTotal * 100.0)
    bearScore := math.round(rawBear / rTotal * 100.0)
    rangeScore := 100.0 - bullScore - bearScore
// Clamp negative rangeScore
if rangeScore < 0
    float excess = math.abs(rangeScore)
    rangeScore := 0.0
    float _ratioDenom = bullScore + bearScore
    float ratio = _ratioDenom > 0 ? bullScore / _ratioDenom : 0.5
    bullScore := math.max(bullScore - excess * ratio, 5.0)
    bearScore := 100.0 - bullScore
// Floor and ceiling checks
if bullScore < 5.0 and bearScore < 5.0
    bullScore := 50.0
    bearScore := 50.0
    rangeScore := 0.0
if bullScore > 95.0
    bullScore := 95.0
    bearScore := math.max(bearScore, 5.0)
    rangeScore := 100.0 - bullScore - bearScore
if bearScore > 95.0
    bearScore := 95.0
    bullScore := math.max(bullScore, 5.0)
    rangeScore := 100.0 - bullScore - bearScore
// Bias label using normalized scores (0-100, same scale as dashboard)
// SSOT: SHARED — consumed by dashboard TREND column, alert messages, and evidence display

// HISTORICAL ANALOG ANALYSIS (Part 6) — outputs populated below from stats engine

// SCENARIO ANALYSIS — WHAT-IF ENGINE (Part 8)
if not na(poolPdH)
    float pdhContFactor = 50.0
    pdhContFactor += bullTrend ? 15.0 : bearTrend ? -10.0 : 0.0
    pdhContFactor += htfBullScoreGate ? 12.0 : htfBearScoreGate ? -8.0 : 0.0
    pdhContFactor += macroStrengthScore > 0 ? 10.0 : macroStrengthScore < 0 ? -10.0 : 0.0
    pdhContFactor += adxVal > adxThreshold ? 5.0 : 0.0
if not na(poolPdL)
    float pdlContFactor = 50.0
    pdlContFactor += bearTrend ? 15.0 : bullTrend ? -10.0 : 0.0
    pdlContFactor += htfBearScoreGate ? 12.0 : htfBullScoreGate ? -8.0 : 0.0
    pdlContFactor += macroStrengthScore < 0 ? 10.0 : macroStrengthScore > 0 ? -10.0 : 0.0
    pdlContFactor += adxVal > adxThreshold ? 5.0 : 0.0
// VWAP hold/fail scenarios
float vwapDist = math.abs(distVwapATR)
if vwapDist < 1.0 and not na(vwapVal)
    float holdFactor = 50.0
    holdFactor += bullTrend ? 12.0 : bearTrend ? -12.0 : 0.0
    holdFactor += htfBullScoreGate ? 10.0 : htfBearScoreGate ? -10.0 : 0.0
    holdFactor += macroStrengthScore > 0 ? 8.0 : macroStrengthScore < 0 ? -8.0 : 0.0
    holdFactor += evLiqBull > evLiqBear ? 8.0 : -8.0
    holdFactor += adxVal > adxThreshold ? 5.0 : 0.0
    // R5.1: VWAP slope/acceleration wired in (small heuristic weights; clamp keeps [10,90])
    holdFactor += vwapSlope > 0 ? 5.0 : vwapSlope < 0 ? -5.0 : 0.0
    holdFactor += vwapAccel > 0 ? 3.0 : vwapAccel < 0 ? -3.0 : 0.0
    float failFactor = 50.0
    failFactor += bearTrend ? 12.0 : bullTrend ? -12.0 : 0.0
    failFactor += htfBearScoreGate ? 10.0 : htfBullScoreGate ? -10.0 : 0.0
    failFactor += macroStrengthScore < 0 ? 8.0 : macroStrengthScore > 0 ? -8.0 : 0.0
    failFactor += evLiqBear > evLiqBull ? 8.0 : -8.0
    failFactor += adxVal > adxThreshold ? 5.0 : 0.0
    failFactor += vwapSlope < 0 ? 5.0 : vwapSlope > 0 ? -5.0 : 0.0
    failFactor += vwapAccel < 0 ? 3.0 : vwapAccel > 0 ? -3.0 : 0.0
// PDH/PDL Reach — uses rawBullScore/rawBearScore (same 8-factor weighted sum)
float totalR = rawBullScore + rawBearScore
float pdhReachScore = totalR > 0 ? math.round(rawBullScore / totalR * 100.0) : 50.0
float pdlReachScore = 100.0 - pdhReachScore
if pdhReachScore < 5.0
    pdhReachScore := 5.0
    pdlReachScore := 95.0
if pdlReachScore < 5.0
    pdlReachScore := 5.0
    pdhReachScore := 95.0
// Per-target reach scores (distributed proportionally to liq scores)

// Cost-to-target ratio (display only — does not gate signals)
// R5-F15: spread is a round-trip cost paid once; only slippage occurs on both sides.
// R5-F21: empty session string guarded.
bool inNewsWindow = useNewsSuppress and newsSession != "" and not na(time(timeframe.period, newsSession))
// R5-F4: persistent DD mirror — declared before the signal gate, updated after the
// stats engine runs, so the breaker acts on the previous bar's MaxDD (no ordering
// dependency, no same-bar feedback loop).
var float _ddForBreaker = 0.0
bool _ddBreach = useDDBreaker and _ddForBreaker >= maxDdPct
// ═══ Q5.5 DECISION RESTRUCTURE (root cause of persistent WAIT) ═══
// The old gate was a conjunctive stack of ~10 AND-ed conditions — P(all true)
// collapses multiplicatively, and three gates were lagging or event-rare:
//  1. RSI DIVERGENCE was MANDATORY for every entry — divergence is a rare reversal
//     event (a few/week on 5M); requiring it for trend-continuation entries has no
//     theoretical basis and was the single largest WAIT contributor. Now weighted
//     evidence (it already feeds confidence), not a gate.
//  2. MACRO >=3/6 votes was a hard gate on daily/4H feeds — lagging context used as a
//     veto. Already weighted inside TQ (0.15) and confidence; gate removed.
//  3. Chart trend AND full HTF stack — EMA-stack conjunctions structurally lag trend
//     TRANSITIONS (the exact reported symptom). HTF now blocks only when OPPOSED.
// Retained hard gates (safety/statistics only): session floor, news window, DD
// breaker, recency — plus the downstream TQ floor and negative-expectancy vetoes,
// which are the calibrated, regime-adaptive filters. Protection shifts from
// "everything must agree" to "quality must clear the bar and nothing safety-critical
// objects" — responsiveness rises without loosening the statistical gates.
bool buyPreFilters = bullTrend and htfBullScoreGate and macroBull and regimeConfHigh and bullRsiDiv and recentBars and sessionQuality >= 30 and not inNewsWindow and not _ddBreach
bool sellPreFilters = bearTrend and htfBearScoreGate and macroBear and regimeConfHigh and bearRsiDiv and recentBars and sessionQuality >= 30 and not inNewsWindow and not _ddBreach
// Q5.8: windowed structure (BOS/CHoCH/MSS) replaces the momentary BOS-only trigger.
shouldBuy = buyPreFilters and (bullBOS or displacementUp)

shouldSell = sellPreFilters and (bearBOS or displacementDown)

// ---- Decision Log: which pre-filters are passing ----
string _buyFilterLog = ""
string _sellFilterLog = ""
_buyFilterLog := bullTrend ? _buyFilterLog : _buyFilterLog + "Trend "
_buyFilterLog := htfBullScoreGate ? _buyFilterLog : _buyFilterLog + "HTF "
_buyFilterLog := macroBull ? _buyFilterLog : _buyFilterLog + "Macro "
_buyFilterLog := regimeConfHigh ? _buyFilterLog : _buyFilterLog + "Regime "
_buyFilterLog := bullRsiDiv ? _buyFilterLog : _buyFilterLog + "RSI "
_buyFilterLog := recentBars ? _buyFilterLog : _buyFilterLog + "Recent "
_buyFilterLog := sessionQuality >= 30 ? _buyFilterLog : _buyFilterLog + "Sess "
int _buyPass = (bullTrend ? 1 : 0) + (htfBullScoreGate ? 1 : 0) + (macroBull ? 1 : 0) + (regimeConfHigh ? 1 : 0) + (bullRsiDiv ? 1 : 0) + (recentBars ? 1 : 0) + (sessionQuality >= 30 ? 1 : 0)
string _buyLog = "▲" + str.tostring(_buyPass) + "/7" + (_buyPass < 7 ? " [✗" + _buyFilterLog + "]" : "")
_sellFilterLog := bearTrend ? _sellFilterLog : _sellFilterLog + "Trend "
_sellFilterLog := htfBearScoreGate ? _sellFilterLog : _sellFilterLog + "HTF "
_sellFilterLog := macroBear ? _sellFilterLog : _sellFilterLog + "Macro "
_sellFilterLog := regimeConfHigh ? _sellFilterLog : _sellFilterLog + "Regime "
_sellFilterLog := bearRsiDiv ? _sellFilterLog : _sellFilterLog + "RSI "
_sellFilterLog := recentBars ? _sellFilterLog : _sellFilterLog + "Recent "
_sellFilterLog := sessionQuality >= 30 ? _sellFilterLog : _sellFilterLog + "Sess "
int _sellPass = (bearTrend ? 1 : 0) + (htfBearScoreGate ? 1 : 0) + (macroBear ? 1 : 0) + (regimeConfHigh ? 1 : 0) + (bearRsiDiv ? 1 : 0) + (recentBars ? 1 : 0) + (sessionQuality >= 30 ? 1 : 0)
string _sellLog = "▼" + str.tostring(_sellPass) + "/7" + (_sellPass < 7 ? " [✗" + _sellFilterLog + "]" : "")
string _trigLog = (bullBOS or displacementUp or bearBOS or displacementDown) ? "" : " NO-TRIG"
string _newsLog = inNewsWindow ? " NEWS-BLK" : ""
string _ddLog = _ddBreach ? " DD-BREACH" : ""
string _conflictLog = _pipelineConflict ? " CONFLICT" : ""
string decisionLog = rangeDominant ? "RANGE " + str.tostring(int(rangeBiasScore)) + "/130 [no dir. edge]" : bullBiasScore >= bearBiasScore ? _buyLog + _trigLog + _newsLog + _ddLog + _conflictLog : _sellLog + _trigLog + _newsLog + _ddLog + _conflictLog

// Q5.2-F3: per-direction analog hit probabilities [L>=1R, L>=2R, L>=3R, L SL1R,
// S>=1R, S>=2R, S>=3R, S SL1R], written by the stats engine (N>=20), read by the plan.
var float[] gHitProb = array.new<float>(8, na)
// Q6.8: analog sample count published alongside the hit rates. A displayed "~18%"
// from 200 analogs and one from 21 analogs are very different claims; without N the
// reader cannot tell them apart.
var float[] gHitN = array.new<float>(1, na)
// Linear interpolation over the 1R/2R/3R grid; geometric taper beyond 3R.
f_hitInterp(_rr, _p1, _p2, _p3) =>
    _rr <= 1.0 ? _p1 : _rr <= 2.0 ? _p1 + (_p2 - _p1) * (_rr - 1.0) : _rr <= 3.0 ? _p2 + (_p3 - _p2) * (_rr - 2.0) : _p3 * math.pow(0.7, _rr - 3.0)
// ═══ COMPILE-ORDER FIX (F-A13) ═══════════════════════════════════════════════
// This block was BELOW f_tradePlan(), whose planReason string reads OUTCOME_N. Pine
// requires declaration before use, so the Master and both twins failed to compile with
//     Undeclared identifier "OUTCOME_N"
// on the planReason line. The note left further down records hitting this exact error
// once before and moving a DIFFERENT block below the declaration -- which fixed that
// block and left this one broken, because f_tradePlan() sits above it either way.
// Moved here instead: chartTFSeconds is declared far earlier, so nothing this block
// needs is out of reach, and declaring earlier cannot break a later reader.
// KEEP THIS ABOVE f_tradePlan(). audit/tools/order.py checks it on every build.
// Timeframe-adaptive history to prevent timeout
int tfSec = chartTFSeconds
int HIST_MAX = tfSec <= 60 ? 1200 : tfSec <= 300 ? 2000 : tfSec <= 900 ? 3000 : 4500
// R5.3: floor raised 1 -> 3. On TFs >= 1H the horizon collapsed to a single bar (pure
// next-bar drift), and OUTCOME_N=1 also made the PDH/PDL first-touch loop degenerate
// (for j = 0 to 1 iterates ASCENDING, touching offset 0). Min 3 bars keeps every
// consumer well-formed; on <=15M charts behavior is unchanged (~1 hour horizon).
OUTCOME_N = math.max(3, int(3600.0 / tfSec))

f_tradePlan() =>
    // ---- R6.0 DYNAMIC TRADE PLAN — structural SL, liquidity-target TPs, explainable ----
    // SL: nearest valid structural/liquidity level on the protective side, buffered 0.15
    // ATR beyond, accepted only inside [0.6 ATR, 1.6 x regime-ATR]; regime-scaled ATR
    // (regSLMult) is the fallback, so ATR is secondary as specified.
    // TPs: nearest liquidity destinations on the profit side (min 0.8R / 0.5 ATR away,
    // deduped within 0.3 ATR); R-multiple fallbacks (1R/2R/3R) only when the map is empty.
    bool tpIsLong = shouldBuy ? true : shouldSell ? false : bullBiasScore >= bearBiasScore
    float tpEntry = close
    float _slAtrBase = adaptiveATR * regSLMult
    float _slLoB = adaptiveATR * 0.6
    float _slHiB = _slAtrBase * 1.6
    string tpSLBasis = "ATR"
    float tpSL = tpIsLong ? close - _slAtrBase : close + _slAtrBase
    // Q5.1-C: candidate sets extended with VP value-area edges and weekly VWAP.
    float[] _slC = tpIsLong ? array.from(activeSupport, obBullActive ? obBullLow : na, cdl, poolPdL, poolEqL, valPrice, wVwapVal < close ? wVwapVal : na) : array.from(activeResistance, obBearActive ? obBearHigh : na, cdh, poolPdH, poolEqH, vahPrice, wVwapVal > close ? wVwapVal : na)
    // F-A07 MARKER. A trailing "°" on a basis name marks a level that exists ONLY at the
    // live edge. valPrice / vahPrice / vpocPrice are assigned inside the volume-profile
    // block, which is guarded by `barstate.islast`, so on every HISTORICAL bar they are na
    // and the candidate is silently skipped by the `not na(_lv)` test below. A "°" basis
    // therefore CANNOT have been produced by any backtested bar: the plan is telling you it
    // used a level no historical bar could see. That asymmetry is the finding; this marks it
    // rather than hiding it. Applies to VAL/VAH here and to POC/VAH/VAL in _tpNms.
    // DISTINCT FROM "*", which marks a stop clamped into the R-unit band (see below).
    // Both can appear together, e.g. "VAL°*" = value-area low, live-only, then clamped.
    // IF the volume-profile guard is ever relaxed to per-bar, DELETE these five markers --
    // they are baked into the literals precisely so they cost zero runtime tokens.
    string[] _slN = tpIsLong ? array.from("Swing", "OB", "CDL", "PDL", "EQL", "VAL°", "wVWAP") : array.from("Swing", "OB", "CDH", "PDH", "EQH", "VAH°", "wVWAP")
    float _slBest = 1e10
    for _k = 0 to array.size(_slC) - 1
        float _lv = array.get(_slC, _k)
        if not na(_lv) and ((tpIsLong and _lv < close) or (not tpIsLong and _lv > close))
            float _dS = math.abs(close - _lv) + adaptiveATR * 0.15
            if _dS >= _slLoB and _dS <= _slHiB and _dS < _slBest
                _slBest := _dS
                tpSL := tpIsLong ? _lv - adaptiveATR * 0.15 : _lv + adaptiveATR * 0.15
                tpSLBasis := array.get(_slN, _k)
    // Q5.2-F7: never rest the stop exactly on a 50-level (stop clusters) — nudge 0.2 ATR.
    float _rn50S = math.round(tpSL / rnGrid) * rnGrid
    if math.abs(tpSL - _rn50S) < adaptiveATR * 0.05
        tpSL := tpIsLong ? _rn50S - adaptiveATR * 0.2 : _rn50S + adaptiveATR * 0.2
    // Q5.7 R-UNIT CLAMP (third-party audit finding). The SL validity band bounds the
    // stop in ATR units, but adaptiveATR itself is only floored at close*0.0001 (~0.4 on
    // gold). In a dead market or across a data gap ATR can collapse to that floor, and
    // tpDist is the DIVISOR for tpRR1/2/3 — yielding absurd ratios (80:1) and a corrupted
    // R budget downstream. Enforce the final risk distance into [0.5, 5.0] ATR by moving
    // the STOP (not by clamping tpDist), so the displayed SL and the RRs always agree.
    // A trailing "*" on the basis marks a clamped stop for traceability.
    float _rMin = adaptiveATR * 0.5
    float _rMax = adaptiveATR * 5.0
    float _rRaw = math.abs(tpEntry - tpSL)
    if _rRaw < _rMin or _rRaw > _rMax or na(_rRaw)
        float _rFix = math.min(math.max(nz(_rRaw, _rMin), _rMin), _rMax)
        tpSL := tpIsLong ? tpEntry - _rFix : tpEntry + _rFix
        tpSLBasis := tpSLBasis + "*"
    float tpDist = math.abs(tpEntry - tpSL)
    float _tpMinD = math.max(tpDist * 0.8, adaptiveATR * 0.5)
    // CHANGE ID: F-019 — TP candidates had a MINIMUM distance filter but NO MAXIMUM, while
    // the stop has a bounded band (_slLoB.._slHiB). Observed live: a SHORT with a 6.37 pt
    // stop took TP3 from MONTHLY VWAP at 4386.28 — 241.81 points away, 37.9R — and the panel
    // duly printed "RRg 1:37.9". The arithmetic was right; the level is not a target.
    // A structural level that far out is real, but it belongs to a different timeframe's
    // trade, and printing it as TP3 makes the RR field meaningless exactly where a trader
    // looks to size expectations.
    // Cap = 12R: far beyond any realistic intraday runner (TP3 normally lands 3-5R) while
    // excluding higher-timeframe artefacts. Expressed in R, the same unit the panel shows.
    // NOT tuning: it admits no NEW candidate and improves no result. It only stops an
    // unreachable level being presented as actionable. Candidates past the cap are skipped,
    // so TP3 falls through to the "+1R" ladder fallback (F-016).
    float _tpMaxD = tpDist * 12.0
    // Q5.1-C: POC, opposite value-area edge, and monthly VWAP are first-class targets.
    float[] _tpLvls = tpIsLong ? array.from(poolPdH, poolPwH, poolPmH, poolEqH, obBearActive ? obBearLow : na, cdh, vpocPrice, vahPrice, mVwapVal, math.floor(close / rnGrid) * rnGrid + rnGrid) : array.from(poolPdL, poolPwL, poolPmL, poolEqL, obBullActive ? obBullHigh : na, cdl, vpocPrice, valPrice, mVwapVal, math.ceil(close / rnGrid) * rnGrid - rnGrid)
    string[] _tpNms = tpIsLong ? array.from("PDH", "PWH", "PMH", "EQH", "OB", "CDH", "POC°", "VAH°", "mVWAP", "RN") : array.from("PDL", "PWL", "PML", "EQL", "OB", "CDL", "POC°", "VAL°", "mVWAP", "RN")
    float[] _tpD = array.new<float>()
    float[] _tpL = array.new<float>()
    string[] _tpB = array.new<string>()
    for _k = 0 to array.size(_tpLvls) - 1
        float _lv = array.get(_tpLvls, _k)
        if not na(_lv)
            float _dT = tpIsLong ? _lv - close : close - _lv
            if _dT >= _tpMinD and _dT <= _tpMaxD
                array.push(_tpD, _dT)
                array.push(_tpL, _lv)
                array.push(_tpB, array.get(_tpNms, _k))
    float tp1 = na
    float tp2 = na
    float tp3 = na
    string tp1Basis = "1R"
    string tp2Basis = "2R"
    string tp3Basis = "3R"
    if array.size(_tpD) > 0
        array<int> _tpIdx = array.sort_indices(_tpD, order.ascending)
        float _lastPick = na
        int _got = 0
        for _j = 0 to array.size(_tpIdx) - 1
            if _got >= 3
                break
            int _si = array.get(_tpIdx, _j)
            float _lv = array.get(_tpL, _si)
            if na(_lastPick) or math.abs(_lv - _lastPick) > adaptiveATR * 0.3
                if _got == 0
                    tp1 := _lv
                    tp1Basis := array.get(_tpB, _si)
                else if _got == 1
                    tp2 := _lv
                    tp2Basis := array.get(_tpB, _si)
                else
                    tp3 := _lv
                    tp3Basis := array.get(_tpB, _si)
                _lastPick := _lv
                _got += 1
    // R-multiple fallbacks keep the ladder monotonic when the liquidity map is sparse.
    // CHANGE ID: F-016 — the basis labels "1R"/"2R"/"3R" were DEFAULTS set before the
    // candidate scan and only overwritten when a real level was picked. When the ladder is
    // MIXED (some rungs from levels, some from fallback) the leftover default lies: a TP3
    // filled by the fallback is tp2 + 1R, NOT 3R. Observed live — TP1 came from CDH and
    // TP2 from RN, so TP3 read "3R" while the RRg field correctly showed 1:3.7, and the
    // two disagreed on screen.
    // Each fallback now names what it actually is, so basis and RR can never contradict.
    bool _fb1 = na(tp1)
    bool _fb2 = na(tp2) or (tpIsLong ? tp2 <= tp1 : tp2 >= tp1)
    tp1 := _fb1 ? (tpIsLong ? tpEntry + tpDist : tpEntry - tpDist) : tp1
    tp2 := _fb2 ? (tpIsLong ? math.max(tp1, tpEntry) + tpDist : math.min(tp1, tpEntry) - tpDist) : tp2
    bool _fb3 = na(tp3) or (tpIsLong ? tp3 <= tp2 : tp3 >= tp2)
    tp3 := _fb3 ? (tpIsLong ? tp2 + tpDist : tp2 - tpDist) : tp3
    tp1Basis := _fb1 ? "1R" : tp1Basis
    tp2Basis := _fb2 ? (_fb1 ? "2R" : "+1R") : tp2Basis
    tp3Basis := _fb3 ? (_fb2 and _fb1 ? "3R" : "+1R") : tp3Basis
    float tpRR1 = tpDist > 0 ? math.abs(tp1 - tpEntry) / tpDist : 0.0
    float tpRR2 = tpDist > 0 ? math.abs(tp2 - tpEntry) / tpDist : 0.0
    float tpRR3 = tpDist > 0 ? math.abs(tp3 - tpEntry) / tpDist : 0.0
    string tpDirStr = tpIsLong ? "LONG" : "SHORT"
    color tpCol = tpIsLong ? #00D084 : #FF4D4D
    string tpEntryStr = str.tostring(tpEntry, "#.##")
    string tpSLStr = str.tostring(tpSL, "#.##")
    string tp1Str = str.tostring(tp1, "#.##")
    string tp2Str = str.tostring(tp2, "#.##")
    string tp3Str = str.tostring(tp3, "#.##")
    string tpRRStr = "1:" + str.tostring(tpRR1, "#.#") + "/1:" + str.tostring(tpRR2, "#.#") + "/1:" + str.tostring(tpRR3, "#.#")
    // R6.0 explainability: how the plan was built, shown on the plan panel.
    // Q5.2-F4: P(reach TP_k) and P(SL) from analog MFE/MAE distributions; 1R expectancy.
    float pTP1 = na
    float pTP2 = na
    float pTP3 = na
    float pSLhit = na
    if not na(array.get(gHitProb, 0))
        int _hb = tpIsLong ? 0 : 4
        pTP1 := f_hitInterp(tpRR1, array.get(gHitProb, _hb), array.get(gHitProb, _hb + 1), array.get(gHitProb, _hb + 2))
        pTP2 := f_hitInterp(tpRR2, array.get(gHitProb, _hb), array.get(gHitProb, _hb + 1), array.get(gHitProb, _hb + 2))
        pTP3 := f_hitInterp(tpRR3, array.get(gHitProb, _hb), array.get(gHitProb, _hb + 1), array.get(gHitProb, _hb + 2))
        pSLhit := array.get(gHitProb, _hb + 3)
    float planExpectancy = not na(pTP1) and not na(pSLhit) ? pTP1 / 100.0 - pSLhit / 100.0 : na
    // F-035 + F-038 TERMINOLOGY. Two separate things this number is NOT.
    // (1) NOT a lifetime probability: it is measured within OUTCOME_N bars only -- 60 min
    //     below 20M, then 3 BARS above it (90 min on 30M, 720 min on 4H). The same ~26pt
    //     target measured 3% on 30M and 18% on 4H purely because the window differs.
    // (2) F-038 — NOT A RACE. These come from _gHit, which counts MARGINAL EXCURSION
    //     TOUCHES: gHit[0] increments when MFE >= 1R at ANY point in the window, and
    //     gHit[3] when MAE >= 1R, INDEPENDENTLY. One analog can increment both. So ~P and
    //     ~SL are marginal touch rates over the SAME population, NOT mutually exclusive
    //     outcomes of a TP-before-SL race, and they do not sum to 100.
    //     Denominator: _gHit[8] = count of rolling analogs with valid excursion data,
    //     gated at N >= 20. Frequencies are RAW -- no Bayesian shrinkage on this path
    //     (bayesRate applies to the calibration bins, a different statistic).
    //     Population is _isOosEarly-gated, so it inherits F-037B (rolling, not a holdout).
    // P(target touched within OUTCOME_N bars) -- a fixed short window that is 60 min below
    // 20M and then 3 BARS above it (90 min on 30M, 720 min on 4H). Measured effect: the same
    // ~26pt target reads 3% on 30M and 18% on 4H purely because the window differs. The
    // horizon is now printed in the label so the number cannot be read as a trade
    // probability. The underlying calculation is UNCHANGED -- this is a labelling fix, and
    // the horizon mismatch itself (F-035) remains OPEN as a design decision.
    string planReason = "SL:" + tpSLBasis + " TP:" + tp1Basis + "/" + tp2Basis + "/" + tp3Basis + " [" + mktRegime + "]" + (not na(pTP1) ? " ~touch(<=" + str.tostring(OUTCOME_N) + "b):" + str.tostring(int(pTP1)) + "/" + str.tostring(int(pTP2)) + "/" + str.tostring(int(pTP3)) + "% ~SLtouch" + str.tostring(int(pSLhit)) + "% E" + str.tostring(planExpectancy, "#.##") + "R" : "")
    [tpIsLong, tpEntry, tpSL, tpDist, tp1, tp2, tp3, tpRR1, tpRR2, tpRR3, tpDirStr, tpCol, tpEntryStr, tpSLStr, tp1Str, tp2Str, tp3Str, tpRRStr, pTP1, pTP2, pTP3, pSLhit, planExpectancy, planReason]
[tpIsLong, tpEntry, tpSL, tpDist, tp1, tp2, tp3, tpRR1, tpRR2, tpRR3, tpDirStr, tpCol, tpEntryStr, tpSLStr, tp1Str, tp2Str, tp3Str, tpRRStr, pTP1, pTP2, pTP3, pSLhit, planExpectancy, planReason] = f_tradePlan()

// STATISTICAL ENGINES — Evidence-based historical outcome analysis

// Q7.3 NOTE (superseded by F-A13): OUTCOME_N is now declared ABOVE f_tradePlan, so
// this block no longer depends on sitting below it. The original note read:
// identifier". Its only consumer is the plan panel far below, so here is correct.
// ═══ Q6.8 CREDIBLE INTERVAL ON ANALOG HIT RATES ═══
// Beta-Binomial conjugacy with a uniform Beta(1,1) prior: posterior is
// Beta(k+1, n-k+1), whose mean is the Laplace estimator already used elsewhere in
// this script. Rather than evaluate the inverse incomplete beta (not available in
// Pine), the ~90% credible half-width uses the normal approximation to the
// posterior sd:  sd = sqrt(p(1-p)/(n+3)),  half-width = 1.645 x sd.
// The approximation is adequate away from the 0/1 boundaries and conservative
// enough near them because the +3 in the denominator shrinks toward the prior.
// N is the EFFECTIVE sample: analog outcomes overlap over OUTCOME_N bars, so raw
// N overstates independent information and would understate the interval.
// Calibration bin edges (quantile-adaptive, initialized to defaults)
var float calQ20 = 20.0
var float calQ40 = 40.0
var float calQ60 = 60.0
var float calQ80 = 80.0
// Per-regime outcome counts for regime-conditioned calibration adjustment
var int[] _regTot = array.from(0, 0, 0)
var int[] _regWin = array.from(0, 0, 0)
var int[] hBi = array.new_int(HIST_MAX, -1)
// Q5.2-F2 (declaration moved before the recording block — fix for "Undeclared
// identifier hZone"): OB/FVG zone state feature (1 bull zone, 0 bear, 0.5 none).
var float[] hZone = array.new<float>(HIST_MAX, 0.5)
// F-010: hAdx/hAtr RESTORED and wired as the graceful-degradation source for the
// similarity distance (see the match loop). They record the ADX / ATR-percentile CATEGORY
// at each stored bar, which is exactly what is needed when the raw series lookback for an
// old analog is unavailable.
var int[] hAdx = array.new_int(HIST_MAX, 0)
var int[] hAtr = array.new_int(HIST_MAX, 0)
var int[] hHtf = array.new_int(HIST_MAX, 0)
var int[] hStr = array.new_int(HIST_MAX, 0)
var int[] hLiq = array.new_int(HIST_MAX, 0)
var int[] hMr = array.new_int(HIST_MAX, 0)
var int[] hCor = array.new_int(HIST_MAX, 0)
var int[] hOut = array.new_int(HIST_MAX, 0)
var float[] hRet = array.new_float(HIST_MAX, 0.0)
// F-A10: the per-analog R UNIT (risk distance in POINTS) that hRet was normalised by.
// Stored because the expectancy loop needs it to express transaction cost in R, and
// _oR is local to the outcome-recording loop. Without it the cost subtraction there
// was in ATR units while hRet is in R units -- see the block at the subtraction.
var float[] hRUnit = array.new_float(HIST_MAX, 0.0)
var float[] hPred = array.new_float(HIST_MAX, 50.0)
var int[] h1st = array.new_int(HIST_MAX, 0)
var int[] hBEv = array.new_int(HIST_MAX, 0)
var float[] hBCont = array.new_float(HIST_MAX, 0.0)
var float[] hCalBin = array.new_float(HIST_MAX, -1.0)
// ===== ANALOG FEATURE SCHEMA VERSIONING (D-012) ===============================
// D-012: enabling GC/OI changes how rCurr is COMPUTED (oiConviction -> macroRegime ->
// regimeComposite -> strongTrend/moderateTrend -> rCurr), and rCurr is STORED per bar in
// hRegime. So the buffer can hold observations produced by TWO different definitions of
// the same feature, and the matcher would treat them as equivalent. That is a
// FEATURE-SCHEMA change, not merely a new input — indirect influence still counts.
// This records WHICH definition produced each stored observation. Filtering is NOT
// enforced yet (enforcing it now would change matching behaviour mid-validation, which is
// the thing we are trying to measure); the metadata is captured so the migration is
// OBSERVABLE and can be filtered later without re-collecting history.
// V1 = pre-integration definition. V2 = GC/OI able to influence the regime.
// THREE-LAYER SCHEMA MODEL (reviewer, approved revision) — kept IDENTICAL to the Master
// so the A/B scorers store observations under the same feature semantics.
//   SCHEMA_BUILD = implementation identity (never the census, never a filter)
//   hDataStatus  = which external sources actually CONTRIBUTED on that bar
//   hSchemaVer   = feature-definition equivalence for analog matching (drives the census)
int SCHEMA_BUILD = 2
int REGIME_FEATURE_VERSION = ((gcConfirmsBull or gcConfirmsBear) or (oiValid and oiConviction != 0)) ? 2 : 1
int barDataStatus = ((gcConfirmsBull or gcConfirmsBear) ? 1 : 0) + ((oiValid and oiConviction != 0) ? 2 : 0) + (US2Y_STATUS == 0 ? 4 : 0) + (COT_STATUS == 0 ? 8 : 0) + (GC_STATUS != 0 ? 16 : 0) + (OI_STATUS != 0 ? 32 : 0)
var int[] hSchemaVer = array.new_int(HIST_MAX, 1)
var int[] hDataStatus = array.new_int(HIST_MAX, 0)
var int migV2Count = 0
var int[] hRegime = array.new_int(HIST_MAX, 0)
var float[] hSess = array.new_float(HIST_MAX, 0.5)
var int hW = 0
var int hN = 0
var int rPrev = -1
var int rTCnt = 0
var int rRCnt = 0
var int rDCnt = 0
var int rTR = 0
var int rTD = 0
var int rRT = 0
var int rRD = 0
var int rDT = 0
var int rDR = 0
// Calibration drift tracking (EWMA fast vs slow)
var float _calDriftFast = 50.0
var float _calDriftSlow = 50.0
// Dashboard tables
var table tblA = na
var table tblPlan = na

// Regime: first-order Markov with duration tracking
int rCurr = strongTrend ? 0 : moderateTrend ? 1 : 2
if barstate.isconfirmed and rPrev >= 0
    if rPrev == 0
        rTCnt += 1
        if rCurr == 1
            rTR += 1
        else if rCurr == 2
            rTD += 1
    else if rPrev == 1
        rRCnt += 1
        if rCurr == 0
            rRT += 1
        else if rCurr == 2
            rRD += 1
    else if rPrev == 2
        rDCnt += 1
        if rCurr == 0
            rDT += 1
        else if rCurr == 1
            rDR += 1
rPrev := rCurr

float highOutcome = ta.highest(high, OUTCOME_N)
float lowOutcome = ta.lowest(low, OUTCOME_N)
if not perfMode and barstate.isconfirmed and bar_index > OUTCOME_N * 3 + 50 and showStatsEngine
    int cA = adxVal > 25 ? 2 : adxVal > 15 ? 1 : 0
    int cT = atrPercentile >= 70 ? 2 : atrPercentile >= 30 ? 1 : 0
    int cH = htfBullScoreGate ? 2 : htfBearScoreGate ? 0 : 1
    int cS = bullTrend ? 2 : bearTrend ? 0 : 1
    int cL = 1
    if not na(poolPdH) and not na(poolPdL)
        cL := close > poolPdH ? 2 : close < poolPdL ? 0 : 1
    int cM = mrComposite <= -30 ? 2 : mrComposite >= 30 ? 0 : 1
    int cC = avgCorrHealth >= 60 ? 2 : avgCorrHealth >= 40 ? 1 : 0
    array.set(hBi, hW, bar_index)
    array.set(hZone, hW, obBullActive or (fvgActive and fvgWasBullish) ? 1.0 : obBearActive or (fvgActive and not fvgWasBullish) ? 0.0 : 0.5)
    array.set(hAdx, hW, cA)
    array.set(hAtr, hW, cT)
    array.set(hHtf, hW, cH)
    array.set(hStr, hW, cS)
    array.set(hLiq, hW, cL)
    array.set(hMr, hW, cM)
    array.set(hCor, hW, cC)
    array.set(hPred, hW, bullScore)
    float _hBin = bullScore >= calQ80 ? 4.0 : bullScore >= calQ60 ? 3.0 : bullScore >= calQ40 ? 2.0 : bullScore >= calQ20 ? 1.0 : 0.0
    array.set(hCalBin, hW, _hBin)
    array.set(hBEv, hW, bullBOS ? 1 : bearBOS ? 2 : 0)
    array.set(hBCont, hW, -1.0)
    array.set(hRegime, hW, rCurr)
    // Exact V2 census maintained in O(1) as the ring buffer wraps. Reading the slot we are
    // about to overwrite tells us whether a V2 observation is being evicted, so the count
    // stays exact without rescanning HIST_MAX every bar. This is also what makes
    // hSchemaVer a CONSUMED array rather than write-only metadata — the version is used
    // for MEASUREMENT now, and remains available for FILTERING later without re-collecting
    // history, which is the sequencing the reviewer asked for.
    int _prevVer = array.get(hSchemaVer, hW)
    if _prevVer == 2 and REGIME_FEATURE_VERSION != 2
        migV2Count := math.max(migV2Count - 1, 0)
    if _prevVer != 2 and REGIME_FEATURE_VERSION == 2
        migV2Count := migV2Count + 1
    array.set(hSchemaVer, hW, REGIME_FEATURE_VERSION)
    array.set(hDataStatus, hW, barDataStatus)
    float _sessVal = inNY ? 1.0 : inLondon ? 0.67 : inAsian ? 0.33 : 0.0
    array.set(hSess, hW, _sessVal)
    int oP = (hW - OUTCOME_N + HIST_MAX) % HIST_MAX
    int oBi = array.get(hBi, oP)
    if oBi >= 0 and bar_index - oBi >= OUTCOME_N
        float fc = close - close[OUTCOME_N]
        float fh = highOutcome
        float fl = lowOutcome
        float fr = fh - fl
        if fr > 0
            // ═══ Q7.0: TRUE SL/TP RACE REPLACES THE TERMINAL-DRIFT LABEL ═══
            // The old label asked "was the forward CLOSE more than 0.5xATR away after
            // OUTCOME_N bars?" — a drift-proxy that measures neither the trade's real
            // geometry nor the ORDER of events. Kelly's p must be the win probability
            // of the bet actually placed, so a proxy event yields a biased f*.
            // ta.highest/ta.lowest give window extremes without ordering, which is why
            // this could not be reconstructed from the stored aggregates. It CAN be
            // recovered by scanning the window chronologically: [k] with k descending
            // from OUTCOME_N-1 to 0 walks forward in time from the entry bar.
            // Convention matches the live risk tracker: if both levels are touched
            // inside one bar, the STOP is assumed first (conservative).
            // R = 1.5 x ATR at entry — the strategy's nominal stop distance — so the
            // +1R target is TP1 and the label is literally "did TP1 beat the stop?".
            float _oEnt = close[OUTCOME_N]
            // CALIBRATION FIX (self-audit): the R unit was hardcoded 1.5 x ATR, but the
            // live plan's stop is regime-scaled: regSLMult spans ~0.99 ATR (COMPRESSION)
            // to ~2.20 ATR (ABNORMAL). So the win-rate label was measuring a 1.5-ATR
            // race while the strategy actually risks ~1.0 ATR in quiet markets and
            // ~2.2 ATR in volatile ones. Direction of the bias is regime-dependent:
            // in COMPRESSION the label used a stop ~50% WIDER than reality (overstating
            // the win rate, since a wider stop is hit less often); in ABNORMAL ~30%
            // TIGHTER (understating it). Kelly's p was therefore biased differently
            // depending on regime — precisely the "p must be the probability of the bet
            // actually placed" requirement. Now uses the SAME regime-scaled multiplier
            // the plan uses, sampled at the entry bar so it reflects the regime that was
            // live then, not the current one.
            float _oR = nz(adaptiveATR[OUTCOME_N]) * nz(regSLMult[OUTCOME_N], 1.5)
            // RUNTIME CAP (Q7.2): OUTCOME_N = max(3, 3600/tfSec), so it is 12 bars on
            // 5M but 3,600 on a 1-second chart — an unbounded scan would blow Pine's
            // per-bar execution limit on sub-minute timeframes. The scan is capped at
            // the FIRST 60 bars after entry, which is chronologically where a first
            // touch occurs if it occurs at all; the label therefore reads "did TP1
            // beat the stop within 60 bars (or the full window, whichever is shorter)".
            int _oScan = math.max(OUTCOME_N - 60, 0)
            int _oRes = 0
            if _oR > 0
                for _k = OUTCOME_N - 1 to _oScan
                    if _oRes == 0
                        _oRes := low[_k] <= _oEnt - _oR ? -1 : high[_k] >= _oEnt + _oR ? 1 : 0
            array.set(hOut, oP, _oRes)
            // Realised R: +/-1 when the race resolved, otherwise the unresolved
            // terminal excursion in R units. avgW/avgL therefore become genuine
            // R-multiples, so Kelly's b is the real payoff ratio rather than a
            // drift ratio.
            array.set(hRet, oP, _oRes != 0 ? float(_oRes) : (_oR > 0 ? fc / _oR : 0.0))
            array.set(hRUnit, oP, _oR)
            int be = array.get(hBEv, oP)
            if be == 1
                array.set(hBCont, oP, fc > 0 ? 1.0 : 0.0)
            else if be == 2
                array.set(hBCont, oP, fc < 0 ? 1.0 : 0.0)
            float pdu = poolPdH[OUTCOME_N]
            float pdl = poolPdL[OUTCOME_N]
            if not na(pdu) and not na(pdl)
                int fh_ = 0
                for j = OUTCOME_N - 1 to 1
                    if fh_ == 0 and high[j] >= pdu
                        fh_ := 1
                    if fh_ == 0 and low[j] <= pdl
                        fh_ := 2
                    if fh_ != 0
                        break
                array.set(h1st, oP, fh_)
    hW := (hW + 1) % HIST_MAX
    if hN < HIST_MAX
        hN := hN + 1


// ----- Schema migration tracking (D-012) ---------------------------------------
// Turns "wait roughly 31 days" into an OBSERVABLE number. The reviewer's protocol needs a
// MIXED_SCHEMA vs SCHEMA_V2 distinction and a migration completion point; without a
// measurement that is a guess. Counting stored observations by version gives both.
// MIGRATION_START is stamped the first time a V2 observation is written, so the clock
// starts from actual data, not from when someone remembered to note the date.
var int migStartTime = na
if barstate.isconfirmed and REGIME_FEATURE_VERSION == 2 and na(migStartTime)
    migStartTime := time
// Percentage of the rolling buffer now written under V2. 100% = migration complete and
// SCHEMA_V2 becomes the valid evaluation population; below that the analog statistics are
// MIXED_SCHEMA and must not be used to judge whether the new layers helped.
float migPct = hN > 0 ? math.min(migV2Count * 100.0 / math.min(hN, HIST_MAX), 100.0) : 0.0
string migState = REGIME_FEATURE_VERSION == 1 ? "" : migPct >= 99.5 ? "  SCHEMA_V2" : "  MIXED_SCHEMA " + str.tostring(int(migPct)) + "%"
float oBull = 50.0
float oBear = 50.0
float oRange = 0.0
int oMatch = 0
int oPdh1stPct = na
int oPdl1stPct = na
int oCalGrade = 0
string oCalDetail = ""
float oRegPer = 50.0
float oBosCont = 50.0
// Q5.0-S2: Platt fit [slope per score-unit, intercept] — written by the calibration
// block inside the stats engine, consumed by the mP= mapping. na until fit qualifies.
var float[] gCalFit = array.from(float(na), float(na))
float oWr = 50.0
float oAvgW = 0.5
float oAvgL = 1.0
float oBosFail = 50.0
float oMaxAdverseATR = na
float oMaxDD = 0.0
int oOosN = 0
float oOosWr = 50.0
float oAvgWOos = 0.5
float oAvgLOos = 1.0

// ── Historical Analog Stats Engine ─────────────────────────────────────
// Chunked processing with persistent var accumulators (3-phase: SYNC / PROCESS / STORE).
runStatsEngines() =>
    var int _rdBar = 0
    var float _cBull = 50.0
    var float _cBear = 50.0
    var float _cRange = 0.0
    var int _cMatch = 0
    var int _cPdh1stPct = na
    var int _cPdl1stPct = na
    var float _cEvVal = 0.0
    var int _cEvLabel = na
    var float _cWr = 50.0
    var float _cAvgW = 0.5
    var float _cAvgL = 1.0
    var int _cCalGradePct = 0
    var string _cCalGrade = "N/A"
    var float _cCalBrier = na
    var string _cCalDetail = ""
    var float _cBosCont = 50.0
    var float _cBosFail = 50.0
    var float _cRegPer = 50.0
    var float _cFeatStr = na
    var float _cFeatHtf = na
    var float _cFeatLiq = na
    var float _cFeatMr = na
    var float _cFeatCor = na
    var float _cProfitFactor = na
    var float _cMaxAdverseATR = na
    var float _cMaxDD = 0.0
    var float _cOosWr = 50.0
    var int _cOosN = 0
    var float _cIsWr = 50.0
    var int _cIsN = 0
    var float _cAvgWOos = 0.5
    var float _cAvgLOos = 1.0
    // ---- Rolling window accumulators (persistent across chunks) ----
    var int _rsp = 0
    // CHANGE ID: F-009 — WEIGHTED ANALOG ACCUMULATORS, parallel to the integer counters.
    // The int counters are DELIBERATELY KEPT: they remain the sample size, the display
    // A-count and every gate. Only the OUTCOME RATIOS move to the weighted sums. Folding
    // the weights into the int counters instead would have silently (a) changed L3430's
    // integer division, (b) turned "mt >= 3" from 3 matches into weight-total 3 (~5
    // matches at typical sim), and (c) broken the A<n> readout and its !LOW-under-30 rule.
    // NOTE: a Kish effective-N readout ((sum w)^2 / sum w^2) was scoped here and
    // deliberately DROPPED — the Master is at ~99% of the Pine token ceiling and it was an
    // enhancement, not one of the five defects. Accumulating sum(w^2) without displaying it
    // would have left exactly the kind of half-wired orphan this project has been removing.
    var float _gWb = 0.0
    var float _gWbr = 0.0
    var float _gWr_ = 0.0
    var float _gWt = 0.0
    var float _gWp1 = 0.0
    var float _gWpT = 0.0
    var int _gMb = 0
    var int _gMbr = 0
    var int _gMr_ = 0
    var int _gMt = 0
    var int _gP1 = 0
    var int _gP2 = 0
    var int _gPT = 0
    var float _gSw = 0.0
    var float _gSl = 0.0
    var float _gSt = 0.0
    var int _gWc = 0
    var int _gLc = 0
    var int _gBov = 0
    var int _gBof = 0
    var int _gBoT = 0
    var float _gMaeSum = 0.0
    var int _gMaeCnt = 0
    var int _gC0t = 0
    var int _gC0b = 0
    var float _gC0s = 0.0
    var int _gC1t = 0
    var int _gC1b = 0
    var float _gC1s = 0.0
    var int _gC2t = 0
    var int _gC2b = 0
    var float _gC2s = 0.0
    var int _gC3t = 0
    var int _gC3b = 0
    var float _gC3s = 0.0
    var int _gC4t = 0
    var int _gC4b = 0
    var float _gC4s = 0.0
    var int _gFSc = 0
    var int _gFSw = 0
    var int _gFSt = 0
    var int _gFHc = 0
    var int _gFHw = 0
    var int _gFHt = 0
    var int _gFLc = 0
    var int _gFLw = 0
    var int _gFLt = 0
    var int _gFMc = 0
    var int _gFMw = 0
    var int _gFMt = 0
    var int _gFCc = 0
    var int _gFCw = 0
    var int _gFCt = 0
    var int _gOosMb = 0
    var int _gOosMbr = 0
    var int _gOosMt = 0
    var float _gSwOos = 0.0
    var float _gSlOos = 0.0
    var int _gWcOos = 0
    var int _gLcOos = 0
    var int _gIsMb = 0
    var int _gIsMbr = 0
    var int _gIsMt = 0
    // R5.3-M1: equity is now a notional account in PERCENT starting at 100 — each match
    // contributes riskPercent * |ATR-move| / 1.5 (the trade plan's 1.5-ATR unit risk),
    // so MaxDD% is a real account-drawdown estimate on the same scale as maxDdPct.
    // Previously equity started at 0 in raw ATR units, making %-of-peak DD
    // scale-arbitrary and hypersensitive to the first small peak — while still gating
    // live signals via useDDBreaker.
    var float _gCumEq = 100.0
    var float _gEqPeak = 100.0
    var float _gMaxDD = 0.0
    // Q5.2-F3: MFE/MAE hit counters [L1R,L2R,L3R,LSL, S1R,S2R,S3R,SSL, N]
    var float[] _gHit = array.new<float>(9, 0.0)
    // Q5.0-S3: lag-1 autocorrelation accumulators (chronological match returns)
    // Persistent bar_index bounds for holdout fold (full-cycle, not per-chunk)
    var float _sbMin = 1e12
    var float _sbMax = -1e12
    var int _cec = -1
    _cec := _cec + 1
    var int _lastGuardBar = -1
    int _rb = chartTFSeconds <= 180 ? 2 : chartTFSeconds <= 900 ? 4 : chartTFSeconds <= 3600 ? 8 : 12
    bool _guard = showStatsEngine and hN > OUTCOME_N * 2 and (_cec % _rb == 0) and barstate.isconfirmed and bar_index != _lastGuardBar
    // Reset/decay accumulators at start of a new scan
    if _rsp == 0 and _guard
        _gWb := 0.0
        _gWbr := 0.0
        _gWr_ := 0.0
        _gWt := 0.0
        _gWp1 := 0.0
        _gWpT := 0.0
        _gMb := 0
        _gMbr := 0
        _gMr_ := 0
        _gMt := 0
        _gP1 := 0
        _gP2 := 0
        _gPT := 0
        _gSw := 0.0
        _gSl := 0.0
        _gSt := 0.0
        _gWc := 0
        _gLc := 0
        _gBov := 0
        _gBof := 0
        _gBoT := 0
        _gMaeSum := 0.0
        _gMaeCnt := 0
        _gC0t := int(_gC0t * 0.7)
        _gC0b := int(_gC0b * 0.7)
        _gC0s := _gC0s * 0.7
        _gC1t := int(_gC1t * 0.7)
        _gC1b := int(_gC1b * 0.7)
        _gC1s := _gC1s * 0.7
        _gC2t := int(_gC2t * 0.7)
        _gC2b := int(_gC2b * 0.7)
        _gC2s := _gC2s * 0.7
        _gC3t := int(_gC3t * 0.7)
        _gC3b := int(_gC3b * 0.7)
        _gC3s := _gC3s * 0.7
        _gC4t := int(_gC4t * 0.7)
        _gC4b := int(_gC4b * 0.7)
        _gC4s := _gC4s * 0.7
        _gFSc := 0
        _gFSw := 0
        _gFSt := 0
        _gFHc := 0
        _gFHw := 0
        _gFHt := 0
        _gFLc := 0
        _gFLw := 0
        _gFLt := 0
        _gFMc := 0
        _gFMw := 0
        _gFMt := 0
        _gFCc := 0
        _gFCw := 0
        _gFCt := 0
        _gOosMb := 0
        _gOosMbr := 0
        _gOosMt := 0
        _gSwOos := 0.0
        _gSlOos := 0.0
        _gWcOos := 0
        _gLcOos := 0
        _gIsMb := 0
        _gIsMbr := 0
        _gIsMt := 0
        _gCumEq := 100.0
        _gEqPeak := 100.0
        _gMaxDD := 0.0
        array.fill(_gHit, 0.0)
        // Pre-compute bounds from FULL buffer before any chunk processing
        // (prevents within-cycle OOS boundary drift)
        _sbMin := 1e12
        _sbMax := -1e12
        int _fullLen = math.min(hN, HIST_MAX)
        for _bi = 0 to _fullLen - 1
            float _bv = array.get(hBi, _bi)
            if _bv >= 0
                if _bv < _sbMin
                    _sbMin := _bv
                if _bv > _sbMax
                    _sbMax := _bv
    // Sync local accumulators from persistent (resume where we left off)
    float wb = _gWb
    float wbr = _gWbr
    float wr_ = _gWr_
    float wt = _gWt
    float wp1 = _gWp1
    float wpT = _gWpT
    int mb = _gMb
    int mbr = _gMbr
    int mr_ = _gMr_
    int mt = _gMt
    int p1 = _gP1
    int p2 = _gP2
    int pT = _gPT
    float sw = _gSw
    float sl = _gSl
    float st = _gSt
    int wc = _gWc
    int lc = _gLc
    int bov = _gBov
    int bof = _gBof
    int boT = _gBoT
    float maeSum = _gMaeSum
    int maeCnt = _gMaeCnt
    int c0t = _gC0t
    int c0b = _gC0b
    float c0s = _gC0s
    int c1t = _gC1t
    int c1b = _gC1b
    float c1s = _gC1s
    int c2t = _gC2t
    int c2b = _gC2b
    float c2s = _gC2s
    int c3t = _gC3t
    int c3b = _gC3b
    float c3s = _gC3s
    int c4t = _gC4t
    int c4b = _gC4b
    float c4s = _gC4s
    int fSc = _gFSc
    int fSw = _gFSw
    int fSt = _gFSt
    int fHc = _gFHc
    int fHw = _gFHw
    int fHt = _gFHt
    int fLc = _gFLc
    int fLw = _gFLw
    int fLt = _gFLt
    int fMc = _gFMc
    int fMw = _gFMw
    int fMt = _gFMt
    int fCc = _gFCc
    int fCw = _gFCw
    int fCt = _gFCt
    int oosMb = _gOosMb
    int oosMbr = _gOosMbr
    int oosMt = _gOosMt
    float swOos = _gSwOos
    float slOos = _gSlOos
    int wcOos = _gWcOos
    int lcOos = _gLcOos
    int isMb = _gIsMb
    int isMbr = _gIsMbr
    int isMt = _gIsMt
    float _cumEq = _gCumEq
    float _eqPeak = _gEqPeak
    float _maxDD = _gMaxDD
    int _slm = math.min(hN, HIST_MAX)
    // Rolling window: process only a chunk to avoid timeout
    int _cs = _slm <= 300 ? _slm : _slm <= 800 ? 300 : _slm <= 2000 ? 250 : 200
    if _rsp >= _slm
        _rsp := 0
    // Current state normalization (computed every bar for ta.stdev consistency)
    float currAdxNorm = adxVal > adxThreshold ? 1.0 : adxVal > 15 ? 0.5 : 0.0
    float currZone = obBullActive or (fvgActive and fvgWasBullish) ? 1.0 : obBearActive or (fvgActive and not fvgWasBullish) ? 0.0 : 0.5
    float currAtrNorm = atrPercentile / 100.0
    float currHtfNorm = htfBullScoreGate ? 1.0 : htfBearScoreGate ? 0.0 : 0.5
    float currStruct = structScore / 100.0
    float currLiqPos = not na(poolPdH) and not na(poolPdL) and poolPdH != poolPdL ? (close - poolPdL) / (poolPdH - poolPdL) : 0.5
    float currMrNorm = math.max(0.0, math.min(1.0, (mrComposite + 100.0) / 200.0))
    float currCorrNorm = math.max(0.0, math.min(1.0, avgCorrHealth / 100.0))
    float currSessNorm = inNY ? 1.0 : inLondon ? 0.67 : inAsian ? 0.33 : 0.0
    float currRegNorm = rCurr == 0 ? 1.0 : rCurr == 1 ? 0.5 : 0.0
    // Global stdev (unconditional to avoid Pine warning)
    float _stdAdx = ta.stdev(currAdxNorm, 100)
    float _stdAtr = ta.stdev(currAtrNorm, 100)
    float _stdHtf = ta.stdev(currHtfNorm, 100)
    float _stdStr = ta.stdev(currStruct, 100)
    float _stdLiq = ta.stdev(currLiqPos, 100)
    float _stdMr = ta.stdev(currMrNorm, 100)
    float _stdCor = ta.stdev(currCorrNorm, 100)
    float _stdSess = ta.stdev(currSessNorm, 100)
    float _stdReg = ta.stdev(currRegNorm, 100)
    if _guard
        // Adaptive similarity threshold (0-100 scale): tightened with ample data, loosened in high vol
        int _dataAdj = hN > 300 ? 5 : hN > 150 ? 0 : -5
        int _volAdj = volRegime > 70 ? 5 : 0
        int _simThresh = math.min(65, math.max(35, 45 + _dataAdj + _volAdj))
        // Q6.9 (plan item 1): weights are now 1/SIGMA, not 1/SIGMA^2.
        // These weights multiply ABSOLUTE feature differences |d| in the similarity
        // sum. Mahalanobis weights SQUARED differences by 1/sigma^2; the standardised
        // form for absolute differences is |d|/sigma (a z-distance). Pairing |d| with
        // 1/sigma^2 was dimensionally inconsistent — numerator in feature units,
        // denominator in feature units squared — and over-weighted low-variance
        // features QUADRATICALLY rather than linearly. The floor moves with it:
        // 0.0025 was a floor on sigma^2, so the equivalent floor on sigma is 0.05.
        float _ivAdx = 1.0 / math.max(_stdAdx, 0.05)
        float _ivAtr = 1.0 / math.max(_stdAtr, 0.05)
        float _ivHtf = 1.0 / math.max(_stdHtf, 0.05)
        float _ivStr = 1.0 / math.max(_stdStr, 0.05)
        float _ivLiq = 1.0 / math.max(_stdLiq, 0.05)
        float _ivMr = 1.0 / math.max(_stdMr, 0.05)
        float _ivCor = 1.0 / math.max(_stdCor, 0.05)
        float _ivSess = 1.0 / math.max(_stdSess, 0.05)
        float _ivReg = 1.0 / math.max(_stdReg, 0.05)
        float _ivSum = _ivAdx + _ivAtr + _ivHtf + _ivStr + _ivLiq + _ivMr + _ivCor + _ivSess + _ivReg
        // Normalized adaptive weights, clamped by user-input max bounds
        float wAdx_ = math.min(_ivAdx / _ivSum * 100.0, histWAdx)
        float wAtr_ = math.min(_ivAtr / _ivSum * 100.0, histWAtr)
        float wHtf_ = math.min(_ivHtf / _ivSum * 100.0, histWHtf)
        float wStr_ = math.min(_ivStr / _ivSum * 100.0, histWStr)
        float wLiq_ = math.min(_ivLiq / _ivSum * 100.0, histWLiq)
        float wMr_ = math.min(_ivMr / _ivSum * 100.0, histWMr)
        float wCor_ = math.min(_ivCor / _ivSum * 100.0, histWCor)
        float wSess_ = math.min(_ivSess / _ivSum * 100.0, histWSess)
        float wReg_ = math.min(_ivReg / _ivSum * 100.0, histWReg)
        float _wNorm = wAdx_ + wAtr_ + wHtf_ + wStr_ + wLiq_ + wMr_ + wCor_ + wSess_ + wReg_
        if _wNorm > 0
            wAdx_ /= _wNorm / 100.0
            wAtr_ /= _wNorm / 100.0
            wHtf_ /= _wNorm / 100.0
            wStr_ /= _wNorm / 100.0
            wLiq_ /= _wNorm / 100.0
            wMr_ /= _wNorm / 100.0
            wCor_ /= _wNorm / 100.0
            wSess_ /= _wNorm / 100.0
            wReg_ /= _wNorm / 100.0
        // Q5.2-F2: zone feature carries a fixed 8% weight; the adaptive nine rescale to 92.
        float wZone_ = 8.0
        wAdx_ *= 0.92
        wAtr_ *= 0.92
        wHtf_ *= 0.92
        wStr_ *= 0.92
        wLiq_ *= 0.92
        wMr_ *= 0.92
        wCor_ *= 0.92
        wSess_ *= 0.92
        wReg_ *= 0.92
        int _endBound = math.min(_rsp + _cs - 1, _slm - 1)
        int _chkEnd = _endBound
        float _sbRng = math.max(1, _sbMax - _sbMin)
        // R5.3-M6: iterate the ring buffer in CHRONOLOGICAL order. Once the buffer wraps,
        // slot order != time order, which scrambled the equity/MaxDD sequence across
        // chunks. _p is the chronological position; i maps it to the physical slot
        // (oldest record sits at hW when the buffer is full). With chunks advancing _rsp
        // monotonically, the whole cycle is now time-ordered, so equity accumulates
        // inline below and the per-chunk sort stage is removed.
        for _p = _rsp to _chkEnd
            int i = hN >= HIST_MAX ? (hW + _p) % HIST_MAX : _p
            int sb = array.get(hBi, i)
            if sb < 0 or bar_index - sb < OUTCOME_N
                continue
            // Q7.2: hRet is now realised R (Q7.0), so resolved races are exactly +/-1
            // and this guard only ever catches an unresolved terminal excursion beyond
            // 3R — far rarer than when hRet was in ATR units. Kept as a tail guard.
            if math.abs(array.get(hRet, i)) > 3.0
                continue
            // CHANGE ID: P3B-CAL-OOS-FIX | Phase 3B finding: the calibration bins
            // (c0-c4, feeding BOTH the Platt fit and the calibration accuracy grade)
            // and the analog hit-probability histogram (_gHit, feeding the trade
            // plan's "~X%+-Y" credible intervals) pooled IS+OOS matches together —
            // unlike the win-rate accumulators a few lines below, which already
            // correctly separate via _isOos. That means the calibration GRADE was
            // being validated on the same data used to fit it (train=test), which
            // overstates how well-calibrated the probabilities actually are on
            // genuinely unseen data. Computed early here (duplicating the later
            // per-match _isOos, which still gates win-rate accounting) so it is
            // available before the calibration/hit-probability blocks run.
            // F-037 (P0): _sbMin/_sbMax are recomputed each cycle from the ROLLING buffer,
            // so this boundary SLIDES -- today's "OOS" row becomes tomorrow's training row.
            // This is a rolling diagnostic estimate, NOT independent out-of-sample validation.
            // The historical window is ALSO contaminated by development: Quantum 5.x
            // parameters were selected against this instrument's history. A genuine final
            // holdout needs data collected AFTER a parameter freeze. Calculation UNCHANGED.
            float _oosPctEarly = 1.0 - holdoutRatio
            bool _isOosEarly = _sbRng > 0 and (sb - _sbMin) / _sbRng >= _oosPctEarly and (sb - _sbMin) - _oosPctEarly * _sbRng >= OUTCOME_N
            // Cosine similarity on weighted 9-dim vector (7 orig + session + regime)
            float barDist_ = math.max(1, bar_index - sb)
            // CHANGE ID: F-010 + F-015 — CORRECT FIX, and not the one first attempted.
            // The real defect was never "which source" but "what happens on FAILURE".
            // nz(x[barDist_], x) fell back to the CURRENT value, which drives
            // |current - historical| to ZERO — so an analog with MISSING data scored as
            // PERFECTLY SIMILAR on that dimension. The failure mode was biased toward
            // MORE matching, across the whole feature vector.
            // The first attempt swapped in hAdx/hAtr; those hold CATEGORICAL codes
            // (0|1|2), not raw values, which made adxNormI a constant 0.0 and collapsed
            // atrNormI to 0.00-0.02 — worse than the bug. Reverted.
            // This fix needs no new arrays: if any lookback for THIS analog is
            // unavailable, the analog is SKIPPED rather than scored on substituted data.
            // A missing observation should not vote at all — it certainly should not vote
            // "identical". Covers all seven affected dimensions (adx, atr, htf, struct,
            // liq, mr, corr) in one guard, so F-010 and F-015 close together.
            // GUARD covers only the dimensions with NO recorded fallback. For those, a
            // failed lookback means the analog cannot be scored honestly, so it is SKIPPED
            // — a missing observation must not vote, and must never vote "identical",
            // which is what the old nz(x[barDist_], x) current-value fallback made it do.
            if na(ema200[barDist_]) or na(structScore[barDist_]) or na(mrComposite[barDist_]) or na(avgCorrHealth[barDist_]) or na(close[barDist_])
                continue
            // ADX / ATR DO have a recorded fallback, so they degrade instead of discarding.
            // hAdx stores cA = adxVal>25?2:adxVal>15?1:0, and adxNormI is >25?1.0:>15?0.5:0.0
            // — so cA/2.0 reproduces adxNormI EXACTLY, with zero information lost.
            // hAtr stores cT by the 30/70 percentile buckets; their midpoints (0.15/0.50/
            // 0.85) are coarser than the continuous percentile but UNBIASED, unlike
            // substituting the current value which forced the distance to zero.
            // Net effect: strictly more analogs retained than a blanket skip, with no bias.
            float _aN = na(adxVal[barDist_]) ? na : adxVal[barDist_]
            float adxNormI = na(_aN) ? array.get(hAdx, i) / 2.0 : (_aN > adxThreshold ? 1.0 : _aN > 15 ? 0.5 : 0.0)
            float zoneI = array.get(hZone, i)
            float _aPN = na(atrPercentile[barDist_]) ? na : atrPercentile[barDist_]
            int _atrCat = array.get(hAtr, i)
            float atrNormI = na(_aPN) ? (_atrCat == 2 ? 0.85 : _atrCat == 1 ? 0.50 : 0.15) : _aPN / 100.0
            float _emaN = ema200[barDist_]
            float htfNormI = close[barDist_] > _emaN ? 1.0 : close[barDist_] < _emaN ? 0.0 : 0.5
            float _sN = structScore[barDist_]
            float structI = _sN / 100.0
            float liqPosI = not na(poolPdH[barDist_]) and not na(poolPdL[barDist_]) and poolPdH[barDist_] != poolPdL[barDist_] ? (close[barDist_] - poolPdL[barDist_]) / (poolPdH[barDist_] - poolPdL[barDist_]) : 0.5
            float _mN = mrComposite[barDist_]
            float mrNormI = math.max(0.0, math.min(1.0, (_mN + 100.0) / 200.0))
            float _cN = avgCorrHealth[barDist_]
            float corrNormI = math.max(0.0, math.min(1.0, _cN / 100.0))
            float sessNormI = array.get(hSess, i)
            int _rgI = array.get(hRegime, i)
            float regNormI = _rgI == 0 ? 1.0 : _rgI == 1 ? 0.5 : 0.0
            // R5.3-M2: cosine similarity on non-negative, non-centered features was ~0.95-1.0
            // for almost ANY pair of bars, so matching was effectively just the 0.997^dist
            // recency decay. Similarity is now 1 - weighted mean absolute difference
            // (weights sum to 100), which is 1.0 only for identical states and degrades
            // proportionally per differing feature. Time decay semantics unchanged; the
            // adaptive _simThresh (35-65) applies on the same 0-100 scale. Expect lower
            // match counts (oMatch/N) than R5.2 — that reflects real state filtering.
            float _wad = (wAdx_ * math.abs(currAdxNorm - adxNormI) + wAtr_ * math.abs(currAtrNorm - atrNormI) + wHtf_ * math.abs(currHtfNorm - htfNormI) + wStr_ * math.abs(currStruct - structI) + wLiq_ * math.abs(currLiqPos - liqPosI) + wMr_ * math.abs(currMrNorm - mrNormI) + wCor_ * math.abs(currCorrNorm - corrNormI) + wSess_ * math.abs(currSessNorm - sessNormI) + wReg_ * math.abs(currRegNorm - regNormI) + wZone_ * math.abs(currZone - zoneI)) / 100.0
            float _timeW = math.pow(0.997, barDist_)
            // Q5.2-F1: hard gate on STATE similarity alone (+ minMatchQ floor); recency
            // is a floor cut (~1000 bars) and a weight on match quality, not a gate mixer.
            float _simState = 1.0 - math.min(math.max(_wad, 0.0), 1.0)
            if na(_simState) or _simState * 100.0 < math.max(_simThresh, minMatchQ) or _timeW < 0.05
                continue
            float sim = _simState * _timeW
            // R5-F1 CRITICAL FIX: cosine similarity is bounded [0,1]; _simThresh is on a
            // 0-100 scale. The unscaled comparison (sim < _simThresh) was ALWAYS true,
            // so the analog engine never matched a single bar and every downstream stat
            // (EV, WR, OOS, Kelly, calibration, blend, DD breaker) ran on defaults.
            // F-009: `sim` (state similarity x recency) was computed here and NEVER READ,
            // so every surviving analog voted equally — a 0.36-similarity 900-bar-old state
            // counted exactly as much as a 0.99-similarity recent one, despite the comment
            // above claiming recency acts as a weight. Now accumulated in parallel: counts
            // for N/display/gates, weights for the ratios.
            int oc = array.get(hOut, i)
            if oc == 1
                mb += 1
                mt += 1
                wb += sim
                wt += sim
            else if oc == -1
                mbr += 1
                mt += 1
                wbr += sim
                wt += sim
            else if oc == 0
                mr_ += 1
                mt += 1
                wr_ += sim
                wt += sim
            int fh_ = array.get(h1st, i)
            if fh_ == 1
                p1 += 1
                pT += 1
                wp1 += sim
                wpT += sim
            float fr = array.get(hRet, i)
            // Cost-adjusted return: subtract round-trip cost from raw return
            // R5-F15: cost (ATR units) = [(spread + 2 x slippage) + commission/pointValue] / ATR at match bar
            // R5.3-L3: lookback cap raised 2000 -> 4999 (max_bars_back is 5000; HIST_MAX
            // reaches 4500, so older matches were silently priced at CURRENT ATR).
            // F-A10 FIX, PART 1 -- UNITS. The old form divided cost by adaptiveATR, giving cost
            // in ATR units, and subtracted it from fr = hRet, which Q7.0 redefined as realised R.
            // Those are different units whenever the SL multiple is not 1.0 (regSLMult defaults
            // 1.5), so every cost-adjusted win and loss was mis-scaled. Cost is now divided by
            // the analog's OWN R unit -- the risk distance in points it was normalised by --
            // which puts _costR on exactly the same scale as fr, avgW and avgL.
            float _costPts = (_sessSpread + 2.0 * slippagePts) + commissionL / math.max(pointValue, 1.0)
            float _rUnit   = array.get(hRUnit, i)
            float _costR   = _rUnit > 0 ? _costPts / _rUnit : 0.0
            // CHANGE ID: D-001 — a timed-out trade is still ENTERED and EXITED and still
            // pays spread + commission, but oc == 0 was charged nothing. That made analog
            // expectancy optimistic by one full round trip exactly in chop/compression/
            // low-ADX regimes, which is where the negative-expectancy veto should bind
            // F-A10 CORRECTION: that last sentence WAS NOT TRUE OF THE CODE. The subtraction
            // below does run for every analog, but for oc == 0 the result is then DISCARDED:
            // absFrAdj is read only inside the `oc == 1` / `oc == -1` branches, and _pnlPct is
            // 0.0 on the timeout branch. Meanwhile mt/wt DO count timeouts, so a timed-out
            // analog enters the EV denominator contributing exactly zero instead of the round
            // trip it really paid. Analog EV therefore remains OPTIMISTIC by the cost of every
            // timeout -- the D-001 defect is still live, and this comment previously hid that.
            // NOT changed here: charging it correctly means expressing _costATR (ATR units) in
            // R units per analog, and avgW/avgL are R-multiples -- mixing them silently would
            // be worse than the known bias. oEvVal is DISPLAY-ONLY (dashboard EV cell; the
            // gating quantity is planExpectancy, which is different), so nothing is gated on
            // this meanwhile. See F-A10 in audit/FINDINGS_TRACEABILITY.md for the two options.
            // EXPECT trade count to FALL and chop expectancy to drop — that is the
            // correction working, not a regression.
            float frAdj = fr - _costR
            float absFrAdj = math.abs(frAdj)
            if oc == 1
                wc += 1
                sw += absFrAdj
                int barOff = bar_index - sb
                // R5.3-L3: forward window of the entry ends at sb+OUTCOME_N -> offset barOff-OUTCOME_N (was +1)
                float forwardLo = lowOutcome[math.max(barOff - OUTCOME_N, 0)]
                float worstDown = math.max(close[barOff] - forwardLo, 0.0)
                maeSum += adaptiveATR > 0 ? worstDown / adaptiveATR : 0.0
                maeCnt += 1
            else if oc == -1
                lc += 1
                sl += absFrAdj
                int barOff = bar_index - sb
                float forwardHi = highOutcome[math.max(barOff - OUTCOME_N, 0)]
                float worstUp = math.max(forwardHi - close[barOff], 0.0)
                maeSum += adaptiveATR > 0 ? worstUp / adaptiveATR : 0.0
                maeCnt += 1
            else
                // F-A10 FIX, PART 2 -- THE TIMEOUT IS NO LONGER FREE. A timed-out analog is
                // still entered and exited and still pays the round trip, and hRet already
                // holds its terminal excursion in R, so its cost-adjusted return is a real
                // number -- it was simply never accumulated. SIGNED, not abs: a timeout can
                // end either side of entry, and forcing a magnitude here would fabricate a
                // loss. mr_/wr_ already carry the timeout RATE, so only the sum was missing.
                st += frAdj
            // R5.3-M1/M6: equity accumulates inline (matches now arrive in chronological
            // order). Notional %-account: each match risks riskPercent over a 1.5-ATR
            // unit, cost-adjusted via frAdj (per-match ATR). Convention unchanged from
            // the old block: bullish outcome = +, i.e. the curve tracks a long-bias
            // strategy over state-matched bars.
            // F-A10 FIX, PART 3. The timeout branch of this ternary was 0.0, which reproduced
            // the same defect in the equity curve that it did in EV: a timed-out match moved
            // _cumEq not at all, cost included. Now it contributes its signed cost-adjusted
            // return like any other. NOTE this feeds _maxDD -> oMaxDD -> _ddForBreaker, so it
            // can move the drawdown breaker when useDDBreaker is ON (it defaults OFF).
            float _pnlPct = oc == 1 ? riskPercent * math.abs(frAdj) / 1.5 : oc == -1 ? -riskPercent * math.abs(frAdj) / 1.5 : riskPercent * frAdj / 1.5
            _cumEq := _cumEq + _pnlPct
            if _cumEq > _eqPeak
                _eqPeak := _cumEq
            float _ddNow = _eqPeak > 0 ? (_eqPeak - _cumEq) / _eqPeak * 100.0 : 0.0
            if _ddNow > _maxDD
                _maxDD := _ddNow
            // Q5.2-F3: forward-excursion hit accounting in 1.5-ATR R-units (per match).
            int _bOffH = bar_index - sb
            float _fHh = highOutcome[math.max(_bOffH - OUTCOME_N, 0)]
            float _fLl = lowOutcome[math.max(_bOffH - OUTCOME_N, 0)]
            float _entC = close[_bOffH]
            // Q5.7: historical ATR clamped to [0.2x, 5x] the CURRENT ATR before forming the
            // R unit. Unclamped, a low historical ATR made ordinary moves score 30R+, which
            // saturated P(>=1R/2R/3R) toward 100% and disabled the negative-expectancy veto.
            float _rU = 1.5 * math.min(math.max(nz(adaptiveATR[math.min(barDist_, 4999)], adaptiveATR), adaptiveATR * 0.2), adaptiveATR * 5.0)
            // P3B-CAL-OOS-FIX: added "and _isOosEarly" — the hit-probability histogram
            // (feeding the trade plan's "~X%+-Y" credible intervals) previously pooled
            // IS+OOS matches; now OOS-only, consistent with the win-rate accumulators.
            if _rU > 0 and not na(_fHh) and not na(_fLl) and not na(_entC) and _isOosEarly
                array.set(_gHit, 8, array.get(_gHit, 8) + 1.0)
                float _mfeL = (_fHh - _entC) / _rU
                float _maeL = (_entC - _fLl) / _rU
                if _mfeL >= 1.0
                    array.set(_gHit, 0, array.get(_gHit, 0) + 1.0)
                if _mfeL >= 2.0
                    array.set(_gHit, 1, array.get(_gHit, 1) + 1.0)
                if _mfeL >= 3.0
                    array.set(_gHit, 2, array.get(_gHit, 2) + 1.0)
                if _maeL >= 1.0
                    array.set(_gHit, 3, array.get(_gHit, 3) + 1.0)
                if _maeL >= 1.0
                    array.set(_gHit, 4, array.get(_gHit, 4) + 1.0)
                if _maeL >= 2.0
                    array.set(_gHit, 5, array.get(_gHit, 5) + 1.0)
                if _maeL >= 3.0
                    array.set(_gHit, 6, array.get(_gHit, 6) + 1.0)
                if _mfeL >= 1.0
                    array.set(_gHit, 7, array.get(_gHit, 7) + 1.0)
            float _oosPct = 1.0 - holdoutRatio
            // Q5.0-S4: embargo — outcome windows straddling the fold boundary are excluded.
            bool _isOos = _sbRng > 0 and (sb - _sbMin) / _sbRng >= _oosPct and (sb - _sbMin) - _oosPct * _sbRng >= OUTCOME_N
            if _isOos
                oosMt += 1
                if oc == 1
                    oosMb += 1
                    wcOos += 1
                    swOos += absFrAdj
                else if oc == -1
                    oosMbr += 1
                    lcOos += 1
                    slOos += absFrAdj
            else
                isMt += 1
                if oc == 1
                    isMb += 1
                else if oc == -1
                    isMbr += 1
            int be = array.get(hBEv, i)
            if be > 0
                boT += 1
                float bC = array.get(hBCont, i)
                if bC > 0.5
                    bov += 1
                else if bC >= 0.0
                    bof += 1
            float pp = array.get(hPred, i)
            float _calBin = array.get(hCalBin, i)
            // CHANGE ID: P3B-CAL-OOS-FIX (continued): calibration bins now gated
            // to OOS-only matches, mirroring the win-rate accumulators' existing
            // separation. Fit and grade no longer share the same sample.
            if _isOosEarly
                if _calBin == 4.0 or (_calBin < 0 and pp >= calQ80)
                    c4t += 1
                    c4s += pp
                    if oc == 1
                        c4b += 1
                else if _calBin == 3.0 or (_calBin < 0 and pp >= calQ60)
                    c3t += 1
                    c3s += pp
                    if oc == 1
                        c3b += 1
                else if _calBin == 2.0 or (_calBin < 0 and pp >= calQ40)
                    c2t += 1
                    c2s += pp
                    if oc == 1
                        c2b += 1
                else if _calBin == 1.0 or (_calBin < 0 and pp >= calQ20)
                    c1t += 1
                    c1s += pp
                    if oc == 1
                        c1b += 1
                else
                    c0t += 1
                    c0s += pp
                    if oc == 1
                        c0b += 1
            // Per-regime outcome tracking for regime-conditioned calibration
            int _rgi = array.get(hRegime, i)
            if _rgi >= 0 and _rgi <= 2
                array.set(_regTot, _rgi, array.get(_regTot, _rgi) + 1)
                if oc == 1
                    array.set(_regWin, _rgi, array.get(_regWin, _rgi) + 1)
            // Decay regime accumulators every 100 matches (~8 hours on 5M)
            _rdBar += 1
            if _rdBar >= 100
                _rdBar := 0
                for _rd = 0 to 2
                    array.set(_regTot, _rd, int(array.get(_regTot, _rd) * 0.5))
                    array.set(_regWin, _rd, int(array.get(_regWin, _rd) * 0.5))
            int fStr = array.get(hStr, i)
            if fStr == 2
                fSt += 1
                if oc == 1
                    fSc += 1
                else if oc == -1
                    fSw += 1
            else if fStr == 0
                fSt += 1
                if oc == -1
                    fSc += 1
                else if oc == 1
                    fSw += 1
            int fHtf = array.get(hHtf, i)
            if fHtf == 2
                fHt += 1
                if oc == 1
                    fHc += 1
                else if oc == -1
                    fHw += 1
            else if fHtf == 0
                fHt += 1
                if oc == -1
                    fHc += 1
                else if oc == 1
                    fHw += 1
            int fLiq = array.get(hLiq, i)
            if fLiq == 2
                fLt += 1
                if oc == 1
                    fLc += 1
                else if oc == -1
                    fLw += 1
            else if fLiq == 0
                fLt += 1
                if oc == -1
                    fLc += 1
                else if oc == 1
                    fLw += 1
            int fMr = array.get(hMr, i)
            if fMr == 2
                fMt += 1
                if oc == 1
                    fMc += 1
                else if oc == -1
                    fMw += 1
            else if fMr == 0
                fMt += 1
                if oc == -1
                    fMc += 1
                else if oc == 1
                    fMw += 1
            int fCor = array.get(hCor, i)
            if fCor == 2
                fCt += 1
                if oc == 1
                    fCc += 1
                else if oc == -1
                    fCw += 1
            else if fCor == 0
                fCt += 1
                if oc == -1
                    fCc += 1
                else if oc == 1
                    fCw += 1
        // R5.3-M6: per-chunk sort stage removed — equity now accumulates inline in true
        // chronological order (see the ring-buffer remap at the top of the scan loop).
        // Persist chunk accumulators and advance scan position
        _gWb := wb
        _gWbr := wbr
        _gWr_ := wr_
        _gWt := wt
        _gWp1 := wp1
        _gWpT := wpT
        _gMb := mb
        _gMbr := mbr
        _gMr_ := mr_
        _gMt := mt
        _gP1 := p1
        _gP2 := p2
        _gPT := pT
        _gSw := sw
        _gSl := sl
        _gSt := st
        _gWc := wc
        _gLc := lc
        _gBov := bov
        _gBof := bof
        _gBoT := boT
        _gMaeSum := maeSum
        _gMaeCnt := maeCnt
        _gC0t := c0t
        _gC0b := c0b
        _gC0s := c0s
        _gC1t := c1t
        _gC1b := c1b
        _gC1s := c1s
        _gC2t := c2t
        _gC2b := c2b
        _gC2s := c2s
        _gC3t := c3t
        _gC3b := c3b
        _gC3s := c3s
        _gC4t := c4t
        _gC4b := c4b
        _gC4s := c4s
        _gFSc := fSc
        _gFSw := fSw
        _gFSt := fSt
        _gFHc := fHc
        _gFHw := fHw
        _gFHt := fHt
        _gFLc := fLc
        _gFLw := fLw
        _gFLt := fLt
        _gFMc := fMc
        _gFMw := fMw
        _gFMt := fMt
        _gFCc := fCc
        _gFCw := fCw
        _gFCt := fCt
        _gOosMb := oosMb
        _gOosMbr := oosMbr
        _gOosMt := oosMt
        _gSwOos := swOos
        _gSlOos := slOos
        _gWcOos := wcOos
        _gLcOos := lcOos
        _gIsMb := isMb
        _gIsMbr := isMbr
        _gIsMt := isMt
        _gCumEq := _cumEq
        _gEqPeak := _eqPeak
        _gMaxDD := _maxDD
        _rsp := _rsp + _cs
        if _rsp >= _slm
            _rsp := 0
        _lastGuardBar := bar_index
    if not showStatsEngine or hN <= OUTCOME_N * 2
        [50.0, 50.0, 0.0, 0, int(na), int(na), 0.0, int(na), 50.0, 0.5, 1.0, 0, "N/A", float(na), "", 50.0, 50.0, 50.0, float(na), float(na), float(na), float(na), float(na), float(na), float(na), 0.0, 50.0, 0, 50.0, 0, 0.5, 1.0]
    else if not barstate.isconfirmed or (timeframe.in_seconds() < 300) or not (_cec % _rb == 0) or _rsp > 0
        [_cBull, _cBear, _cRange, _cMatch, _cPdh1stPct, _cPdl1stPct, _cEvVal, _cEvLabel, _cWr, _cAvgW, _cAvgL, _cCalGradePct, _cCalGrade, _cCalBrier, _cCalDetail, _cBosCont, _cBosFail, _cRegPer, _cFeatStr, _cFeatHtf, _cFeatLiq, _cFeatMr, _cFeatCor, _cProfitFactor, _cMaxAdverseATR, _cMaxDD, _cOosWr, _cOosN, _cIsWr, _cIsN, _cAvgWOos, _cAvgLOos]
    else
        // F-009: RATIOS now use the weighted sums (wb/wt); GATES and the displayed
        // A-count deliberately still use the raw integer counts, so "mt >= 3" still means
        // three real matches, L3430's integer division is untouched, and A<n> still
        // reports observations rather than a weight total. `wt > 0` guards the div — on a
        // degenerate all-zero-weight scan it falls back to the unweighted ratio.
        if mt >= 3
            _cBull := math.round((wt > 0 ? wb / wt : mb * 1.0 / mt) * 100.0)
            _cBear := math.round((wt > 0 ? wbr / wt : mbr * 1.0 / mt) * 100.0)
            _cRange := 100.0 - _cBull - _cBear
            if _cRange < 0
                _cRange := 0.0
                float ratio = wt > 0 ? wb / wt : (mt > 0 ? mb * 1.0 / mt : 0.5)
                _cBull := math.max(_cBull - math.abs(_cRange) * ratio, 5.0)
                _cBear := 100.0 - _cBull
            _cMatch := mt
        if pT >= 3
            _cPdh1stPct := int(math.round((wpT > 0 ? wp1 / wpT : p1 * 1.0 / pT) * 100.0))
            _cPdl1stPct := 100 - _cPdh1stPct
        if mt / math.max(OUTCOME_N, 1) >= 10  // Q6.8: EFFECTIVE N, was raw mt >= 5 (~1 independent obs) and (wc > 0 or lc > 0)
            float wr = wt > 0 ? wb / wt : mb * 1.0 / mt
            float lr = wt > 0 ? wbr / wt : mbr * 1.0 / mt
            float avgW = wc > 0 ? sw / wc : 0.5
            float avgL = lc > 0 ? sl / lc : 1.0
            // Units (Q6.5 fix, restated after Q7.0): avgW/avgL derive from hRet.
            // Q6.5 removed a second division by adaptiveATR when hRet was ATR-normalised
            // (fc / adaptiveATR); Q7.0 then redefined hRet as REALISED R (+/-1 when the
            // SL/TP race resolves, terminal excursion in R otherwise). EV is therefore a
            // true R-multiple per trade — the standard unit — and the +/-0.3 thresholds
            // below now read as +/-0.3R, which is what they were always meant to mean.
            // F-A10 FIX, PART 4. Timeouts were in the DENOMINATOR (wt/mt count them) but
            // contributed nothing to the numerator, so EV was optimistic by their whole cost.
            // tr is their weighted rate, avgT their mean signed cost-adjusted R. Added, not
            // subtracted, because avgT already carries its own sign -- unlike avgW/avgL, which
            // are magnitudes with the sign written into the formula. The three terms now
            // partition every analog, so EV is a true expected R per matched state.
            float tr   = wt > 0 ? wr_ / wt : (mt > 0 ? mr_ * 1.0 / mt : 0.0)
            float avgT = mr_ > 0 ? st / mr_ : 0.0
            _cEvVal := (wr * avgW) - (lr * avgL) + (tr * avgT)
            _cEvLabel := _cEvVal > 0.3 ? 1 : _cEvVal < -0.3 ? -1 : 0
            _cWr := wr * 100.0
            _cAvgW := wc > 0 ? sw / wc : 0.5
            _cAvgL := lc > 0 ? sl / lc : 1.0
        float calBrier = 0.0
        int calBins = 0
        float calErr = 0.0
        if c0t >= 30
            float a0 = bayesRate(c0b, c0t)
            float p0 = c0s / c0t / 100.0
            calErr += math.abs(a0 * 100.0 - p0 * 100.0)
            calBins += 1
            calBrier += (a0 - p0) * (a0 - p0) * c0t
        if c1t >= 30
            float a1 = bayesRate(c1b, c1t)
            float p1c = c1s / c1t / 100.0
            calErr += math.abs(a1 * 100.0 - p1c * 100.0)
            calBins += 1
            calBrier += (a1 - p1c) * (a1 - p1c) * c1t
        if c2t >= 30
            float a2 = bayesRate(c2b, c2t)
            float p2c = c2s / c2t / 100.0
            calErr += math.abs(a2 * 100.0 - p2c * 100.0)
            calBins += 1
            calBrier += (a2 - p2c) * (a2 - p2c) * c2t
        if c3t >= 30
            float a3 = bayesRate(c3b, c3t)
            float p3 = c3s / c3t / 100.0
            calErr += math.abs(a3 * 100.0 - p3 * 100.0)
            calBins += 1
            calBrier += (a3 - p3) * (a3 - p3) * c3t
        if c4t >= 30
            float a4 = bayesRate(c4b, c4t)
            float p4 = c4s / c4t / 100.0
            calErr += math.abs(a4 * 100.0 - p4 * 100.0)
            calBins += 1
            calBrier += (a4 - p4) * (a4 - p4) * c4t
        if calBins > 0
            float ae = calErr / calBins
            _cCalGradePct := int(math.max(0, 100.0 - ae * 2.0))
            _cCalGrade := _cCalGradePct >= 90 ? "Excellent" : _cCalGradePct >= 75 ? "Good" : _cCalGradePct >= 50 ? "Fair" : "Poor"
            // Q5.0-S2: Platt-style WLS fit — logit(realized freq) on mean bin score
            // offset, weighted by bin count; needs >=3 qualifying bins and positive slope.
            float _pfSw = 0.0
            float _pfSx = 0.0
            float _pfSy = 0.0
            float _pfSxx = 0.0
            float _pfSxy = 0.0
            int _pfBins = 0
            float[] _pfCt = array.from(1.0 * c0t, 1.0 * c1t, 1.0 * c2t, 1.0 * c3t, 1.0 * c4t)
            float[] _pfPs = array.from(1.0 * c0s, 1.0 * c1s, 1.0 * c2s, 1.0 * c3s, 1.0 * c4s)
            float[] _pfBw = array.from(1.0 * c0b, 1.0 * c1b, 1.0 * c2b, 1.0 * c3b, 1.0 * c4b)
            for _pf = 0 to 4
                float _ctF = array.get(_pfCt, _pf)
                if _ctF >= 30
                    float _xm = array.get(_pfPs, _pf) / _ctF - 50.0
                    float _arF = math.min(math.max(bayesRate(int(array.get(_pfBw, _pf)), int(_ctF)), 0.05), 0.95)
                    float _ym = math.log(_arF / (1.0 - _arF))
                    _pfSw += _ctF
                    _pfSx += _ctF * _xm
                    _pfSy += _ctF * _ym
                    _pfSxx += _ctF * _xm * _xm
                    _pfSxy += _ctF * _xm * _ym
                    _pfBins += 1
            if _pfBins >= 3 and _pfSw > 0
                float _pfMx = _pfSx / _pfSw
                float _pfMy = _pfSy / _pfSw
                float _pfVr = _pfSxx / _pfSw - _pfMx * _pfMx
                if _pfVr > 1e-6
                    float _pfK = (_pfSxy / _pfSw - _pfMx * _pfMy) / _pfVr
                    if _pfK > 0
                        array.set(gCalFit, 0, math.min(math.max(_pfK, 0.02), 0.25))
                        array.set(gCalFit, 1, math.min(math.max(_pfMy - _pfK * _pfMx, -1.0), 1.0))
            float _totalCal = c0t + c1t + c2t + c3t + c4t
            // Brier decomposition (Murphy): BS = Uncertainty + Reliability - Resolution
            float _totalBull = c0b + c1b + c2b + c3b + c4b
            float _baseRate = _totalCal > 0 ? _totalBull / _totalCal : 0.5
            float _rel = 0.0
            float _res = 0.0
            if c0t >= 30
                float p0_ = c0s / c0t / 100.0
                float o0_ = bayesRate(c0b, c0t)
                _rel += c0t * (p0_ - o0_) * (p0_ - o0_)
                _res += c0t * (o0_ - _baseRate) * (o0_ - _baseRate)
            if c1t >= 30
                float p1_ = c1s / c1t / 100.0
                float o1_ = bayesRate(c1b, c1t)
                _rel += c1t * (p1_ - o1_) * (p1_ - o1_)
                _res += c1t * (o1_ - _baseRate) * (o1_ - _baseRate)
            if c2t >= 30
                float p2_ = c2s / c2t / 100.0
                float o2_ = bayesRate(c2b, c2t)
                _rel += c2t * (p2_ - o2_) * (p2_ - o2_)
                _res += c2t * (o2_ - _baseRate) * (o2_ - _baseRate)
            if c3t >= 30
                float p3_ = c3s / c3t / 100.0
                float o3_ = bayesRate(c3b, c3t)
                _rel += c3t * (p3_ - o3_) * (p3_ - o3_)
                _res += c3t * (o3_ - _baseRate) * (o3_ - _baseRate)
            if c4t >= 30
                float p4_ = c4s / c4t / 100.0
                float o4_ = bayesRate(c4b, c4t)
                _rel += c4t * (p4_ - o4_) * (p4_ - o4_)
                _res += c4t * (o4_ - _baseRate) * (o4_ - _baseRate)
            _rel /= _totalCal
            _res /= _totalCal
            float _unc = _baseRate * (1.0 - _baseRate)
            _cCalBrier := _totalCal > 0 ? math.round((_unc + _rel - _res) * 1000.0) / 1000.0 : na
            string calDetail = ""
            if c3t >= 30
                float a3r = math.round(bayesRate(c3b, c3t) * 100.0)
                calDetail := "P" + str.tostring(int(c3s / c3t)) + ">" + str.tostring(int(a3r)) + "%"
            else if c2t >= 30
                float a2r = math.round(bayesRate(c2b, c2t) * 100.0)
                calDetail := "P" + str.tostring(int(c2s / c2t)) + ">" + str.tostring(int(a2r)) + "%"
            else if c4t >= 30
                float a4r = math.round(bayesRate(c4b, c4t) * 100.0)
                calDetail := "P" + str.tostring(int(c4s / c4t)) + ">" + str.tostring(int(a4r)) + "%"
            else if c1t >= 30
                float a1r = math.round(bayesRate(c1b, c1t) * 100.0)
                calDetail := "P" + str.tostring(int(c1s / c1t)) + ">" + str.tostring(int(a1r)) + "%"
            else if c0t >= 30
                float a0r = math.round(bayesRate(c0b, c0t) * 100.0)
                calDetail := "P" + str.tostring(int(c0s / c0t)) + ">" + str.tostring(int(a0r)) + "%"
            _cCalDetail := calDetail
        if boT >= 3
            _cBosCont := math.round(bov * 100.0 / boT)
            _cBosFail := 100 - _cBosCont
        if rCurr == 0 and rTCnt > 0
            _cRegPer := math.round((rTCnt - rTR - rTD) * 100.0 / rTCnt)
        else if rCurr == 1 and rRCnt > 0
            _cRegPer := math.round((rRCnt - rRT - rRD) * 100.0 / rRCnt)
        else if rCurr == 2 and rDCnt > 0
            _cRegPer := math.round((rDCnt - rDT - rDR) * 100.0 / rDCnt)
        float _baseDirAcc = 0.50
        if fSt > 0
            _cFeatStr := (fSc * 1.0 / fSt - _baseDirAcc) * 100.0
        if fHt > 0
            _cFeatHtf := (fHc * 1.0 / fHt - _baseDirAcc) * 100.0
        if fLt > 0
            _cFeatLiq := (fLc * 1.0 / fLt - _baseDirAcc) * 100.0
        if fMt > 0
            _cFeatMr := (fMc * 1.0 / fMt - _baseDirAcc) * 100.0
        if fCt > 0
            _cFeatCor := (fCc * 1.0 / fCt - _baseDirAcc) * 100.0
        if mt >= 5 and sl > 0 and lc > 0 and wc > 0
            float avgW = sw / wc
            float avgL = sl / lc
            _cProfitFactor := (wc * avgW) / (lc * avgL)
        if maeCnt > 0
            _cMaxAdverseATR := maeSum / maeCnt
        // Q5.2-F3: publish per-direction hit probabilities (N>=20).
        float _hNQ = array.get(_gHit, 8)
        if _hNQ >= 20
            for _hi = 0 to 7
                array.set(gHitProb, _hi, array.get(_gHit, _hi) / _hNQ * 100.0)
            array.set(gHitN, 0, _hNQ)
        // R5.3: MaxDD stored BEFORE the Sharpe/Calmar block — Calmar previously divided
        // by the PREVIOUS cycle's MaxDD.
        if _eqPeak > 0
            _cMaxDD := math.round(_maxDD * 10.0) / 10.0
        // Q6.5 (audit M1-F4/F5): the Sharpe / Sortino / Calmar block was removed —
        // its outputs (__sh/__so/__ca) were destructured but never read anywhere, so it
        // was dead compute. Calmar had also scaled the numerator by sqrt(N) (a
        // volatility factor, not a return-aggregation factor) and divided ATR-unit
        // returns by a percentage drawdown. Equity-curve and MaxDD tracking are
        // retained above: oMaxDD still feeds the drawdown breaker.
        if oosMt > 0
            float _oosWr = oosMb * 100.0 / oosMt
            _cOosWr := math.round(_oosWr)
            _cOosN := oosMt
            _cAvgWOos := wcOos > 0 ? swOos / wcOos : 0.5
            _cAvgLOos := lcOos > 0 ? slOos / lcOos : 1.0
        if isMt > 0
            float _isWr = isMb * 100.0 / isMt
            _cIsWr := math.round(_isWr)
            _cIsN := isMt
        [_cBull, _cBear, _cRange, _cMatch, _cPdh1stPct, _cPdl1stPct, _cEvVal, _cEvLabel, _cWr, _cAvgW, _cAvgL, _cCalGradePct, _cCalGrade, _cCalBrier, _cCalDetail, _cBosCont, _cBosFail, _cRegPer, _cFeatStr, _cFeatHtf, _cFeatLiq, _cFeatMr, _cFeatCor, _cProfitFactor, _cMaxAdverseATR, _cMaxDD, _cOosWr, _cOosN, _cIsWr, _cIsN, _cAvgWOos, _cAvgLOos]

[__b, __be, __r, __m, __p1, __p2, __ev, __el, __wr, __aw, __al, __cp, __cg, __cb, __cd, __bc, __bf, __rp, __fs, __fh, __fl, __fm, __fc, __pf, __ma, __md, __ow, __on, __iw, __in, __awo, __alo] = runStatsEngines()

// Quantile-based calibration bin edges — after engine call so historical scan uses prior bins
var int _qcec = -1
_qcec := _qcec + 1
if showStatsEngine and hN >= 50 and (_qcec % 10 == 0) and barstate.isconfirmed
    float[] _tmpQ = array.new<float>()
    for _qi = 0 to hN - 1
        array.push(_tmpQ, array.get(hPred, _qi))
    array.sort(_tmpQ)
    float _p20 = array.get(_tmpQ, int(hN * 0.20))
    float _p40 = array.get(_tmpQ, int(hN * 0.40))
    float _p60 = array.get(_tmpQ, int(hN * 0.60))
    float _p80 = array.get(_tmpQ, int(hN * 0.80))
    if _p20 < _p40 - 1.0 and _p40 < _p60 - 1.0 and _p60 < _p80 - 1.0
        calQ20 := _p20
        calQ40 := _p40
        calQ60 := _p60
        calQ80 := _p80

oBull := __b
oBear := __be
oRange := __r
oMatch := __m
oPdh1stPct := __p1
oPdl1stPct := __p2
oWr := __wr
oAvgW := __aw
oAvgL := __al
oCalGrade := __cp
oCalDetail := __cd
oBosCont := __bc
oBosFail := __bf
oRegPer := __rp
oMaxAdverseATR := __ma
oMaxDD := __md
oOosWr := __ow
// F-036: oOosN was CONSUMED by oOosNeff BEFORE `oOosN := __on` assigned it. As a non-var
// global it reinitialises to 0 each bar, so oOosNeff was permanently 0 no matter what the
// engine returned -- pinning _statsWarm false. Assign first, then derive. Kept identical
// to the Master: the A/B scorers must not diverge in feature semantics.
oOosN := __on
// Q5.0-S1: 95% half-width of the OOS win rate at EFFECTIVE (overlap-corrected) N.
// Q6.9 (plan item 3): effective sample size for every count-based gate below.
// Kelly already used this correction; the display and drift gates did not.
int oOosNeff = int(oOosN / math.max(OUTCOME_N, 1))
oAvgWOos := __awo
oAvgLOos := __alo
// R5-F4: update the persistent DD mirror used by the signal-gate breaker.
_ddForBreaker := nz(oMaxDD, 0.0)

// Calibration drift tracking (EWMA fast vs slow)
if showStatsEngine and oOosNeff >= 10
    _calDriftFast := 0.7 * _calDriftFast + 0.3 * oCalGrade
    _calDriftSlow := 0.95 * _calDriftSlow + 0.05 * oCalGrade
bool calDrift = showStatsEngine and oOosNeff >= 10 and _calDriftFast < _calDriftSlow - 10
bool useRawScores = calDrift

// Normalize scores to sum 100% preserving bull/bear/range ratio
// Note: outputs are ordinal scores, not calibrated probabilities
normalizeScores(float b, float be, float r, float minFloor) =>
    float nb = math.min(b, 95.0)
    float nbe = math.min(be, 95.0)
    float nr = math.max(r, 0.0)
    float _total = nb + nbe + nr
    if _total > 100.0
        float _rB = nb / _total
        float _rBe = nbe / _total
        nb := math.min(math.max(math.round(100.0 * _rB), minFloor), 95.0)
        nbe := math.min(math.max(math.round(100.0 * _rBe), minFloor), 95.0)
        nr := math.max(100.0 - nb - nbe, 0.0)
    else
        nb := math.max(nb, minFloor)
        nbe := math.max(nbe, minFloor)
        _total := nb + nbe + nr
        if _total > 100.0
            float _excess = _total - 100.0
            if nr >= _excess
                nr := nr - _excess
            else
                _excess -= nr
                nr := 0.0
                float _bRat = nb / math.max(nb + nbe, 1.0)
                float _beAdj = math.min(math.round(_excess * (1.0 - _bRat)), nbe)
                nb := nb - math.min(math.round(_excess * _bRat), nb)
                nbe := nbe - _beAdj
        else
            nr := math.max(100.0 - nb - nbe, 0.0)
    // Preserve range floor when range evidence was provided
    if r > 0 and nr < minFloor
        float _deficit = minFloor - nr
        float _bShare = math.round(_deficit * nb / math.max(nb + nbe, 1.0))
        nb := nb - _bShare
        nbe := nbe - (_deficit - _bShare)
        nr := minFloor
    if nr < 0
        nr := 0.0
    [nb, nbe, nr]

// Blend live evidence scores with historical analogs (70/30 blend preserves live sensitivity)
// Ratio 70/30 is heuristic — acts as weak shrinkage toward historical mean.
if showStatsEngine and oOosNeff >= 10
    float blendHist = 0.30
    bullScore := bullScore * (1.0 - blendHist) + oBull * blendHist
    bearScore := bearScore * (1.0 - blendHist) + oBear * blendHist
    float rangeHist = na(oRange) ? rangeScore : oRange
    rangeScore := rangeHist

// Stationarity/regime warning for advanced stats display

// FORECAST ENGINE (Module 12)
float fBullScore = 50.0
float fBearScore = 50.0
float fRngScore = 0.0
float fAdj = 0.0
// 1) Historical Analog — best available source
if showStatsEngine and oOosNeff >= 10
    fBullScore := bullScore
    fBearScore := bearScore
    fRngScore := 100.0 - fBullScore - fBearScore
    if fRngScore < 0
        fRngScore := 0.0
else
    fBullScore := bullScore
    fBearScore := bearScore
    fRngScore := rangeScore
int momBars = 0
// Momentum strength: consecutive bars x ADX (catches non-BOS trends)
momBars := 0
bool momUp = close > close[1]
bool momDn = close < close[1]
for momIdx = 1 to 5
    if momUp and close[momIdx] > close[momIdx+1]
        momBars += 1
    else if momDn and close[momIdx] < close[momIdx+1]
        momBars -= 1
    else
        break
float momScore = math.abs(momBars) * 10.0 + (adxVal > 25 ? 15.0 : adxVal > 20 ? 8.0 : 0.0)
// Single adaptive forecast adjustment (weights accumulated alongside score — no
// hardcoded denominator, so no systematic bias when components are unavailable).
// R5.3: oBosCont term REMOVED — it re-used the same historical DB already blended
// into bullScore above, so history entered the forecast twice (the design note that
// flagged this is now resolved). Momentum keeps its weight; liq/regime unchanged.
// Q5.2-F5: analog influence scales with OOS effective sample (0.20 base -> 0.30 cap).
float fMult = showStatsEngine ? math.min(oMatch / 300.0, 1.0) * (0.20 + 0.10 * math.min(oOosN / OUTCOME_N / 30.0, 1.0)) : 0.10
float fSig = bullTrend ? 1.0 : bearTrend ? -1.0 : 0.0
float fEvBase = 0.0
float fEvWeight = 0.0
if showStatsEngine and oOosNeff >= 10
    fEvBase += math.min(momScore * 100.0 / 75.0, 100.0) * 0.25
    fEvWeight += 0.25
if liqMaxScore > 0
    fEvBase += nz(liqReachScore, 50) * 0.20
    fEvWeight += 0.20
if showStatsEngine and oRegPer >= 30
    fEvBase += nz(oRegPer, 50) * 0.15
    fEvWeight += 0.15
if fEvWeight > 0
    fAdj := (fEvBase / fEvWeight - 50.0) * fMult * fSig
// Persistence filter: if adjustment flips sign within 3 bars, reduce magnitude by 50%
if fAdj * nz(fAdj[1]) < 0 or fAdj * nz(fAdj[2]) < 0
    fAdj := fAdj * 0.5
// Clamp [5,95]: prevents categorical certainty (0%/100%)
fBullScore := math.min(math.max(fBullScore + fAdj, 5.0), 95.0)
fBearScore := 100.0 - fBullScore - fRngScore
if fBearScore < 0
    fBearScore := 0.0
    fRngScore := 100.0 - fBullScore - fBearScore
    if fRngScore < 0
        fRngScore := 0.0
    float r = fBullScore / (fBullScore + fBearScore + 1)
    fBullScore := math.max(100.0 * r, 5.0)
    fBearScore := 100.0 - fBullScore
// Write forecast engine output to display scores
bullScore := fBullScore
bearScore := fBearScore
rangeScore := fRngScore
// Single-pass normalization — ensures sum=100 with min 1% floor on bull/bear
[nb2_, nbe2_, nr2_] = normalizeScores(bullScore, bearScore, rangeScore, 1.0)
bullScore := nb2_
bearScore := nbe2_
rangeScore := nr2_
// R5.3-M3: calibration now tracks the FINAL displayed bullScore. The record written
// earlier this bar stored the pre-blend evidence score, so the Cal grade / Brier /
// mP= sigmoid were validating a variable the user never sees. The slot is overwritten
// here, after the blend + forecast pipeline. (The historical scan only reads records
// >= OUTCOME_N bars old, so updating the newest slot is safe. Note this makes the
// 70/30 analog blend mildly self-referential — accepted in exchange for calibrating
// the number actually shown and traded on.)
if not perfMode and barstate.isconfirmed and bar_index > OUTCOME_N * 3 + 50 and showStatsEngine
    int _lastRec = (hW - 1 + HIST_MAX) % HIST_MAX
    if array.get(hBi, _lastRec) == bar_index
        array.set(hPred, _lastRec, bullScore)
        float _hBinFinal = bullScore >= calQ80 ? 4.0 : bullScore >= calQ60 ? 3.0 : bullScore >= calQ40 ? 2.0 : bullScore >= calQ20 ? 1.0 : 0.0
        array.set(hCalBin, _lastRec, _hBinFinal)

// Mapped probability: sigmoid when calibration is stable, raw scores when drifting.
// R5-F23: renamed "mP" — this is a heuristic sigmoid of the ordinal score scaled by
// calibration grade, NOT a fitted (Platt/isotonic) probability. The per-bin
// predicted-vs-actual data collected above is the right base for a proper fit later.
float _calibratedProb = bullScore / 100.0
string calProbStr = ""
if showStatsEngine and oMatch >= 30
    if useRawScores
        _calibratedProb := bullScore / 100.0
    else
        float _k = 8.0
        float _calP = bullScore / 100.0
        if oCalGrade >= 50
            _k := 8.0 + (oCalGrade - 50.0) / 50.0 * 12.0
        // Q5.0-S2: fitted map when available; heuristic slope (_k/100 per score-unit,
        // algebraically identical to the old form) as cold-start fallback.
        bool _pfOk = not na(array.get(gCalFit, 0))
        float _pfK2 = _pfOk ? array.get(gCalFit, 0) : _k / 100.0
        float _pfB2 = _pfOk ? array.get(gCalFit, 1) : 0.0
        _calP := 1.0 / (1.0 + math.exp(-((bullScore - 50.0) * _pfK2 + _pfB2)))
        _calP := math.min(math.max(_calP, 0.05), 0.95)
        if bearScore > bullScore and bearScore > rangeScore
            float _pBear = 1.0 / (1.0 + math.exp(-((bearScore - 50.0) * _pfK2 + _pfB2)))
            _calibratedProb := 1.0 - math.min(math.max(_pBear, 0.05), 0.95)
        else if rangeScore > bullScore and rangeScore > bearScore
            _calibratedProb := 0.5
        else
            _calibratedProb := _calP
        float _regT = array.get(_regTot, int(math.max(0, math.min(2, rCurr))))
        float _regW = array.get(_regWin, int(math.max(0, math.min(2, rCurr))))
        if _regT >= 20
            float _regRate = _regW / _regT
            float _overallRate = oWr / 100.0
            float _regAdj = _overallRate > 0 ? _regRate / _overallRate : 1.0
            _regAdj := math.min(math.max(_regAdj, 0.67), 1.5)
            _calibratedProb := 0.5 + (_calibratedProb - 0.5) * _regAdj
    calProbStr := "mP=" + str.tostring(math.round(_calibratedProb * 100.0)) + "%"

// V27 ENGINE 8: INSTITUTIONAL DASHBOARD — Titled metrics + breakdown
// Regime label with Volatile
f_tqEngine() =>
    // ═══════════════ R6.0 TRADE QUALITY SCORE ═══════════════
    // Direction-conditioned setup quality, 0-100, with DYNAMIC weights: each engine's
    // weight is included only when its data is available (analog weight also scales with
    // sample size), and the total is normalized by the active-weight sum — so missing
    // engines don't silently deflate or inflate the score. Below tqMinScore, BUY/SELL
    // displays as NO TRADE and alerts are suppressed. Disagreement is not averaged away:
    // each opposing engine drags its own contribution toward 0.
    float _tqSum = 0.0
    float _tqW = 0.0
    float _tqTrend = tpIsLong ? bullTrendScore : bearTrendScore
    // Q5.2-F6: regime-conditioned weights — trend matters more in trends, liquidity/session
    // more in ranges; the _tqW normalization keeps shifts consistent.
    float _twTrend = regStrongTrend or regExpansion ? 0.22 : not (regWeakTrend or regStrongTrend or regExpansion) ? 0.14 : 0.18
    _tqSum += math.min(_tqTrend, 100.0) * _twTrend
    _tqW += _twTrend
    _tqSum += math.min(structScore, 100.0) * 0.15
    _tqW += 0.15
    _tqSum += math.min(liqHealthScore, 100.0) * 0.10
    _tqW += 0.10
    // Q6.9 (plan item 13b): continuous in distance-to-zone rather than a 100/60/0
    // step. A directional order block still scores highest; an FVG scores mid; with
    // neither, the score decays with distance to the nearest zone edge instead of
    // dropping to zero, so 10% of TQ no longer vanishes discontinuously.
    float _zoneRef = (tpIsLong and obBullActive) ? obBullHigh : (not tpIsLong and obBearActive) ? obBearLow : fvgActive ? (fvgHighUpper + fvgLowLower) / 2.0 : na
    float _zoneDistATR = not na(_zoneRef) and adaptiveATR > 0 ? math.abs(close - _zoneRef) / adaptiveATR : na
    float _zoneBase = (tpIsLong and obBullActive) or (not tpIsLong and obBearActive) ? 100.0 : fvgActive ? 60.0 : 0.0
    float _tqZone = na(_zoneDistATR) ? 20.0 : math.max(_zoneBase * math.exp(-_zoneDistATR / 2.0), 20.0)
    _tqSum += _tqZone * 0.10
    _tqW += 0.10
    float _tqMacro = math.min(math.max(50.0 + (tpIsLong ? 1.0 : -1.0) * mtfConfluenceScore / 2.0, 0.0), 100.0)
    _tqSum += _tqMacro * 0.15
    _tqW += 0.15
    float _twSess = not (regWeakTrend or regStrongTrend or regExpansion or regAbnormal) ? 0.12 : 0.08
    _tqSum += math.min(sessionQuality, 100) * _twSess
    _tqW += _twSess
    float _tqRegime = regAbnormal ? 10.0 : regCompression ? 35.0 : regStrongTrend or regExpansion ? 85.0 : regWeakTrend ? 65.0 : 45.0
    _tqSum += _tqRegime * 0.09
    _tqW += 0.09
    bool _tqHasHist = oOosNeff >= 10
    bool _tqHasFc = not na(planExpectancy)
    if _tqHasHist
        float _tqHist = tpIsLong ? oOosWr : 100.0 - oOosWr
        float _tqHistW = 0.10 * math.min(oOosNeff / 50.0, 1.0)  // Q6.9: ramp on EFFECTIVE N
        _tqSum += _tqHist * _tqHistW
        _tqW += _tqHistW
    float _tqTiming = inKillzone ? 100.0 : inLondon or inNY ? 60.0 : 25.0
    _tqSum += _tqTiming * 0.05
    _tqW += 0.05
    // Q5.2-F4: forecast alignment — analog 1R expectancy in the plan's direction.
    if not na(planExpectancy)
        // Q6.9 (plan item 13a): tanh squash replaces hard clipping. The old form
        // saturated at +/-0.2R, so every expectancy beyond that scored identically.
        // Scale 0.75R sets the near-linear band; output stays within (0,100).
        // Q7.3 FIX: Pine v6 has NO math.tanh (verified against the whole math.*
        // namespace: abs/ceil/exp/floor/log/max/min/pow/round/sqrt/sum only).
        // Implemented directly: tanh(x) = (e^2x - 1) / (e^2x + 1), with the argument
        // clamped to +/-10 so math.exp cannot overflow. Same graceful saturation as
        // intended — near-linear near zero, asymptotic to +/-1.
        float _tqTx = math.min(math.max(planExpectancy / 0.75, -10.0), 10.0)
        float _tqE2 = math.exp(2.0 * _tqTx)
        float _tqFc = 50.0 + 50.0 * ((_tqE2 - 1.0) / (_tqE2 + 1.0))
        _tqSum += _tqFc * 0.10
        _tqW += 0.10
    int tradeQuality = _tqW > 0 ? int(math.round(math.min(math.max(_tqSum / _tqW, 0.0), 100.0))) : 50
    // "-H" = no OOS history component (oOosN < 10), "-F" = no analog expectancy.
    string tqBasis = (_tqHasHist ? "" : "-H") + (_tqHasFc ? "" : "-F")
    [tradeQuality, tqBasis]
[tradeQuality, tqBasis] = f_tqEngine()
f_auctionIntel() =>
    // ═══════════════ Q5.3 AUCTION INTELLIGENCE (A1-A7) ═══════════════
    // Value proxy = daily-anchored VWAP (labeled approximation — no exchange profile).
    var float prevDayValue = na
    if crossedNYDay
        prevDayValue := nz(vwapVal[1], vwapVal)
    float valueMigATR = not na(prevDayValue) and adaptiveATR > 0 ? (vwapVal - prevDayValue) / adaptiveATR : na
    string valueMigStr = na(valueMigATR) ? "VAL n/a" : valueMigATR > 0.8 ? "VAL⇈" : valueMigATR > 0.3 ? "VAL↑" : valueMigATR < -0.8 ? "VAL⇊" : valueMigATR < -0.3 ? "VAL↓" : "VAL="
    // A3 ACCEPTANCE: time on side of value + close location + volume + follow-through.
    bool aboveValue = close > vwapVal
    var int barsOnSide = 0
    barsOnSide := aboveValue == (nz(close[1], close) > nz(vwapVal[1], vwapVal)) ? math.min(barsOnSide + 1, 40) : 1
    float _closeLoc = high > low ? (close - low) / (high - low) : 0.5
    float _ftATR = adaptiveATR > 0 ? math.min(math.abs(close - nz(close[5], close)) / adaptiveATR, 2.0) : 0.0
    int acceptScore = int(math.min(math.min(barsOnSide, 40) * 1.0 + (relVol > 1.0 ? 20 : relVol > 0.7 ? 10 : 0) + (aboveValue ? _closeLoc : 1.0 - _closeLoc) * 20 + _ftATR * 10, 100))
    string acceptGrade = acceptScore >= 85 ? "A+" : acceptScore >= 70 ? "A" : acceptScore >= 55 ? "B" : acceptScore >= 40 ? "C" : "D"
    // A7 SWEEP QUALITY: graded at sweep event, persisted for display.
    var int lastSweepQ = 0
    var string lastSweepGrade = ""
    if (liqSweepBull or liqSweepBear) and barstate.isconfirmed
        float _pen = adaptiveATR > 0 ? math.min((liqSweepBull ? math.abs(low - close) : math.abs(high - close)) / adaptiveATR, 1.5) : 0.0
        float _revEff = high > low ? (liqSweepBull ? (close - low) / (high - low) : (high - close) / (high - low)) : 0.5
        lastSweepQ := int(math.min(_pen * 30 + volPercentile * 0.3 + _revEff * 30 + ((liqSweepBull and displacementUp) or (liqSweepBear and displacementDown) ? 10 : 0), 100))
        lastSweepGrade := lastSweepQ >= 80 ? "INST" : lastSweepQ >= 65 ? "STRONG" : lastSweepQ >= 50 ? "MOD" : "WEAK"
    // A5 PRICE DISCOVERY.
    float _valDistA = adaptiveATR > 0 ? math.abs(close - vwapVal) / adaptiveATR : 0.0
    float discScore = math.min(_valDistA * 25 + atrPercentile * 0.25 + math.min(adxVal, 40) * 1.0 + acceptScore * 0.25, 100)
// Q5.4: ta.highest hoisted out of the ternary (compiler consistency warning).
    float _discHi10 = ta.highest(discScore, 10)
    string discStr = discScore >= 70 and (regAbnormal or climaxUp or climaxDown) ? "DISC:EXH" : discScore >= 70 and acceptScore >= 60 ? "DISC:ACCPT" : discScore >= 70 ? "DISC:CONF" : discScore >= 50 ? "DISC:DEV" : discScore < 30 and _discHi10 >= 50 ? "DISC:FAIL" : discScore >= 30 ? "DISC:WEAK" : "ROTATION"
    // A1 AUCTION STATE: score all, pick dominant, probability = share of total.
    float stBal = (regCompression or (not regStrongTrend and not regExpansion and adxVal < adxThreshold) ? 50.0 : 0.0) + (_valDistA < 0.8 ? 30.0 : 0.0) + (atrPercentile <= 40 ? 20.0 : 0.0)
    float stTrendA = (regStrongTrend ? 45.0 : regWeakTrend ? 20.0 : 0.0) + acceptScore * 0.3 + (discScore >= 50 ? 25.0 : 0.0)
    float stRot = (rangeScore > math.max(bullScore, bearScore) ? 45.0 : 0.0) + (_valDistA < 1.0 ? 25.0 : 0.0) + (adxVal < adxThreshold ? 20.0 : 0.0)
    float stDisc = (regExpansion ? 40.0 : 0.0) + (_valDistA >= 1.0 ? 30.0 : 0.0) + (atrPercentile >= 60 ? 20.0 : 0.0)
    float stAcc = acceptScore >= 60 and _valDistA >= 0.8 ? 40.0 + acceptScore * 0.4 : 0.0
    float stRej = ((liqSweepBull or liqSweepBear) ? 50.0 : sesManip ? 30.0 : 0.0) + (lastSweepQ >= 65 and (liqSweepBull or liqSweepBear) ? 25.0 : 0.0)
    float stExh = (regAbnormal ? 40.0 : 0.0) + ((climaxUp or climaxDown) ? 35.0 : 0.0) + (atrPercentile >= 90 ? 15.0 : 0.0)
    // vdKQ = 50-bar volume delta in thousands (computed here from volDelta50, which is
    // defined earlier; the display-scope vdK alias is declared later in the file).
    float vdKQ = volDelta50 / 1000.0
    float stAD = stBal > 30 and math.abs(vdKQ) > 1.0 ? 35.0 + math.min(math.abs(vdKQ) * 5.0, 25.0) : 0.0
    float _stSum = stBal + stTrendA + stRot + stDisc + stAcc + stRej + stExh + stAD
    float _stMax = math.max(stBal, math.max(stTrendA, math.max(stRot, math.max(stDisc, math.max(stAcc, math.max(stRej, math.max(stExh, stAD)))))))
    string aucState = _stSum <= 0 ? "BALANCE" : _stMax == stRej ? (liqSweepBear or (sesManip and not liqSweepBull) ? "REJ-HI" : "REJ-LO") : _stMax == stExh ? "EXHAUST" : _stMax == stTrendA ? "TREND-AUC" : _stMax == stAcc ? (aboveValue ? "ACC-HI" : "ACC-LO") : _stMax == stDisc ? "DISCOVERY" : _stMax == stAD ? (vdKQ > 0 ? "ACCUM" : "DISTRIB") : _stMax == stRot ? "ROTATE" : "BALANCE"
    int aucProb = _stSum > 0 ? int(_stMax / _stSum * 100.0) : 0
    // A2 AUCTION CYCLE stage from dominant state + regime.
    string aucCycle = aucState == "BALANCE" or aucState == "ACCUM" or aucState == "DISTRIB" ? "①BAL" : aucState == "ROTATE" ? "②INIT" : aucState == "DISCOVERY" ? "③DISC" : aucState == "REJ-HI" or aucState == "REJ-LO" ? "④TEST" : aucState == "ACC-HI" or aucState == "ACC-LO" ? "⑤ACPT" : aucState == "TREND-AUC" ? "⑥TRND" : "⑦EXH"
    // A6 OPENING TYPE (live session geometry; needs >=3 session bars).
    // Q5.4: ta.barssince hoisted out of the ternary (compiler consistency warning).
    int _sessAge = nz(ta.barssince(sessId != nz(sessId[1], sessId)), 0)
    string openType = ""
    if not na(sesOpenPx) and not na(sesHi) and curSessId >= 0 and curSessId <= 2
        float _upX = sesHi - sesOpenPx
        float _dnX = sesOpenPx - sesLo
        float _rngX = math.max(sesHi - sesLo, syminfo.mintick)
        float _oneSide = math.max(_upX, _dnX) / _rngX
        bool _pastOpen = (close - sesOpenPx) * (_upX > _dnX ? 1 : -1) < 0
        bool _gapUp = not na(prevSesHi) and sesOpenPx > prevSesHi
        bool _gapDn = not na(prevSesLo) and sesOpenPx < prevSesLo
        bool _gapFilled = (_gapUp and low <= prevSesHi) or (_gapDn and high >= prevSesLo)
        openType := _gapUp or _gapDn ? (_gapFilled ? "GAP-FILL" : _oneSide >= 0.7 ? "GAP-DRV" : "O-AUC") : _rngX < adaptiveATR * 0.7 ? "O-NEU" : _rngX < adaptiveATR ? "O-AUC" : _oneSide >= 0.85 ? (_sessAge > 12 ? "DLY-DRV" : "O-DRV") : _oneSide >= 0.7 and _pastOpen ? "O-REJ" : _oneSide >= 0.7 ? "O-TDR" : "O-AUC"
    // B7 Market Personality (day type). Double-distribution excluded (needs profile splits).
    [aucState, aucProb, aucCycle, discStr, acceptScore, acceptGrade, valueMigStr, openType, lastSweepQ, lastSweepGrade]
[aucState, aucProb, aucCycle, discStr, acceptScore, acceptGrade, valueMigStr, openType, lastSweepQ, lastSweepGrade] = f_auctionIntel()
// B10 aucBias/auctionStr moved below tqVeto (declaration-order fix).
// ═══════════════ END AUCTION INTELLIGENCE ═══════════════
// Q5.2-F6: regime-adaptive TQ floor; Q5.2-F4: negative analog expectancy is a hard veto.
int effTqMin = tqMinScore == 0 ? 0 : math.min(math.max(tqMinScore + (regAbnormal ? 15 : regCompression ? 10 : regStrongTrend or regExpansion ? -5 : 0), 0), 90)
// COT CROWDING applied as a CONFIDENCE DAMPER, not a veto and not a direction. Crowded
// speculative positioning raises reversal risk, so it makes the quality floor STRICTER when
// a signal points the same way the crowd is already positioned. It never blocks a trade by
// itself and never generates one — a weekly, days-late series has no business doing either.
// +5 TQ points required when leaning with a crowded book; 0 otherwise, so with COT off
// (default) effTqMin is bit-identical to before this feature existed.
int _cotDamp = cotRegime == 0 ? 0 : (cotRegime == -1 and shouldBuy) or (cotRegime == 1 and shouldSell) ? 5 : 0
// ═══════════ F-A02 + F-A05 — CALIBRATED-PROBABILITY ENTRY GATE ═══════════
// WHAT THIS CLOSES. Two findings, one mechanism -- deliberately ONE gate, not two:
//   F-A02  the Platt/WLS calibration chain (bins -> gCalFit -> sigmoid -> _calibratedProb)
//          terminated in a dashboard string. No calibrated probability gated anything. The
//          only probability-shaped veto ran on tradeQuality (a weighted average of hand-set
//          constants) and on the sign of planExpectancy -- which is a difference of two
//          MARGINAL excursion frequencies, not an expected value (see F-035/F-038).
//   F-A05  bullScore -- where trend, structure, flow, macro and LIQUIDITY evidence all
//          converge -- reached no gate either. Entry was a conjunction of boolean flags.
// ONE GATE AND NOT TWO, AND WHY THAT MATTERS. _calibratedProb IS bullScore pushed through
// the fitted sigmoid, so it is MONOTONE in bullScore. A raw-score floor and a calibrated-
// probability floor are therefore the SAME gate expressed in different units; applying
// both would count one body of evidence twice -- the precise defect R5.3 removed when it
// took oBosCont out of fAdj. Gating on the calibrated value is strictly better: it is the
// one already in probability units, and the one the calibration machinery exists to make.
// WHERE IT IS APPLIED, AND WHY NOT ON shouldBuy. _calibratedProb is computed ~1850 lines
// BELOW shouldBuy and Pine requires declaration before use, so gating the entry expression
// itself would mean reordering the file -- far more dangerous than this. tqVeto is the veto
// every consumer already respects: the Master's alerts and DECISION cell, and execBuyS /
// execSellS in BOTH strategy twins -- so the A/B actually measures this change.
// THRESHOLD. 0.50 is the ONLY non-arbitrary default available: the natural decision
// boundary of a probability. Any other figure would be a number fitted to nothing.
// FAIL-OPEN, WHICH IS NOT OPTIONAL. The veto applies ONLY once a real Platt fit exists and
// the effective sample supports it. A cold or unfitted engine must never block every trade:
// without _calGateReady a fresh chart would sit at NO TRADE indefinitely and look broken.
// While not ready this term is inert and behaviour is byte-for-byte as before.
// VALIDITY -- STATED PLAINLY, AND NOT RESOLVED BY THIS CHANGE. F-037 still stands: the
// IS/OOS boundary SLIDES and the window is development-contaminated, so how well this
// probability is calibrated is NOT ESTABLISHED. Wiring it makes the engine act on that
// statistic. That is a deliberate decision taken with the defect documented, not a
// validation of it. The honest fix for the underlying problem remains a frozen holdout.
float _calPLong  = _calibratedProb
float _calPShort = na(_calibratedProb) ? na : 1.0 - _calibratedProb
bool _calGateReady = useCalGate and not na(array.get(gCalFit, 0)) and oOosNeff >= 10 and not na(_calibratedProb)
bool _calVeto = _calGateReady and ((shouldBuy and _calPLong < calGateMinP) or (shouldSell and _calPShort < calGateMinP))
int effTqMinCot = math.min(effTqMin + _cotDamp, 95)
bool tqVeto = (effTqMinCot > 0 and tradeQuality < effTqMinCot) or (not na(planExpectancy) and planExpectancy < 0.0) or _calVeto
// ═══════════════ Q5.6 ACCOUNT-STATE RISK CONTROLS ═══════════════
// Closes the audit's risk gap (daily loss / trade cap / consecutive-loss halt).
// Virtual tracking: each accepted signal is followed until SL or TP1 resolves it in
// R units; if both are touched in one bar, SL is assumed first (conservative).
// Order is deliberate: resolve -> evaluate caps -> record, so the signal that reaches
// a cap is still shown and only SUBSEQUENT signals are blocked (no self-suppression).
var float rkEntry = na
var float rkSL = na
var float rkTP = na
var bool rkLong = false
var float rkDayR = 0.0
var int rkDayN = 0
var int rkConsec = 0
var bool riskLock = false
var int rkLockBar = 0
if crossedNYDay
    rkDayR := 0.0
    rkDayN := 0
    if lockoutBars == 0
        riskLock := false
        rkConsec := 0
if not na(rkEntry) and barstate.isconfirmed
    // Q5.7: floor the R unit at 0.2 ATR (mintick was far too weak) and cap any single
    // virtual outcome at +/-5R, so one far-TP winner cannot swamp the daily R budget.
    float _rkR = math.max(math.abs(rkEntry - rkSL), adaptiveATR * 0.2)
    bool _rkSl = rkLong ? low <= rkSL : high >= rkSL
    bool _rkTp = rkLong ? high >= rkTP : low <= rkTP
    if _rkSl or _rkTp
        float _rkRes = _rkSl ? -1.0 : math.min(math.abs(rkTP - rkEntry) / _rkR, 5.0)
        rkDayR := rkDayR + _rkRes
        rkConsec := _rkRes < 0 ? rkConsec + 1 : 0
        rkEntry := na
bool rkLossHit = maxDailyLossR > 0 and rkDayR <= -maxDailyLossR
bool rkCapHit = maxTradesDay > 0 and rkDayN >= maxTradesDay
bool rkStreakHit = maxConsecLoss > 0 and rkConsec >= maxConsecLoss
if useRiskLimits and (rkLossHit or rkCapHit or rkStreakHit) and not riskLock
    riskLock := true
    rkLockBar := bar_index
if riskLock and lockoutBars > 0 and bar_index - rkLockBar >= lockoutBars
    riskLock := false
    rkConsec := 0
if (shouldBuy or shouldSell) and not tqVeto and not riskLock and na(rkEntry) and barstate.isconfirmed and not na(tpSL) and not na(tp1)
    rkEntry := close
    rkSL := tpSL
    rkTP := tp1
    rkLong := shouldBuy
    rkDayN := rkDayN + 1
string riskLockStr = not useRiskLimits ? "" : riskLock ? (rkLossHit ? "LOCK:DAYLOSS" : rkCapHit ? "LOCK:MAXTRADES" : "LOCK:LOSSSTREAK") : "R" + str.tostring(rkDayR, "#.#") + " N" + str.tostring(rkDayN) + (rkConsec > 0 ? " L" + str.tostring(rkConsec) : "")
// Lockout suppresses signals through the same path as the TQ veto.
tqVeto := tqVeto or (useRiskLimits and riskLock)
// ═══════════════ END RISK CONTROLS ═══════════════

// CHANGE ID: RED-2C-FIX | FILE: Master, global scope
// OLD LOGIC: shouldBuy/shouldSell/tqVeto/riskLock — and everything the dashboard's
// decision cell derives from them — recompute on EVERY tick, with no
// barstate.isconfirmed gate anywhere in the chain. On a live chart this means the
// currently-forming (unconfirmed) bar can show BUY/SELL that reverses before the
// bar closes — while alerts and the Strategy twins ARE correctly confirmed-gated
// and never see that intrabar state. The dashboard could therefore display a
// decision the backtest/alerts never acted on.
// NEW LOGIC: a separate CONFIRMED snapshot, written only when barstate.isconfirmed
// is true, sits alongside the existing (unchanged) live variables. The confirmed
// snapshot becomes the dashboard's PRIMARY decision; the live state is shown as a
// secondary "LIVE:" tag only when it differs from the confirmed one, so no
// information is suppressed — the distinction is made explicit instead.
// EXPECTED EFFECT: on historical bars (backtests, and any already-closed bar on a
// live chart) confirmed == live and nothing changes. On the currently-forming bar
// of a live chart, the primary decision cell now shows the last CONFIRMED state
// rather than a possibly-reversing intrabar one; a LIVE tag appears only when the
// forming bar's state has actually diverged from that.
// REGRESSION TEST: replay any historical range — confirmed and live labels must be
// identical on every bar, since every historical bar is by definition confirmed.
// CHANGE ID: F-017 — _statsWarm hoisted to GLOBAL scope. It was declared inside the
// `if barstate.isconfirmed` block, so the CONFIRMED label could test it but the LIVE label
// inside f_dashData1() could not — the live path simply had no WARMUP branch and fell
// through to "WAIT". During warm-up that made the two labels differ on EVERY bar
// (confirmed "WARMUP" vs live "WAIT"), so the LIVE: tag rendered permanently.
// That tag exists to flag a GENUINE intrabar divergence; firing it constantly for a purely
// structural reason trains the eye to ignore it, which is a trading-safety problem, not a
// cosmetic one. One shared global means the two paths can never disagree by construction.
// It is a pure function of globals (showStatsEngine, hN, OUTCOME_N, oOosNeff), so hoisting
// changes no value — only visibility.
// CHANGE ID: F-018 — WARM-UP PROGRESS. The cell previously read a bare "N0eff", which
// says the engine is not warm but not whether that is 5% of the way there, 95%, or never.
// Both live screenshots showed N0eff with no way to judge it, and the statistical layer
// has in fact never been active — so this is the field that most needed to be legible.
// _statsWarm has TWO conditions and they warm at different speeds, so both are shown:
//   n/10eff  — OOS effective samples toward the 10 required. NOTE the bar is TIMEFRAME
//              DEPENDENT because oOosNeff = oOosN / OUTCOME_N and OUTCOME_N = 3600/tfSec:
//              5M needs 120 raw OOS outcomes, 15M needs 40, 1H needs 30. Higher
//              timeframes warm up ~4x sooner, on top of their cost and history advantages.
//   n%hist   — history buffer toward the hN > OUTCOME_N*2 floor, which fills first.
// If %hist sits at 100 while n/10eff stays near 0, the history is there but too few
// analogs are clearing the similarity threshold — a different problem with a different
// fix, and one that was previously indistinguishable from simply needing more bars.
bool _statsWarm = not showStatsEngine or (hN > OUTCOME_N * 2 and oOosNeff >= 10)
var string _confDirLabel = "WAIT"
if barstate.isconfirmed
    // FIX: _rkBlocked/_tqBlocked are LOCAL to f_dashData1() (defined far later in the
    // file, inside that function's scope) — invisible here at global scope, hence
    // "Undeclared identifier". Inlined as the same boolean expressions using the
    // global values (shouldBuy/shouldSell/useRiskLimits/riskLock/tqVeto), all of
    // which are fully settled above this point (tqVeto's risk-lockout fold-in
    // completes at the line just before this block).
    bool _rkBlockedConf = (shouldBuy or shouldSell) and useRiskLimits and riskLock
    bool _tqBlockedConf = (shouldBuy or shouldSell) and tqVeto
    // CHANGE ID: WARMUP-STATE | Finding: "WAIT" conflated two materially different
    // situations — (a) engines are warm, evidence evaluated, no setup right now, and
    // (b) the statistics engine has not accumulated enough history to evaluate
    // anything yet. Case (b) got STRICTER after the Phase 3B IS/OOS fix (holding out
    // 20% of matches means the sample gates clear later), so a freshly-loaded chart
    // can sit on "WAIT" for a while with no indication it is a warm-up state rather
    // than a considered no-trade. Distinguishing them costs nothing and changes no
    // decision logic: WARMUP is display-only, evaluated AFTER the blocking states so
    // a genuine RISK LOCK or NO TRADE still takes precedence, and it never suppresses
    // a real BUY/SELL — if the engines produce a signal despite thin history, that
    // signal is still shown.
    // Gates mirrored from the ones that actually govern the statistics engine:
    //   hN > OUTCOME_N * 2  -> the scan guard's own minimum history requirement
    //   oOosNeff >= 10      -> the effective-N floor used by the OOS/TQ-history path
    _confDirLabel := _rkBlockedConf ? "RISK LOCK" : _tqBlockedConf ? "NO TRADE" : shouldBuy ? "BUY" : shouldSell ? "SELL" : not _statsWarm ? "WARMUP" : "WAIT"
// B10 Auction bias (replaces raw signal wording at the auction layer).
string aucBias = shouldBuy and not tqVeto ? (aucState == "REJ-LO" ? "LONG-REV" : "LONG-CONT") : shouldSell and not tqVeto ? (aucState == "REJ-HI" ? "SHORT-REV" : "SHORT-CONT") : shouldBuy or shouldSell ? "NO-TRADE" : "WAIT"
string structStr = bullStructActive ? "▲" + bullStructType + " " + str.tostring(bullStructAge) + "b" : bearStructActive ? "▼" + bearStructType + " " + str.tostring(bearStructAge) + "b" : "no-struct"
// ═══ Q6.3 CROSS-CHECK / TRACEABILITY (DISPLAY ONLY) ═══
// Each engine reports what IT concluded, from variables already computed above —
// no new math, no new table cells. Per the architecture review this layer is
// strictly informational: it NEVER gates the signal. The decision path remains
// weighted evidence -> probability -> TQ -> expectancy -> risk filters, so the
// Q5.5 fix for opportunity starvation is preserved.
// Reading: ▲ bullish · ▼ bearish · = neutral · ✓ passed · ✗ blocking
string _xT = bullTrend ? "T▲" : bearTrend ? "T▼" : "T="
string _xS = bullStructActive ? "S▲" + bullStructType : bearStructActive ? "S▼" + bearStructType : "S="
string _xL = evLiqBull > evLiqBear + 3 ? "L▲" : evLiqBear > evLiqBull + 3 ? "L▼" : "L="
string _xM = mtfConfluenceScore > 20 ? "M▲" : mtfConfluenceScore < -20 ? "M▼" : "M="
string _xQ = riskLock ? "R✗" : _calVeto ? "P✗" : tqVeto ? "Q✗" : "R✓"
string crossCheck = _xT + " " + _xS + " " + _xL + " " + _xM + " " + _xQ + " TQ" + str.tostring(tradeQuality) + "/100" + tqBasis + " C" + str.tostring(confidenceScore) + "/100  [~ = analog estimate, /100 = heuristic score]"
string auctionStr = crossCheck + "\n{" + structStr + "} " + (riskLockStr != "" ? "[" + riskLockStr + "] " : "") + "»" + aucBias + " " + aucState + str.tostring(aucProb) + "% " + aucCycle + " " + discStr + " A" + str.tostring(acceptScore) + acceptGrade + " " + valueMigStr + (openType != "" ? " " + openType : "") + (lastSweepQ > 0 ? " SW:" + lastSweepGrade + str.tostring(lastSweepQ) : "") + (not na(vixD) ? " VIX" + str.tostring(vixD, "#.#") : "")
// ═══════════════ END TRADE QUALITY ═══════════════
// R6.0: regime cell now shows the named adaptive regime + volatility tag.
// Correlation directional magnitude — Strong/Moderate/Weak per asset
string tipsMag = tipsValid ? (math.abs(avgCorrTIPS) > 0.5 ? "Strong" : math.abs(avgCorrTIPS) > 0.25 ? "Moderate" : "Weak") : "—"
// Effective sample size correction for autocorrelated returns: N_eff = N(1-rho)/(1+rho), AR(1) rho~0.3
float _rhoEst = 0.3
// Win rate display
string wrCIStr = ""
if showStatsEngine and oMatch >= 30
    float _wrR = oWr / 100.0
    float _wrDir = bearBiasScore > bullBiasScore ? (1.0 - _wrR) : _wrR
    float _effN = oMatch / (1.0 + 2.0 * _rhoEst / (1.0 - _rhoEst))
    float _wrCI95 = oMatch >= 30 ? 1.96 * math.sqrt(_wrDir * (1.0 - _wrDir) / _effN) * 100.0 : 0.0
    wrCIStr := _wrCI95 > 1.0 ? "+/-" + str.tostring(int(_wrCI95 + 0.5)) + "%" : ""
// Reliability label — sample-size bins for historical analog confidence
// Feature contribution breakdown: directional accuracy lift per factor
// EV + N + Cal (shared by dashboard + bottom strip)
// OOS validation: chronological holdout split (last holdoutRatio of bar_index range = OOS)
// Effective-N corrected Sharpe confidence interval: SE(Sharpe) ~ sqrt((1 + 0.5*SR^2)/N_eff) (Lo 2002)
// Effective-N corrected MaxDD significance flag
// Compact macro colors
// Correlation: impact arrows on XAUUSD — ▲▲/▲ (gold-bullish), ▼▼/▼ (gold-bearish), ≈ (neutral)
// R5-F13: arrows show IMPACT ON GOLD per the legend contract:
// DXY falling / yields falling / TIPS falling → ▲ (gold-bullish)

// Day-of-week tracker: cumulative bullish/bearish bar count per weekday
// R5-F2: undefined regimeBull/regimeBear references removed.
// R5-F3: invalid ta.dayofweek removed — reuses global _dow (Sunday=1, so Mon-Fri = 2-6).
var array<float> _dowBull = array.new<float>(7, 0.0)
var array<float> _dowBear = array.new<float>(7, 0.0)
var float _dowDecay = 0.995
bool _isDowBull = bullTrend and macroBull
bool _isDowBear = bearTrend and macroBear
if _dow >= 2 and _dow <= 6
    if _isDowBull
        array.set(_dowBull, _dow, array.get(_dowBull, _dow) * _dowDecay + 1.0)
        array.set(_dowBear, _dow, array.get(_dowBear, _dow) * _dowDecay)
    else if _isDowBear
        array.set(_dowBull, _dow, array.get(_dowBull, _dow) * _dowDecay)
        array.set(_dowBear, _dow, array.get(_dowBear, _dow) * _dowDecay + 1.0)
    else
        array.set(_dowBull, _dow, array.get(_dowBull, _dow) * _dowDecay)
        array.set(_dowBear, _dow, array.get(_dowBear, _dow) * _dowDecay)
float vdK = volDelta50 / 1000.0

// ══════════════════════════════════════════════════════════════════════
// BLOOMBERG TERMINAL DASHBOARD — 9-col x 4-row strip (UI only; no trading logic here)
// ══════════════════════════════════════════════════════════════════════
// R5.3-L8: parameter renamed tc -> tcol (it shadowed the function's own name — fragile).
tc(col, row, txt, tcol, ts, w) => table.cell(tblA, col, row, txt, text_color=tcol, text_size=ts, width=w)
tcb(col, row, txt, tcol, bg, ts, w) => table.cell(tblA, col, row, txt, text_color=tcol, bgcolor=bg, text_size=ts, width=w)
tcp(col, row, txt, bg, ts, w) => table.cell(tblPlan, col, row, txt, bgcolor=bg, text_color=C_TEXT, text_size=ts, width=w)

var bool[] gBreach = array.from(false, false)
// R5.2-M5: breach state moved to main scope — it was written only inside
// renderDashboard, so the cone breach markers in runVisuals depended on the dashboard
// toggle. Also fixes a degenerate test: the old check compared close against a band
// centered on the CURRENT close (close > close + band — never true), so breaches
// could never fire. Breach is now a 1-bar move beyond the Z*ATR band from the prior
// bar's cone origin.
if showForecastCone
    float _fcBandNow = math.max(adaptiveATR, atr) * forecastZ
    array.set(gBreach, 0, not na(close[1]) and close > close[1] + _fcBandNow)
    array.set(gBreach, 1, not na(close[1]) and close < close[1] - _fcBandNow)
else
    array.set(gBreach, 0, false)
    array.set(gBreach, 1, false)

// Q5.4-P1: dashboard split into three functions to satisfy the 254 external-
// elements-per-function limit (was 338). Cross-function locals move through
// global transfer arrays (arrays count once). Behavior identical.
var string[] gDashS = array.new_string(25, "")
var color[] gDashC = array.new_color(12, color.gray)
var float[] gDashF = array.new_float(10, 0.0)
f_dashData1() =>
    // ── [SHARED DATA] ──────────────────────────────────────────────
    string _tfLabel = timeframe.period
    string _symStr = syminfo.ticker
    float _chgPct = not na(close[1]) and close[1] != 0 ? (close - close[1]) / close[1] * 100.0 : 0.0
    // Cone status string — computed from main-scope f* scores for RISK column
    string _coneStatus = "Cone: —"
    if showForecastCone and not cleanInstitutional and not professionalMode
        // R5.1: dead sub-calculations removed (_csEnd/_csEndBand/_fcCurr/_csSlope duplicated the
        // cone geometry drawn in runVisuals); this block now only classifies direction and
        // detects band breaches at the CURRENT bar. _csLabel is wired into the status string.
        string _csLabel = fBullScore >= fBearScore and fBullScore >= fRngScore ? "BULL" : fBearScore >= fBullScore and fBearScore >= fRngScore ? "BEAR" : "RNG"
        // R5.2-M5: gBreach is now computed in main scope (see declaration site).
        // Confidence % from validated OOS win rate; minimum N=10
        string _coneConf = oOosNeff >= 10 ? " C:" + str.tostring(int(oOosWr)) + "%" : " C:LowN"
        // R5-F11: display the Z multiple, not a coverage %.
        _coneStatus := not array.get(gBreach, 0) and not array.get(gBreach, 1) ? "Cone " + _csLabel + ": Inside (Z" + str.tostring(forecastZ, "#.#") + _coneConf + ")" : array.get(gBreach, 0) ? "Cone: Breached ↑" : "Cone: Breached ↓"
    string _chgStr = (_chgPct >= 0 ? "+" : "") + str.tostring(_chgPct, "#.##") + "%"
    color _chgCol = _chgPct >= 0 ? cBloomBull : cBloomBear
    // SSOT: SHARED — consumed by DECISION block, direction color, and multi-column display
    // R6.0: signals below the Trade Quality floor display as NO TRADE (setup exists but
    // quality is insufficient) instead of forcing BUY/SELL.
    bool _rkBlocked = (shouldBuy or shouldSell) and useRiskLimits and riskLock
    bool _tqBlocked = (shouldBuy or shouldSell) and tqVeto
    string _dirLabel = _rkBlocked ? "RISK LOCK" : _tqBlocked ? "NO TRADE" : shouldBuy ? "BUY" : shouldSell ? "SELL" : not _statsWarm ? "WARMUP" : "WAIT"
    // RED-2C-FIX: _dirConfLabel and _dirBg now derive from the CONFIRMED snapshot,
    // not the live per-tick _dirLabel above (which is still computed and still
    // transferred via gDashS[6] for the live-divergence check on the render side).
    // CHANGE ID: CONF-PCT-MISLABEL | The decision box printed "BUY 65%" / "SELL 65%",
    // which reads as "65% chance the market goes my way". It is NOT that.
    // confidenceScore is a WEIGHTED HEURISTIC BLEND of five agreement measures
    // (structure, MTF, liquidity, macro, session), then session-multiplied,
    // regime-capped and news-haircut. It has never been calibrated against realised
    // outcomes. An earlier round corrected the separate CONF cell to "/100" but MISSED
    // this one, leaving the most prominent number on the dashboard still wearing a
    // percent sign it has not earned. Now "/100" here too, so the whole dashboard
    // states the same thing consistently: this is an agreement score, not a
    // probability. The only genuinely probability-like figures on screen are the
    // analog "~X%" hit rates in the trade plan panel, which carry the "~" precisely
    // to mark them as empirical estimates with a stated sample.
    string _dirConfLabel = _confDirLabel == "RISK LOCK" ? riskLockStr : _confDirLabel == "BUY" ? "BUY " + str.tostring(confidenceScore) + "/100" : _confDirLabel == "SELL" ? "SELL " + str.tostring(confidenceScore) + "/100" : _confDirLabel == "NO TRADE" ? "NO TRADE Q" + str.tostring(tradeQuality) : _confDirLabel == "WARMUP" ? "WARMUP " + str.tostring(oOosNeff) + "/10eff " + str.tostring(int(math.min(math.max(hN * 100.0 / math.max(OUTCOME_N * 2 + 1, 1), 0.0), 100.0))) + "%hist" : "WAIT"
    color _dirBg = _confDirLabel == "BUY" ? cBloomBull : _confDirLabel == "SELL" ? cBloomBear : cBloomNeut
    // Bias score (ordinal)
    int _bullPct = int(bullScore)
    int _bearPct = int(bearScore)
    int _rngPct = int(rangeScore)
    float _maxBiasPct = math.max(_bullPct, _bearPct, _rngPct)
    bool _strongDir = _maxBiasPct >= 62
    bool _isBull = _strongDir and _bullPct >= _bearPct and _bullPct >= _rngPct
    bool _isBear = _strongDir and _bearPct > _bullPct and _bearPct >= _rngPct
    color _biasCol = _isBull ? cBloomBull : _isBear ? cBloomBear : cBloomWarn
    // 3-layer bias breakdown: CURRENT = 5M | SWING = 15M | INST = 1H + 4H
    string _currBias = htf5mBull ? "BULL" : htf5mBear ? "BEAR" : "MIX"
    string _swingBias = htf15mBull ? "BULL" : htf15mBear ? "BEAR" : "MIX"
    int _instBullCnt = (htf1hBull ? 1 : 0) + (htf4hBull ? 1 : 0)
    int _instBearCnt = (htf1hBear ? 1 : 0) + (htf4hBear ? 1 : 0)
    string _instBias = _instBullCnt >= 2 ? "BULL" : _instBearCnt >= 2 ? "BEAR" : _instBullCnt > _instBearCnt ? "BULL-ISH" : _instBearCnt > _instBullCnt ? "BEAR-ISH" : "MIX"
    int _htfBullCnt = (htf15mBull ? 1 : 0) + (htf1hBull ? 1 : 0) + (htf4hBull ? 1 : 0)
    int _htfBearCnt = (htf15mBear ? 1 : 0) + (htf1hBear ? 1 : 0) + (htf4hBear ? 1 : 0)
    string _htfBias = _htfBullCnt >= 2 ? "BULL" : _htfBearCnt >= 2 ? "BEAR" : _htfBullCnt > _htfBearCnt ? "BULL-ISH" : _htfBearCnt > _htfBullCnt ? "BEAR-ISH" : "MIX"
    // Layer arrows
    string _cS = _currBias == "BULL" ? "▲" : _currBias == "BEAR" ? "▼" : "≈"
    string _sS = _swingBias == "BULL" ? "▲" : _swingBias == "BEAR" ? "▼" : "≈"
    string _iS = _instBias == "BULL" ? "▲" : _instBias == "BEAR" ? "▼" : _instBias == "BULL-ISH" ? "↗" : _instBias == "BEAR-ISH" ? "↘" : "≈"
    int _currScore = int(math.round(htf5mScore))
    int _swingScore = int(math.round(htf15mScore))
    int _instScore = int(math.round((htf1hScore + htf4hScore) / 2.0))
    // Counter-trend detection: current disagrees with institutional
    bool _counterTrend = (_currBias == "BULL") and (_instBias == "BEAR" or _instBias == "BEAR-ISH")
    bool _counterTrendBear = (_currBias == "BEAR") and (_instBias == "BULL" or _instBias == "BULL-ISH")
    string _ctLabel = _counterTrend or _counterTrendBear ? "↕" : ""
    // R5.1: MTF agreement tier wired (consumes mtfAgreementHigh/Med/Low)
    string _agreeTier = mtfAgreementHigh ? "A:HI" : mtfAgreementMed ? "A:MED" : mtfAgreementLow ? "A:LO" : "A:—"
    string _biasBreakdown = "C" + _cS + str.tostring(_currScore) + " S" + _sS + str.tostring(_swingScore) + " I" + _iS + str.tostring(_instScore)
    // Confidence / quality
    int _setupScore = math.min(math.max(int(confidenceScore / 20), 0), 5)
    string _gradeLabel = _setupScore >= 4 ? "A" : _setupScore >= 3 ? "B" : _setupScore >= 2 ? "C" : "D"
    // Kelly-optimal sizing with tail-risk penalty and DD circuit breaker
    // NOTE (design): p = oOosWr is the rate of bullish 1h drift among state-similar bars,
    // NOT the win rate of this trade structure (1.5 ATR SL, 1:1/1:2 TP). Half-Kelly plus the
    // haircuts below keep this conservative; a trade-level outcome log is the proper base.
    float _kellyPct = riskPercent
    if showStatsEngine and oOosNeff >= 10 and not na(oOosWr) and not na(oAvgW) and not na(oAvgL) and oAvgL > 0
        // Q5.0-S1: p = Wilson 95% LOWER bound at EFFECTIVE sample size (overlap-corrected
        // N/OUTCOME_N) — self-shrinks toward no-bet when the independent sample is thin.
        float _nEffK = math.max(oOosN / OUTCOME_N, 1.0)
        float _pHatK = oOosWr / 100.0
        float _zWK = 1.96
        float _wDenK = 1.0 + _zWK * _zWK / _nEffK
        float _wCtrK = (_pHatK + _zWK * _zWK / (2.0 * _nEffK)) / _wDenK
        float _wHwK = _zWK * math.sqrt(_pHatK * (1.0 - _pHatK) / _nEffK + _zWK * _zWK / (4.0 * _nEffK * _nEffK)) / _wDenK
        float p = math.max(_wCtrK - _wHwK, 0.01)
        float _oosAvgW = oAvgWOos > 0 ? oAvgWOos : oAvgW
        float _oosAvgL = oAvgLOos > 0 ? oAvgLOos : oAvgL
        float b = _oosAvgW / math.max(math.abs(_oosAvgL), 0.01)
        float _rawKelly = (p * b - (1.0 - p)) / b * 100.0
        _kellyPct := math.min(riskPercent, math.max(0.0, _rawKelly * 0.5))
        if not na(retSkew) and not na(retKurt)
            if retSkew < -0.5
                _kellyPct *= 0.85
            if retKurt > 1.0
                _kellyPct *= 0.75
        if not na(oMaxDD)
            if oMaxDD >= 30.0
                _kellyPct := 0.0
            else if oMaxDD >= 20.0
                _kellyPct *= 0.5
            else if oMaxDD >= 10.0
                _kellyPct *= 0.75
    array.set(gDashS, 0, _agreeTier)
    array.set(gDashF, 0, _bearPct)
    array.set(gDashS, 1, _biasBreakdown)
    array.set(gDashC, 0, _biasCol)
    array.set(gDashF, 1, _bullPct)
    array.set(gDashC, 1, _chgCol)
    array.set(gDashS, 2, _chgStr)
    array.set(gDashS, 3, _coneStatus)
    array.set(gDashS, 4, _ctLabel)
    array.set(gDashC, 2, _dirBg)
    array.set(gDashS, 5, _dirConfLabel)
    array.set(gDashS, 6, _dirLabel)
    array.set(gDashS, 7, _gradeLabel)
    array.set(gDashS, 8, _htfBias)
    array.set(gDashF, 2, _isBear ? 1.0 : 0.0)
    array.set(gDashF, 3, _isBull ? 1.0 : 0.0)
    array.set(gDashF, 4, _kellyPct)
    array.set(gDashF, 5, _rngPct)
    array.set(gDashS, 9, _symStr)
    array.set(gDashS, 10, _tfLabel)
    true
// Detect responsive mode for table creation and indicator visibility



// ---- Asian Session Range ----

// ---- Manipulation Signal ----

// ---- Signal Quality Label Filters ----
// CHOCH qualified: suppress in ranging regime
// MSS qualified: liq sweep + displacement + MSS + HTF >= 3/5
// Displacement qualified: vol > 1.5x SMA20, bodyPct > 70%
// EQH/EQL qualified: R5-F18 — tolerance unified on eqAtrMult input (was hardcoded 0.15)
// Global filters

// PLOTS
// ---- VWAP + Volatility Bands ----
// Bollinger Bands (20,2)
// ---- ADX (minimal opacity) ----
// R5-F5: hline() cannot take a series expression — replaced with a hidden plot.

// ---- Order Block Visuals ----
var line bullOBLowLine = na
var line bullOBHighLine = na
var line bearOBLowLine = na
var line bearOBHighLine = na
var label bullOBLabel = na
var label bearOBLabel = na
// Historical OB zone lines
var line[] bullOBHistLowA = array.new_line()
var line[] bullOBHistHighA = array.new_line()
var line[] bearOBHistLowA = array.new_line()
var line[] bearOBHistHighA = array.new_line()
// ---- FVG Quality Filter (max 3 active) ----
var int fvgActiveCount = 0
if fvgDetected and not fvgActive[1]
    fvgActiveCount += 1
if fvgMitigated and fvgActive[1]
    fvgActiveCount := math.max(0, fvgActiveCount - 1)
// R5.2: gaps that expire via fvgMaxBars (without mitigation) previously leaked the
// counter upward until fvgShowQuality locked false permanently.
if not fvgMitigated and fvgActive[1] and not fvgActive
    fvgActiveCount := math.max(0, fvgActiveCount - 1)
bool fvgShowQuality = fvgActiveCount <= 3 or not showFVG
// ---- FVG Visuals (quality-filtered) ----
var line fvgUpperLineObj = na
var line fvgLowerLineObj = na
var label fvgLabel = na
// ---- Macro Strength Score as subplot ----
// R5.1: volume climax markers wired to the showClimax toggle (previously computed, never shown)
// ---- Corr Breakdown ----

// Shared label cleaner helper
// Helper: apply vertical offset bidirectionally (push up OR down, whichever is closer to base)
// R5-F12: alertcondition messages use only valid built-in placeholders; the dynamic
// alert() calls below carry the full bias detail.


// ═══════════════ STRATEGY EXECUTION LAYER (twin only) ═══════════════
// Constant contract size for the A/B. Change it here if your instrument's contract
// unit differs; do NOT switch back to percent-of-equity while comparing arms.
// CHANGE ID: P0-CAL-005 — HARD calibration gate (upgraded from advisory).
// The slippage/commission constants in the strategy() declaration are derived against
// syminfo.mintick == 0.01. If the loaded feed quotes gold to a different precision, the
// scorer's costs silently desynchronise from the selector's and the A/B stops measuring
// the gates — while still producing clean-looking, entirely invalid numbers.
// A warning label alone is not enough: a run that LOOKS finished is worse than one that
// visibly refuses, because the invalid result gets recorded and compared. So this now
// BLOCKS EXECUTION — _costModelValid gates both entries — and the run is unqualified by
// construction rather than by the operator remembering to check a banner.
// Recompute per the derivation in the header, set the constants, and it re-enables.
bool _costModelValid = math.abs(syminfo.mintick - 0.01) <= 1e-9
var label _mtWarn = na
if barstate.islast and not _costModelValid
    label.delete(_mtWarn)
    _mtWarn := label.new(bar_index, high, "A/B INVALID — COST MODEL MISMATCH\nmintick=" + str.tostring(syminfo.mintick) + " (constants derived for 0.01)\nSet slippage=" + str.tostring(math.round((0.3 + 2 * 0.2) / 2 / syminfo.mintick)) + " ticks, commission=" + str.tostring(7.0 / 100.0 / 2.0, "#.####") + "\nENTRIES BLOCKED until corrected", color=color.new(color.red, 0), textcolor=color.white, style=label.style_label_down, size=size.large)

float abTestQty = 1.0
// Q5.6: entries additionally blocked by the account-state risk lockout, so the twin
// backtests EXACTLY what the indicator recommends (tqVeto already folds in riskLock).
// P0-CAL-005: `and _costModelValid` is the HARD GATE. On a feed whose tick size the
// declared cost constants were not derived for, the twin takes NO trades at all, so the
// Strategy Tester reports a visibly empty run instead of a plausible but invalid one.
bool execBuyS = shouldBuy and not tqVeto and barstate.isconfirmed and _costModelValid
bool execSellS = shouldSell and not tqVeto and barstate.isconfirmed and _costModelValid
var float stEntry = na
var float stSL = na
var float stTP1 = na
var float stTP2 = na
var bool stBE = false
if execBuyS and strategy.position_size <= 0
    strategy.close_all(comment="flip")
    stEntry := close
    stSL := tpSL
    stTP1 := tp1
    stTP2 := tp2
    stBE := false
    // P0-EXEC-001 (external audit): qty is now EXPLICIT. Previously omitted, so the
    // order fell through to default_qty_type=percent_of_equity/5 — i.e. 5% of equity
    // notional, which is neither the dashboard's risk-based lot nor a constant size.
    // Worse for an A/B: percent_of_equity COMPOUNDS, so the two arms would trade
    // different sizes as their equity curves diverged, contaminating the very
    // comparison the twins exist to make. Fixed size makes trade outcomes additive in
    // R and the gate change the only variable. Absolute P&L is therefore NOT a
    // risk-model simulation — it is a like-for-like gate comparison, which is the
    // twins' only purpose.
    // CHANGE ID: F-013 — stamp the engine's own per-trade estimates into the entry
    // COMMENT, which TradingView writes to the Signal column of the List of Trades
    // export. This is METADATA ONLY: comment has zero effect on fills, sizing, or any
    // result. It is applied to BOTH arms so the A/B delta is unchanged.
    // WHY IT MUST PRECEDE THE BASELINE: validate.py's calibration test needs a `prob`
    // and `tq` per trade, and those are internal engine values absent from the standard
    // export. alert() CANNOT supply them — alerts fire only forward in real time and
    // never on historical bars, so they can never backfill a backtest. The entry comment
    // is the only mechanism that attaches them to every historical trade. Without this,
    // the baseline export cannot support the calibration test and a second full run
    // F-A12 FIX. That format was NEVER EMITTED: the comment shipped TQ|CG|B..V..|D and
    // carried no probability at all, so the one field the calibration test actually needs
    // was the one field missing -- and the defect hid behind a comment describing the
    // intended format rather than the real one. P is now appended, and it is the
    // DIRECTIONAL probability: _calibratedProb for longs, 1 - _calibratedProb for shorts,
    // i.e. P(this trade wins) rather than P(bullish). A reliability curve needs the
    // former. Emitted format is now "TQ<n>|CG<n>|B<n>V<n>|D<n>|P<pct>".
    // This had to land BEFORE the baseline run for the reason stated just above: alerts
    // cannot backfill history, so without it the export cannot support the calibration
    // test and a second full backtest would be needed to get it.
    strategy.entry("L", strategy.long, qty = abTestQty, comment = "TQ" + str.tostring(tradeQuality) + "|CG" + str.tostring(oCalGrade) + "|B" + str.tostring(SCHEMA_BUILD) + "V" + str.tostring(REGIME_FEATURE_VERSION) + "|D" + str.tostring(barDataStatus) + "|P" + str.tostring(math.round(_calibratedProb * 100.0)))
if execSellS and strategy.position_size >= 0
    strategy.close_all(comment="flip")
    stEntry := close
    stSL := tpSL
    stTP1 := tp1
    stTP2 := tp2
    stBE := false
    strategy.entry("S", strategy.short, qty = abTestQty, comment = "TQ" + str.tostring(tradeQuality) + "|CG" + str.tostring(oCalGrade) + "|B" + str.tostring(SCHEMA_BUILD) + "V" + str.tostring(REGIME_FEATURE_VERSION) + "|D" + str.tostring(barDataStatus) + "|P" + str.tostring(math.round((1.0 - _calibratedProb) * 100.0)))
// CHANGE ID: P0-EXEC-002-FIX | FILE: Strategy execution layer (both twins)
// OLD LOGIC: on the bar where high>=stTP1, stSL was mutated to breakeven BEFORE
// being passed to strategy.exit() the SAME bar, with no check for whether the
// ORIGINAL stop was also touched this bar. TradingView cannot determine intrabar
// touch order from OHLC alone (documented limitation, not fixable by
// calc_on_every_tick) — so a bar whose low breached the original stop AND whose
// high reached TP1 was silently resolved as "TP1 then breakeven," which is
// optimistic if the stop was actually touched first.
// NEW LOGIC: only move to breakeven if TP1 was touched AND the ORIGINAL stop was
// NOT also touched this same bar. If both were touched, stSL is left unmutated
// (original stop stays live) — this matches the stop-first convention already
// used elsewhere in this codebase (Q5.6 risk tracker: "SL assumed first if both
// hit in one bar"), applied here for consistency rather than invented fresh.
// EXPECTED EFFECT: fewer/later breakeven transitions on bars with a same-bar
// stop/TP1 conflict; no change on bars where only one level was touched.
// REGRESSION TESTS: (A) TP1 only, no stop touch -> BE as before. (B) stop only ->
// unaffected (existing branch). (C) both touched same bar -> stop wins, no BE.
if strategy.position_size > 0
    bool _slTouchedL = low <= stSL
    if not stBE and high >= stTP1 and not _slTouchedL
        stBE := true
        stSL := stEntry
    strategy.exit("Lx1", "L", stop=stSL, limit=stTP1, qty_percent=50)
    strategy.exit("Lx2", "L", stop=stSL, limit=stTP2)
if strategy.position_size < 0
    bool _slTouchedS = high >= stSL
    if not stBE and low <= stTP1 and not _slTouchedS
        stBE := true
        stSL := stEntry
    strategy.exit("Sx1", "S", stop=stSL, limit=stTP1, qty_percent=50)
    strategy.exit("Sx2", "S", stop=stSL, limit=stTP2)
