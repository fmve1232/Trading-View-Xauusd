//@version=6
// ╔══════════════════════════════════════════════════════════════════════════════╗
// ║  BUILD STAMP — this file last CHANGED in v95   (engine structure, SX)         ║
// ║  Compare against the build record in chat. If they differ, the copy on your   ║
// ║  chart is STALE — re-paste. Stale scripts throw errors already fixed here:    ║
// ║  e.g. a pre-fix EdgeCases threw "Row 70 is out of table bounds" on a build    ║
// ║  whose table has had 100 rows since the first audited version.                ║
// ║  The stamp only moves when THIS file changes, so an unchanged file keeps its  ║
// ║  old number and still matches the record.                                     ║
// ╚══════════════════════════════════════════════════════════════════════════════╝
// ═══════════════════════════════════════════════════════════════════════════════
// XAUUSD QUANTUM — VISUALS & FOOTPRINT COMPANION  (V2.0)
// Runs ALONGSIDE the Quantum Master (Q6.3) indicator on the same chart.
//
// WHY TWO SCRIPTS: the Master sits ~1,500 tokens under Pine's 100,256 ceiling, so
// its chart-drawing layer lives here instead. Master = intelligence + dashboard.
// Companion = every line, label, zone, and the footprint approximation.
// Definitions MATCH the Master exactly (EMA 20/100/200, corrected FVG bounds,
// NY-session-anchored PDH/PDL/PWH/PWL + CDH/CDL), so the two never disagree.
//
// V2.0 ADDS (the achievable subset of the Final Institutional Edition spec):
//   · Unified TAG REGISTRY with collision avoidance — every label is placed via
//     one sorter that enforces a minimum vertical gap, so tags stop overlapping
//     when EMAs / VWAP / BB / S-R converge. Pine has NO auto-layout engine; this
//     is hand-written collision handling, the only way it can be done.
//   · Candle info panel (O/H/L/C, range, ATR%, direction, relative volume).
//   · S/R auto-hide — levels beyond N×ATR from price are suppressed.
//   · Extended zone colors (OB brown / FVG orange / sweep magenta), toggleable
//     back to directional bull-bear coding, which carries more information.
//
// PRICE-SCALE POLICY (deliberate — per the earlier explicit instruction):
// ONLY current price, Support, Resistance, EMA 200 and VWAP-D publish to the
// right axis. The spec's 7-tag list was NOT adopted: it re-crowds the axis that
// the 5-tag limit was chosen to fix, and it drops S/R which was asked for.
// NOTE: TradingView owns price-axis layout — axis tags CANNOT be de-overlapped
// from Pine. The collision handling below applies to CHART labels, not the axis.
//
// FOOTPRINT HONESTY: Pine has NO bid/ask order-flow data, so a true footprint
// (volume at bid vs ask per price level) is impossible here. What follows is a
// documented approximation: intrabar data via request.security_lower_tf(), each
// intrabar classified by the tick rule (close>open = buy-side), binned by price.
// A genuine intrabar volume distribution — NOT exchange footprint.
// ═══════════════════════════════════════════════════════════════════════════════
indicator("XAUUSD Quantum Visuals V2", "QV2", overlay = true, max_lines_count = 500, max_labels_count = 500, max_boxes_count = 500, max_bars_back = 5000)

// ─────────────────────────── INPUTS ───────────────────────────
grpT = "Trend Overlays"
showEma      = input.bool(true,  "EMA 20 / 100 / 200",      group = grpT)
ema20Len     = input.int(20,  "EMA fast length",   minval = 2, group = grpT, tooltip = "Keep these matched to the Master's EMA inputs, or the drawn averages will differ from the ones the engine scores.")
ema100Len    = input.int(100, "EMA mid length",    minval = 5, group = grpT)
ema200Len    = input.int(200, "EMA slow length",   minval = 10, group = grpT)
showVwap     = input.bool(true,  "VWAP (daily anchor)",     group = grpT)
showVwapWM   = input.bool(false, "VWAP weekly + monthly",   group = grpT)
// v81: OFF by default to cut chart clutter (operator); kept OFF in v87 (not read by any rule; see CHANGELOG v87). Drawing only.
showBB       = input.bool(false, "Bollinger Bands (20, 2)", group = grpT)

grpTag = "Labels"
showTags      = input.bool(true, "Label every line at right edge", group = grpTag)
tagOffset     = input.int(14,    "Tag distance (bars right)", minval = 2, maxval = 60, group = grpTag)
tagGapATR     = input.float(0.22, "Min label separation (ATR)", minval = 0.0, maxval = 2.0, step = 0.02, group = grpTag, tooltip = "Collision avoidance: labels closer than this are pushed apart vertically. The dotted leader still points at each line's true value. Set 0 to disable.")
showPriceLine = input.bool(true, "Live price line + tag",   group = grpTag)

grpL = "Key Levels"
showLevels   = input.bool(true,  "PDH/PDL · PWH/PWL",       group = grpL)
showMonthly  = input.bool(false, "PMH/PML (monthly)",       group = grpL)
showCurDay   = input.bool(true,  "CDH/CDL (current day)",   group = grpL, tooltip = "Current NY-session day high/low — the Master uses these as live take-profit candidates.")

grpSR = "Support / Resistance"
showSR       = input.bool(true,  "Show S/R levels",         group = grpSR)
srCount      = input.int(2,      "Levels each side", minval = 1, maxval = 4, group = grpSR)
srMergeATR   = input.float(0.5,  "Merge distance (ATR)", minval = 0.1, step = 0.1, group = grpSR)
srMaxDistATR = input.float(8.0,  "Auto-hide beyond (ATR)", minval = 1.0, maxval = 50.0, step = 0.5, group = grpSR, tooltip = "Levels farther than this from current price are hidden — keeps the chart clean when price travels away from an old zone.")
srMaxKeep    = input.int(40,     "Pivots retained", minval = 10, maxval = 120, group = grpSR)

grpS = "Structure"
// F-030: these markers come from a DIFFERENT algorithm than the Master's. This script
// uses ONE pivot scale (pivotLen), a simple close-through-pivot break and a bias-flip
// CHoCH; the Master uses TWO pivot scales, HH/HL/LH/LL sequence validation, ATR-distance
// and bar-spacing filters, and an 8-bar structWindow -- and it also detects MSS, which
// this script cannot produce at all. A marker here is therefore NOT evidence the engine
// scored a structure break. The "~" prefix on every label says so on the chart itself.
// v88: OFF by default (operator: "too much noisy"; these approximate labels can disagree with the Master's STRUCTURE
// cell, the engine's own BOS / CHoCH / MSS). The CHURN check reads brokeUp / brokeDown, computed with the switch off too.
showStruct   = input.bool(false, "BOS / CHoCH / MSS labels (the engine's)", group = grpS, tooltip = "v95: drawn from the Master's own structure engine, copied verbatim (SX block): the same BOS / CHoCH / MSS as the Master's STRUCTURE cell. OFF by default (v88: too noisy).")
pivotLen     = input.int(5,      "Pivot length", minval = 2, maxval = 20, group = grpS)
showPivots   = input.bool(false, "Mark swing pivots",       group = grpS)
structKeep   = input.int(25,     "BOS/CHoCH markers kept", minval = 5, maxval = 100, group = grpS, tooltip = "Older structure markers are deleted. Without a cap they accumulate until TradingView's 500-object limit silently drops the oldest drawings.")
showSweep    = input.bool(true,  "Liquidity sweep markers", group = grpS)

grpZ = "Zones"
// v81: OFF to cut clutter; v87 ON; v88 OFF again (operator: "too much noisy", 2026-10-29). Drawing only, the engine is the Master's.
showFVG      = input.bool(false, "Fair Value Gaps",         group = grpZ)
// v95: the Master's FVG Max Bars (default and bounds); the minimum size is the engine's (0.3 x adaptive ATR, in fvgDetected)
fvgMaxBars   = input.int(30,     "FVG max age (bars), as the Master's", minval = 10, maxval = 100, group = grpZ)
// v81: OFF to cut clutter; v87 ON; v88 OFF again (operator: "too much noisy", 2026-10-29). Drawing only, the engine is the Master's.
showOB       = input.bool(false, "Order Blocks",            group = grpZ)
obDispATR    = input.float(2.5,  "OB displacement (xATR)", minval = 1.5, maxval = 5.0, step = 0.1, group = grpZ, tooltip = "F-A08: was 1.0 while the Master's dispMult is 2.5, so this chart drew order blocks on candles the engine does not treat as displacement at all. Now matched to the Master default. Keep the two equal or the boxes will not be the ones the engine scored.")
// v95: the F-A08 parity inputs (ADX length / threshold, Adaptive ATR) are the engine's own now (SX block).
obKeep       = input.int(4,      "Order Blocks kept", minval = 1, maxval = 10, group = grpZ)
obShowLabel = input.bool(true, "Label OB / FVG zones", group="Zones", tooltip="Zone identity labels, relocated here from the Master when it exceeded the Pine token limit.")

// ===== SUPPORT / RESISTANCE — MIGRATED FROM THE MASTER =====================
// PORTED VERBATIM. The Master was at ~95% of the Pine token ceiling while this file sits
// at ~14%, and the S/R scanner was display-only there: its level arrays were consumed only
// by the scanner and the drawing block, never by a decision. (The activeResistance /
// activeSupport that DO feed the trade plan come from the pivot path and remain in the
// Master.) Moving it freed ~1,587 compiled tokens for inputs that change decisions.
// PARITY IS THE RISK, so the function below is copied UNCHANGED and driven with the same
// constants the Master used: maxSR 6, scanLen 100, same ATR proximity clustering. The
// levels drawn here are therefore the same levels the Master drew. Any future edit must be
// mirrored or the Master/Visuals parity check will flag it.
srShow    = input.bool(true, "Support / Resistance levels", group="Zones")
srMaxLv   = input.int(6,   "  Max levels per side", minval=1, maxval=12, group="Zones")
srScanLen = input.int(100, "  Scan lookback (bars)", minval=20, maxval=400, group="Zones")
boxFade      = input.int(94,     "Zone fill transparency (higher = fainter)", minval = 80, maxval = 99, group = grpZ)
zoneFlatCol  = input.bool(true,  "Spec colors (OB brown / FVG orange)", group = grpZ, tooltip = "ON = Final Edition palette. OFF = directional bull/bear colouring, which carries MORE information — you can read gap direction at a glance.")

grpC = "Candle Info Panel"
showCandle   = input.bool(true,  "Show candle info panel",  group = grpC)
candlePos    = input.string("Top Right", "Panel position", options = ["Top Right", "Middle Right", "Bottom Right", "Top Left"], group = grpC)
// v73: ONE terminal panel (candle + H2 + gold drivers, one style) is the default; the three separate v72 cards stay
// selectable. The panel's sections follow the cards' own switches: Show candle info panel, Show H2 signals and card,
// Gold drivers panel = Hidden; the H2 card layout "Full" adds the session rows and its text size sets the panel's.
grpTm = "TERMINAL PANEL (v73)"
vLayout = input.string("Terminal (one panel)", "Panel layout", options = ["Terminal (one panel)", "Separate cards (v72)"], group = grpTm, tooltip = "Terminal: market, H2 and gold drivers in one docked panel, one style. Separate cards: the three v72 cards, each at its own position.")
vPos = input.string("Bottom Left", "Terminal position", options = ["Bottom Left", "Middle Left", "Top Left", "Middle Right"], group = grpTm, tooltip = "The Master's dashboard sits top right and its trade plan bottom right (Desktop); bottom left keeps both and the newest candles clear. With the Master on Tablet its plan is bottom left: pick Middle Left (not Top Left: the docks take that corner then; TradingView shows one table per corner).")
vDetail = input.string("Standard", "Terminal detail", options = ["Standard", "Compact"], group = grpTm, tooltip = "Standard: every row. Compact: price + flow, signal + next, and the five drivers as one line (hover it for the detail).")
bool vSep = vLayout == "Separate cards (v72)"
// v79: MARKET AT A GLANCE, the panel's first section: eight plain-language answers for a new trader. Each answer is a
// value Visuals already computes; bias and probability are the Master engine's (Visuals cannot read another script's
// values), so those two rows name the Master cell instead of inventing a second number that could disagree with it.
glShow = input.bool(true, "Market at a glance (8 answers)", group = grpTm, tooltip = "Trend, bias, heading, liquidity, macro, room for a move, history, probability, in plain words. Display only.")
glMoveA = input.float(10.0, "Move to plan for: at least ($)", minval = 0.5, maxval = 500.0, step = 0.5, group = grpTm, tooltip = "The ROOM row checks whether price has this much space before the nearest liquidity level on each side. Display only: no gate, no signal.")
glMoveB = input.float(20.0, "Move to plan for: target ($)", minval = 0.5, maxval = 500.0, step = 0.5, group = grpTm)
// v81: the glance as a BOTTOM TICKER (operator's choice B): six tiles in one strip at the bottom centre, lifted above
// the Master's plan strip; the panel keeps only what is not docked. "In the panel" restores the v79 / v80 section.
glPlace = input.string("Bottom ticker", "Glance placement", options = ["Bottom ticker", "In the panel"], group = grpTm, tooltip = "Bottom ticker: six tiles along the bottom (trend, value, room, macro, last sweep, H2), the price area stays clear. In the panel: the glance section of the bottom-left panel.")
tkLift = input.int(5, "Ticker lift above the Master's plan strip (% of chart height)", minval = 0, maxval = 40, group = grpTm, tooltip = "Raise it if the ticker overlaps the Master's plan strip; 0 = on the bottom edge.")
tkSize = input.string("Normal", "Ticker text size", options = ["Small", "Normal", "Large"], group = grpTm)
bool tkOn = glShow and glPlace == "Bottom ticker"
glStyle = input.string("Gauges (compact)", "Glance style", options = ["Gauges (compact)", "Text (v79)"], group = grpTm, tooltip = "Gauges: the same answers as bars and sliders, about one line each. Text: the v79 sentences.")
gdPos = input.string("Bottom Right", "Gold drivers panel", options=["Bottom Right", "Bottom Center", "Bottom Left", "Middle Right", "Hidden"], group="GOLD DRIVERS (display only)")
// v74: the drivers can sit directly UNDER the Master's MACRO column, so the two read as one macro block. The Master's
// dashboard has fixed geometry: top right (Desktop / Auto) or top left (Tablet), no border, no frame, column widths
// 10/10/12/11/13/10/11/11/13 % of the chart x its Density. These three inputs are the Master's own (same names,
// options, defaults; inputs_check.py holds them equal) -- set them as in the Master. Only the gap is free.
gdDock = input.string("Under the Master's MACRO", "Gold drivers placement", options=["Under the Master's MACRO", "In the panel / card"], group="GOLD DRIVERS (display only)", tooltip="Under the Master's MACRO: a column aligned under the Master dashboard's MACRO cell (Desktop / Tablet; not with the Master on Mobile). In the panel / card: inside the terminal panel, or the separate drivers card.")
gdGap = input.int(24, "Dock gap below the Master dashboard (% of chart height)", minval=0, maxval=70, group="GOLD DRIVERS (display only)", tooltip="All docks (liquidity, gold drivers, H2) start this far down: raise it until they clear the Master's tallest column (DECISION, with its H2 SETUP cell).")
dashMode = input.string("Auto", "Dash Mode", options=["Auto", "Desktop", "Tablet", "Mobile"], group="GOLD DRIVERS (display only)", tooltip="Set as in the Master (its Layout group).")
textSize = input.string("Auto", "Text Size", options=["Auto", "Small", "Medium", "Large"], group="GOLD DRIVERS (display only)", tooltip="Set as in the Master (its Layout group).")
density = input.string("Standard", "Density", options=["Compact", "Standard", "Spacious"], group="GOLD DRIVERS (display only)", tooltip="Set as in the Master (its Layout group).")
bool gdDocked = gdDock == "Under the Master's MACRO" and gdPos != "Hidden" and dashMode != "Mobile"
// v75: the H2 card (= the website's arm H3, the same rule) and a LIQUIDITY · SWEEPS block can sit under the
// Master's DECISION and LIQUIDITY columns, as the drivers sit under MACRO. v77: ONE table for all docks (TradingView
// shows one table per position per script: v76's three top-right tables showed only the last one), so they share one
// gap below the Master's tallest column. These inputs moved up here so the cards can read them.
grpDk = "DOCK UNDER THE MASTER (v75)"
h2Dock = input.string("Under the Master's DECISION", "H2 card placement", options=["Under the Master's DECISION", "In the panel / card"], group=grpDk, tooltip="The H2 sweep-to-value card (the website records the same rule as arm H3) under the Master dashboard's DECISION column, or in the terminal panel / its own card.")
lqDock = input.string("Under the Master's LIQUIDITY", "Liquidity & sweeps placement", options=["Under the Master's LIQUIDITY", "In the panel", "Hidden"], group=grpDk, tooltip="PDH/PDL, PWH/PWL, PMH/PML, CDH/CDL with distance from price, the unswept swings and the last sweeps, under the Master's LIQUIDITY column or in the terminal panel. Display only.")
bool h2Docked = h2Dock == "Under the Master's DECISION" and dashMode != "Mobile"
bool lqDocked = lqDock == "Under the Master's LIQUIDITY" and dashMode != "Mobile"
// v77: the separate candle card's "Top Right" would share the docks' corner (one table per position): it moves to
// middle right while any dock is on
bool dkOn = gdDocked or lqDocked or h2Docked
bool lqInPanel = lqDock == "In the panel" or lqDock == "Under the Master's LIQUIDITY" and dashMode == "Mobile"

grpSess = "Sessions (UTC)"
// v81: OFF to cut clutter; v87 ON; v88 OFF again (operator: "too much noisy", 2026-10-29). Drawing only, the engine is the Master's.
showSess     = input.bool(false, "Session shading",         group = grpSess)

grpF = "Footprint (approximation)"
// v81: OFF by default to cut chart clutter (operator); kept OFF in v87 (not read by any rule; see CHANGELOG v87). Drawing only.
showFP       = input.bool(false, "Enable footprint engine", group = grpF)
fpTf         = input.timeframe("1", "Intrabar timeframe",   group = grpF, tooltip = "Must be LOWER than the chart timeframe. 1 minute on a 5M chart gives 5 intrabars per candle.")
fpBars       = input.int(25,     "Bars to render", minval = 5, maxval = 60, group = grpF)
fpBins       = input.int(6,      "Price bins per bar", minval = 3, maxval = 10, group = grpF)
showFpBins   = input.bool(true,  "Draw volume-at-price bins", group = grpF)
showFpPOC    = input.bool(true,  "Mark bar volume POC",     group = grpF)
showFpDelta  = input.bool(true,  "Delta labels",            group = grpF)

// ===== ABSORPTION BUBBLES =====================================================
// WHAT THIS IS, PRECISELY. True absorption is large RESTING size soaking up aggression
// without price moving — that requires bid/ask order-flow, which Pine does not expose and
// which spot XAUUSD does not have at all: `volume` on this feed is a TICK COUNT (number of
// price updates), not contracts traded. So this is NOT exchange absorption and is not
// labelled as such anywhere on the chart.
// WHAT IT ACTUALLY MEASURES — the observable shadow of absorption, three conditions
// together (any one alone is meaningless):
//   EFFORT   total lower-timeframe activity well above its own recent average
//   RESULT   realised progress (|close-open|) SMALL relative to the bar's own range
//   ONE-SIDED  the footprint delta clearly skewed to one side
// Read together: one side pushed hard, and got nowhere. That is the footprint an
// absorbing counterparty leaves behind on a feed without a tape.
// DIRECTION IS DELIBERATELY INVERTED vs the aggression: buy-side effort that fails to
// advance means BUYERS were absorbed, which is a BEARISH tell, and vice versa.
// Bubble is placed at fpPOC — where the activity actually concentrated — not at the close.
// REQUIRES the footprint engine (it consumes its delta/POC), so it is gated on showFP.
showAbs      = input.bool(true,  "Absorption bubbles",      group = grpF, tooltip = "Tick-activity proxy, NOT exchange order-flow. Spot XAUUSD volume is a tick count. Requires the footprint engine.")
absEffort    = input.float(1.6,  "  Effort: vol vs average", minval = 1.0, maxval = 5.0, step = 0.1, group = grpF)
absResult    = input.float(0.35, "  Result: |c-o| / range",  minval = 0.05, maxval = 0.9, step = 0.05, group = grpF)
absImb       = input.float(0.30, "  Delta imbalance min",    minval = 0.05, maxval = 0.9, step = 0.05, group = grpF)
absKeep      = input.int(40,     "  Bubbles kept",           minval = 5, maxval = 200, group = grpF)

// ─────────────────────────── COLORS ───────────────────────────
cBull   = #00D084
cBear   = #FF4D4D
cNeut   = #808A93
cFast   = #FFFFFF
cMid    = #3B82F6
cSlow   = #FFD700
cVwap   = #00BCD4
cBB     = #B084FF
cPrice  = #00E676
cLevel  = #FFD54F
cLevelW = #FF8A65
cCur    = #4DD0E1
cSup    = #26A69A
cRes    = #EF5350
cOB     = #8D6E63
cFVG    = #FF9800
cSweep  = #E040FB

float atr14 = ta.atr(14)
// ta.* must be evaluated on EVERY bar or its rolling window silently desynchronises.
// Both former call sites sat inside conditional blocks — the candle panel's was inside
// `if showCandle and barstate.islast`, so the 20-bar average only ever advanced on the
// final bar and RVOL was computed against a window that had barely accumulated. Hoisted
// here so both consumers read one consistent series.
// SX-BEGIN (v95) the Master's structure + FVG engine, COPIED: every line between SX-BEGIN and SX-END is a Master line,
// in the Master's order (sx_check.py); the backward slice of bosLabel* / chochLabel* / mssLabel* /
// fvgDetected. Edit the Master, then re-copy. One exception: the engine switch showFVG is Visuals' draw switch.
grpModules = "MODULES"
showAdaptiveATR = input.bool(false, "Adaptive ATR Regime", group=grpModules)
grpCore = "CORE"
atrLen = input.int(14, "ATR Base", minval=1, group=grpCore)
adxLen = input.int(14, "ADX", minval=1, group=grpCore)
adxThreshold = input.int(25, "ADX Threshold", minval=10, maxval=50, group=grpCore)
internalPivotLen = input.int(2, "Internal Pivot Len (fast)", minval=1, maxval=5, group=grpCore)
swingPivotLen = input.int(5, "Swing Pivot Len (major)", minval=3, maxval=10, group=grpCore)
atr = ta.atr(atrLen)
[diplus, diminus, adxVal] = ta.dmi(adxLen, adxLen)
volSma20 = ta.sma(volume, 20)
float atrTrending = ta.atr(7)
float atrRanging = ta.atr(21)
float regimeStrength = math.min(math.max((adxVal - (adxThreshold - 5)) / 10.0, 0.0), 1.0)
_rawAdaptiveATR = showAdaptiveATR ? (atrRanging * (1.0 - regimeStrength) + atrTrending * regimeStrength) : atr
adaptiveATR = math.max(nz(_rawAdaptiveATR, ta.tr), close * 0.0001)
pivotHigh = ta.pivothigh(high, internalPivotLen, internalPivotLen)
pivotLow = ta.pivotlow(low, internalPivotLen, internalPivotLen)
var float activeResistance = na
var float activeSupport = na
var float lastBrokenRes = na
var float lastBrokenSup = na
bosResistanceSnap = activeResistance
bosSupportSnap = activeSupport
if not na(pivotHigh)
    if not na(activeResistance)
        lastBrokenRes := activeResistance
    activeResistance := pivotHigh
if not na(pivotLow)
    if not na(activeSupport)
        lastBrokenSup := activeSupport
    activeSupport := pivotLow
swingPivotHigh = ta.pivothigh(high, swingPivotLen, swingPivotLen)
swingPivotLow = ta.pivotlow(low, swingPivotLen, swingPivotLen)
var float swingActiveResistance = na
var float swingActiveSupport = na
var float swingLastBrokenRes = na
var float swingLastBrokenSup = na
swingBosResSnap = swingActiveResistance
swingBosSupSnap = swingActiveSupport
if not na(swingPivotHigh)
    if not na(swingActiveResistance)
        swingLastBrokenRes := swingActiveResistance
    swingActiveResistance := swingPivotHigh
if not na(swingPivotLow)
    if not na(swingActiveSupport)
        swingLastBrokenSup := swingActiveSupport
    swingActiveSupport := swingPivotLow
intBosLabelBull = not na(bosResistanceSnap) and close > bosResistanceSnap and close[1] <= bosResistanceSnap[1] and bosResistanceSnap != lastBrokenRes
intBosLabelBear = not na(bosSupportSnap) and close < bosSupportSnap and close[1] >= bosSupportSnap[1] and bosSupportSnap != lastBrokenSup
swingBosLabelBull = not na(swingBosResSnap) and close > swingBosResSnap and close[1] <= swingBosResSnap[1] and swingBosResSnap != swingLastBrokenRes
swingBosLabelBear = not na(swingBosSupSnap) and close < swingBosSupSnap and close[1] >= swingBosSupSnap[1] and swingBosSupSnap != swingLastBrokenSup
bosLabelBull = intBosLabelBull or swingBosLabelBull
bosLabelBear = intBosLabelBear or swingBosLabelBear
if not na(activeResistance) and close > activeResistance and close[1] <= activeResistance[1] and not na(volume) and volume > volSma20
    lastBrokenRes := activeResistance
    activeResistance := na
if not na(activeSupport) and close < activeSupport and close[1] >= activeSupport[1] and not na(volume) and volume > volSma20
    lastBrokenSup := activeSupport
    activeSupport := na
if not na(swingActiveResistance) and close > swingActiveResistance and close[1] <= swingActiveResistance[1] and not na(volume) and volume > volSma20
    swingLastBrokenRes := swingActiveResistance
    swingActiveResistance := na
if not na(swingActiveSupport) and close < swingActiveSupport and close[1] >= swingActiveSupport[1] and not na(volume) and volume > volSma20
    swingLastBrokenSup := swingActiveSupport
    swingActiveSupport := na
var float seqHigh1 = na
var float seqHigh2 = na
var float seqHigh3 = na
var float seqLow1 = na
var float seqLow2 = na
var float seqLow3 = na
var int seqLastBar = -999
if not na(pivotHigh) or not na(pivotLow)
    if not na(pivotHigh)
        seqHigh3 := seqHigh2
        seqHigh2 := seqHigh1
        seqHigh1 := pivotHigh
    if not na(pivotLow)
        seqLow3 := seqLow2
        seqLow2 := seqLow1
        seqLow1 := pivotLow
    seqLastBar := bar_index
bool seqValid = not na(seqHigh1) and not na(seqHigh2) and not na(seqHigh3) and not na(seqLow1) and not na(seqLow2) and not na(seqLow3)
bool hl = seqValid and seqLow1 > seqLow2
bool lh = seqValid and seqHigh1 < seqHigh2
bool barSpaceOk = (bar_index - seqLastBar) >= 3
float pivotAtrDist = not na(adaptiveATR) ? adaptiveATR * 0.5 : na
bool atrDistOkBull = hl and not na(seqLow1) and not na(seqLow2) and not na(pivotAtrDist) and math.abs(seqLow1 - seqLow2) >= pivotAtrDist
bool atrDistOkBear = lh and not na(seqHigh1) and not na(seqHigh2) and not na(pivotAtrDist) and math.abs(seqHigh1 - seqHigh2) >= pivotAtrDist
bool priorBullSeq = seqValid and seqHigh2 > seqHigh3 and seqLow2 > seqLow3
bool priorBearSeq = seqValid and seqHigh2 < seqHigh3 and seqLow2 < seqLow3
chochLabelBull = priorBearSeq and hl and barSpaceOk and atrDistOkBull
chochLabelBear = priorBullSeq and lh and barSpaceOk and atrDistOkBear
mssLabelBull = chochLabelBull and (seqValid and seqHigh1 > seqHigh2) and barSpaceOk and atrDistOkBull
mssLabelBear = chochLabelBear and (seqValid and seqLow1 < seqLow2) and barSpaceOk and atrDistOkBear
fvgDetected = showFVG and barstate.isconfirmed and ((high[2] < low[0] and low[0] - high[2] > adaptiveATR * 0.3) or (low[2] > high[0] and low[2] - high[0] > adaptiveATR * 0.3))
// SX-END

// ═══════ F-A08 — MASTER DISPLACEMENT ENGINE, PORTED ═══════
// WHY. This file previously computed its own displacement as `body > atr14 * obDispATR`
// with obDispATR defaulting to 1.0, while the Master requires `body > adaptiveATR *
// dispMult` with dispMult defaulting to 2.5 -- a 2.5x looser test. The chart therefore
// drew order blocks on candles the engine does not consider displacement at all, while
// the comment on that block claimed "Master logic mirrored". It was not mirrored.
// (At Master defaults showAdaptiveATR is OFF and atrLen is 14, so adaptiveATR collapses
// to ta.atr(14) and equals atr14 here -- which is why the multiplier was the whole gap.
// The full engine is ported anyway so the two stay equal if Adaptive ATR is switched on.)
// PORTED VERBATIM from Master: adaptive ATR regime blend, the five displacement terms,
// the 2.5x-enter / 1.5x-hold hysteresis latch, and the ONSET edge the Master's order-block
// detector actually triggers on (dispOnsetUp/Down, not the raw or latched signal).
// RESIDUAL DIFFERENCE, STATED. The Master keeps ONE active order block per side with a
// mitigation lifecycle (`not obBullActive`) and has a reversal-OB path for failed
// displacement; this file keeps the last N boxes and has neither. Detection now matches;
// RETENTION still does not, so an old box may persist here that the Master has retired.
// v95: adaptive ATR, ADX and DI are the engine's (SX block above), so the V copies are gone.
// diplus/diminus are UNREAD ON PURPOSE and must not be swept: ta.dmi returns a 3-tuple and
// Pine requires every element be named. Only adxVal is needed here (the Master does use
// its diplus/diminus, in bullTrendScore -- this file has no trend score to feed).
// v67 (operator: nothing is dead, wire it): DI+ / DI- are now shown with ADX in the candle info panel.
float _bodySzV  = math.abs(close - open)
float _cRangeV  = high - low
float _bodyPctV = _cRangeV > 0 ? _bodySzV / _cRangeV * 100.0 : 0.0
bool  _volOkV   = not na(volume) and not na(volSma20) and volume > volSma20 * 1.30
float _dispEnterV = adaptiveATR * obDispATR
float _dispHoldV  = adaptiveATR * (obDispATR * 0.6)
bool _dispRawUpV   = _bodySzV > _dispEnterV and close > open and close > high[1] and _cRangeV > 0 and _bodyPctV > 70 and _volOkV
bool _dispRawDownV = _bodySzV > _dispEnterV and close < open and close < low[1]  and _cRangeV > 0 and _bodyPctV > 70 and _volOkV
var bool dispUpActiveV = false
var bool dispDnActiveV = false
if _dispRawUpV
    dispUpActiveV := true
else if _bodySzV <= _dispHoldV
    dispUpActiveV := false
if _dispRawDownV
    dispDnActiveV := true
else if _bodySzV <= _dispHoldV
    dispDnActiveV := false
bool displacementUpV   = _dispRawUpV or dispUpActiveV
bool displacementDownV = _dispRawDownV or dispDnActiveV
bool dispOnsetUpV   = displacementUpV and not displacementUpV[1]
bool dispOnsetDownV = displacementDownV and not displacementDownV[1]

// ═══════════════════ TREND OVERLAYS (match Master: 20/100/200) ═══════════════════
float ema20  = ta.ema(close, ema20Len)
float ema100 = ta.ema(close, ema100Len)
float ema200 = ta.ema(close, ema200Len)
plot(showEma ? ema20  : na, "EMA 20",  color = cFast, linewidth = 1, display = display.pane)
plot(showEma ? ema100 : na, "EMA 100", color = cMid,  linewidth = 1, display = display.pane)
plot(showEma ? ema200 : na, "EMA 200", color = cSlow, linewidth = 2, display = display.all)

float vwapD = ta.vwap(hlc3)
float vwapW = ta.vwap(hlc3, timeframe.change("1W"))
float vwapM = ta.vwap(hlc3, timeframe.change("1M"))
plot(showVwap ? vwapD : na, "VWAP D", color = cVwap, linewidth = 2, display = display.all)
plot(showVwapWM ? vwapW : na, "VWAP W", color = color.new(cVwap, 40), linewidth = 1, display = display.pane)
plot(showVwapWM ? vwapM : na, "VWAP M", color = color.new(cVwap, 65), linewidth = 1, display = display.pane)

float bbBasis = ta.sma(close, 20)
float bbDev   = 2.0 * ta.stdev(close, 20)
pBBU = plot(showBB ? bbBasis + bbDev : na, "BB Upper", color = color.new(cBB, 25), display = display.pane)
pBBL = plot(showBB ? bbBasis - bbDev : na, "BB Lower", color = color.new(cBB, 25), display = display.pane)
plot(showBB ? bbBasis : na, "BB Basis", color = color.new(cBB, 55), display = display.pane)
fill(pBBU, pBBL, color = color.new(cBB, 96), title = "BB Fill")

// ═══════════════ KEY LEVELS — NY-SESSION ANCHORED (matches the Master) ═══════════════
// AUDIT FIX: this block previously used request.security("D"/"W", high[1]) — the
// EXCHANGE CALENDAR day/week. The Master does NOT: it tracks previous day/week
// extremes against the 17:00 New York close, with the weekly roll detected by the
// PREVIOUS bar being a Friday bar (the market is shut Fri 17:00 -> Sun 17:00 ET, so
// testing the crossing bar's own weekday can never be true — the Master's R5.2-C1
// fix). Calendar levels and NY-session levels are NOT the same numbers, so the chart
// could disagree with the engine trading off them. Master logic replicated verbatim.
// Monthly stays on request.security — that is what the Master uses for PMH/PML.
int msInDay = 86400000
// CHANGE ID: F-033 | NY-day anchor bound to the EXCHANGE timezone instead of New York.
// DEFECT. `hour`/`minute` with no timezone argument return EXCHANGE time, so this resolved
// to "17:00 in whatever timezone the feed reports" -- not 17:00 New York. On a feed whose
// exchange timezone is UTC (common for spot metals/FX), the NY-day rollover fired at
// 17:00 UTC = 13:00 EDT, four hours early, cutting PDH/PDL through the middle of the New
// York session. PWH/PWL and CDH/CDL inherit it: both key off crossedNYDay.
// SECOND DEFECT, same line. There was no DST handling here at all, while the session
// shading block below IS explicitly DST-aware (usIsDST). Two blocks in one file, both
// about New York time, disagreeing on whether DST exists.
// FIX. Read the clock in "America/New_York" explicitly. The offset then comes from the
// IANA zone, so DST is handled by the calendar rather than by arithmetic that has to be
// maintained: the boundary lands on 21:00 UTC in EDT and 22:00 UTC in EST, which is
// exactly the convention F-005 documents. The exchange-timezone dependency is removed
// entirely, so the levels no longer change meaning when the feed's timezone does.
// The final ((x % d) + d) % d normalises the result -- Pine's % can return a negative.
int _nyMsOfDay  = hour(time, "America/New_York") * 3600000 + minute(time, "America/New_York") * 60000
int _nyOffsetMs = _nyMsOfDay - int(time % msInDay)
int nyCloseDayMs = ((17 * 3600000 - _nyOffsetMs) % msInDay + msInDay) % msInDay
var float nyDailyHigh = na
var float nyDailyLow = na
var float prevNyDailyHigh = na
var float prevNyDailyLow = na
var float nyWeeklyHigh = na
var float nyWeeklyLow = na
var float prevNyWeeklyHigh = na
var float prevNyWeeklyLow = na
bool crossedNYDay = false
if not na(time[1])
    int tMod = time % msInDay
    int t1Mod = time[1] % msInDay
    if tMod > t1Mod
        crossedNYDay := t1Mod < nyCloseDayMs and tMod >= nyCloseDayMs
    else
        // F-004 PARITY (see Master for the full rationale): strict `<`, not `<=`. A bar
        // opening exactly on the boundary has already consumed the rollover; `<=` re-fired
        // when the next bar wrapped past midnight, double-resetting the NY day on 2H (EST)
        // and 3H (EDT). Chart and engine must agree on every timeframe.
        crossedNYDay := t1Mod < nyCloseDayMs or tMod >= nyCloseDayMs
// CHANGE ID: P1-LVL-002 | Timeframe robustness of the NY-anchored rollover.
// FINDING (simulated across 1M/5M/15M/1H/4H/D/W): the boundary detector is correct on
// every INTRADAY timeframe and on D. On W and above it degenerates twice over:
//  (a) tMod == t1Mod on every bar (bar times are a whole number of days apart), so the
//      wrap-case `t1Mod <= C or tMod >= C` is a tautology -> crossedNYDay fires EVERY
//      bar. On D that is harmless and in fact correct (prev bar = prev day). On W it
//      makes "PDH/PDL" silently mean PREVIOUS WEEK's high/low under a daily label.
//  (b) crossedNYWeek additionally required the previous bar to be a Friday. Weekly bars
//      open Sunday/Monday, so that test is NEVER true -> PWH/PWL never rolled and stayed
//      na forever (measured: 0 week-rollovers over 700 simulated days on W).
// FIX: on D-and-above use timeframe.change("1W"), which resolves the weekly boundary off
// the exchange calendar and is correct on D, W and MN alike (verified). Intraday keeps
// the NY 17:00-Friday anchor, which is the more precise trading convention and is
// already correct there — so no intraday behaviour changes.
bool _tfDayPlus = timeframe.in_seconds() >= 86400
bool crossedNYWeek = _tfDayPlus ? timeframe.change("1W") : (crossedNYDay and dayofweek(nz(time[1], time), "UTC") == dayofweek.friday)
if na(nyDailyHigh)
    // FIX (PDH/PDL parity with Master): previous-session values are no longer seeded
    // from the chart's first bar. Seeding them fabricated a "previous day" equal to
    // one bar's range, which on a fresh chart drew PDH/PDL right on top of price.
    // They stay na until the first genuine rollover; f_tagAdd/f_level already skip
    // na values, so the lines and labels are simply absent until real data exists.
    nyDailyHigh := high
    nyDailyLow := low
    nyWeeklyHigh := high
    nyWeeklyLow := low
else if crossedNYDay
    prevNyDailyHigh := nyDailyHigh
    prevNyDailyLow := nyDailyLow
    nyDailyHigh := high
    nyDailyLow := low
    if crossedNYWeek
        prevNyWeeklyHigh := nyWeeklyHigh
        prevNyWeeklyLow := nyWeeklyLow
        nyWeeklyHigh := high
        nyWeeklyLow := low
else
    nyDailyHigh := math.max(nz(nyDailyHigh, high), high)
    nyDailyLow := math.min(nz(nyDailyLow, low), low)
    nyWeeklyHigh := math.max(nz(nyWeeklyHigh, high), high)
    nyWeeklyLow := math.min(nz(nyWeeklyLow, low), low)

// P1-LVL-002 (b) PARITY: mirrors the Master's suppression above D, where a "previous
// DAY" extreme is undefined and the detector would otherwise resolve to the previous
// week/month under a PDH/PDL label. na simply omits the tag (f_tagAdd is na-guarded),
// so the chart and the engine still agree on every timeframe.
bool _tfAboveD = timeframe.in_seconds() > 86400
float pdh = _tfAboveD ? na : prevNyDailyHigh
float pdl = _tfAboveD ? na : prevNyDailyLow
// P1-LVL-002 (c) PARITY: mirrors the Master's suppression above W.
bool _tfAboveW = timeframe.in_seconds() > 604800
float pwh = _tfAboveW ? na : prevNyWeeklyHigh
float pwl = _tfAboveW ? na : prevNyWeeklyLow
[pmh, pml] = request.security(syminfo.tickerid, "M", [high[1], low[1]], gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_on)

// CURRENT-DAY extremes (CDH/CDL) — same NY anchor. Present in the Master as live TP
// candidates but never drawn here, so the chart omitted two levels the engine targets.
var float cdh = na
var float cdl = na
if crossedNYDay
    cdh := high
    cdl := low
else
    cdh := math.max(nz(cdh, high), high)
    cdl := math.min(nz(cdl, low), low)

// ═══════════════════ STRUCTURE — pivots, BOS / CHoCH, sweeps ═══════════════════
float ph = ta.pivothigh(pivotLen, pivotLen)
float pl = ta.pivotlow(pivotLen, pivotLen)
plotshape(showPivots and not na(ph) ? high[pivotLen] : na, "Swing High", shape.triangledown, location.absolute, cBear, offset = -pivotLen, size = size.tiny)
plotshape(showPivots and not na(pl) ? low[pivotLen]  : na, "Swing Low",  shape.triangleup,   location.absolute, cBull, offset = -pivotLen, size = size.tiny)

var float lastPH   = na
var float lastPL   = na
if not na(ph)
    lastPH := high[pivotLen]
if not na(pl)
    lastPL := low[pivotLen]

// v95: structure breaks are the ENGINE'S (SX block): BOS on its two pivot scales, CHoCH / MSS on its HH / HL / LH / LL
// sequence; the events are the first bar of each state, as the Master's alert reports them.
bool sxChochUp = chochLabelBull and not chochLabelBull[1]
bool sxChochDn = chochLabelBear and not chochLabelBear[1]
bool sxMssUp = mssLabelBull and not mssLabelBull[1]
bool sxMssDn = mssLabelBear and not mssLabelBear[1]

// AUDIT FIX (object lifecycle): these were the ONLY uncapped drawing calls in this
// script — a label + line per structure break, never deleted. On a long chart they
// exhaust max_labels_count/max_lines_count (500), at which point TradingView silently
// drops the OLDEST objects, which also starves the tag registry below. Now bounded.
var label[] structLb = array.new<label>()
var line[]  structLn = array.new<line>()
if showStruct and barstate.isconfirmed
    if bosLabelBull or sxChochUp or sxMssUp
        array.push(structLb, label.new(bar_index, high, sxMssUp ? "MSS▲" : sxChochUp ? "CHoCH▲" : "BOS▲", xloc.bar_index, yloc.abovebar, color.new(cBull, 20), label.style_label_down, color.white, size.tiny))
        if bosLabelBull
            float _bl = intBosLabelBull ? bosResistanceSnap : swingBosResSnap
            array.push(structLn, line.new(bar_index - 1, _bl, bar_index, _bl, xloc.bar_index, extend.none, cBull, line.style_solid, 2))
    if bosLabelBear or sxChochDn or sxMssDn
        array.push(structLb, label.new(bar_index, low, sxMssDn ? "MSS▼" : sxChochDn ? "CHoCH▼" : "BOS▼", xloc.bar_index, yloc.belowbar, color.new(cBear, 20), label.style_label_up, color.white, size.tiny))
        if bosLabelBear
            float _bs = intBosLabelBear ? bosSupportSnap : swingBosSupSnap
            array.push(structLn, line.new(bar_index - 1, _bs, bar_index, _bs, xloc.bar_index, extend.none, cBear, line.style_solid, 2))
    while array.size(structLb) > structKeep
        label.delete(array.shift(structLb))
    while array.size(structLn) > structKeep
        line.delete(array.shift(structLn))

// Liquidity sweep = trade beyond a confirmed pivot, then close back inside it.
bool sweepUp = showSweep and not na(lastPH) and high > lastPH and close < lastPH and barstate.isconfirmed
bool sweepDn = showSweep and not na(lastPL) and low  < lastPL and close > lastPL and barstate.isconfirmed
plotshape(sweepUp ? high : na, "Sweep High", shape.xcross, location.absolute, cSweep, size = size.tiny)
plotshape(sweepDn ? low  : na, "Sweep Low",  shape.xcross, location.absolute, cSweep, size = size.tiny)
// v75: the last pivot sweep the ✕ markers show, kept for the LIQUIDITY · SWEEPS block (display only)
var string pvLastSweep = "none yet"
var float pvLastLvl = na
var int pvLastTime = na
var bool pvLastUp = false
if sweepUp or sweepDn
    pvLastLvl := sweepUp ? lastPH : lastPL
    pvLastTime := time
    pvLastUp := sweepUp
    pvLastSweep := (sweepUp ? "HIGH " + str.tostring(lastPH, format.mintick) : "LOW " + str.tostring(lastPL, format.mintick)) + "  " + str.format_time(time, "MM-dd HH:mm", "UTC") + " UTC"
// v84: the ✕ pivot sweeps as an alert() too. It fires only if an alert is created on Visuals ("Any alert() function
// call"); the Master's one alert already carries the engine's pool sweeps (PDH/PDL, PWH/PWL, PMH/PML), H2's swing
// sweeps, CHoCH / BOS / MSS and the confirmed BUY / SELL with its plan. Bar close only (sweepUp / sweepDn are confirmed).
alertOnPvSweep = input.bool(true, "Alert on pivot sweeps (✕)", group = grpS, tooltip = "Needs an alert on Visuals (Any alert() function call); on a plan with one alert, put it on the Master instead: it carries the engine's sweeps, CHoCH and the confirmed signals.")
if alertOnPvSweep and (sweepUp or sweepDn)
    alert("XAUUSD " + timeframe.period + " pivot sweep " + pvLastSweep + " (TradingView price; Visuals' detector, info only)", alert.freq_once_per_bar_close)

// ═══════════════════ FAIR VALUE GAPS (Master's corrected bounds) ═══════════════════
// Bullish (BISI): low[0] > high[2] -> gap [high[2], low[0]]
// Bearish (SIBI): low[2] > high[0] -> gap [high[0], low[2]]
// Store for the OB/FVG zone labels relocated from the Master. Capped alongside obBoxes so
// label objects cannot accumulate past Pine's per-script drawing limit.
var label[] obLbls = array.new<label>()
var box[] fvgBoxes = array.new<box>()
if fvgDetected and bar_index > 3   // v95: the engine's detector (SX block)
    bool bullGap = low > high[2]
    bool bearGap = low[2] > high
    float gLo = bullGap ? high[2] : bearGap ? high   : na
    float gHi = bullGap ? low     : bearGap ? low[2] : na
    if not na(gLo)
        color _fc = zoneFlatCol ? cFVG : bullGap ? cBull : cBear
        box nb = box.new(bar_index - 2, gHi, bar_index + fvgMaxBars, gLo, border_color = color.new(_fc, 78), border_width = 1, bgcolor = color.new(_fc, boxFade))
        array.push(fvgBoxes, nb)
        if obShowLabel
            array.push(obLbls, label.new(bar_index - 2, gHi, "FVG", xloc.bar_index, yloc.price, color.new(color.black, 100), label.style_label_down, _fc, size.tiny))
    // Mitigation sweep — snapshot the size and iterate downward so removals stay in range.
    int fvgN = array.size(fvgBoxes)
    if fvgN > 0
        for i = fvgN - 1 to 0
            if i < array.size(fvgBoxes)
                box bx = array.get(fvgBoxes, i)
                float bTop = box.get_top(bx)
                float bBot = box.get_bottom(bx)
                if low < bTop and high > bBot
                    box.set_right(bx, bar_index)
                    box.set_bgcolor(bx, color.new(cNeut, 92))
                    box.set_border_color(bx, color.new(cNeut, 70))
                    array.remove(fvgBoxes, i)
    while array.size(fvgBoxes) > 30
        array.remove(fvgBoxes, 0)

// ═══════════════════ ORDER BLOCKS ═══════════════════
// F-A08: detection now comes from the ported Master displacement engine above
// (dispOnsetUpV / dispOnsetDownV) instead of a local, 2.5x-looser body > ATR test.
// Two further corrections in the same pass:
//   * it triggers on the displacement ONSET edge, exactly as the Master's order-block
//     detector does, not on every bar the displacement remains true -- which previously
//     pushed a fresh box per bar for the whole run.
//   * the local `close[1] < open[1]` / `close[1] > open[1]` filter is REMOVED. The Master
//     takes the PREVIOUS bar as the order block regardless of that bar's direction
//     (obBullHigh := high[1] on dispOnsetUp), so this filter was suppressing boxes the
//     engine does record.
// RETENTION still differs from the Master by design -- see the note on the engine above.
var box[] obBoxes = array.new<box>()
if showOB and barstate.isconfirmed and bar_index > 3
    if dispOnsetUpV
        color _oc = zoneFlatCol ? cOB : cBull
        box ob = box.new(bar_index - 1, high[1], bar_index + 40, low[1], border_color = color.new(_oc, 72), border_width = 1, bgcolor = color.new(_oc, boxFade))
        array.push(obBoxes, ob)
        // OB/FVG zone LABELS relocated here from the Master (which was over the Pine token
        // limit). The Master already drew these zones as boundary lines + a label while this
        // file drew them as filled boxes, so every zone was rendered twice in two styles.
        // Rendering is now consolidated here: the box carries the zone, this label carries
        // its identity, and the Master keeps the detection that feeds the decision engine.
        if obShowLabel
            array.push(obLbls, label.new(bar_index - 1, high[1], "OB▲", xloc.bar_index, yloc.price, color.new(color.black, 100), label.style_label_down, _oc, size.tiny))
    if dispOnsetDownV
        color _oc2 = zoneFlatCol ? cOB : cBear
        box ob2 = box.new(bar_index - 1, high[1], bar_index + 40, low[1], border_color = color.new(_oc2, 72), border_width = 1, bgcolor = color.new(_oc2, boxFade))
        array.push(obBoxes, ob2)
        if obShowLabel
            array.push(obLbls, label.new(bar_index - 1, low[1], "OB▼", xloc.bar_index, yloc.price, color.new(color.black, 100), label.style_label_up, _oc2, size.tiny))
    while array.size(obBoxes) > obKeep * 2
        box old = array.shift(obBoxes)
        box.delete(old)
    while array.size(obLbls) > obKeep * 3
        label.delete(array.shift(obLbls))

// ═══════════════════ SESSION SHADING — DST-AWARE (matches the Master) ═══════════════════
// AUDIT FIX: this block used FIXED UTC hours (London 7-16, NY 12-21) while the Master
// derives its session windows from EU and US daylight-saving trackers:
//     londonClose = euIsDST ? 16 : 17
//     nyOpen      = usIsDST ? 14 : 15      nyClose = usIsDST ? 20 : 21
// The NY window was therefore shaded from 12:00 UTC while the engine only counts NY
// from 14:00/15:00 — a 2-3 hour disagreement, and the London/NY overlap highlight was
// wrong with it. Since sessionQuality gates trades, the chart was telling you a
// different session than the one the decision engine was scoring. Master trackers
// replicated verbatim below.
int _dom = dayofmonth(time, "UTC")
int _mon = month(time, "UTC")
int _yr  = year(time, "UTC")
int _dow = dayofweek(time, "UTC")
int _thisSunDom = _dom - ((_dow - 1 + 7) % 7)
int _firstSunDom = _thisSunDom - 7 * int((_thisSunDom - 1) / 7)
if _firstSunDom < 1
    _firstSunDom := _firstSunDom + 7
var int usDstStartDom = 8
var int usDstEndDom = 1
var int _lastUsDstYr = 0
if _yr != _lastUsDstYr
    usDstStartDom := 8
    usDstEndDom := 1
    _lastUsDstYr := _yr
if _mon == 3
    usDstStartDom := _firstSunDom + 7
if _mon == 11
    usDstEndDom := _firstSunDom
bool usIsDST = (_mon > 3 and _mon < 11) or (_mon == 3 and _dom >= usDstStartDom) or (_mon == 11 and _dom < usDstEndDom)
var int euDstStartDom = 25
var int euDstEndDom = 25
var int _lastEuDstYr = 0
if _yr != _lastEuDstYr
    euDstStartDom := 25
    euDstEndDom := 25
    _lastEuDstYr := _yr
// v63 (F-A62): the last Sunday of the month from today's date, as in the Master (the old tracker assumed the 25th
// until it saw that Sunday, so London DST was wrong for up to 5 trading days a year).
if _mon == 3
    euDstStartDom := 31 - ((_dow - 1 + 31 - _dom) % 7)
if _mon == 10
    euDstEndDom := 31 - ((_dow - 1 + 31 - _dom) % 7)
bool euIsDST = (_mon > 3 and _mon < 10) or (_mon == 3 and _dom >= euDstStartDom) or (_mon == 10 and _dom < euDstEndDom)

int hU = hour(time, "UTC")
int londonOpen  = 7
int londonClose = euIsDST ? 16 : 17
int nyOpen      = usIsDST ? 14 : 15
int nyClose     = usIsDST ? 20 : 21
bool inAsian  = hU >= 0 and hU < londonOpen
bool inLondon = hU >= londonOpen and hU < londonClose
bool inNY     = hU >= nyOpen and hU < nyClose
bgcolor(showSess and inLondon and inNY ? color.new(#FFD54F, 95) : showSess and inLondon ? color.new(#4DA6FF, 95) : showSess and inNY ? color.new(#00D084, 95) : showSess and inAsian ? color.new(#B084FF, 96) : na, title = "Sessions")
// v37: SESSION INTELLIGENCE moved here from the Master (token ceiling; display only, it fed no
// gate there). f_sessionIntel is the Treatment engine's function VERBATIM (sess_parity.py checks
// it) on this file's session clock, which matches the engine's hours (London 07 UTC, NY by US DST).
// SESSIntel-BEGIN
f_sessionIntel() =>
    // ═══════════════ R6.0 SESSION INTELLIGENCE ═══════════════
    // Per-session-class rolling statistics (Asian=0, London=1, NY=2), confirmed bars only.
    // avg range = EWMA (a~0.1, ~ last 20 sessions); manipulation = swept the PREVIOUS
    // session's extreme intra-session but closed back inside; continuation = session closed
    // beyond 50% of its own range from its open (directional session).
    int sessId = inAsian ? 0 : inLondon ? 1 : inNY ? 2 : 3
    var int curSessId = -1
    var float sesHi = na
    var float sesLo = na
    var float sesOpenPx = na
    var float prevSesHi = na
    var float prevSesLo = na
    var bool sesManip = false
    var float[] sessRngAvg = array.from(0.0, 0.0, 0.0)
    var int[] sessCnt = array.from(0, 0, 0)
    var int[] sessManipCnt = array.from(0, 0, 0)
    var int[] sessContCnt = array.from(0, 0, 0)
    if barstate.isconfirmed
        if sessId != curSessId
            if curSessId >= 0 and curSessId <= 2 and not na(sesHi)
                float _rngS = sesHi - sesLo
                int _cS = array.get(sessCnt, curSessId)
                array.set(sessRngAvg, curSessId, _cS == 0 ? _rngS : array.get(sessRngAvg, curSessId) * 0.9 + _rngS * 0.1)
                array.set(sessCnt, curSessId, _cS + 1)
                if sesManip
                    array.set(sessManipCnt, curSessId, array.get(sessManipCnt, curSessId) + 1)
                if _rngS > 0 and math.abs(close[1] - sesOpenPx) / _rngS > 0.5
                    array.set(sessContCnt, curSessId, array.get(sessContCnt, curSessId) + 1)
            prevSesHi := sesHi
            prevSesLo := sesLo
            curSessId := sessId
            sesHi := high
            sesLo := low
            sesOpenPx := open
            sesManip := false
        else
            sesHi := math.max(nz(sesHi, high), high)
            sesLo := math.min(nz(sesLo, low), low)
            if not na(prevSesHi) and not na(prevSesLo) and ((high > prevSesHi and close < prevSesHi) or (low < prevSesLo and close > prevSesLo))
                sesManip := true
    float sessAvgRange = curSessId >= 0 and curSessId <= 2 ? array.get(sessRngAvg, curSessId) : na
    float sessExpansionPct = not na(sessAvgRange) and sessAvgRange > 0 and not na(sesHi) ? (sesHi - sesLo) / sessAvgRange * 100.0 : na
    int _sessN = curSessId >= 0 and curSessId <= 2 ? array.get(sessCnt, curSessId) : 0
    float sessManipProb = _sessN >= 5 ? array.get(sessManipCnt, curSessId) * 100.0 / _sessN : na
    float sessContProb = _sessN >= 5 ? array.get(sessContCnt, curSessId) * 100.0 / _sessN : na
    [sessId, curSessId, sesHi, sesLo, sesOpenPx, prevSesHi, prevSesLo, sesManip, sessExpansionPct, sessManipProb, sessContProb]
[sessId, curSessId, sesHi, sesLo, sesOpenPx, prevSesHi, prevSesLo, sesManip, sessExpansionPct, sessManipProb, sessContProb] = f_sessionIntel()
// SESSIntel-END
// Session volume vs its own per-session EWMA (alpha 0.01, ~100-bar half-life), from the Master.
var float volAsianEWMA = 0.0
var float volLondonEWMA = 0.0
var float volNyEWMA = 0.0
if barstate.isconfirmed and not na(volume)
    if inAsian
        volAsianEWMA := volAsianEWMA > 0 ? 0.99 * volAsianEWMA + 0.01 * volume : volume
    else if inLondon
        volLondonEWMA := volLondonEWMA > 0 ? 0.99 * volLondonEWMA + 0.01 * volume : volume
    else if inNY
        volNyEWMA := volNyEWMA > 0 ? 0.99 * volNyEWMA + 0.01 * volume : volume
float sessVolBase = inAsian ? volAsianEWMA : inLondon ? volLondonEWMA : inNY ? volNyEWMA : 0.0
// v86: 95% ranges for the session history percentages (the CHECKS & RISK section, the H2 card and the panel)
// Wilson 95% interval for k successes in n (0-1); [na, na] if n = 0
f_wil(float k, int n) =>
    float lo = na
    float hi = na
    if n > 0 and not na(k)
        float z = 1.959964
        float p = k / n
        float d = 1.0 + z * z / n
        float c = (p + z * z / (2.0 * n)) / d
        float h = z * math.sqrt(math.max(p * (1.0 - p) / n + z * z / (4.0 * n * n), 0.0)) / d
        lo := math.max(0.0, c - h)
        hi := math.min(1.0, c + h)
    [lo, hi]
// " (lo–hi) nN" for a percentage measured on n cases, "" if undefined
f_ci(float pct, int n) =>
    string out = ""
    if not na(pct) and n > 0
        [lo, hi] = f_wil(math.round(pct * n / 100.0), n)
        out := " (" + str.tostring(lo * 100.0, "#") + "–" + str.tostring(hi * 100.0, "#") + ") n" + str.tostring(n)
    out
// ---- session history sample size: the SESSIntel block's own count (sessCnt), rebuilt outside the byte-locked block
// from its outputs: a session closes when curSessId changes on a confirmed bar, the old one was 0-2 and had a range
var int[] ckSessN = array.from(0, 0, 0)
if barstate.isconfirmed and not na(curSessId[1]) and curSessId != curSessId[1] and curSessId[1] >= 0 and curSessId[1] <= 2 and not na(sesHi[1])
    array.set(ckSessN, curSessId[1], array.get(ckSessN, curSessId[1]) + 1)
int ckN = curSessId >= 0 and curSessId <= 2 ? array.get(ckSessN, curSessId) : 0


// ═══════════════════ SUPPORT & RESISTANCE ═══════════════════
// Confirmed swing pivots, clustered by ATR proximity so repeated tests of the same
// area merge into ONE level carrying a touch count. Non-repainting (pivots confirm
// pivotLen bars back). Levels flip side naturally as price crosses them, and are
// auto-hidden once price travels beyond srMaxDistATR.
var float[] srPrice = array.new<float>()
var int[]   srHits  = array.new<int>()

f_srAdd(_px) =>
    if not na(_px) and showSR
        int hit = -1
        for i = 0 to math.max(array.size(srPrice) - 1, 0)
            if array.size(srPrice) > 0 and math.abs(array.get(srPrice, i) - _px) <= atr14 * srMergeATR
                hit := i
                break
        if hit >= 0
            int c = array.get(srHits, hit)
            array.set(srPrice, hit, (array.get(srPrice, hit) * c + _px) / (c + 1))
            array.set(srHits, hit, c + 1)
        else
            array.push(srPrice, _px)
            array.push(srHits, 1)
        while array.size(srPrice) > srMaxKeep
            array.shift(srPrice)
            array.shift(srHits)

if not na(ph)
    f_srAdd(high[pivotLen])
if not na(pl)
    f_srAdd(low[pivotLen])

// Nearest levels as SERIES so they can publish to the right price axis.
float nearestRes = na
float nearestSup = na
if showSR and array.size(srPrice) > 0
    for i = 0 to array.size(srPrice) - 1
        float lv = array.get(srPrice, i)
        if lv > close and (na(nearestRes) or lv < nearestRes)
            nearestRes := lv
        if lv < close and (na(nearestSup) or lv > nearestSup)
            nearestSup := lv
plot(nearestRes, "Resistance", color = cRes, display = display.price_scale, editable = false)
plot(nearestSup, "Support", color = cSup, display = display.price_scale, editable = false)

// ═══════════════════ TAG REGISTRY (collision-aware labelling) ═══════════════════
// Pine has NO automatic label layout. Every tag is registered here, then a single
// pass sorts them by price and enforces a minimum vertical gap, pushing colliding
// labels apart. The dotted LEADER LINE always runs from the current candle at the
// line's TRUE value to the (possibly nudged) label, so a displaced tag still
// points unambiguously at the thing it labels.
var float[]  tgPx = array.new<float>()
var string[] tgTx = array.new<string>()
var color[]  tgCl = array.new<color>()
var line[]   tgLn = array.new<line>()
var label[]  tgLb = array.new<label>()

f_tagAdd(_px, _txt, _col, _on) =>
    if _on and not na(_px)
        array.push(tgPx, _px)
        array.push(tgTx, _txt)
        array.push(tgCl, _col)

if barstate.islast
    while array.size(tgLn) > 0
        line.delete(array.pop(tgLn))
    while array.size(tgLb) > 0
        label.delete(array.pop(tgLb))
    array.clear(tgPx)
    array.clear(tgTx)
    array.clear(tgCl)

    f_tagAdd(close,           str.tostring(close, format.mintick), cPrice, showPriceLine)
    // Extended horizontal reference at the live price. The registry only draws a short
    // leader into the tag; this restores the full-width line the V2 rewrite dropped.
    if showPriceLine
        array.push(tgLn, line.new(math.max(bar_index - 250, 0), close, bar_index + tagOffset, close, xloc.bar_index, extend.right, color.new(cPrice, 55), line.style_dotted, 1))
    f_tagAdd(ema20,           "EMA " + str.tostring(ema20Len),  cFast, showTags and showEma)
    f_tagAdd(ema100,          "EMA " + str.tostring(ema100Len), cMid,  showTags and showEma)
    f_tagAdd(ema200,          "EMA " + str.tostring(ema200Len), cSlow, showTags and showEma)
    f_tagAdd(vwapD,           "VWAP D",  cVwap, showTags and showVwap)
    f_tagAdd(vwapW,           "VWAP W",  cVwap, showTags and showVwapWM)
    f_tagAdd(vwapM,           "VWAP M",  cVwap, showTags and showVwapWM)
    f_tagAdd(bbBasis + bbDev, "BB +2σ",  cBB,   showTags and showBB)
    f_tagAdd(bbBasis - bbDev, "BB −2σ",  cBB,   showTags and showBB)
    f_tagAdd(pdh, "PDH " + str.tostring(pdh, format.mintick), cLevel,  showLevels)
    f_tagAdd(pdl, "PDL " + str.tostring(pdl, format.mintick), cLevel,  showLevels)
    f_tagAdd(pwh, "PWH " + str.tostring(pwh, format.mintick), cLevelW, showLevels)
    f_tagAdd(pwl, "PWL " + str.tostring(pwl, format.mintick), cLevelW, showLevels)
    f_tagAdd(pmh, "PMH " + str.tostring(pmh, format.mintick), cNeut,   showMonthly)
    f_tagAdd(pml, "PML " + str.tostring(pml, format.mintick), cNeut,   showMonthly)
    f_tagAdd(cdh, "CDH " + str.tostring(cdh, format.mintick), cCur,    showCurDay)
    f_tagAdd(cdl, "CDL " + str.tostring(cdl, format.mintick), cCur,    showCurDay)

    // S/R: nearest srCount each side, auto-hidden beyond srMaxDistATR
    if showSR and array.size(srPrice) > 0
        float maxDist = atr14 * srMaxDistATR
        for _side = 0 to 1
            float lastPick = na
            for _rank = 0 to srCount - 1
                float best = na
                int bestHits = 0
                for i = 0 to array.size(srPrice) - 1
                    float lv = array.get(srPrice, i)
                    bool sideOk = _side == 0 ? lv > close : lv < close
                    bool beyond = na(lastPick) or (_side == 0 ? lv > lastPick : lv < lastPick)
                    bool closer = na(best) or (_side == 0 ? lv < best : lv > best)
                    if sideOk and beyond and closer and math.abs(lv - close) <= maxDist
                        best := lv
                        bestHits := array.get(srHits, i)
                if not na(best)
                    color _sc = _side == 0 ? cRes : cSup
                    f_tagAdd(best, (_side == 0 ? "R" : "S") + str.tostring(_rank + 1) + " " + str.tostring(best, format.mintick) + " ×" + str.tostring(bestHits), _sc, true)
                    line sl = line.new(math.max(bar_index - 200, 0), best, bar_index + tagOffset, best, xloc.bar_index, extend.none, color.new(_sc, 70), line.style_dotted, bestHits >= 3 ? 2 : 1)
                    array.push(tgLn, sl)
                    lastPick := best

    // collision pass: sort by price, push overlapping labels apart
    int nTag = array.size(tgPx)
    if nTag > 0
        int[] ord = array.sort_indices(tgPx, order.ascending)
        float minGap = atr14 * tagGapATR
        float prevY = na
        for k = 0 to nTag - 1
            int i = array.get(ord, k)
            float truePx = array.get(tgPx, i)
            float dispY = na(prevY) or minGap <= 0 ? truePx : math.max(truePx, prevY + minGap)
            prevY := dispY
            color c = array.get(tgCl, i)
            line ln = line.new(bar_index, truePx, bar_index + tagOffset, dispY, xloc.bar_index, extend.none, color.new(c, 45), line.style_dotted, 1)
            label lb = label.new(bar_index + tagOffset, dispY, array.get(tgTx, i), xloc.bar_index, yloc.price, color.new(c, 82), label.style_label_left, c, size.small)
            array.push(tgLn, ln)
            array.push(tgLb, lb)

// ═══════════════════ CANDLE INFO PANEL ═══════════════════
var table tblC = na
if vSep and showCandle and barstate.islast
    if na(tblC)
        tblC := table.new(candlePos == "Top Right" ? (dkOn ? position.middle_right : position.top_right) : candlePos == "Middle Right" ? position.middle_right : candlePos == "Bottom Right" ? position.bottom_right : position.top_left, 1, 1, bgcolor = color.new(#101418, 12), border_width = 0, frame_width = 0)
    float rngC   = high - low
    float atrPct = close > 0 ? atr14 / close * 100.0 : na
    float rvol   = not na(volSma20) and volSma20 > 0 ? volume / volSma20 : na
    bool  isUp   = close >= open
    string cTxt = "O " + str.tostring(open, format.mintick) + "   H " + str.tostring(high, format.mintick) + "\nL " + str.tostring(low, format.mintick) + "   C " + str.tostring(close, format.mintick) + "\nRNG " + str.tostring(rngC, "#.##") + "  (" + str.tostring(atr14 > 0 ? rngC / atr14 : na, "#.##") + " ATR)\nATR% " + str.tostring(atrPct, "#.###") + "   " + (isUp ? "▲ UP" : "▼ DOWN") + (na(rvol) ? "" : "\nRVOL " + str.tostring(rvol, "#.##") + "x") + (na(adxVal) ? "" : "\nADX " + str.tostring(adxVal, "#.#") + "  DI+ " + str.tostring(diplus, "#.#") + " / DI- " + str.tostring(diminus, "#.#"))
    table.cell(tblC, 0, 0, cTxt, bgcolor = color.new(#101418, 12), text_color = isUp ? cBull : cBear, text_size = size.small, text_halign = text.align_left)
if (not showCandle or not vSep) and not na(tblC)
    table.delete(tblC)
    tblC := na

// ═══════════════════ FOOTPRINT APPROXIMATION ═══════════════════
// Intrabar volume via request.security_lower_tf(), classified by the tick rule and
// binned by price. NOT exchange bid/ask footprint — Pine has no order-flow feed.
array<float> ltfC = request.security_lower_tf(syminfo.tickerid, fpTf, close)
array<float> ltfO = request.security_lower_tf(syminfo.tickerid, fpTf, open)
array<float> ltfV = request.security_lower_tf(syminfo.tickerid, fpTf, volume)

var box[]   fpBoxes  = array.new<box>()
var label[] fpLabels = array.new<label>()
var label[] absLbls  = array.new<label>()
float absVolSma = ta.sma(volume, 20)
float fpPOC   = na
float fpDelta = na

if showFP and barstate.isconfirmed
    int nI = array.size(ltfV)
    if nI > 0 and high > low
        float buyV  = 0.0
        float sellV = 0.0
        array<float> binV = array.new<float>(fpBins, 0.0)
        float rngF = high - low
        float binH = rngF / fpBins
        for i = 0 to nI - 1
            float c = array.get(ltfC, i)
            float o = array.get(ltfO, i)
            float v = nz(array.get(ltfV, i), 0.0)
            if c > o
                buyV += v
            else if c < o
                sellV += v
            else
                buyV  += v * 0.5
                sellV += v * 0.5
            int bi = binH > 0 ? int(math.floor((c - low) / binH)) : 0
            bi := math.min(math.max(bi, 0), fpBins - 1)
            array.set(binV, bi, array.get(binV, bi) + v)
        fpDelta := buyV - sellV
        float maxV = 0.0
        int   maxI = 0
        for b = 0 to fpBins - 1
            if array.get(binV, b) > maxV
                maxV := array.get(binV, b)
                maxI := b
        fpPOC := low + binH * (maxI + 0.5)
        if showFpBins and maxV > 0
            for b = 0 to fpBins - 1
                float bv = array.get(binV, b)
                if bv > 0
                    int tr = int(math.max(78.0, 97.0 - bv / maxV * 19.0))
                    box nb2 = box.new(bar_index, low + binH * (b + 1), bar_index + 1, low + binH * b, border_color = color.new(cNeut, 90), border_width = 1, bgcolor = color.new(fpDelta >= 0 ? cBull : cBear, tr))
                    array.push(fpBoxes, nb2)
        // --- Absorption detection (reuses the footprint's own delta and POC) ---
        if showAbs and not na(absVolSma) and absVolSma > 0
            float _totV   = buyV + sellV
            float _effort = _totV / absVolSma
            float _result = rngF > 0 ? math.abs(close - open) / rngF : 1.0
            float _imb    = _totV > 0 ? math.abs(fpDelta) / _totV : 0.0
            if _effort >= absEffort and _result <= absResult and _imb >= absImb
                // Aggression that failed to move price = that side was ABSORBED, so the
                // implication runs AGAINST the aggressor.
                bool _buyAbsorbed = fpDelta > 0
                color _ac = _buyAbsorbed ? cBear : cBull
                string _tag = (_buyAbsorbed ? "▼" : "▲") + " ABS " + str.tostring(_effort, "#.#") + "x"
                label ab = label.new(bar_index, fpPOC, _tag, xloc.bar_index, yloc.price, color.new(_ac, 82), _buyAbsorbed ? label.style_label_down : label.style_label_up, _ac, _effort >= absEffort * 1.75 ? size.small : size.tiny)
                array.push(absLbls, ab)
        if showFpDelta
            label dl = label.new(bar_index, low, (fpDelta >= 0 ? "+" : "") + str.tostring(fpDelta / 1000.0, "#.#") + "k", xloc.bar_index, yloc.belowbar, color.new(color.black, 100), label.style_label_up, fpDelta >= 0 ? cBull : cBear, size.tiny)
            array.push(fpLabels, dl)
    while array.size(fpBoxes) > fpBars * fpBins
        box ob3 = array.shift(fpBoxes)
        box.delete(ob3)
    while array.size(absLbls) > absKeep
        label.delete(array.shift(absLbls))
    while array.size(fpLabels) > fpBars
        label ol = array.shift(fpLabels)
        label.delete(ol)

plot(showFP and showFpPOC ? fpPOC : na, "Bar volume POC", color = color.new(#FFD54F, 10), style = plot.style_circles, linewidth = 2, display = display.pane)


// ===== S/R SCANNER (ported verbatim from the Master) ==========================
scanSRLevels(float[] srResLevels, float[] srResStrengths, float[] srSupLevels, float[] srSupStrengths, int maxSR, int scanLen, float atr, bool perfModeFlag) =>
    if barstate.islast and barstate.isconfirmed and bar_index > 100 and not perfModeFlag
        array.clear(srResLevels)
        array.clear(srResStrengths)
        array.clear(srSupLevels)
        array.clear(srSupStrengths)
        for i = 1 to scanLen
            if i >= bar_index - 2
                break
            if not na(high[i]) and not na(high[i+1]) and not na(high[i-1])
                if high[i] > high[i+1] and high[i] >= high[i-1]
                    float clusterThreshold = math.max(atr * 0.4, high[i] * 0.0003) / math.max(high[i], 1.0)
                    bool alreadyExists = false
                    int _srN = array.size(srResLevels)
                    if _srN > 0
                        for j = 0 to _srN - 1
                            float lev = array.get(srResLevels, j)
                            if math.abs(lev - high[i]) / lev < clusterThreshold
                                alreadyExists := true
                                array.set(srResStrengths, j, array.get(srResStrengths, j) + 1.0)
                                break
                    if not alreadyExists and array.size(srResLevels) < maxSR
                        array.push(srResLevels, high[i])
                        array.push(srResStrengths, 1.0)
        // Fractal-low (support) detection — symmetric to fractal-high pass above
        for i = 1 to scanLen
            if i >= bar_index - 2
                break
            if not na(low[i]) and not na(low[i+1]) and not na(low[i-1])
                if low[i] < low[i+1] and low[i] <= low[i-1]
                    float clusterThreshold = math.max(atr * 0.4, low[i] * 0.0003) / math.max(low[i], 1.0)
                    bool alreadyExists = false
                    int _srN = array.size(srSupLevels)
                    if _srN > 0
                        for j = 0 to _srN - 1
                            float lev = array.get(srSupLevels, j)
                            if math.abs(lev - low[i]) / lev < clusterThreshold
                                alreadyExists := true
                                array.set(srSupStrengths, j, array.get(srSupStrengths, j) + 1.0)
                                break
                    if not alreadyExists and array.size(srSupLevels) < maxSR
                        array.push(srSupLevels, low[i])
                        array.push(srSupStrengths, 1.0)

var float[] srResLevels    = array.new_float()
var float[] srResStrengths = array.new_float()
var float[] srSupLevels    = array.new_float()
var float[] srSupStrengths = array.new_float()
var line[]  srLines        = array.new_line()

if barstate.islast
    // F-031: this passed ta.atr(14) INSIDE the barstate.islast branch, so the call was
    // evaluated on one bar instead of every bar. ta.* functions keep internal state that
    // only stays correct when called on each calculation -- a conditionally-called ta.atr
    // returns an unreliable value, and that value sets the S/R cluster threshold. The file
    // already maintains atr14 = ta.atr(14) globally at the top, so reuse it rather than
    // making a second, conditionally-evaluated call.
    scanSRLevels(srResLevels, srResStrengths, srSupLevels, srSupStrengths, srMaxLv, srScanLen, atr14, false)
    // clear previous frame's lines before redrawing
    if array.size(srLines) > 0
        for i = 0 to array.size(srLines) - 1
            line _sl = array.get(srLines, i)
            if not na(_sl)
                line.delete(_sl)
        array.clear(srLines)
    // Single merged pass over both sides (resistance then support), preserving the
    // Master's draw order and colour tiers exactly.
    for _p = 0 to 1
        float[] _lv = _p == 0 ? srResLevels : srSupLevels
        float[] _st = _p == 0 ? srResStrengths : srSupStrengths
        color   _bc = _p == 0 ? #FF4D4D : #00D084
        if srShow and array.size(_lv) > 0
            for i = 0 to array.size(_lv) - 1
                if i >= srMaxLv
                    break
                float lev = array.get(_lv, i)
                float st  = array.get(_st, i)
                if not na(lev)
                    color lc = color.new(_bc, st >= 3 ? 30 : st >= 2 ? 50 : 65)
                    array.push(srLines, line.new(bar_index - 1, lev, bar_index, lev, xloc.bar_index, extend.both, lc, line.style_dotted, 1))

// ═══════════════════ LAST 4H CANDLE — yellow dotted reference ═══════════════════
// Marks the most recent CLOSED 4H candle on a lower-timeframe chart.
//
// NON-REPAINTING BY CONSTRUCTION. The request.security below reads high[1]/low[1]/
// open[1]/close[1] with lookahead_off, so it returns the LAST FULLY CLOSED 4H bar and
// never the one still forming. A forming 4H candle's high and low change until it
// closes; drawing those would repaint historical chart state, which is exactly the
// defect class this audit treats as critical. The forming candle is therefore offered
// only behind an explicit opt-in that names the cost.
//
// NO PRICE-SCALE TAGS, as required. These are line objects, not plot() calls and not
// hline(): line.new never writes a coloured tag into the price column or onto the bar.
//
// OBJECT LIFECYCLE. Four `var` lines are created once and repositioned each bar with
// line.set_xy1/xy2. Nothing accumulates, so this cannot contribute to the 500-object
// ceiling that the structure layer above had to be capped against.
grpH4 = "4H Candle Marker"
showH4      = input.bool(true,  "Mark last closed 4H candle", group = grpH4)
h4ShowOC    = input.bool(false, "Also mark open / close",     group = grpH4, tooltip = "High and low bound the 4H range. Open and close add two more lines; off by default to keep the chart readable.")
h4ShowLive  = input.bool(false, "Also mark the FORMING 4H candle (REPAINTS)", group = grpH4, tooltip = "The in-progress 4H bar's high and low change until it closes, so these two lines move and historical chart state is not reproducible. Diagnostic only — leave off unless you specifically want live 4H range context.")
h4Col       = input.color(color.yellow, "Line colour", group = grpH4)
// The span is DERIVED, not a bar count: 4 hours / chart-TF seconds, so the line covers
// exactly the last four hours on any timeframe (48 bars on 5M, 16 on 15M, 4 on 1H) and
// stays correct when the timeframe changes. It terminates at the current candle -- no
// right extension -- so the marker reads as a bounded 4-hour window, not an open level.

// Self-disables at or above 4H, where "the last 4H candle" is just the previous bar and
// the lines would sit on top of the chart's own candles.
bool h4Active = showH4 and timeframe.in_seconds() < 14400

[h4H, h4L, h4O, h4C] = request.security(syminfo.tickerid, "240", [high[1], low[1], open[1], close[1]], gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_on)
[h4LiveH, h4LiveL]   = request.security(syminfo.tickerid, "240", [high, low], gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_off)

var line h4Hi = na
var line h4Lo = na
var line h4Op = na
var line h4Cl = na
var line h4LvH = na
var line h4LvL = na

// Visibility is expressed as full transparency rather than by deleting and recreating
// the line: a hidden line costs nothing, and recreating objects each bar is what
// exhausts the drawing ceiling. A na level is hidden for the same reason it must not be
// drawn at 0 -- a zero level would compress the entire price scale.
_h4Set(line _ln, float _px, int _x1, int _x2, bool _on, int _transp, int _w) =>
    if not na(_ln)
        bool _vis = _on and not na(_px)
        line.set_xy1(_ln, _x1, nz(_px, 0.0))
        line.set_xy2(_ln, _x2, nz(_px, 0.0))
        line.set_color(_ln, color.new(h4Col, _vis ? _transp : 100))
        line.set_width(_ln, _w)
        line.set_style(_ln, line.style_dotted)
        line.set_extend(_ln, extend.none)

if barstate.islast
    if na(h4Hi)
        h4Hi  := line.new(bar_index, 0.0, bar_index, 0.0, xloc.bar_index, extend.none, h4Col, line.style_dotted, 1)
        h4Lo  := line.new(bar_index, 0.0, bar_index, 0.0, xloc.bar_index, extend.none, h4Col, line.style_dotted, 1)
        h4Op  := line.new(bar_index, 0.0, bar_index, 0.0, xloc.bar_index, extend.none, h4Col, line.style_dotted, 1)
        h4Cl  := line.new(bar_index, 0.0, bar_index, 0.0, xloc.bar_index, extend.none, h4Col, line.style_dotted, 1)
        h4LvH := line.new(bar_index, 0.0, bar_index, 0.0, xloc.bar_index, extend.none, h4Col, line.style_dotted, 1)
        h4LvL := line.new(bar_index, 0.0, bar_index, 0.0, xloc.bar_index, extend.none, h4Col, line.style_dotted, 1)
    int _h4Bars = math.max(1, int(14400 / math.max(timeframe.in_seconds(), 1)))
    int _x1 = bar_index - _h4Bars
    int _x2 = bar_index
    _h4Set(h4Hi,  h4H,     _x1, _x2, h4Active, 0,  2)
    _h4Set(h4Lo,  h4L,     _x1, _x2, h4Active, 0,  2)
    _h4Set(h4Op,  h4O,     _x1, _x2, h4Active and h4ShowOC, 45, 1)
    _h4Set(h4Cl,  h4C,     _x1, _x2, h4Active and h4ShowOC, 45, 1)
    // Forming candle: dimmer and thinner so it is distinguishable from the closed one
    // without a label, since price-column tags are explicitly not wanted.
    _h4Set(h4LvH, h4LiveH, _x1, _x2, h4Active and h4ShowLive, 65, 1)
    _h4Set(h4LvL, h4LiveL, _x1, _x2, h4Active and h4ShowLive, 65, 1)

// ═══════════ PDH/PDL DASHED LINES + 4H / 1D TOUCH ALERTS ═══════════
// PDH/PDL previously rendered as price tags only. These are the same NY-anchored values
// (F-033 corrected), drawn as lines so the level is visible across the chart, not just in
// the price column. Reuses the existing pdh/pdl -- no second calculation, no new source.
grpPD = "PDH/PDL lines & alerts"
showPdLines = input.bool(true, "PDH / PDL dashed lines", group = grpPD)
// Yellow to match the 4H marker; the two stay distinguishable by STYLE, not colour:
// PDH/PDL = DASHED, 4H = DOTTED. Both remain user-configurable.
pdCol       = input.color(color.new(color.yellow, 0), "PDH/PDL colour", group = grpPD)
pdBack      = input.int(200, "Bars drawn back", minval = 20, maxval = 500, group = grpPD)

// Same var-and-reposition lifecycle as the 4H marker: two objects created once, moved each
// bar. Nothing accumulates, so this cannot contribute to the 500-object ceiling.
var line pdhLn = na
var line pdlLn = na

// Declared at GLOBAL scope: Pine does not permit a function definition inside a local
// block, and _x1 is passed in rather than captured, since a function cannot close over a
// local variable from the calling scope.
_pdSet(line _ln, float _px, int _x1, int _x2) =>
    if not na(_ln)
        bool _vis = showPdLines and not na(_px)
        line.set_xy1(_ln, _x1, nz(_px, 0.0))
        line.set_xy2(_ln, _x2, nz(_px, 0.0))
        line.set_color(_ln, color.new(pdCol, _vis ? 0 : 100))
        line.set_style(_ln, line.style_dashed)
        line.set_width(_ln, 1)

if barstate.islast
    if na(pdhLn)
        pdhLn := line.new(bar_index, 0.0, bar_index, 0.0, xloc.bar_index, extend.none, pdCol, line.style_dashed, 1)
        pdlLn := line.new(bar_index, 0.0, bar_index, 0.0, xloc.bar_index, extend.none, pdCol, line.style_dashed, 1)
    _pdSet(pdhLn, pdh, bar_index - pdBack, bar_index)
    _pdSet(pdlLn, pdl, bar_index - pdBack, bar_index)

// ---- TOUCH ALERTS: 4H closed candle high/low, and 1D (PDH/PDL) ----------------
// WHAT COUNTS AS A TOUCH: the bar's range spans the level (high >= L and low <= L). This
// fires on the bar that actually reaches the level rather than waiting for a close beyond
// it, which is what a level-touch alert is for.
// TIMING, STATED PLAINLY: these fire in REALTIME, on the forming bar. That is intentional
// for a notification -- a touch alert delivered one bar late is useless. It does mean an
// alert can fire on a wick that the bar later retraces. These alerts are NOT signals and
// feed nothing: no gate, no score, no plotted history. The decision engine remains
// confirmed-bar-only, so nothing here weakens the non-repainting guarantee.
// freq_once_per_bar keeps one alert per level per bar instead of one per tick.
alertOn4H = input.bool(true, "Alert on 4H high/low touch", group = grpPD)
alertOn1D = input.bool(true, "Alert on PDH/PDL touch",     group = grpPD)

_touched(float _lvl) => not na(_lvl) and high >= _lvl and low <= _lvl

bool _t4hH = alertOn4H and h4Active and _touched(h4H)
bool _t4hL = alertOn4H and h4Active and _touched(h4L)
bool _t1dH = alertOn1D and _touched(pdh)
bool _t1dL = alertOn1D and _touched(pdl)

if _t4hH
    alert("XAUUSD touched 4H HIGH " + str.tostring(h4H, format.mintick) + " (price " + str.tostring(close, format.mintick) + ")", alert.freq_once_per_bar)
if _t4hL
    alert("XAUUSD touched 4H LOW " + str.tostring(h4L, format.mintick) + " (price " + str.tostring(close, format.mintick) + ")", alert.freq_once_per_bar)
if _t1dH
    alert("XAUUSD touched PDH " + str.tostring(pdh, format.mintick) + " (price " + str.tostring(close, format.mintick) + ")", alert.freq_once_per_bar)
if _t1dL
    alert("XAUUSD touched PDL " + str.tostring(pdl, format.mintick) + " (price " + str.tostring(close, format.mintick) + ")", alert.freq_once_per_bar)

// alertcondition() alternatives: these appear as named conditions in the alert dialog, so
// a separate alert can be set per level. Both routes are provided because alert() needs
// "Any alert() function call" while alertcondition() gives per-level granularity.
alertcondition(_t4hH, "4H High Touch", "XAUUSD touched the last closed 4H candle HIGH")
alertcondition(_t4hL, "4H Low Touch",  "XAUUSD touched the last closed 4H candle LOW")
alertcondition(_t1dH, "PDH Touch",     "XAUUSD touched the previous day HIGH (PDH)")
alertcondition(_t1dL, "PDL Touch",     "XAUUSD touched the previous day LOW (PDL)")

// H2-TREND-BEGIN — per file. Visuals and Strategy_H2 request 1H / 4H / 1D themselves; the Master
// reads its engine's byte-identical requests instead (see the Master's H2-TREND block).
h2HtfScore(float _c, float _e20, float _e100, float _e200) => na(_c) ? 50.0 : (not na(_e200) and _c > _e200 ? 40.0 : 0.0) + (not na(_e20) and not na(_e100) and _e20 > _e100 ? 40.0 : 0.0) + (not na(_e20) and _c > _e20 ? 20.0 : 0.0)
// F-A41 (v38): every HIGHER-timeframe request.security in this file that asks for an offset value
// ([1] / [2]) now uses barmerge.lookahead_on. With lookahead_off, close[1] on a higher timeframe is
// TWO bars back on historical bars but ONE bar back live (measured on the operator's chart: daily
// close two days old on 6,027 of 6,091 bars), so backtest/record and live alerts saw different data.
// [1] + lookahead_on = the last COMPLETED higher-timeframe bar, identical live and in history; no
// lookahead, because every value is offset. Same-timeframe requests (timeframe.period) are unchanged.
[h2C1, h2A1, h2B1, h2D1] = request.security(syminfo.tickerid, "60", [close[1], ta.ema(close[1], 20), ta.ema(close[1], 100), ta.ema(close[1], 200)], barmerge.gaps_off, barmerge.lookahead_on)
[h2C4, h2A4, h2B4, h2D4] = request.security(syminfo.tickerid, "240", [close[1], ta.ema(close[1], 20), ta.ema(close[1], 100), ta.ema(close[1], 200)], barmerge.gaps_off, barmerge.lookahead_on)
[h2CD, h2AD, h2BD, h2DD] = request.security(syminfo.tickerid, "D", [close[1], ta.ema(close[1], 20), ta.ema(close[1], 100), ta.ema(close[1], 200)], barmerge.gaps_off, barmerge.lookahead_on)
float h2S1 = h2HtfScore(h2C1, h2A1, h2B1, h2D1)
float h2S4 = h2HtfScore(h2C4, h2A4, h2B4, h2D4)
float h2SD = h2HtfScore(h2CD, h2AD, h2BD, h2DD)
// H2-TREND-END
// H2-BEGIN
// ═══ HYPOTHESIS H2 — SWEEP-TO-VALUE (pre-registered: PREREGISTRATION amendment A3) ═══
// Operator's specification: a signal from the market trend, swing highs and lows, a liquidity
// sweep, the volume profile, and the next expected movement. This block is byte-identical in
// XAUUSD_Quantum_5_5_Visuals.pine (chart signals + H2 card) and XAUUSD_Quantum_5_0_Strategy_H2.pine
// (the forward-test arm); audit/tools/h2_parity.py fails otherwise.
// Every number is fixed in advance and borrowed from the existing system, not fitted:
//   trend  = the engine's HTF trend score on COMPLETED 1H / 4H / 1D bars (>= 60 up, <= 40 down),
//            at least 2 of the 3 agreeing
//   swings = 5-bar pivots (the Visuals structure default); a swing is liquidity until price
//            trades through it once, then it is consumed
//   sweep  = the confirmed bar trades through the last unconsumed swing low (high) and CLOSES
//            back above (below) it
//   value  = the engine's volume profile, rebuilt on every confirmed bar: 100 bars, 40 bins,
//            typical price, POC and a 70% value area (OANDA volume is tick volume; Diagnostics
//            reports its correlation with COMEX volume)
//   entry  = long only at or below the POC (discount), short only at or above it (premium)
//   plan   = stop beyond the sweep wick by 0.15 ATR (the engine's buffer), risk 0.5-5 ATR (the
//            engine's R bounds); TP1 = POC or 1R, TP2 = VAH (VAL) or 2R, whichever is farther
// Evaluated on confirmed bars only; reads nothing from the future.
int h2UpN = (h2S1 >= 60 ? 1 : 0) + (h2S4 >= 60 ? 1 : 0) + (h2SD >= 60 ? 1 : 0)
int h2DnN = (h2S1 <= 40 ? 1 : 0) + (h2S4 <= 40 ? 1 : 0) + (h2SD <= 40 ? 1 : 0)
bool h2TrendUp = h2UpN >= 2
bool h2TrendDn = h2DnN >= 2
// swings: the last unconsumed 5-bar pivot on each side
float h2PH = ta.pivothigh(high, 5, 5)
float h2PL = ta.pivotlow(low, 5, 5)
var float h2SwH = na
var float h2SwL = na
bool h2SweepL = barstate.isconfirmed and not na(h2SwL) and low < h2SwL and close > h2SwL
bool h2SweepH = barstate.isconfirmed and not na(h2SwH) and high > h2SwH and close < h2SwH
float h2SweptLvl = h2SweepL ? h2SwL : h2SweepH ? h2SwH : na
if barstate.isconfirmed and not na(h2SwL) and low < h2SwL
    h2SwL := na
if barstate.isconfirmed and not na(h2SwH) and high > h2SwH
    h2SwH := na
if not na(h2PL)
    h2SwL := h2PL
if not na(h2PH)
    h2SwH := h2PH
// volume profile, rebuilt on every confirmed bar (the engine's definition)
float h2VHi = ta.highest(high, 100)
float h2VLo = ta.lowest(low, 100)
var float h2Poc = na
var float h2Vah = na
var float h2Val = na
if barstate.isconfirmed and bar_index >= 100 and h2VHi > h2VLo
    float _h2bs = (h2VHi - h2VLo) / 40.0
    float[] _h2vv = array.new_float(40, 0.0)
    for _h2i = 0 to 99
        int _h2k = math.max(0, math.min(int(((high[_h2i] + low[_h2i] + close[_h2i]) / 3.0 - h2VLo) / _h2bs), 39))
        array.set(_h2vv, _h2k, array.get(_h2vv, _h2k) + nz(volume[_h2i], 0.0))
    float _h2mx = 0.0
    int _h2pk = 0
    for _h2j = 0 to 39
        if array.get(_h2vv, _h2j) > _h2mx
            _h2mx := array.get(_h2vv, _h2j)
            _h2pk := _h2j
    float _h2cum = _h2mx
    float _h2tgt = array.sum(_h2vv) * 0.70
    int _h2lo = _h2pk
    int _h2hi = _h2pk
    while _h2cum < _h2tgt and (_h2lo > 0 or _h2hi < 39)
        float _h2vb = _h2lo > 0 ? array.get(_h2vv, _h2lo - 1) : -1.0
        float _h2va = _h2hi < 39 ? array.get(_h2vv, _h2hi + 1) : -1.0
        if _h2va >= _h2vb and _h2hi < 39
            _h2hi += 1
            _h2cum += _h2va
        else if _h2lo > 0
            _h2lo -= 1
            _h2cum += _h2vb
        else
            break
    h2Poc := h2VLo + _h2bs * (_h2pk + 0.5)
    h2Vah := h2VLo + _h2bs * (_h2hi + 0.5)
    h2Val := h2VLo + _h2bs * (_h2lo + 0.5)
// the signal and its plan
float h2Atr = ta.atr(14)
float h2RL = h2SweepL ? close - (low - 0.15 * h2Atr) : na
float h2RS = h2SweepH ? (high + 0.15 * h2Atr) - close : na
bool h2Long = h2SweepL and h2TrendUp and not na(h2Poc) and close <= h2Poc and h2RL >= 0.5 * h2Atr and h2RL <= 5.0 * h2Atr
bool h2Short = h2SweepH and h2TrendDn and not na(h2Poc) and close >= h2Poc and h2RS >= 0.5 * h2Atr and h2RS <= 5.0 * h2Atr
float h2R = h2Long ? h2RL : h2Short ? h2RS : na
float h2Sl = h2Long ? close - h2RL : h2Short ? close + h2RS : na
float h2Tp1 = h2Long ? math.max(h2Poc, close + h2R) : h2Short ? math.min(h2Poc, close - h2R) : na
float h2Tp2 = h2Long ? math.max(h2Vah, close + 2.0 * h2R) : h2Short ? math.min(h2Val, close - 2.0 * h2R) : na
// H2-END

// ═══ v36 H2 DISPLAY — chart markers, H2 card and alerts. Display only: the signal is the H2 block
// above, byte-identical to the H2 strategy arm, whose on-chart scorecard is the H2 record. ═══
// next expected movement, from where price sits against value (shown on every bar)
string h2Trend = h2TrendUp ? "UP" : h2TrendDn ? "DOWN" : "MIXED"
grpH2 = "H2 sweep-to-value (pre-registered)"
h2Show = input.bool(true, "Show H2 signals and card", group = grpH2)
h2CardPos = input.string("Middle Left", "H2 card position", options = ["Middle Left", "Bottom Left", "Top Left", "Middle Right"], group = grpH2)
h2Layout = input.string("Compact (phone)", "H2 card layout", options = ["Compact (phone)", "Full"], group = grpH2, tooltip = "Compact: 7 short rows that fit a phone-width chart. Full: adds the three session rows.")
h2TxtSize = input.string("Small", "H2 card text size", options = ["Small", "Normal"], group = grpH2)
h2Mt5 = input.float(0.0, "MT5 price offset (same value as the Master)", minval = -50.0, maxval = 50.0, step = 0.01, group = grpH2, tooltip = "MT5 price minus TradingView price. Shifts the card's and the alert's prices only.")
plotshape(h2Show and h2Long, "H2 BUY", shape.triangleup, location.belowbar, color.new(#00D084, 0), size = size.small, text = "H2")
plotshape(h2Show and h2Short, "H2 SELL", shape.triangledown, location.abovebar, color.new(#FF4D4D, 0), size = size.small, text = "H2")
_h2p(float _x) => na(_x) ? "—" : str.tostring(_x + h2Mt5, "#.##")
// v81: a 0-100 trend score as text, "—" when missing (early history, a data gap). Every H2 TREND row used
// str.tostring(x, "#"), which prints "NaN" for na (found by executing the tiles, panel_check.py 9).
f_sc(float x) => na(x) ? "—" : str.tostring(x, "#")
// v55: MT5 prices like every other row (was TradingView prices), short enough for a phone
string h2Next = na(h2Poc) ? "building profile" : close < h2Val ? "below value → POC " + _h2p(h2Poc) : close > h2Vah ? "above value → POC " + _h2p(h2Poc) : close < h2Poc ? "in value, under POC " + _h2p(h2Poc) : "in value, over POC " + _h2p(h2Poc)
var string h2LastSig = "none yet"
var string h2LastSweep = "none yet"
var string h2SigCard = "none yet"
if h2SweepL or h2SweepH
    h2LastSweep := (h2SweepL ? "LOW " : "HIGH ") + _h2p(h2SweptLvl) + "\n" + str.format_time(time, "MM-dd HH:mm", "UTC") + " UTC"
// v85: H2's swing sweeps as an alert() here (the Master is at its token limit: v84 with this line in its alert failed
// to compile at 100,332, F-A72). Needs an alert on Visuals ("Any alert() function call"); bar close (h2Sweep* are
// confirmed-bar flags); the swept level at the MT5 price, as the card shows it.
alertOnH2Sweep = input.bool(true, "Alert on H2 swing sweeps", group = grpH2, tooltip = "Needs an alert on Visuals (Any alert() function call). The Master's alert carries the confirmed signals, CHoCH / BOS / MSS and the pool sweeps.")
if alertOnH2Sweep and (h2SweepL or h2SweepH)
    alert("XAUUSD " + timeframe.period + " H2-SWEEP-" + (h2SweepL ? "LOW " : "HIGH ") + _h2p(h2SweptLvl) + (h2SweepL and h2SweepH ? " (+HIGH)" : "") + " (MT5) | trend " + h2Trend + " | info, not a DECISION", alert.freq_once_per_bar_close)
if h2Long or h2Short
    h2LastSig := (h2Long ? "BUY " : "SELL ") + str.format_time(time, "MM-dd HH:mm", "UTC") + " UTC  entry " + _h2p(close) + "  SL " + _h2p(h2Sl) + "  TP1 " + _h2p(h2Tp1) + "  TP2 " + _h2p(h2Tp2)
    h2SigCard := (h2Long ? "BUY " : "SELL ") + str.format_time(time, "MM-dd HH:mm", "UTC") + " UTC\nentry " + _h2p(close) + "  SL " + _h2p(h2Sl) + "\nTP1 " + _h2p(h2Tp1) + "  TP2 " + _h2p(h2Tp2)
    alert("XAUUSD " + timeframe.period + " H2 sweep-to-value " + h2LastSig + " (MT5 prices) | trend " + h2Trend, alert.freq_once_per_bar_close)
// v76: the LAST H2 signal's age, outcome and whether it is still live. DISPLAY ONLY: the H2 rule (H2-BEGIN..END,
// = the website's arm H3) is unchanged; the card used to show the last signal with no age, so an old SELL could read
// as a live call. After the signal bar, each CONFIRMED bar checks its plan against the bar's range (TradingView
// prices, as the rule): stop first when one bar touches both stop and target (order inside a bar is unknown, so the
// conservative reading). STALE = closed (stopped / TP2), older than the bar limit, or H2's 1H/4H/1D trend vote no
// longer agrees with the signal's direction.
h2StaleBars = input.int(24, "Mark the last H2 signal stale after (bars)", minval = 1, maxval = 1000, group = grpH2, tooltip = "Display only: greys the card's SIGNAL row out after this many bars. The H2 rule has no expiry; this does not change it.")
var int h2SigBar = na
var int h2SigTime = na
var int h2SigDir = 0
var float h2SigSlV = na
var float h2SigT1 = na
var float h2SigT2 = na
var string h2SigOut = ""
if h2Long or h2Short
    h2SigBar := bar_index
    h2SigTime := time
    h2SigDir := h2Long ? 1 : -1
    h2SigSlV := h2Sl
    h2SigT1 := h2Tp1
    h2SigT2 := h2Tp2
    h2SigOut := ""
else if h2SigDir != 0 and barstate.isconfirmed and h2SigOut != "stopped" and h2SigOut != "TP2 hit" and h2SigOut != "TP1 hit, then stop"
    bool _slHit = h2SigDir == 1 ? low <= h2SigSlV : high >= h2SigSlV
    bool _t1Hit = h2SigDir == 1 ? high >= h2SigT1 : low <= h2SigT1
    bool _t2Hit = h2SigDir == 1 ? high >= h2SigT2 : low <= h2SigT2
    h2SigOut := _slHit ? (h2SigOut == "TP1 hit" ? "TP1 hit, then stop" : "stopped") : _t2Hit ? "TP2 hit" : _t1Hit ? "TP1 hit" : h2SigOut
int h2AgeB = na(h2SigBar) ? na : bar_index - h2SigBar
float h2AgeH = na(h2SigTime) ? na : (time - h2SigTime) / 3600000.0
bool h2TrendAgrees = h2SigDir == 1 ? h2TrendUp : h2SigDir == -1 ? h2TrendDn : true
bool h2SigDone = h2SigOut == "stopped" or h2SigOut == "TP2 hit" or h2SigOut == "TP1 hit, then stop"
bool h2Stale = h2SigDir != 0 and (h2SigDone or h2AgeB > h2StaleBars or not h2TrendAgrees)
// 0 = none yet, 1 = live BUY, -1 = live SELL, 2 = stale (any direction)
int h2SigState = h2SigDir == 0 ? 0 : h2Stale ? 2 : h2SigDir
string h2SigStat = h2SigDir == 0 ? "" : "\n" + (h2Stale ? "○ STALE · " : "● LIVE · ") + (h2AgeB == 0 ? "this bar" : str.tostring(h2AgeB) + " bars · " + (h2AgeH >= 48 ? str.tostring(math.floor(h2AgeH / 24)) + " d" : str.tostring(h2AgeH, "#.#") + " h") + " ago") + (h2SigOut != "" ? " · " + h2SigOut : "") + (h2TrendAgrees ? "" : " · trend no longer " + (h2SigDir == 1 ? "UP" : "DOWN"))
alertcondition(h2Long, "H2 BUY", "XAUUSD H2 sweep-to-value BUY on {{interval}} at {{close}} (TradingView price)")
alertcondition(h2Short, "H2 SELL", "XAUUSD H2 sweep-to-value SELL on {{interval}} at {{close}} (TradingView price)")
// v55 H2 CARD, redesigned for a phone-width chart: two columns, short keys, each line <= ~30
// characters, MT5 prices throughout, colour = what the row means for gold (green up / red down).
// Compact (default) = 7 rows; Full adds the three session rows. Display only: the record is the website.
var table h2Card = table.new(h2CardPos == "Bottom Left" ? position.bottom_left : h2CardPos == "Top Left" ? position.top_left : h2CardPos == "Middle Right" ? position.middle_right : position.middle_left, 2, 11, bgcolor = color.new(#0B0F14, 5), border_width = 1, border_color = color.new(#2A3340, 0))
h2Sz = h2TxtSize == "Normal" ? size.normal : size.small
_h2Row(int _r, string _k, string _x, color _c) =>
    table.cell(h2Card, 0, _r, _k, text_color = color.new(#8FA3B8, 0), text_size = h2Sz, text_halign = text.align_left)
    table.cell(h2Card, 1, _r, _x, text_color = _c, text_size = h2Sz, text_halign = text.align_left)
if vSep and h2Show and not h2Docked and barstate.islast
    color _h2t = color.new(#E6EDF3, 0)
    color _h2u = color.new(#00D084, 0)
    color _h2d = color.new(#FF4D4D, 0)
    color _h2s = color.new(#787B86, 0)
    bool _full = h2Layout == "Full"
    table.cell(h2Card, 0, 0, "H2 SWEEP→VALUE", text_color = color.white, bgcolor = color.new(#1F3A5F, 0), text_size = h2Sz, text_halign = text.align_left)
    table.cell(h2Card, 1, 0, timeframe.period + " · display only", text_color = color.white, bgcolor = color.new(#1F3A5F, 0), text_size = h2Sz, text_halign = text.align_left)
    _h2Row(1, "SIGNAL", h2SigCard + h2SigStat, h2SigState == 1 ? _h2u : h2SigState == -1 ? _h2d : h2SigState == 2 ? _h2s : _h2t)
    _h2Row(2, "TREND", h2Trend + "  1H " + f_sc(h2S1) + " 4H " + f_sc(h2S4) + " 1D " + f_sc(h2SD) + "\n(>=60 up, <=40 down)", h2TrendUp ? _h2u : h2TrendDn ? _h2d : _h2t)
    _h2Row(3, "VALUE", "VAL " + _h2p(h2Val) + "  POC " + _h2p(h2Poc) + "\nVAH " + _h2p(h2Vah) + "  (100 bars)", _h2t)
    _h2Row(4, "SWINGS", "high " + (na(h2SwH) ? "consumed" : _h2p(h2SwH)) + "\nlow " + (na(h2SwL) ? "consumed" : _h2p(h2SwL)) + "  (unswept)", _h2t)
    _h2Row(5, "SWEEP", h2LastSweep, str.startswith(h2LastSweep, "LOW") ? _h2u : str.startswith(h2LastSweep, "HIGH") ? _h2d : _h2t)
    _h2Row(6, "NEXT", h2Next, na(h2Poc) ? _h2t : close < h2Val ? _h2u : close > h2Vah ? _h2d : _h2t)
    if _full
        string _sn = sessId == 0 ? "Asian" : sessId == 1 ? "London" : sessId == 2 ? "NY" : "off-session"
        _h2Row(7, "SESSION", _sn + (curSessId != sessId or na(sesHi) ? "\nstarts next confirmed bar" : "  range " + _h2p(sesLo) + "-" + _h2p(sesHi) + "\nopen " + _h2p(sesOpenPx) + "  exp " + (na(sessExpansionPct) ? "—" : str.tostring(int(sessExpansionPct)) + "% of avg") + (sesManip ? "\nSWEPT prev session extreme" : "")), sesManip ? color.orange : _h2t)
        _h2Row(8, "HISTORY", "manip " + (na(sessManipProb) ? "—" : str.tostring(int(sessManipProb)) + "%" + f_ci(sessManipProb, ckN)) + "  cont " + (na(sessContProb) ? "—" : str.tostring(int(sessContProb)) + "%" + f_ci(sessContProb, ckN)) + "\nprev H " + _h2p(prevSesHi) + "  L " + _h2p(prevSesLo), _h2t)
        _h2Row(9, "VOLUME", sessVolBase > 0 and not na(volume) ? "x" + str.tostring(volume / sessVolBase, "#.#") + " of session avg\n(tick volume)" : "—", _h2t)
    _h2Row(_full ? 10 : 7, "NOTE", "conditional, not an entry\nH2 record: the website", color.new(#8FA3B8, 0))

// ═══════════════════ GOLD DRIVERS (v66) — display only ═══════════════════
// The free TradingView plan allows two indicators per chart, so Master + Visuals is the everyday pair. The five
// drivers the Brief shows (USDJPY, oil, real 10Y yield, 10Y breakeven, US 2Y) are COPIED here, not moved: the block
// between GD-BEGIN and GD-END is byte-identical to the Brief's (macro_check.py E), and the engine lines it reads are
// the Master's own (below, verbatim; the inputs keep the Master's names and defaults, inputs_check.py). No vote,
// no weight, no gate: the Master's DECISION is unchanged by anything here.
safeDiv(a, b) => not na(a) and not na(b) and math.abs(b) > 1e-10 ? a / b : 0.0
macroTF = input.timeframe("60", "Macro Correlation Timeframe", group="GOLD DRIVERS (display only)", tooltip="Keep equal to the Master's.")
y2Symbol = input.symbol("TVC:US02Y", "US 2Y Yield (blank=off)", group="GOLD DRIVERS (display only)", tooltip="With US10Y this gives the 2y10y curve spread — steepening favours gold, flattening pressures it. Context only, adds no macro vote.")
corrMedLen = input.int(60, "Corr Medium Window", minval=30, maxval=100, group="GOLD DRIVERS (display only)", tooltip="Keep equal to the Master's.")
chartTFSeconds = timeframe.in_seconds()
int _kM = math.max(1, int(timeframe.in_seconds(macroTF) / chartTFSeconds))
float _gM = request.security(syminfo.tickerid, macroTF, close[1], barmerge.gaps_off, barmerge.lookahead_on)
float goldRetM = not na(_gM[1]) ? safeDiv(_gM, _gM[1]) - 1 : na
int _wM = math.min(corrMedLen * _kM, 4500)
bool _fM = corrMedLen * _kM <= 4500
// MX-BEGIN (v88) the Master's MACRO verdict, COPIED: every line between MX-BEGIN and MX-END is a line of the Master,
// verbatim and in the Master's order (v88_check.py), and together with the engine lines above (safeDiv, macroTF,
// corrMedLen, chartTFSeconds, _kM, _gM, goldRetM, _wM, _fM, already the Master's) they are every statement the Master's
// macroIntelScore / macroIntelLabel depend on. Inputs keep the Master's names and defaults (inputs_check.py). So the
// MACRO Visuals shows is the Master's MACRO cell, never a second opinion. Display only: nothing here votes or gates.
rsiLen = input.int(14, "RSI Length", minval=2, maxval=50, group=grpCore)
grpV17 = "V17 PREDICTIVE ENHANCEMENTS"
dxyRocLen = input.int(10, "DXY Momentum ROC Length (bars)", minval=5, maxval=30, group=grpV17)
znRocLen = input.int(10, "ZN1 Rate Pressure ROC Length", minval=5, maxval=20, group=grpV17)
yieldSymbol = input.symbol("TVC:US10Y", "Yield Symbol (use TVC:US10Y for yield, ZN1! for futures price)", group=grpV17)
invertYield = input.bool(false, "Invert Yield Logic (enable for ZN1! futures price)", group=grpV17)
dxySymbol = input.symbol("TVC:DXY", "DXY Symbol", group=grpV17)
silverSymbol = input.symbol("OANDA:XAGUSD", "Silver Symbol", group=grpV17)
eurusdSymbol = input.symbol("OANDA:EURUSD", "EURUSD Symbol", group=grpV17)
spxSymbol = input.symbol("SP:SPX", "S&P 500 Symbol", group=grpV17)
tipsSymbol = input.symbol("TVC:US10Y", "TIPS/Real-Yield Symbol (blank=off)", group=grpV17, tooltip="Q5.5: default changed from the unprefixed US10YTIPS (which errored on many feeds) to TVC:US10Y. v65: while it equals the Yield Symbol (the default) the TIPS layer is OFF, because it would count the 10Y twice. FRED:DFII10 (the real yield) is DAILY: the Brief shows it as daily context; here it would be correlated on 1H bars. Leave it equal to the Yield Symbol unless you have an intraday real-yield feed. ignore_invalid_symbol protects the math regardless.")
grpV19c = "V19 CORRELATION"
corrShortLen = input.int(30, "Corr Short Window", minval=10, maxval=50, group=grpV19c)
corrLongLen = input.int(120, "Corr Long Window", minval=60, maxval=200, group=grpV19c)
float _rawGoldRet = safeDiv(close, nz(close[1], close)) - 1
float _retClampW = math.min(math.max(nz(ta.stdev(_rawGoldRet, 100)[1], 0.0) * 6.0, 0.002), 0.05)
goldRet = math.min(math.max(_rawGoldRet, -_retClampW), _retClampW)
[_rawDXY, _rawDXYFast, _rawDXYSlow, _rawDXYRoc, _rawDXYRSI] = request.security(dxySymbol, macroTF, [close[1], ta.ema(close[1], 10), ta.ema(close[1], 20), ta.roc(close[1], dxyRocLen), ta.rsi(close[1], rsiLen)], barmerge.gaps_off, barmerge.lookahead_on, ignore_invalid_symbol=true)
[_rawYield, _rawYieldFast, _rawYieldSlow, _rawYieldRoc] = request.security(yieldSymbol, macroTF, [close[1], ta.ema(close[1], 10), ta.ema(close[1], 20), ta.roc(close[1], znRocLen)], barmerge.gaps_off, barmerge.lookahead_on, ignore_invalid_symbol=true)
[_rawSilver, _rawSilverEMA, _silverRSI] = request.security(silverSymbol, timeframe.period, [close[1], ta.ema(close[1], 20), ta.rsi(close[1], rsiLen)], barmerge.gaps_off, barmerge.lookahead_off, ignore_invalid_symbol=true)
[_rawEURUSD, _rawEURFast, _rawEURSlow, _rawEURRoc] = request.security(eurusdSymbol, timeframe.period, [close[1], ta.ema(close[1], 10), ta.ema(close[1], 20), ta.roc(close[1], dxyRocLen)], barmerge.gaps_off, barmerge.lookahead_off, ignore_invalid_symbol=true)
[_rawSPX, _rawSPXFast, _rawSPXSlow] = request.security(spxSymbol, timeframe.period, [close[1], ta.ema(close[1], 10), ta.ema(close[1], 20)], barmerge.gaps_off, barmerge.lookahead_off, ignore_invalid_symbol=true)
[_rawTIPS, _rawTIPSFast, _rawTIPSSlow] = request.security(tipsSymbol != "" ? tipsSymbol : syminfo.tickerid, macroTF, [close[1], ta.ema(close[1], 10), ta.ema(close[1], 20)], barmerge.gaps_off, barmerge.lookahead_on, ignore_invalid_symbol=true)
var float cachedDXY = na
var float cachedYield = na
var float cachedSilver = na
var float cachedEURUSD = na
var float cachedSPX = na
var float cachedTIPS = na
var int dxyStaleCount = 0
var int yieldStaleCount = 0
var int silverStaleCount = 0
var int eurusdStaleCount = 0
var int spxStaleCount = 0
var int tipsStaleCount = 0
if not na(_rawDXY)
    cachedDXY := _rawDXY
    dxyStaleCount := 0
else
    dxyStaleCount := dxyStaleCount + 1
if not na(_rawYield)
    cachedYield := _rawYield
    yieldStaleCount := 0
else
    yieldStaleCount := yieldStaleCount + 1
if not na(_rawSilver)
    cachedSilver := _rawSilver
    silverStaleCount := 0
else
    silverStaleCount := silverStaleCount + 1
if not na(_rawEURUSD)
    cachedEURUSD := _rawEURUSD
    eurusdStaleCount := 0
else
    eurusdStaleCount := eurusdStaleCount + 1
if not na(_rawSPX)
    cachedSPX := _rawSPX
    spxStaleCount := 0
else
    spxStaleCount := spxStaleCount + 1
if not na(_rawTIPS)
    cachedTIPS := _rawTIPS
    tipsStaleCount := 0
else
    tipsStaleCount := tipsStaleCount + 1
int MACRO_STALE_MAX = 2
dxyClose = cachedDXY
yieldClose = cachedYield
silverClose = cachedSilver
eurusdClose = cachedEURUSD
spxClose = cachedSPX
tipsClose = cachedTIPS
dxyValid = not na(dxyClose) and not na(_rawDXYFast) and not na(_rawDXYSlow) and dxyStaleCount < MACRO_STALE_MAX
yieldValid = not na(yieldClose) and not na(_rawYieldFast) and not na(_rawYieldSlow) and yieldStaleCount < MACRO_STALE_MAX
silverValid = not na(silverClose) and not na(_rawSilverEMA) and silverStaleCount < MACRO_STALE_MAX
eurusdValid = not na(eurusdClose) and not na(_rawEURFast) and not na(_rawEURSlow) and eurusdStaleCount < MACRO_STALE_MAX
spxValid = not na(spxClose) and not na(_rawSPXFast) and not na(_rawSPXSlow) and spxStaleCount < MACRO_STALE_MAX
bool _tipsOn = tipsSymbol != yieldSymbol
tipsValid = _tipsOn and not na(tipsClose) and not na(_rawTIPSFast) and not na(_rawTIPSSlow) and tipsStaleCount < MACRO_STALE_MAX
dxyEMAFast = _rawDXYFast
dxyEMASlow = _rawDXYSlow
yieldEMAFast = _rawYieldFast
yieldEMASlow = _rawYieldSlow
eurusdEMAFast = _rawEURFast
eurusdEMASlow = _rawEURSlow
spxEMAFast = _rawSPXFast
spxEMASlow = _rawSPXSlow
tipsEMAFast = _rawTIPSFast
tipsEMASlow = _rawTIPSSlow
silverEMA = _rawSilverEMA
dxyBull = dxyValid and dxyClose > dxyEMAFast and dxyEMAFast > dxyEMASlow
dxyBear = dxyValid and dxyClose < dxyEMAFast and dxyEMAFast < dxyEMASlow
_yieldUp = yieldValid and yieldClose > yieldEMAFast and yieldEMAFast > yieldEMASlow
_yieldDown = yieldValid and yieldClose < yieldEMAFast and yieldEMAFast < yieldEMASlow
yieldRising = invertYield ? _yieldDown : _yieldUp
yieldFalling = invertYield ? _yieldUp : _yieldDown
eurusdBull = eurusdValid and eurusdClose > eurusdEMAFast and eurusdEMAFast > eurusdEMASlow
eurusdBear = eurusdValid and eurusdClose < eurusdEMAFast and eurusdEMAFast < eurusdEMASlow
spxBull = spxValid and spxClose > spxEMAFast and spxEMAFast > spxEMASlow
spxBear = spxValid and spxClose < spxEMAFast and spxEMAFast < spxEMASlow
tipsRising = tipsValid and tipsClose > tipsEMAFast and tipsEMAFast > tipsEMASlow
tipsFalling = tipsValid and tipsClose < tipsEMAFast and tipsEMAFast < tipsEMASlow
dxyROC = dxyValid ? nz(_rawDXYRoc, 0.0) : 0.0
dxyMomBull = dxyROC > 0.15
dxyMomBear = dxyROC < -0.15
znROC = yieldValid ? nz(_rawYieldRoc, 0.0) : 0.0
eurusdROC = eurusdValid ? nz(_rawEURRoc, 0.0) : 0.0
ratePressure = znROC
ratePressureUp = ratePressure > 0.1
ratePressureDown = ratePressure < -0.1
silverRet = silverValid and not na(silverClose[1]) ? safeDiv(silverClose, silverClose[1]) - 1 : na
dxyRet = dxyValid and not na(dxyClose[1]) ? safeDiv(dxyClose, dxyClose[1]) - 1 : na
yieldRet = yieldValid and not na(yieldClose[1]) ? safeDiv(yieldClose, yieldClose[1]) - 1 : na
eurRet = eurusdValid and not na(eurusdClose[1]) ? safeDiv(eurusdClose, eurusdClose[1]) - 1 : na
spxRet = spxValid and not na(spxClose[1]) ? safeDiv(spxClose, spxClose[1]) - 1 : na
tipsRet = tipsValid and not na(tipsClose[1]) ? safeDiv(tipsClose, tipsClose[1]) - 1 : na
float goldRetL = goldRet[1]
int _wS = math.min(corrShortLen * _kM, 4500)
int _wL = math.min(corrLongLen * _kM, 4500)
bool _fS = corrShortLen * _kM <= 4500
bool _fL = corrLongLen * _kM <= 4500
f_cc3(float g, float r, bool v, int a, int b, int c, bool fa, bool fb, bool fc) =>
    float x = ta.correlation(g, r, a)
    float y = ta.correlation(g, r, b)
    float z = ta.correlation(g, r, c)
    [v and fa ? x : na, v and fb ? y : na, v and fc ? z : na]
[corrGoldDXY_30, corrGoldDXY_60, corrGoldDXY_120] = f_cc3(goldRetM, dxyRet, dxyValid, _wS, _wM, _wL, _fS, _fM, _fL)
[corrGoldYld_30, corrGoldYld_60, corrGoldYld_120] = f_cc3(goldRetM, yieldRet, yieldValid, _wS, _wM, _wL, _fS, _fM, _fL)
[corrGoldSlv_30, corrGoldSlv_60, corrGoldSlv_120] = f_cc3(goldRetL, silverRet, silverValid, corrShortLen, corrMedLen, corrLongLen, true, true, true)
[corrGoldSPX_30, corrGoldSPX_60, corrGoldSPX_120] = f_cc3(goldRetL, spxRet, spxValid, corrShortLen, corrMedLen, corrLongLen, true, true, true)
[corrGoldEUR_30, corrGoldEUR_60, corrGoldEUR_120] = f_cc3(goldRetL, eurRet, eurusdValid, corrShortLen, corrMedLen, corrLongLen, true, true, true)
[corrGoldTIPS_30, corrGoldTIPS_60, corrGoldTIPS_120] = f_cc3(goldRetM, tipsRet, tipsValid, _wS, _wM, _wL, _fS, _fM, _fL)
avgCorrDXY = (nz(corrGoldDXY_30) + nz(corrGoldDXY_60) + nz(corrGoldDXY_120)) / 3.0
avgCorrYld = (nz(corrGoldYld_30) + nz(corrGoldYld_60) + nz(corrGoldYld_120)) / 3.0
avgCorrSlv = (nz(corrGoldSlv_30) + nz(corrGoldSlv_60) + nz(corrGoldSlv_120)) / 3.0
avgCorrSPX = (nz(corrGoldSPX_30) + nz(corrGoldSPX_60) + nz(corrGoldSPX_120)) / 3.0
avgCorrEUR = (nz(corrGoldEUR_30) + nz(corrGoldEUR_60) + nz(corrGoldEUR_120)) / 3.0
avgCorrTIPS = (nz(corrGoldTIPS_30) + nz(corrGoldTIPS_60) + nz(corrGoldTIPS_120)) / 3.0
_wDXYr = math.min(math.abs(avgCorrDXY) * 100, 30)
_wYldr = math.min(math.abs(avgCorrYld) * 100, 30)
_wSlvr = math.min(math.abs(avgCorrSlv) * 100, 25)
_wSPXr = spxValid ? math.min(math.abs(avgCorrSPX) * 100, 15) : 0.0 // R5.1: adaptive by |corr| like the other assets (wires avgCorrSPX)
_wEURr = eurusdValid and not dxyValid ? math.min(math.abs(avgCorrEUR) * 100, 30) : 0.0
_wTIPSr = math.min(math.abs(avgCorrTIPS) * 100, 25)
_wTot = _wDXYr + _wYldr + _wSlvr + _wSPXr + _wEURr + _wTIPSr
wDXY = _wTot > 0 ? _wDXYr / _wTot * 100 : 30.0
wYld = _wTot > 0 ? _wYldr / _wTot * 100 : 25.0
wSlv = _wTot > 0 ? _wSlvr / _wTot * 100 : 20.0
wSPX = _wTot > 0 ? _wSPXr / _wTot * 100 : 15.0
wEUR = _wTot > 0 ? _wEURr / _wTot * 100 : 20.0
wTIPS = _wTot > 0 ? _wTIPSr / _wTot * 100 : 10.0
msDXY = dxyValid ? (dxyBear ? wDXY : dxyBull ? -wDXY : 0.0) : 0.0
msYld = yieldValid ? (yieldFalling ? wYld : yieldRising ? -wYld : 0.0) : 0.0
msSPX = spxValid ? (spxBull ? wSPX : spxBear ? -wSPX : 0.0) : 0.0
msEUR = eurusdValid and not dxyValid ? (eurusdBull ? wEUR : eurusdBear ? -wEUR : 0.0) : 0.0
msSlv = silverValid ? (silverClose > silverEMA ? wSlv : silverClose < silverEMA ? -wSlv : 0.0) : 0.0
msTIPS = tipsValid ? (tipsFalling ? wTIPS : tipsRising ? -wTIPS : 0.0) : 0.0
msMom = dxyValid ? (dxyMomBear ? 10.0 : dxyMomBull ? -10.0 : 0.0) : 0.0
msRate = (yieldValid ? (ratePressureDown ? 5.0 : ratePressureUp ? -5.0 : 0.0) : 0.0) + (eurusdValid and not dxyValid ? (eurusdROC > 0.15 ? 5.0 : eurusdROC < -0.15 ? -5.0 : 0.0) : 0.0)
macroStrengthScore = int(math.max(math.min(msDXY + msYld + msSPX + msEUR + msSlv + msTIPS + msMom + msRate, 100), -100))
macroIntelScore = macroStrengthScore
macroIntelValid = dxyValid or yieldValid or spxValid or eurusdValid or silverValid
string macroIntelLabel = macroIntelValid ? (macroIntelScore >= 40 ? "BULL" : macroIntelScore <= -40 ? "BEAR" : macroIntelScore >= 15 ? "BULL-ISH" : macroIntelScore <= -15 ? "BEAR-ISH" : "MIXED") : "N/A"
// MX-END
// The Master's MACRO cell text (its _macroVerdict expression, verbatim) and, for the tooltips, each component's
// contribution to the score (ms*: + supports gold, - weighs on it; the score is their sum, clamped to +-100).
string mxVerdict = "Macro " + (macroIntelLabel == "BULL" ? "BULL" : macroIntelLabel == "BEAR" ? "BEAR" : macroIntelLabel == "BULL-ISH" ? "bull-ish" : macroIntelLabel == "BEAR-ISH" ? "bear-ish" : macroIntelLabel == "N/A" ? "—" : "MIX") + " " + str.tostring(macroIntelScore)
int mxDir = macroIntelLabel == "BULL" or macroIntelLabel == "BULL-ISH" ? 1 : macroIntelLabel == "BEAR" or macroIntelLabel == "BEAR-ISH" ? -1 : 0
string mxGlyph = macroIntelLabel == "BULL" ? "▲▲" : macroIntelLabel == "BULL-ISH" ? "▲" : macroIntelLabel == "BEAR" ? "▼▼" : macroIntelLabel == "BEAR-ISH" ? "▼" : macroIntelLabel == "N/A" ? "—" : "≈"
f_mxC(string n, bool v, float pts) => n + (not v ? " no data" : pts > 0 ? " ▲+" + str.tostring(pts, "#") : pts < 0 ? " ▼" + str.tostring(pts, "#") : " ≈0")
string mxWhy = "MACRO = the Master's MACRO cell (same code): " + mxVerdict + "\n" + f_mxC("DXY", dxyValid, msDXY + msMom) + " · " + f_mxC("10Y", yieldValid, msYld + msRate) + " · " + f_mxC("SPX", spxValid, msSPX) + " · " + f_mxC("silver", silverValid, msSlv) + "\n" + f_mxC("TIPS", tipsValid, msTIPS) + " · " + f_mxC("EURUSD (only without DXY)", eurusdValid and not dxyValid, msEUR) + " · DXY RSI " + (na(_rawDXYRSI) ? "—" : str.tostring(_rawDXYRSI, "#")) + " · silver RSI " + (na(_silverRSI) ? "—" : str.tostring(_silverRSI, "#"))
// GD-BEGIN gold drivers: byte-identical in the Brief and Visuals (v66, macro_check.py E). Display only: no vote,
// no weight, no gate. It reads goldRetM / _wM / _fM / macroTF / y2Symbol / safeDiv, which each file defines as the
// engine does (Visuals copies those lines from the Master; macro_check.py E and inputs_check.py hold them equal).
f_brS(bool up, bool dn) => up ? 1.0 : dn ? -1.0 : 0.0
f_brM(bool v, bool up, bool dn, float r) => v ? f_brS(up, dn) * (math.abs(r) > 0.5 ? 2.0 : math.abs(r) > 0.25 ? 1.0 : 0.0) : na
f_brMv(bool v, bool rise, bool fall) => not v ? "no data" : rise ? "rising" : fall ? "falling" : "flat"
// ---- v65 (option 4): five more gold drivers, DISPLAY ONLY: no vote, no weight, no gate, the DECISION is unchanged.
// Read as the engine reads DXY: close[1], EMA10 / EMA20 of it, lookahead_on (the last COMPLETED bar, F-A41), and
// "rising" = close > EMA10 > EMA20. Impact on gold: USDJPY / real yield / 2Y falling = up; oil / breakeven rising = up.
// USDJPY and oil also carry the same-bar correlation with gold (macroTF, the v64 pairing, F-A64), which scales the
// arrow as for DXY (|r| <= 0.25 = neutral). The real yield and breakeven are DAILY series (FRED): direction only.
brJpySym = input.symbol("OANDA:USDJPY", "USDJPY symbol (blank = off)", group="GOLD DRIVERS (display only)")
brOilSym = input.symbol("OANDA:WTICOUSD", "Oil (WTI) symbol (blank = off)", group="GOLD DRIVERS (display only)")
brRySym = input.symbol("FRED:DFII10", "Real 10Y yield, daily (blank = off)", group="GOLD DRIVERS (display only)", tooltip="10-year TIPS yield. Daily, published with a lag: shown as the day's direction, no intraday correlation.")
brBeSym = input.symbol("FRED:T10YIE", "10Y breakeven inflation, daily (blank = off)", group="GOLD DRIVERS (display only)", tooltip="10Y nominal minus TIPS yield = the market's inflation expectation. Daily.")
// v70: written out (TradingView expands every helper call): each line is what the v69 helper call expanded to,
// same values; refactor_check.py executes old and new side by side.
[brJc, brJf, brJs] = request.security(brJpySym != "" ? brJpySym : syminfo.tickerid, macroTF, [close[1], ta.ema(close[1], 10), ta.ema(close[1], 20)], barmerge.gaps_off, barmerge.lookahead_on, ignore_invalid_symbol=true)
[brOc, brOf, brOs] = request.security(brOilSym != "" ? brOilSym : syminfo.tickerid, macroTF, [close[1], ta.ema(close[1], 10), ta.ema(close[1], 20)], barmerge.gaps_off, barmerge.lookahead_on, ignore_invalid_symbol=true)
[brRc, brRf, brRs] = request.security(brRySym != "" ? brRySym : syminfo.tickerid, "D", [close[1], ta.ema(close[1], 10), ta.ema(close[1], 20)], barmerge.gaps_off, barmerge.lookahead_on, ignore_invalid_symbol=true)
[brBc, brBf, brBs] = request.security(brBeSym != "" ? brBeSym : syminfo.tickerid, "D", [close[1], ta.ema(close[1], 10), ta.ema(close[1], 20)], barmerge.gaps_off, barmerge.lookahead_on, ignore_invalid_symbol=true)
[br2c, br2f, br2s] = request.security(y2Symbol != "" ? y2Symbol : syminfo.tickerid, macroTF, [close[1], ta.ema(close[1], 10), ta.ema(close[1], 20)], barmerge.gaps_off, barmerge.lookahead_on, ignore_invalid_symbol=true)
bool brJv = brJpySym != "" and not na(brJc) and not na(brJf) and not na(brJs)
bool brOv = brOilSym != "" and not na(brOc) and not na(brOf) and not na(brOs)
bool brRv = brRySym != "" and not na(brRc) and not na(brRf) and not na(brRs)
bool brBv = brBeSym != "" and not na(brBc) and not na(brBf) and not na(brBs)
bool br2v = y2Symbol != "" and not na(br2c) and not na(br2f) and not na(br2s)
bool brJu = brJc > brJf and brJf > brJs
bool brJn = brJc < brJf and brJf < brJs
bool brOu = brOc > brOf and brOf > brOs
bool brOn = brOc < brOf and brOf < brOs
bool brRu = brRc > brRf and brRf > brRs
bool brRn = brRc < brRf and brRf < brRs
bool brBu = brBc > brBf and brBf > brBs
bool brBn = brBc < brBf and brBf < brBs
bool br2u = br2c > br2f and br2f > br2s
bool br2n = br2c < br2f and br2f < br2s
// same-bar correlation with gold over the macroTF-bar window (goldRetM / _wM / _fM), every bar; shown only when valid
float brJr = ta.correlation(goldRetM, not na(brJc[1]) ? safeDiv(brJc, brJc[1]) - 1 : na, _wM)
float brJR = brJv and _fM ? brJr : na
float brOr = ta.correlation(goldRetM, not na(brOc[1]) ? safeDiv(brOc, brOc[1]) - 1 : na, _wM)
float brOR = brOv and _fM ? brOr : na
// each driver's arrow (d: > 0 supports gold up) and its line of text
float brJd = f_brM(brJv, brJn, brJu, nz(brJR))
string brJh = "yen-dollar " + f_brMv(brJv, brJu, brJn) + (na(brJR) ? "" : " r" + str.tostring(brJR, "#.##"))
float brOd = f_brM(brOv, brOu, brOn, nz(brOR))
string brOh = "WTI " + f_brMv(brOv, brOu, brOn) + (na(brOR) ? "" : " r" + str.tostring(brOR, "#.##"))
float brRd = brRv ? f_brS(brRn, brRu) : na
string brRh = (brRv ? str.tostring(brRc, "#.##") + "% " : "") + f_brMv(brRv, brRu, brRn) + " · daily"
float brBd = brBv ? f_brS(brBu, brBn) : na
string brBh = (brBv ? str.tostring(brBc, "#.##") + "% " : "") + f_brMv(brBv, brBu, brBn) + " · daily"
float br2d = br2v ? f_brS(br2n, br2u) : na
string br2h = (br2v ? str.tostring(br2c, "#.##") + "% " : "") + f_brMv(br2v, br2u, br2n) + " · Fed path"
// GD-END
var table gdT = table.new(gdPos == "Bottom Center" ? (tkOn ? position.bottom_right : position.bottom_center) : gdPos == "Bottom Left" ? position.bottom_left : gdPos == "Middle Right" ? position.middle_right : position.bottom_right, 2, 6, bgcolor=color.new(#0B0F14, 5), border_width=1, border_color=color.new(#2A2E39, 0))
f_gdRow(int r, string nm, float d, string how) =>
    color c = na(d) ? color.new(#787B86, 0) : d > 0 ? color.new(#26A69A, 0) : d < 0 ? color.new(#EF5350, 0) : color.new(#B2B5BE, 0)
    table.cell(gdT, 0, r, nm + " " + (na(d) ? "—" : d >= 2 ? "▲▲" : d > 0 ? "▲" : d <= -2 ? "▼▼" : d < 0 ? "▼" : "≈"), text_color=c, text_size=size.small, text_halign=text.align_left)
    table.cell(gdT, 1, r, how, text_color=c, text_size=size.small, text_halign=text.align_left)
if vSep and barstate.islast and gdPos != "Hidden" and not gdDocked
    table.cell(gdT, 0, 0, "GOLD DRIVERS · green = supports gold UP · red = DOWN · display only", text_color=color.new(#D1D4DC, 0), text_size=size.small, text_halign=text.align_left)
    table.merge_cells(gdT, 0, 0, 1, 0)
    f_gdRow(1, "USDJPY", brJd, brJh)
    f_gdRow(2, "OIL", brOd, brOh)
    f_gdRow(3, "REAL YLD", brRd, brRh)
    f_gdRow(4, "BREAKEVEN", brBd, brBh)
    f_gdRow(5, "US 2Y", br2d, br2h)

// ═══════════════════ CHECKS & RISK (v86) — display only ═══════════════════
// The Phase 1 research audit's display items (audit/RESEARCH_AUDIT_PHASE1.md §4, §9, §10). DISPLAY ONLY: no gate, no
// signal and no engine threshold changes; the DECISION stays the Master's. Every constant here is a stated convention
// fixed before it was shown on a chart (Wilson / Student-t 95%, 4 x cost, 2 flips in 20 bars, the -2R cap); none was
// chosen from results on this price history (AUDIT_PROMPT.md §9).
grpCk = "CHECKS & RISK (v86, display only)"
ckPanel = input.bool(true, "Checks & risk section in the panel", group = grpCk, tooltip = "Score note, news calendar, cost, churn, daily regime, position size, today's loss cap, session history with 95% ranges, the website's forward record.")
// News calendar: official release times, New York (BLS Employment Situation and CPI 08:30; FOMC statement 14:00 on the
// second meeting day). Dates from the BLS and Federal Reserve schedules as published on 2026-10-22; FOMC dates are
// tentative until the meeting before. The Master's own news block takes one recurring session, not dates, so the
// dated calendar lives here.
nwShow = input.bool(true, "News calendar: NFP / CPI / FOMC (official dates)", group = grpCk, tooltip = "08:30 New York for NFP and CPI, 14:00 New York for the FOMC statement. Dates as published by the BLS and the Federal Reserve on 2026-10-22 (FOMC dates tentative until the meeting before). The list ends 2027-12-10: update Visuals before then.")
nwBefore = input.int(30, "News window: minutes before", minval = 0, maxval = 240, group = grpCk)
nwAfter = input.int(30, "News window: minutes after", minval = 0, maxval = 240, group = grpCk)
nwShade = input.bool(true, "Shade the news windows", group = grpCk)
nwCostMult = input.float(3.0, "News window: cost multiplier (spread + slippage)", minval = 1.0, maxval = 10.0, step = 0.5, group = grpCk, tooltip = "v92 (B-03): inside an NFP / CPI / FOMC window the COST and RISK rows charge spread + slippage x this (commission is per lot and does not widen). Default 3: the low end of the 3-5x design, not fitted to any result; set it from your broker's news-time spreads. Display only: the Master's engine does not re-cost or block news.")
alertOnNews = input.bool(true, "Alert when a news window starts", group = grpCk, tooltip = "Needs an alert on Visuals (Any alert() function call). Fires once, on the first bar that touches the window (at that bar's open).")
// The Master's cost model, with its inputs (same defaults; set them as in the Master)
spreadCost = input.float(0.3, "Spread Cost (points), as in the Master", minval=0.0, maxval=5.0, step=0.1, group=grpCk)
slippagePts = input.float(0.2, "Slippage (points), as in the Master", minval=0.0, maxval=2.0, step=0.1, group=grpCk)
commissionL = input.float(7.0, "Commission per Lot (USD, round turn), as in the Master", minval=0.0, maxval=50.0, step=0.5, group=grpCk)
pointValue = input.float(100, "Value per Point per Lot (USD), as in the Master", minval=1, group=grpCk)
rkEquity = input.float(25000.0, "Account equity ($)", minval = 100.0, maxval = 100000000.0, step = 100.0, group = grpCk)
rkPct = input.float(1.0, "Risk per trade (% of equity)", minval = 0.05, maxval = 5.0, step = 0.05, group = grpCk, tooltip = "Default 1% (operator, 2026-10-31). The Phase 1 report §9 suggests 0.25-0.5% while no arm has shown an edge.")
rkStop = input.float(0.0, "Stop distance ($ per oz; 0 = 1 ATR of this chart)", minval = 0.0, maxval = 500.0, step = 0.1, group = grpCk, tooltip = "Type the distance from your entry to your stop, e.g. from the Master's plan strip.")
rkToday = input.float(0.0, "Today's realised result (R, typed in)", minval = -20.0, maxval = 20.0, step = 0.1, group = grpCk, tooltip = "An indicator cannot see your MT5 trades: type today's closed result in R.")
rkCap = input.float(-2.0, "Daily loss cap (R)", minval = -10.0, maxval = -0.5, step = 0.5, group = grpCk)
rgShow = input.bool(true, "Daily regime tile (untested)", group = grpCk, tooltip = "12-month return and the 200-day average (trend), 20-day change of the real yield and the dollar (macro). Shown as context: an UNTESTED hypothesis (Phase 1 report §6, R1 / R2), never a signal.")
rgDxySym = input.symbol("TVC:DXY", "Dollar index, daily (blank = off)", group = grpCk)
lgShow = input.bool(true, "Banner: the website's forward record", group = grpCk, tooltip = "Typed in from the website's forward ledger (Pine cannot read it). The verdict uses the pre-registered rule: N >= 50, 95% t-interval of mean R above 0 and PF >= 1.2.")
// v89: refreshed from the website's forward ledger as of 2026-10-31 00:58 UTC (v86_check.py 7 recomputes the defaults
// from the ledger file), and a second line for arm H3, the rule behind Visuals' H2 card. Each arm is shown on its
// DECIDING record (H4: 15m, Amendment 8 / 9; H3: 1H, Amendment 7); other timeframes are reported in the note.
lgArm = input.string("H4 · 15m (deciding)", "Record: arm / timeframe", group = grpCk)
lgAsof = input.string("2026-10-31 00:58 UTC", "Record: as of", group = grpCk)
lgN = input.int(171, "Record: closed trades (N)", minval = 0, maxval = 100000, group = grpCk)
lgW = input.int(66, "Record: wins (R > 0)", minval = 0, maxval = 100000, group = grpCk)
lgMean = input.float(-0.0920, "Record: mean R", minval = -10.0, maxval = 10.0, step = 0.0001, group = grpCk)
lgSd = input.float(0.8006, "Record: standard deviation of R", minval = 0.0, maxval = 20.0, step = 0.0001, group = grpCk)
lgPF = input.float(0.7502, "Record: profit factor", minval = 0.0, maxval = 100.0, step = 0.0001, group = grpCk)
lgNote = input.string("5m: N 511, mean -0.18R, interval below 0 · the Brief's H4 playbook: not for live money", "Record: note", group = grpCk)
lg2Show = input.bool(true, "Banner: a second record (H3 = the H2 card's rule)", group = grpCk)
lg2Arm = input.string("H3 · 1H (deciding) = the H2 card's rule", "Record 2: arm / timeframe", group = grpCk)
lg2N = input.int(3, "Record 2: closed trades (N)", minval = 0, maxval = 100000, group = grpCk)
lg2W = input.int(1, "Record 2: wins (R > 0)", minval = 0, maxval = 100000, group = grpCk)
lg2Mean = input.float(-0.1642, "Record 2: mean R", minval = -10.0, maxval = 10.0, step = 0.0001, group = grpCk)
lg2Sd = input.float(1.6215, "Record 2: standard deviation of R", minval = 0.0, maxval = 20.0, step = 0.0001, group = grpCk)
lg2PF = input.float(0.7762, "Record 2: profit factor", minval = 0.0, maxval = 100.0, step = 0.0001, group = grpCk)
lg2Note = input.string("5m reported: N 14, mean +0.55R (-0.43 … +1.54): not enough trades yet", "Record 2: note", group = grpCk)

// Student-t 97.5% quantile, Cornish-Fisher series in 1/df (Abramowitz & Stegun 26.7.5): within 2e-4 for df >= 10
f_tq(int df) =>
    float z = 1.959964
    float v = math.max(df, 1)
    z + (math.pow(z, 3) + z) / (4.0 * v) + (5.0 * math.pow(z, 5) + 16.0 * math.pow(z, 3) + 3.0 * z) / (96.0 * v * v) + (3.0 * math.pow(z, 7) + 19.0 * math.pow(z, 5) + 17.0 * math.pow(z, 3) - 15.0 * z) / (384.0 * v * v * v)
// a duration in ms as "2d 3h" / "3h 05m" / "12m"; "—" if undefined
f_dur(float ms) =>
    float m = math.max(ms, 0.0) / 60000.0
    na(m) ? "—" : m >= 1440 ? str.tostring(math.floor(m / 1440)) + "d " + str.tostring(math.floor(m % 1440 / 60)) + "h" : m >= 60 ? str.tostring(math.floor(m / 60)) + "h " + (m % 60 < 10 ? "0" : "") + str.tostring(math.floor(m % 60)) + "m" : str.tostring(math.floor(m)) + "m"

// ---- news calendar: yyyymmddhhmm, New York time, in date order
var int[] nwCode = array.from(202610281400, 202611060830, 202611100830, 202612040830, 202612091400, 202612100830, 202701080830, 202701130830, 202701271400, 202702050830, 202702110830, 202703050830, 202703100830, 202703171400, 202704020830, 202704130830, 202704281400, 202705070830, 202705120830, 202706040830, 202706091400, 202706100830, 202707020830, 202707140830, 202707281400, 202708060830, 202708110830, 202709030830, 202709140830, 202709151400, 202710080830, 202710140830, 202710271400, 202711050830, 202711100830, 202712030830, 202712081400, 202712100830)
var string[] nwName = array.from("FOMC", "NFP", "CPI", "NFP", "FOMC", "CPI", "NFP", "CPI", "FOMC", "NFP", "CPI", "NFP", "CPI", "FOMC", "NFP", "CPI", "FOMC", "NFP", "CPI", "NFP", "FOMC", "CPI", "NFP", "CPI", "FOMC", "NFP", "CPI", "NFP", "CPI", "FOMC", "NFP", "CPI", "FOMC", "NFP", "CPI", "NFP", "FOMC", "CPI")
var int[] nwT = array.new_int()
if barstate.isfirst
    for c in nwCode
        array.push(nwT, timestamp("America/New_York", int(c / 100000000), int(c / 1000000) % 100, int(c / 10000) % 100, int(c / 100) % 100, c % 100))
// nwI: the first event whose window has not ended before this bar opened; nwBarIn: this bar touches its window
var int nwI = 0
bool nwBarIn = false
if nwShow
    while nwI < array.size(nwT)
        if array.get(nwT, nwI) + nwAfter * 60000 >= time
            break
        nwI += 1
    if nwI < array.size(nwT)
        int _t = array.get(nwT, nwI)
        nwBarIn := time <= _t + nwAfter * 60000 and nz(time_close, time) > _t - nwBefore * 60000
bgcolor(nwShade and nwBarIn ? color.new(#FF9800, 85) : na, title = "News windows (v86)")
// one alert per event: the first bar touching a window, or the next event's window on the very next bar (daily charts)
if alertOnNews and nwBarIn and (not nwBarIn[1] or nwI != nwI[1])
    alert("XAUUSD NEWS WINDOW: " + array.get(nwName, nwI) + " " + str.format_time(array.get(nwT, nwI), "MM-dd HH:mm", "America/New_York") + " New York (" + str.format_time(array.get(nwT, nwI), "HH:mm", "UTC") + " UTC), window -" + str.tostring(nwBefore) + "/+" + str.tostring(nwAfter) + " min. Display only: the DECISION is the Master's.", alert.freq_once_per_bar)

// ---- cost: the Master's model, copied (its killzone tiers, _sessSpread and the round-trip cost; v86 checker
// executes both side by side over every hour and DST state)
int ckLo = euIsDST ? 7 : 8
bool ckKZ = (hU >= ckLo + 1 and hU < ckLo + 4) or (hU >= nyOpen and hU < nyOpen + 3) or (hU >= londonClose - 1 and hU < londonClose) or (hU >= ckLo + 3 and hU < ckLo + 4)
float ckSpread = ckKZ ? math.max(0.18, spreadCost) : inNY ? math.max(0.22, spreadCost) : inLondon ? math.max(0.30, spreadCost) : math.max(0.50, spreadCost)
// v92 (B-03): spread + slippage widen in a dated news window (nwBarIn); commission does not.
float ckCost = (ckSpread + 2.0 * slippagePts) * (nwBarIn ? nwCostMult : 1.0) + commissionL / math.max(pointValue, 1.0)
float ckCostPct = atr14 > 0 ? ckCost / atr14 * 100.0 : na
int ckCostLv = na(ckCostPct) ? 0 : ckCostPct > 25.0 ? 2 : ckCostPct > 15.0 ? 1 : 0

// ---- churn: direction changes of the structure breaks (the ~BOS / ~CHoCH detector above) in the last 20 bars, and
// Kaufman's efficiency ratio (net move / path length over 20 bars; low = choppy)
var int ckDir = 0
bool ckFlip = false
if barstate.isconfirmed and (bosLabelBull or bosLabelBear)   // v95: the engine's BOS breaks
    int _nd = bosLabelBear ? -1 : 1
    ckFlip := ckDir != 0 and _nd != ckDir
    ckDir := _nd
int ckFlips = int(math.sum(ckFlip ? 1 : 0, 20))
float _ckPath = math.sum(math.abs(close - close[1]), 20)
float ckER = _ckPath > 0 ? math.abs(close - close[20]) / _ckPath : na
bool ckChurn = ckFlips >= 2

// ---- daily regime (untested): last COMPLETED month / day, so nothing repaints
[rgM1, rgM13] = request.security(syminfo.tickerid, "M", [close[1], close[13]], lookahead = barmerge.lookahead_on)
[rgC1, rgSma1] = request.security(syminfo.tickerid, "D", [close[1], ta.sma(close, 200)[1]], lookahead = barmerge.lookahead_on)
[rgRy1, rgRy21] = request.security(brRySym != "" ? brRySym : syminfo.tickerid, "D", [close[1], close[21]], lookahead = barmerge.lookahead_on, ignore_invalid_symbol = true)
[rgDx1, rgDx21] = request.security(rgDxySym != "" ? rgDxySym : syminfo.tickerid, "D", [close[1], close[21]], lookahead = barmerge.lookahead_on, ignore_invalid_symbol = true)
float rgRet12 = rgM1 > 0 and rgM13 > 0 ? (rgM1 / rgM13 - 1.0) * 100.0 : na
bool rgUp = not na(rgRet12) and not na(rgSma1) and rgRet12 > 0 and rgC1 > rgSma1
bool rgDn = not na(rgRet12) and not na(rgSma1) and rgRet12 < 0 and rgC1 < rgSma1
float rgRyD = brRySym != "" and not na(rgRy1) and not na(rgRy21) ? rgRy1 - rgRy21 : na
float rgDxD = rgDxySym != "" and not na(rgDx1) and not na(rgDx21) ? rgDx1 - rgDx21 : na
int rgMac = na(rgRyD) or na(rgDxD) ? 0 : rgRyD < 0 and rgDxD < 0 ? 1 : rgRyD > 0 and rgDxD > 0 ? -1 : 0
string rgTxt = rgUp ? "▲ LONG" : rgDn ? "▼ SHORT" : "◆ FLAT"
string rgMacTxt = na(rgRyD) or na(rgDxD) ? "20d macro: no data" : rgMac == 1 ? "20d macro supports gold" : rgMac == -1 ? "20d macro against gold" : "20d macro mixed"

// ---- position size and the daily cap (typed-in result)
// v94 LINK: the Master's two series (pick them once per chart). Unlinked, a source is `close` (> 0 on every bar); the
// Master's decision series is 0 on every WAIT bar, so a 0 proves the link.
lkDec = input.source(close, "Master link: LINK decision x stop", group = grpCk, tooltip = "v94: pick the Master's 'LINK decision x stop' here (and 'LINK lots' below) so Visuals scores the Master's own BUY / SELL and shows its plan lots and stop. Left at 'close', Visuals works as before (the tracker scores H2 signals).")
lkLots = input.source(close, "Master link: LINK lots", group = grpCk)
var bool lkOn = false
if not lkOn and lkDec == 0
    lkOn := true
int lkD = lkOn and not na(lkDec) ? (lkDec > 0 ? 1 : lkDec < 0 ? -1 : 0) : 0
float lkSLp = lkD != 0 ? math.abs(lkDec) : na
bool lkTrig = barstate.isconfirmed and lkD != 0 and lkD != nz(lkD[1])
bool lkLotsOn = lkOn and not na(lkLots) and lkLots != close
bool trkLongSig = lkOn ? lkTrig and lkD > 0 : h2Long
bool trkShortSig = lkOn ? lkTrig and lkD < 0 : h2Short
// v94: with the link and a live DECISION, the default stop is the Master's plan stop (it was 1 ATR)
float rkStopD = rkStop > 0 ? rkStop : not na(lkSLp) ? math.abs(close - lkSLp) : atr14
float rkRisk = rkEquity * rkPct / 100.0
float rkPerLot = (rkStopD + ckCost) * pointValue
float rkLots = rkPerLot > 0 ? math.floor(rkRisk / rkPerLot * 100.0) / 100.0 : na
bool rkLocked = rkToday <= rkCap

// ---- v93 BRACKET TRACKER (operator, 2026-10-31): the operator's fixed SL / TP scored on every H2 signal (= the
// website's arm H3 rule) from the signal bar's close; from the next bar, TP or SL first (both on one bar = SL).
trkShow = input.bool(true, "Bracket tracker: score H2 signals with my SL / TP", group = grpCk, tooltip = "v93: for every H2 signal on the loaded chart, did your TP or your SL come first, from the signal bar's close? Shows the TP-first rate with its 95% range, the break-even rate (cost included) and the net $ at your lot size. H2 is Visuals' own signal (the website's arm H3); Visuals cannot read the Master's BUY / SELL. Display only.")
trkUnit = input.string("Money ($)", "Bracket unit", options = ["Money ($)", "MT5 points"], group = grpCk)
trkSL = input.float(500.0, "Bracket SL (in the unit above)", minval = 0.01, maxval = 10000000.0, group = grpCk)
trkTP = input.float(1000.0, "Bracket TP (in the unit above)", minval = 0.01, maxval = 10000000.0, group = grpCk)
trkLot = input.float(0.5, "Bracket lot size", minval = 0.01, maxval = 100.0, step = 0.01, group = grpCk)
trkPt = input.float(0.01, "MT5 point size (price per point; 0.01 for a 2-digit XAUUSD quote)", minval = 0.0001, maxval = 1.0, step = 0.0001, group = grpCk)
float trkSLd = trkUnit == "MT5 points" ? trkSL * trkPt : trkSL / (trkLot * pointValue)
float trkTPd = trkUnit == "MT5 points" ? trkTP * trkPt : trkTP / (trkLot * pointValue)
var float[] trkE = array.new_float()
var int[] trkDir = array.new_int()
var int trkW = 0
var int trkL = 0
var float trkNet = 0.0
if trkShow and barstate.isconfirmed
    int _tn = array.size(trkE)
    if _tn > 0
        for _ti = _tn - 1 to 0
            float _te = array.get(trkE, _ti)
            int _td = array.get(trkDir, _ti)
            bool _tsl = _td > 0 ? low <= _te - trkSLd : high >= _te + trkSLd
            bool _ttp = _td > 0 ? high >= _te + trkTPd : low <= _te - trkTPd
            if _tsl or _ttp
                if _tsl
                    trkL += 1
                    trkNet -= (trkSLd + ckCost) * trkLot * pointValue
                else
                    trkW += 1
                    trkNet += (trkTPd - ckCost) * trkLot * pointValue
                array.remove(trkE, _ti)
                array.remove(trkDir, _ti)
    if (trkLongSig or trkShortSig) and array.size(trkE) < 200
        array.push(trkE, close)
        array.push(trkDir, trkLongSig ? 1 : -1)
int trkN = trkW + trkL
float trkBE = (trkSLd + ckCost) / (trkSLd + trkTPd)
[trkLo, trkHi] = f_wil(trkW, trkN)
float trkEqPct = trkSLd * trkLot * pointValue / rkEquity * 100.0
int trkLv = trkN < 1 ? 0 : trkLo > trkBE ? 1 : trkHi < trkBE ? -1 : 0
string trkTxt = (lkOn ? "Master BUY / SELL" : "H2 signals (link the Master to score its BUY / SELL)") + " · SL " + (trkUnit == "MT5 points" ? str.tostring(trkSL, "#") + " pts" : "$" + str.tostring(trkSL, "#")) + " / TP " + (trkUnit == "MT5 points" ? str.tostring(trkTP, "#") + " pts" : "$" + str.tostring(trkTP, "#")) + " at " + str.tostring(trkLot, "#.##") + " lot = $" + str.tostring(trkSLd, "#.##") + " / $" + str.tostring(trkTPd, "#.##") + " price · risk " + str.tostring(trkEqPct, "#.#") + "% of equity\n" + (trkN < 1 ? "no closed H2 signal on this chart yet" : "TP first " + str.tostring(trkW) + "/" + str.tostring(trkN) + " = " + str.tostring(trkW * 100.0 / trkN, "#") + "% (95% " + str.tostring(trkLo * 100.0, "#") + "–" + str.tostring(trkHi * 100.0, "#") + ") · break-even " + str.tostring(trkBE * 100.0, "#") + "% · chance " + str.tostring(trkSLd / (trkSLd + trkTPd) * 100.0, "#") + "%") + "\nnet $" + str.tostring(trkNet, "#") + " · open " + str.tostring(array.size(trkE)) + " · this chart's history only" + (lkOn ? "" : ", not the Master's BUY / SELL")

// ---- the website's forward record (typed in) and its verdict under the pre-registered rule
float lgSe = lgN > 1 ? lgSd / math.sqrt(lgN) : na
float lgT = lgN > 1 ? f_tq(lgN - 1) : na
float lgLo = lgMean - lgT * lgSe
float lgHi = lgMean + lgT * lgSe
[lgWlo, lgWhi] = f_wil(math.min(lgW, lgN), lgN)
string lgVerdict = lgN < 50 ? "UNDECIDED · N < 50" : na(lgLo) ? "—" : lgLo > 0 and lgPF >= 1.2 ? "EDGE SHOWN" : lgLo > 0 ? "NO EDGE SHOWN · PF < 1.2" : lgHi < 0 ? "NO EDGE · interval below 0" : "NO EDGE SHOWN · interval spans 0"
int lgLv = lgVerdict == "EDGE SHOWN" ? 1 : lgVerdict == "NO EDGE · interval below 0" ? -1 : 0
string lgTxt = lgArm + " · website ledger, " + lgAsof + "\nN " + str.tostring(lgN) + " · win " + (lgN > 0 ? str.tostring(math.min(lgW, lgN) * 100.0 / lgN, "#") + "% (" + str.tostring(lgWlo * 100.0, "#") + "–" + str.tostring(lgWhi * 100.0, "#") + ")" : "—") + " · mean " + (na(lgLo) ? "—" : str.tostring(lgMean, "#.##") + "R (" + str.tostring(lgLo, "#.##") + " … " + str.tostring(lgHi, "#.##") + ")") + " · PF " + str.tostring(lgPF, "#.##")
// v89: the second record, the same lines with lg -> lg2 (v86_check.py 7 checks the rename and executes both)
float lg2Se = lg2N > 1 ? lg2Sd / math.sqrt(lg2N) : na
float lg2T = lg2N > 1 ? f_tq(lg2N - 1) : na
float lg2Lo = lg2Mean - lg2T * lg2Se
float lg2Hi = lg2Mean + lg2T * lg2Se
[lg2Wlo, lg2Whi] = f_wil(math.min(lg2W, lg2N), lg2N)
string lg2Verdict = lg2N < 50 ? "UNDECIDED · N < 50" : na(lg2Lo) ? "—" : lg2Lo > 0 and lg2PF >= 1.2 ? "EDGE SHOWN" : lg2Lo > 0 ? "NO EDGE SHOWN · PF < 1.2" : lg2Hi < 0 ? "NO EDGE · interval below 0" : "NO EDGE SHOWN · interval spans 0"
int lg2Lv = lg2Verdict == "EDGE SHOWN" ? 1 : lg2Verdict == "NO EDGE · interval below 0" ? -1 : 0
string lg2Txt = lg2Arm + " · website ledger, " + lgAsof + "\nN " + str.tostring(lg2N) + " · win " + (lg2N > 0 ? str.tostring(math.min(lg2W, lg2N) * 100.0 / lg2N, "#") + "% (" + str.tostring(lg2Wlo * 100.0, "#") + "–" + str.tostring(lg2Whi * 100.0, "#") + ")" : "—") + " · mean " + (na(lg2Lo) ? "—" : str.tostring(lg2Mean, "#.##") + "R (" + str.tostring(lg2Lo, "#.##") + " … " + str.tostring(lg2Hi, "#.##") + ")") + " · PF " + str.tostring(lg2PF, "#.##")
// v89 (C): the registered decision timeframe is 15m (PREREG A2.4); 5m is for timing only
string tfNote = timeframe.period == "15" ? "chart 15m = the decision timeframe" : timeframe.period == "5" ? "5m chart: timing only, decide on 15m" : "decide on 15m · " + timeframe.period + " chart = context"
string lgLine = lgArm + ": " + lgVerdict + " · " + str.replace_all(str.substring(lgTxt, str.pos(lgTxt, "\n") + 1), "\n", " ")
string lg2Line = lg2Arm + ": " + lg2Verdict + " · " + str.replace_all(str.substring(lg2Txt, str.pos(lg2Txt, "\n") + 1), "\n", " ")

// ---- at the last bar: the current or next event on the real clock (timenow), for the panel and the ticker
int nwK = -1
bool nwNowIn = false
float nwMs = na
string nwKName = ""
string nwNext = nwShow ? "calendar ended: update Visuals" : "calendar off"
if nwShow and barstate.islast and nwI < array.size(nwT)
    for i = nwI to array.size(nwT) - 1
        if array.get(nwT, i) + nwAfter * 60000 >= timenow
            nwK := i
            break
    if nwK >= 0
        int _tk = array.get(nwT, nwK)
        nwNowIn := timenow >= _tk - nwBefore * 60000
        nwMs := _tk - timenow
        nwKName := array.get(nwName, nwK)
        nwNext := nwKName + " " + str.format_time(_tk, "MM-dd HH:mm", "America/New_York") + " NY (" + str.format_time(_tk, "HH:mm", "UTC") + " UTC)"
int nwLv = nwNowIn ? 2 : not na(nwMs) and nwMs <= 4 * 3600000 ? 1 : 0

// ═══════════════════ TERMINAL PANEL (v73) — one panel, one style ═══════════════════
// The three cards' values in one docked panel: MARKET (the candle panel), H2 SWEEP → VALUE (the H2 card's rows,
// same expressions) and GOLD DRIVERS (the drivers panel's rows, same glyphs and colours). Grey = labels, white =
// values, colour only for direction (teal supports gold up / the bar closed up, red down). Display only.
// v86: 64 rows (the CHECKS · RISK section adds up to 10).
var table tblV = table.new(vPos == "Middle Left" ? position.middle_left : vPos == "Top Left" ? position.top_left : vPos == "Middle Right" ? position.middle_right : position.bottom_left, 2, 64, bgcolor = color.new(#0B0F14, 4), frame_color = color.new(#2A3340, 0), frame_width = 1, border_color = color.new(#18202A, 0), border_width = 1)
color _tmK = color.new(#7D8FA3, 0)
color _tmV = color.new(#E6EDF3, 0)
color _tmUp = color.new(#26A69A, 0)
color _tmDn = color.new(#EF5350, 0)
color _tmSec = color.new(#16202B, 0)
color _tmS = color.new(#787B86, 0)
// v75: a liquidity level and its distance from price (TradingView prices, as the level tags)
f_lv(string n, float p) => na(p) ? n + " —" : n + " " + str.tostring(p, format.mintick) + "  (" + (p >= close ? "+" : "") + str.tostring(p - close, "#.##") + ")"
// v79: the nearest of the eight tagged levels beyond `from` (above if up, below if not), and its name; na / "" if none
f_glNear(bool up, float from) =>
    float best = na
    string nm = ""
    for [i, p] in array.from(pdh, pdl, pwh, pwl, pmh, pml, cdh, cdl)
        if not na(p) and (up ? p > from : p < from) and (na(best) or math.abs(p - from) < math.abs(best - from))
            best := p
            nm := array.get(array.from("PDH", "PDL", "PWH", "PWL", "PMH", "PML", "CDH", "CDL"), i)
    [best, nm]
// v80: text gauges for the glance. f_gBar: a 0-100 value as n segments (▰ filled, ▱ empty; Pine's half-away rounding).
// f_gPos: where x sits between lo and hi on an n-character track (● inside, ◀ / ▶ beyond an end; "—" if undefined).
f_gBar(float pct, int n) =>
    string out = ""
    if na(pct)
        out := "—"
    else
        int k = int(math.round(math.max(0.0, math.min(100.0, pct)) / 100.0 * n))
        for i = 0 to n - 1
            out += i < k ? "▰" : "▱"
    out
f_gPos(float lo, float x, float hi, int n) =>
    string out = "—"
    if not na(lo) and not na(hi) and not na(x) and hi > lo
        int k = int(math.round((x - lo) / (hi - lo) * (n - 1)))
        out := ""
        for i = 0 to n - 1
            out += x < lo and i == 0 ? "◀" : x > hi and i == n - 1 ? "▶" : x >= lo and x <= hi and i == k ? "●" : "━"
    out
f_tmG(float d) => na(d) ? "—" : d >= 2 ? "▲▲" : d > 0 ? "▲" : d <= -2 ? "▼▼" : d < 0 ? "▼" : "≈"
f_tmC(float d) => na(d) ? color.new(#787B86, 0) : d > 0 ? color.new(#26A69A, 0) : d < 0 ? color.new(#EF5350, 0) : color.new(#B2B5BE, 0)
_tmRow(int r, string k, string v, color c) =>
    table.cell(tblV, 0, r, k, text_color = _tmK, text_size = h2Sz, text_halign = text.align_left)
    table.cell(tblV, 1, r, v, text_color = c, text_size = h2Sz, text_halign = text.align_left)
_tmHead(int r, string k, string v, color bg) =>
    table.cell(tblV, 0, r, k, text_color = color.white, bgcolor = bg, text_size = h2Sz, text_halign = text.align_left)
    table.cell(tblV, 1, r, v, text_color = color.new(#AEBBC9, 0), bgcolor = bg, text_size = h2Sz, text_halign = text.align_right)
if not vSep and barstate.islast
    table.clear(tblV, 0, 0, 1, 63)
// v75: drawn only while it has a section (everything docked under the Master + candle panel off = no empty frame)
if not vSep and barstate.islast and (glShow and not tkOn or showCandle or h2Show and not h2Docked or gdPos != "Hidden" and not gdDocked or lqInPanel or ckPanel)
    bool _cmp = vDetail == "Compact"
    int r = 0
    _tmHead(r, "XAUUSD · " + timeframe.period, "VISUALS · " + str.format_time(time, "dd MMM HH:mm", "UTC") + " UTC", color.new(#1F3A5F, 0))
    if glShow and not tkOn
        [_upP, _upN] = f_glNear(true, close)
        [_dnP, _dnN] = f_glNear(false, close)
        [_up2P, _up2N] = f_glNear(true, nz(_upP, close))
        [_dn2P, _dn2N] = f_glNear(false, nz(_dnP, close))
        float _gNet = nz(brJd) + nz(brOd) + nz(brRd) + nz(brBd) + nz(br2d)
        float _upR = na(_upP) ? na : _upP - close
        float _dnR = na(_dnP) ? na : close - _dnP
        if glStyle == "Text (v79)"
            r += 1
            _tmHead(r, "MARKET AT A GLANCE", "display only · plain words", _tmSec)
            r += 1
            _tmRow(r, "1 TREND", h2Trend + " on 1H/4H/1D (2 of 3 vote) · price " + (na(ema200) ? "—" : close > ema200 ? "above" : "below") + " EMA200", h2TrendUp ? _tmUp : h2TrendDn ? _tmDn : _tmV)
            r += 1
            _tmRow(r, "2 BIAS", "the Master's BIAS + DECISION cells (top): its engine's call", _tmK)
            r += 1
            _tmRow(r, "3 HEADING", h2Next, na(h2Poc) ? _tmV : close < h2Val ? _tmUp : close > h2Vah ? _tmDn : _tmV)
            r += 1
            _tmRow(r, "4 LIQUIDITY", "last swept: " + pvLastSweep + "\nnext above: " + (na(_upP) ? "none tagged" : _upN + " " + str.tostring(_upP, format.mintick) + " (+" + str.tostring(_upR, "#.##") + ")") + " · below: " + (na(_dnP) ? "none tagged" : _dnN + " " + str.tostring(_dnP, format.mintick) + " (−" + str.tostring(_dnR, "#.##") + ")"), _tmV)
            r += 1
            _tmRow(r, "5 MACRO", "the Master's MACRO: " + mxVerdict + " · other drivers (context) net " + f_tmG(_gNet), (mxDir > 0 ? _tmUp : mxDir < 0 ? _tmDn : _tmV))
            r += 1
            _tmRow(r, "6 ROOM", "up $" + (na(_upR) ? "—" : str.tostring(_upR, "#.##")) + (na(_upR) ? "" : _upR >= glMoveB ? " ✓ $" + str.tostring(glMoveB, "#") : _upR >= glMoveA ? " ✓ $" + str.tostring(glMoveA, "#") : " ✗ <$" + str.tostring(glMoveA, "#") + (na(_up2P) ? "" : " (then " + _up2N + " +" + str.tostring(_up2P - close, "#.##") + ")")) + "\ndown $" + (na(_dnR) ? "—" : str.tostring(_dnR, "#.##")) + (na(_dnR) ? "" : _dnR >= glMoveB ? " ✓ $" + str.tostring(glMoveB, "#") : _dnR >= glMoveA ? " ✓ $" + str.tostring(glMoveA, "#") : " ✗ <$" + str.tostring(glMoveA, "#") + (na(_dn2P) ? "" : " (then " + _dn2N + " −" + str.tostring(close - _dn2P, "#.##") + ")")) + " · plan: the Master's plan strip", _tmV)
            r += 1
            _tmRow(r, "7 HISTORY", "this session: manipulation " + (na(sessManipProb) ? "—" : str.tostring(int(sessManipProb)) + "%" + f_ci(sessManipProb, ckN)) + " · continuation " + (na(sessContProb) ? "—" : str.tostring(int(sessContProb)) + "%" + f_ci(sessContProb, ckN)) + "\nlast H2 signal: " + (h2SigDir == 0 ? "none yet" : (h2SigDir == 1 ? "BUY " : "SELL ") + (h2SigOut == "" ? "open" : h2SigOut) + (h2Stale ? " · stale" : " · live")), _tmV)
            r += 1
            _tmRow(r, "8 ODDS", "the Master's SIGNAL cell: L / S / R scores, not win odds (Diagnostics: RELIABILITY)", _tmK)
        else
            string _mk = "✗<$" + str.tostring(glMoveA, "#")
            r += 1
            _tmHead(r, "AT A GLANCE · " + timeframe.period, h2TrendUp ? "▲ TREND UP" : h2TrendDn ? "▼ TREND DOWN" : "◆ TREND MIXED", _tmSec)
            r += 1
            _tmRow(r, "TREND", "1H " + f_gBar(h2S1, 5) + "  4H " + f_gBar(h2S4, 5) + "  1D " + f_gBar(h2SD, 5) + (na(ema200) ? "" : close > ema200 ? "  ▲EMA200" : "  ▼EMA200"), h2TrendUp ? _tmUp : h2TrendDn ? _tmDn : _tmV)
            r += 1
            _tmRow(r, "VALUE", "VAL " + f_gPos(h2Val, close, h2Vah, 11) + " VAH" + (na(h2Poc) ? "" : close >= h2Poc ? "  over POC" : "  under POC"), na(h2Poc) ? _tmV : close < h2Val ? _tmUp : close > h2Vah ? _tmDn : _tmV)
            r += 1
            _tmRow(r, "ROOM", (na(_dnP) ? "—" : _dnN + " −" + str.tostring(_dnR, "#.#")) + " " + f_gPos(_dnP, close, _upP, 11) + " " + (na(_upP) ? "—" : "+" + str.tostring(_upR, "#.#") + " " + _upN) + "\n↓ " + (na(_dnR) ? "—" : _dnR >= glMoveB ? "✓$" + str.tostring(glMoveB, "#") : _dnR >= glMoveA ? "✓$" + str.tostring(glMoveA, "#") : _mk) + "    ↑ " + (na(_upR) ? "—" : _upR >= glMoveB ? "✓$" + str.tostring(glMoveB, "#") : _upR >= glMoveA ? "✓$" + str.tostring(glMoveA, "#") : _mk), _tmV)
            r += 1
            _tmRow(r, "MACRO", mxGlyph + " " + (macroIntelLabel == "N/A" ? "—" : str.tostring(macroIntelScore)) + " = Master · other: JPY" + f_tmG(brJd) + " OIL" + f_tmG(brOd) + " RY" + f_tmG(brRd) + " BE" + f_tmG(brBd) + " 2Y" + f_tmG(br2d) + " (net " + f_tmG(_gNet) + ")", (mxDir > 0 ? _tmUp : mxDir < 0 ? _tmDn : _tmV))
            r += 1
            _tmRow(r, "SWEPT", pvLastSweep, str.startswith(pvLastSweep, "LOW") ? _tmUp : str.startswith(pvLastSweep, "HIGH") ? _tmDn : _tmV)
            r += 1
            _tmRow(r, "HISTORY", "manip " + f_gBar(sessManipProb, 5) + (na(sessManipProb) ? "" : " " + str.tostring(int(sessManipProb)) + "%") + "  cont " + f_gBar(sessContProb, 5) + (na(sessContProb) ? "" : " " + str.tostring(int(sessContProb)) + "%") + (ckN > 0 ? "  n" + str.tostring(ckN) : ""), _tmV)
            r += 1
            _tmRow(r, "H2", h2SigDir == 0 ? "none yet" : (h2SigDir == 1 ? "BUY" : "SELL") + (h2Stale ? " · ○ stale" : " · ● live") + (h2SigOut != "" ? " · " + h2SigOut : ""), h2SigState == 1 ? _tmUp : h2SigState == -1 ? _tmDn : h2SigState == 2 ? _tmS : _tmV)
            r += 1
            _tmRow(r, "BIAS · ODDS", "→ the Master's BIAS / SIGNAL cells (scores, not odds)", _tmK)
    if showCandle
        float _rng = high - low
        bool _up = close >= open
        float _rv = not na(volSma20) and volSma20 > 0 ? volume / volSma20 : na
        r += 1
        _tmHead(r, "MARKET", "last bar " + (_up ? "▲ UP" : "▼ DOWN"), _tmSec)
        r += 1
        _tmRow(r, "PRICE", (_cmp ? "" : "O " + str.tostring(open, format.mintick) + "  H " + str.tostring(high, format.mintick) + "  L " + str.tostring(low, format.mintick) + "  ") + "C " + str.tostring(close, format.mintick), _up ? _tmUp : _tmDn)
        if not _cmp
            r += 1
            _tmRow(r, "RANGE", str.tostring(_rng, "#.##") + "  (" + str.tostring(atr14 > 0 ? _rng / atr14 : na, "#.##") + " ATR)  ATR% " + str.tostring(close > 0 ? atr14 / close * 100.0 : na, "#.###"), _tmV)
        r += 1
        _tmRow(r, "FLOW", (na(_rv) ? "" : "RVOL " + str.tostring(_rv, "#.##") + "x  ") + (na(adxVal) ? "ADX —" : "ADX " + str.tostring(adxVal, "#.#") + "  DI+ " + str.tostring(diplus, "#.#") + " / DI- " + str.tostring(diminus, "#.#")), _tmV)
    if h2Show and not h2Docked
        r += 1
        _tmHead(r, "H2 SWEEP → VALUE", "pre-registered · display only", _tmSec)
        r += 1
        _tmRow(r, "SIGNAL", h2SigCard + h2SigStat, h2SigState == 1 ? _tmUp : h2SigState == -1 ? _tmDn : h2SigState == 2 ? _tmS : _tmV)
        if not _cmp
            r += 1
            _tmRow(r, "TREND", h2Trend + "  1H " + f_sc(h2S1) + " 4H " + f_sc(h2S4) + " 1D " + f_sc(h2SD) + "\n(>=60 up, <=40 down)", h2TrendUp ? _tmUp : h2TrendDn ? _tmDn : _tmV)
            r += 1
            _tmRow(r, "VALUE", "VAL " + _h2p(h2Val) + "  POC " + _h2p(h2Poc) + "\nVAH " + _h2p(h2Vah) + "  (100 bars)", _tmV)
            r += 1
            _tmRow(r, "SWINGS", "high " + (na(h2SwH) ? "consumed" : _h2p(h2SwH)) + "\nlow " + (na(h2SwL) ? "consumed" : _h2p(h2SwL)) + "  (unswept)", _tmV)
            r += 1
            _tmRow(r, "SWEEP", h2LastSweep, str.startswith(h2LastSweep, "LOW") ? _tmUp : str.startswith(h2LastSweep, "HIGH") ? _tmDn : _tmV)
        r += 1
        _tmRow(r, "NEXT", h2Next, na(h2Poc) ? _tmV : close < h2Val ? _tmUp : close > h2Vah ? _tmDn : _tmV)
        if h2Layout == "Full"
            string _sn = sessId == 0 ? "Asian" : sessId == 1 ? "London" : sessId == 2 ? "NY" : "off-session"
            r += 1
            _tmRow(r, "SESSION", _sn + (curSessId != sessId or na(sesHi) ? "\nstarts next confirmed bar" : "  range " + _h2p(sesLo) + "-" + _h2p(sesHi) + "\nopen " + _h2p(sesOpenPx) + "  exp " + (na(sessExpansionPct) ? "—" : str.tostring(int(sessExpansionPct)) + "% of avg") + (sesManip ? "\nSWEPT prev session extreme" : "")), sesManip ? color.orange : _tmV)
            r += 1
            _tmRow(r, "HISTORY", "manip " + (na(sessManipProb) ? "—" : str.tostring(int(sessManipProb)) + "%" + f_ci(sessManipProb, ckN)) + "  cont " + (na(sessContProb) ? "—" : str.tostring(int(sessContProb)) + "%" + f_ci(sessContProb, ckN)) + "\nprev H " + _h2p(prevSesHi) + "  L " + _h2p(prevSesLo), _tmV)
            r += 1
            _tmRow(r, "VOLUME", sessVolBase > 0 and not na(volume) ? "x" + str.tostring(volume / sessVolBase, "#.#") + " of session avg\n(tick volume)" : "—", _tmV)
    if gdPos != "Hidden" and not gdDocked
        r += 1
        r += 1
        _tmRow(r, "MACRO", mxVerdict + " (= the Master's MACRO cell)", (mxDir > 0 ? _tmUp : mxDir < 0 ? _tmDn : _tmV))
        _tmHead(r + 1, "OTHER DRIVERS", "context · not in the MACRO score", _tmSec)
        r += 1
        if _cmp
            float _net = nz(brJd) + nz(brOd) + nz(brRd) + nz(brBd) + nz(br2d)
            r += 1
            table.cell(tblV, 0, r, "OTHER", text_color = _tmK, text_size = h2Sz, text_halign = text.align_left)
            table.cell(tblV, 1, r, "JPY" + f_tmG(brJd) + "  OIL" + f_tmG(brOd) + "  RY" + f_tmG(brRd) + "  BE" + f_tmG(brBd) + "  2Y" + f_tmG(br2d), text_color = _tmV, text_size = h2Sz, text_halign = text.align_left, tooltip = "Net of the five: " + f_tmG(_net) + " (context only; the MACRO verdict is the row above)\nUSDJPY: " + brJh + "\nOIL: " + brOh + "\nREAL YLD: " + brRh + "\nBREAKEVEN: " + brBh + "\nUS 2Y: " + br2h)
        else
            r += 1
            _tmRow(r, "USDJPY " + f_tmG(brJd), brJh, f_tmC(brJd))
            r += 1
            _tmRow(r, "OIL " + f_tmG(brOd), brOh, f_tmC(brOd))
            r += 1
            _tmRow(r, "REAL YLD " + f_tmG(brRd), brRh, f_tmC(brRd))
            r += 1
            _tmRow(r, "BREAKEVEN " + f_tmG(brBd), brBh, f_tmC(brBd))
            r += 1
            _tmRow(r, "US 2Y " + f_tmG(br2d), br2h, f_tmC(br2d))
    if lqInPanel
        r += 1
        _tmHead(r, "LIQUIDITY · SWEEPS", "TradingView prices", _tmSec)
        r += 1
        _tmRow(r, "DAY", f_lv("PDH", pdh) + "\n" + f_lv("PDL", pdl), _tmV)
        r += 1
        _tmRow(r, "WEEK", f_lv("PWH", pwh) + "\n" + f_lv("PWL", pwl), _tmV)
        r += 1
        _tmRow(r, "MONTH", f_lv("PMH", pmh) + "\n" + f_lv("PML", pml), _tmV)
        r += 1
        _tmRow(r, "TODAY", f_lv("CDH", cdh) + "\n" + f_lv("CDL", cdl), _tmV)
        r += 1
        _tmRow(r, "SWEEPS", "pivot ✕ " + pvLastSweep + "\nH2 " + str.replace_all(h2LastSweep, "\n", "  "), str.startswith(pvLastSweep, "LOW") ? _tmUp : str.startswith(pvLastSweep, "HIGH") ? _tmDn : _tmV)
    if ckPanel
        color _amb = color.new(#FFB74D, 0)
        r += 1
        _tmHead(r, "CHECKS · RISK", "display only · v86", _tmSec)
        r += 1
        _tmRow(r, "SCORE", "the Master's L / S / R and mP are SCORES, not win odds" + (_cmp ? "" : "\nmP measured out of sample (audit, Oct 2026): AUC 0.48-0.53,\nno better than chance; trust the levels, not the %"), _amb)
        r += 1
        _tmRow(r, "NEWS", (nwNowIn ? "IN THE WINDOW · " : "next ") + nwNext + (na(nwMs) or nwNowIn ? "" : " · in " + f_dur(nwMs)) + (_cmp ? "" : "\nwindow −" + str.tostring(nwBefore) + "/+" + str.tostring(nwAfter) + " min · official BLS / Fed dates · the Master's engine neither blocks nor re-costs news"), nwLv == 2 ? _tmDn : nwLv == 1 ? _amb : _tmV)
        r += 1
        _tmRow(r, "COST", str.tostring(ckCost, "#.##") + " pts round trip" + (nwBarIn and nwCostMult > 1.0 ? " (NEWS ×" + str.tostring(nwCostMult, "#.#") + ")" : "") + " = " + (na(ckCostPct) ? "—" : str.tostring(ckCostPct, "#") + "%") + " of 1 ATR (" + (na(atr14) ? "—" : str.tostring(atr14, "#.##")) + ")" + (_cmp ? "" : "\nTP1 should be ≥ 4 × cost = $" + str.tostring(4.0 * ckCost, "#.##") + " · above 25% the cost eats the edge"), ckCostLv == 2 ? _tmDn : ckCostLv == 1 ? _amb : _tmV)
        if not _cmp
            r += 1
            _tmRow(r, "CHURN", "structure flips " + str.tostring(ckFlips) + " in 20 bars · efficiency " + (na(ckER) ? "—" : str.tostring(ckER, "#.##")) + "\n" + (ckChurn ? "CHURN: signals tend to flip within a few bars" : "no churn (2+ flips = churn; efficiency < 0.25 = choppy)"), ckChurn ? _amb : _tmV)
            r += 1
            _tmRow(r, "DAILY", rgTxt + " · 12M " + (na(rgRet12) ? "—" : (rgRet12 >= 0 ? "+" : "") + str.tostring(rgRet12, "#.#") + "%") + " · " + (na(rgSma1) or na(rgC1) ? "SMA200 —" : rgC1 > rgSma1 ? "above SMA200" : "below SMA200") + "\nreal yld 20d " + (na(rgRyD) ? "—" : str.tostring(rgRyD, "#.##")) + " · DXY 20d " + (na(rgDxD) ? "—" : str.tostring(rgDxD, "#.##")) + " · " + rgMacTxt + " · UNTESTED", rgUp ? _tmUp : rgDn ? _tmDn : _tmV)
        r += 1
        _tmRow(r, "RISK", str.tostring(rkPct, "#.##") + "% of $" + str.tostring(rkEquity, "#") + " = $" + str.tostring(rkRisk, "#.##") + " · stop $" + (na(rkStopD) ? "—" : str.tostring(rkStopD, "#.##")) + (rkStop > 0 ? "" : not na(lkSLp) ? " (the Master's plan SL)" : " (1 ATR, not the Master's plan SL: type it in)") + " + cost " + str.tostring(ckCost, "#.##") + "\n→ " + (na(rkLots) ? "—" : rkLots < 0.01 ? "below 0.01 lot: skip or widen the account" : str.tostring(rkLots, "#.##") + " lot (MT5 step 0.01, " + str.tostring(pointValue, "#") + " oz)") + (lkLotsOn ? "\nthe Master's plan: " + (lkLots < 0 ? "below 0.01 lot" : str.tostring(lkLots, "#.##") + " lot (half-Kelly, capped at its Risk %)") : ""), _tmV)
        if trkShow
            r += 1
            _tmRow(r, "BRACKET", trkTxt, trkLv == 1 ? _tmUp : trkLv == -1 ? _tmDn : _amb)
        r += 1
        _tmRow(r, "TODAY", rkLocked ? "STOP FOR THE DAY · " + str.tostring(rkToday, "#.##") + "R reached the " + str.tostring(rkCap, "#.#") + "R cap" : str.tostring(rkToday, "#.##") + "R so far · " + str.tostring(rkToday - rkCap, "#.##") + "R left before the " + str.tostring(rkCap, "#.#") + "R cap (typed in)", rkLocked ? _tmDn : _tmV)
        if not _cmp
            r += 1
            _tmRow(r, "SESSIONS", "this session: manip " + (na(sessManipProb) ? "—" : str.tostring(int(sessManipProb)) + "%" + f_ci(sessManipProb, ckN)) + "\ncont " + (na(sessContProb) ? "—" : str.tostring(int(sessContProb)) + "%" + f_ci(sessContProb, ckN)) + " · 95% ranges (Wilson)", _tmV)
        if lgShow
            r += 1
            _tmRow(r, "RECORD", lgTxt + "\n→ " + lgVerdict + (lgNote != "" ? " · " + lgNote : "") + "\n" + tfNote, lgLv == -1 ? _tmDn : lgLv == 1 ? _tmUp : _amb)
        if lg2Show
            r += 1
            _tmRow(r, "RECORD 2", lg2Txt + "\n→ " + lg2Verdict + (lg2Note != "" ? " · " + lg2Note : ""), lg2Lv == -1 ? _tmDn : lg2Lv == 1 ? _tmUp : _amb)
    r += 1
    table.cell(tblV, 0, r, "display only · the DECISION is the Master's · H2 record: the website", text_color = color.new(#5D6B7A, 0), text_size = size.tiny, text_halign = text.align_left)
    table.merge_cells(tblV, 0, r, 1, r)

// ═══════════════════ DOCKS UNDER THE MASTER'S DASHBOARD (v74 drivers; v75 H2 card, liquidity) ═══════════════════
// Same anchor, no border / frame and the same nine column widths as the Master's dashboard, so a dock's column c sits
// exactly under the Master's column c (4 LIQUIDITY, 6 MACRO, 8 DECISION); row 0 is a transparent spacer of the dock
// gap (% of chart height). v77: one table for all three (one table per position per script is what TradingView shows). The cells use the Master's dashboard
// background and detail text size; the drivers use the drivers card's glyphs and colours, the H2 dock the H2 card's
// row texts and colours.
int[] _dkW = array.from(10, 10, 12, 11, 13, 10, 11, 11, 13)
float _dw = density == "Compact" ? 0.8 : density == "Spacious" ? 1.25 : 1.0
string _dsz = textSize == "Large" or textSize == "Medium" ? "small" : "tiny"
color _dbg = color.new(#0d0d1a, 40)
f_dock(table t, int col, int gap) =>
    for [c, w] in _dkW
        table.cell(t, c, 0, "", width = int(w * _dw), height = c == col ? gap : 0)
f_dkCell(table t, int col, int r, string txt, color tc) =>
    table.cell(t, col, r, txt, text_color = tc, bgcolor = _dbg, text_size = _dsz, width = int(array.get(_dkW, col) * _dw), text_halign = text.align_left)
// v78: the band's rows share heights, so every cell is kept to the same 2 lines (headers 1): the H2 header is one line
// and its 4-line SIGNAL is split into two 2-line cells (same text, same colour). No gaps between the liquidity and the
// driver lines; nothing removed.
var table dkT = table.new(dashMode == "Tablet" ? position.top_left : position.top_right, 9, 10, border_width = 0, frame_width = 0)
if barstate.islast
    table.clear(dkT, 0, 0, 8, 9)
if (gdDocked or lqDocked or h2Docked and h2Show) and barstate.islast
    f_dock(dkT, 0, gdGap)
if gdDocked and barstate.islast
    float _net = nz(brJd) + nz(brOd) + nz(brRd) + nz(brBd) + nz(br2d)
    table.cell(dkT, 6, 1, "OTHER DRIVERS · context", text_color = color.new(#AEBBC9, 0), bgcolor = _dbg, text_size = _dsz, width = int(11 * _dw), text_halign = text.align_left, tooltip = "Not in the Master's MACRO score: the MACRO verdict is the Master's MACRO cell above (Visuals' ticker shows the same). Net of these five: " + f_tmG(_net) + ". Each arrow: green = supports gold up, red = down. Display only.")
    f_dkCell(dkT, 6, 2, "USDJPY " + f_tmG(brJd) + "\n" + brJh, f_tmC(brJd))
    f_dkCell(dkT, 6, 3, "OIL " + f_tmG(brOd) + "\n" + brOh, f_tmC(brOd))
    f_dkCell(dkT, 6, 4, "REAL YLD " + f_tmG(brRd) + "\n" + brRh, f_tmC(brRd))
    f_dkCell(dkT, 6, 5, "BREAKEVEN " + f_tmG(brBd) + "\n" + brBh, f_tmC(brBd))
    f_dkCell(dkT, 6, 6, "US 2Y " + f_tmG(br2d) + "\n" + br2h, f_tmC(br2d))
if lqDocked and barstate.islast
    f_dkCell(dkT, 4, 1, "LIQUIDITY · SWEEPS", color.new(#AEBBC9, 0))
    f_dkCell(dkT, 4, 2, f_lv("PDH", pdh) + "\n" + f_lv("PDL", pdl), _tmV)
    f_dkCell(dkT, 4, 3, f_lv("PWH", pwh) + "\n" + f_lv("PWL", pwl), _tmV)
    f_dkCell(dkT, 4, 4, f_lv("PMH", pmh) + "\n" + f_lv("PML", pml), _tmV)
    f_dkCell(dkT, 4, 5, f_lv("CDH", cdh) + "\n" + f_lv("CDL", cdl), _tmV)
    f_dkCell(dkT, 4, 6, "SWEPT pivot ✕ " + pvLastSweep + "\nH2 " + str.replace_all(h2LastSweep, "\n", "  "), str.startswith(pvLastSweep, "LOW") ? _tmUp : str.startswith(pvLastSweep, "HIGH") ? _tmDn : _tmV)
if h2Docked and h2Show and barstate.islast
    f_dkCell(dkT, 8, 1, "H2 SWEEP → VALUE · " + timeframe.period + " · = website H3", color.new(#AEBBC9, 0))
    array<string> _sp = str.split("SIGNAL  " + h2SigCard + h2SigStat, "\n")
    int _ns = array.size(_sp)
    color _sgc = h2SigState == 1 ? _tmUp : h2SigState == -1 ? _tmDn : h2SigState == 2 ? _tmS : _tmV
    f_dkCell(dkT, 8, 2, _ns > 1 ? array.get(_sp, 0) + "\n" + array.get(_sp, 1) : array.get(_sp, 0), _sgc)
    f_dkCell(dkT, 8, 3, _ns > 2 ? array.join(array.slice(_sp, 2, _ns), "\n") : "", _sgc)
    f_dkCell(dkT, 8, 4, "TREND  " + h2Trend + "  1H " + f_sc(h2S1) + " 4H " + f_sc(h2S4) + " 1D " + f_sc(h2SD) + "\n(>=60 up, <=40 down)", h2TrendUp ? _tmUp : h2TrendDn ? _tmDn : _tmV)
    f_dkCell(dkT, 8, 5, "VALUE  " + "VAL " + _h2p(h2Val) + "  POC " + _h2p(h2Poc) + "\nVAH " + _h2p(h2Vah) + "  (100 bars)", _tmV)
    f_dkCell(dkT, 8, 6, "SWINGS  " + "high " + (na(h2SwH) ? "consumed" : _h2p(h2SwH)) + "\nlow " + (na(h2SwL) ? "consumed" : _h2p(h2SwL)) + "  (unswept)", _tmV)
    f_dkCell(dkT, 8, 7, "SWEEP  " + h2LastSweep, str.startswith(h2LastSweep, "LOW") ? _tmUp : str.startswith(h2LastSweep, "HIGH") ? _tmDn : _tmV)
    f_dkCell(dkT, 8, 8, "NEXT  " + h2Next, na(h2Poc) ? _tmV : close < h2Val ? _tmUp : close > h2Vah ? _tmDn : _tmV)
    f_dkCell(dkT, 8, 9, "conditional, not an entry\nH2 record: the website", color.new(#8FA3B8, 0))

// ═══════════════════ BOTTOM TICKER (v81) — the glance in one strip ═══════════════════
// Six tiles, each a large value over a small grey label, the same values as the glance (trend vote, value position,
// room to the nearest tagged levels, macro net, last pivot sweep, last H2 signal). Bias and odds stay the Master's
// (its BIAS / SIGNAL cells; the TREND tile's tooltip says so). Row 2 is a transparent spacer that lifts the strip above
// the Master's plan strip; it has no background (the tiles carry their own), so it stays see-through. Bottom centre is
// this script's only bottom-centre table while the ticker is on.
// v86: row 0 is the forward-record banner (merged across the tiles), rows 1-2 the tiles, row 3 the spacer; tile 6 the
// daily regime (untested) and tile 7 the checks (news, cost, churn, daily cap).
var table tkT = table.new(position.bottom_center, 8, 4, border_color = color.new(#0B0F14, 0), border_width = 2, frame_width = 0)
f_tk(int c, string v, color vc, string lbl, string tip) =>
    table.cell(tkT, c, 1, v, text_color = vc, bgcolor = color.new(#0F141B, 0), text_size = tkSize == "Large" ? size.large : tkSize == "Small" ? size.small : size.normal, tooltip = tip)
    table.cell(tkT, c, 2, lbl, text_color = color.new(#7D8FA3, 0), bgcolor = color.new(#0F141B, 0), text_size = size.tiny, tooltip = tip)
if barstate.islast
    table.clear(tkT, 0, 0, 7, 3)
if tkOn and barstate.islast
    [_tUpP, _tUpN] = f_glNear(true, close)
    [_tDnP, _tDnN] = f_glNear(false, close)
    float _tUpR = na(_tUpP) ? na : _tUpP - close
    float _tDnR = na(_tDnP) ? na : close - _tDnP
    float _tNet = nz(brJd) + nz(brOd) + nz(brRd) + nz(brBd) + nz(br2d)
    string _ok = "✓"
    string _no = "✗"
    f_tk(0, h2TrendUp ? "▲ UP" : h2TrendDn ? "▼ DOWN" : "◆ MIXED", h2TrendUp ? _tmUp : h2TrendDn ? _tmDn : _tmV, "trend 1H·4H·1D" + (na(ema200) ? "" : close > ema200 ? " · ▲EMA200" : " · ▼EMA200"), "1H " + f_sc(h2S1) + " · 4H " + f_sc(h2S4) + " · 1D " + f_sc(h2SD) + " (>=60 up, <=40 down; 2 of 3 decide)\nBias and scores: the Master's BIAS / SIGNAL cells (scores, not calibrated odds).")
    f_tk(1, na(h2Poc) ? "building" : close > h2Vah ? "above value" : close < h2Val ? "below value" : close >= h2Poc ? "over POC" : "under POC", na(h2Poc) ? _tmV : close < h2Val ? _tmUp : close > h2Vah ? _tmDn : _tmV, "value · POC " + _h2p(h2Poc), "VAL " + _h2p(h2Val) + " · POC " + _h2p(h2Poc) + " · VAH " + _h2p(h2Vah) + " (100 bars)\n" + h2Next)
    f_tk(2, "↓" + (na(_tDnR) ? "—" : str.tostring(_tDnR, "#.#") + (_tDnR >= glMoveA ? _ok : _no)) + "  ↑" + (na(_tUpR) ? "—" : str.tostring(_tUpR, "#.#") + (_tUpR >= glMoveA ? _ok : _no)), _tmV, "room $" + str.tostring(glMoveA, "#") + " · " + (na(_tDnP) ? "—" : _tDnN) + " / " + (na(_tUpP) ? "—" : _tUpN), "Space to the nearest tagged level: below " + (na(_tDnP) ? "none" : _tDnN + " " + str.tostring(_tDnP, format.mintick)) + ", above " + (na(_tUpP) ? "none" : _tUpN + " " + str.tostring(_tUpP, format.mintick)) + "\n✓ = at least $" + str.tostring(glMoveA, "#") + (na(_tUpR) and na(_tDnR) ? "" : "; $" + str.tostring(glMoveB, "#") + " target: " + (not na(_tUpR) and _tUpR >= glMoveB ? "up ✓ " : "up ✗ ") + (not na(_tDnR) and _tDnR >= glMoveB ? "down ✓" : "down ✗")))
    f_tk(3, mxGlyph + " " + (macroIntelLabel == "N/A" ? "—" : str.tostring(macroIntelScore)), (mxDir > 0 ? _tmUp : mxDir < 0 ? _tmDn : _tmV), "macro · = Master", mxWhy + "\nOther drivers (context, not in the score), net " + f_tmG(_tNet) + ": USDJPY " + f_tmG(brJd) + " · OIL " + f_tmG(brOd) + " · REAL YLD " + f_tmG(brRd) + " · BREAKEVEN " + f_tmG(brBd) + " · US 2Y " + f_tmG(br2d) + "\nDisplay only: no vote, weight or gate.")
    f_tk(4, na(pvLastLvl) ? "none yet" : (pvLastUp ? "HIGH " : "LOW ") + str.tostring(pvLastLvl, format.mintick), na(pvLastLvl) ? _tmV : pvLastUp ? _tmDn : _tmUp, "last sweep" + (na(pvLastTime) ? "" : " · " + str.tostring((time - pvLastTime) / 3600000.0, "#.#") + " h ago"), "Pivot sweep (the ✕ markers): " + pvLastSweep + "\nH2 sweep: " + str.replace_all(h2LastSweep, "\n", "  "))
    f_tk(5, h2SigDir == 0 ? "none yet" : (h2SigDir == 1 ? "BUY" : "SELL") + (h2Stale ? " ○" : " ●"), h2SigState == 1 ? _tmUp : h2SigState == -1 ? _tmDn : h2SigState == 2 ? _tmS : _tmV, "H2 · " + (h2SigDir == 0 ? "no signal" : (h2Stale ? "stale" : "live") + (h2SigOut != "" ? " · " + h2SigOut : "")), h2SigCard + h2SigStat)
    int _c = 6
    if rgShow
        f_tk(_c, rgTxt, rgUp ? _tmUp : rgDn ? _tmDn : _tmV, "daily regime · untested", "12-month return " + (na(rgRet12) ? "—" : str.tostring(rgRet12, "#.#") + "%") + " · " + (na(rgSma1) or na(rgC1) ? "SMA200 —" : rgC1 > rgSma1 ? "above" : "below") + " the 200-day average\nreal yield 20d " + (na(rgRyD) ? "—" : str.tostring(rgRyD, "#.##")) + " · DXY 20d " + (na(rgDxD) ? "—" : str.tostring(rgDxD, "#.##")) + " → " + rgMacTxt + " (a 20-day daily reading, not the Master's MACRO)\nAn UNTESTED hypothesis (Phase 1 report R1 / R2): context, never a signal.")
        _c += 1
    int _ckLv = math.max(nwLv, ckCostLv, rkLocked ? 2 : 0, ckChurn ? 1 : 0)
    string _ckTx = (rkLocked ? "STOP DAY · " : "") + (nwLv == 2 ? "NEWS · " : nwLv == 1 ? nwKName + " " + f_dur(nwMs) + " · " : "") + (ckCostLv >= 1 ? "COST " + str.tostring(ckCostPct, "#") + "% · " : "") + (ckChurn ? "CHURN · " : "")
    f_tk(_c, _ckTx == "" ? "OK ✓" : str.substring(_ckTx, 0, str.length(_ckTx) - 3), _ckLv == 2 ? _tmDn : _ckLv == 1 ? color.new(#FFB74D, 0) : _tmUp, "checks · next " + nwNext, "NEWS " + (nwNowIn ? "in the window: " : "next: ") + nwNext + (na(nwMs) or nwNowIn ? "" : " in " + f_dur(nwMs)) + "\nCOST " + str.tostring(ckCost, "#.##") + " pts = " + (na(ckCostPct) ? "—" : str.tostring(ckCostPct, "#") + "%") + " of 1 ATR (red > 25%, amber > 15%)\nCHURN " + str.tostring(ckFlips) + " structure flips in 20 bars (2+ = churn) · efficiency " + (na(ckER) ? "—" : str.tostring(ckER, "#.##")) + "\nTODAY " + str.tostring(rkToday, "#.##") + "R of the " + str.tostring(rkCap, "#.#") + "R cap\nScores in the Master are not win odds.")
    if lgShow
        table.cell(tkT, 0, 0, "● " + lgLine + " · " + tfNote + (lg2Show ? "\n● " + lg2Line + (lg2Note != "" ? " · " + lg2Note : "") : ""), text_color = color.white, bgcolor = lgLv == -1 ? color.new(#B71C1C, 15) : lgLv == 1 ? color.new(#1B5E20, 15) : color.new(#6D4C00, 15), text_size = size.tiny, tooltip = "Typed in from the website's forward ledger as of " + lgAsof + " (Visuals settings, CHECKS & RISK). Rule: N >= 50, 95% t-interval of mean R above 0, PF >= 1.2.\n" + lgArm + " note: " + lgNote)
        table.merge_cells(tkT, 0, 0, _c, 0)
    for c = 0 to 7
        table.cell(tkT, c, 3, "", height = tkLift, bgcolor = color(na))
