
// DIAG-BEGIN market brief
// ═══════════════════ MARKET BRIEF (v52, DECISION-driven since v54) ═══════════════════
// The website's Market Brief (site/app.js renderBrief, default branch) on this chart, from the
// Treatment engine above, verbatim. Display only: no gate, no order. DO NOW reads the engine's own
// DECISION `_confDirLabel` (RISK LOCK > NO TRADE > BUY / SELL > WARMUP > WAIT), the same line as the
// Master's (F-A55). The twin refreshes its statistics every 2-12 bars, the Master also on the last
// bar, so L/S/R and the DECISION can differ from the Master's for a few bars; the Master rules. The playbook
// is the website's arm H4 rule (quantum/arm_h4.py), constant for constant; brief_trace.py executes
// it. Its record is the website's (A7); nothing here is counted.
grpBrief = "MARKET BRIEF"
brPos = input.string("Top Right", "Panel position", options=["Top Right", "Middle Right", "Bottom Right", "Bottom Left", "Top Left"], group=grpBrief)
brTxt = input.string("Small", "Text size", options=["Tiny", "Small", "Normal"], group=grpBrief)
brOffset = input.float(0.0, "MT5 Price Offset (MT5 - TradingView)", minval=-50.0, maxval=50.0, step=0.01, group=grpBrief, tooltip="Use the same value as in the Master. Shifts DISPLAYED prices only; distances do not change.")
brAlert = input.bool(true, "Alert when a playbook trigger fires (info, not a DECISION)", group=grpBrief)
brGPos = input.string("Bottom Left", "Gold-arrow grid position", options=["Bottom Left", "Bottom Right", "Middle Right", "Top Left", "Hidden"], group=grpBrief) // v61: default off the panel's column
brLayout = input.string("Full", "Panel layout", options=["Full", "Compact (phone)"], group=grpBrief, tooltip="Compact: TREND, DO NOW, the playbook and the gates only, for a phone-width chart. Full adds heading, last sweep, target, playbook note, engine cross-check and data feeds.")
bool brCompact = brLayout == "Compact (phone)"
// v90 (F-A77): the website's H4 verdict (site/app.js h4Losing, 2026-10-22). Each timeframe is judged on ITS OWN live H4
// record: with N >= 50 and t = mean R / (sd / sqrt N) <= -2 (backtest.metrics t_stat), the site's DO NOW no longer says
// "Wait for a trigger" and the playbook triggers are levels, not entries. Pine cannot read the ledger, so the records
// are typed in per timeframe (defaults: the ledger as of 2026-10-31 00:58 UTC; brief_trace.py 7 runs the site's own
// h4Losing / doNow lines in Node against these lines, and recomputes the defaults from the ledger files).
brH4Asof = input.string("2026-10-31 00:58 UTC", "H4 live record: as of", group=grpBrief)
brH4N5 = input.int(511, "H4 5m: N", minval=0, maxval=100000, group=grpBrief, inline="h45")
brH4M5 = input.float(-0.1789, "mean R", minval=-10.0, maxval=10.0, step=0.0001, group=grpBrief, inline="h45")
brH4S5 = input.float(0.8513, "sd R", minval=0.0, maxval=20.0, step=0.0001, group=grpBrief, inline="h45")
brH4N15 = input.int(171, "H4 15m: N", minval=0, maxval=100000, group=grpBrief, inline="h415")
brH4M15 = input.float(-0.0920, "mean R", minval=-10.0, maxval=10.0, step=0.0001, group=grpBrief, inline="h415")
brH4S15 = input.float(0.8006, "sd R", minval=0.0, maxval=20.0, step=0.0001, group=grpBrief, inline="h415")
brH4N60 = input.int(49, "H4 1h: N", minval=0, maxval=100000, group=grpBrief, inline="h460")
brH4M60 = input.float(-0.1867, "mean R", minval=-10.0, maxval=10.0, step=0.0001, group=grpBrief, inline="h460")
brH4S60 = input.float(0.6343, "sd R", minval=0.0, maxval=20.0, step=0.0001, group=grpBrief, inline="h460")
brH4N240 = input.int(12, "H4 4h: N", minval=0, maxval=100000, group=grpBrief, inline="h4240")
brH4M240 = input.float(-0.1070, "mean R", minval=-10.0, maxval=10.0, step=0.0001, group=grpBrief, inline="h4240")
brH4S240 = input.float(0.8853, "sd R", minval=0.0, maxval=20.0, step=0.0001, group=grpBrief, inline="h4240")
string brTf = timeframe.period
int brH4N = brTf == "5" ? brH4N5 : brTf == "15" ? brH4N15 : brTf == "60" ? brH4N60 : brTf == "240" ? brH4N240 : 0
float brH4M = brTf == "5" ? brH4M5 : brTf == "15" ? brH4M15 : brTf == "60" ? brH4M60 : brTf == "240" ? brH4M240 : na
float brH4S = brTf == "5" ? brH4S5 : brTf == "15" ? brH4S15 : brTf == "60" ? brH4S60 : brTf == "240" ? brH4S240 : na
float brH4T = brH4N > 1 and brH4S > 0 ? brH4M / (brH4S / math.sqrt(brH4N)) : na
bool h4Losing = brH4N >= 50 and not na(brH4T) and brH4T <= -2
f_brSt(int c) => c == 0 ? "OK" : c == 1 ? "NA" : c == 2 ? "STALE" : "BAD"
brSz = brTxt == "Tiny" ? size.tiny : brTxt == "Normal" ? size.normal : size.small

f_brP(float x) => na(x) ? "—" : str.tostring(x + brOffset, "#.##")
f_brD(float x) => na(x) ? "—" : (x >= 0 ? "+" : "") + str.tostring(x, "#.##")
// v67 (operator: every value wired): integer or — (as the Master's _si), for the STATS row
f_brI(float x) => na(x) ? "—" : str.tostring(int(x))
f_brAgo(int n) => str.tostring(n) + (n == 1 ? " bar ago" : " bars ago")
f_brHtf(float s) => na(s) or s == 50 ? "n/a" : s >= 60 ? "up" : s <= 40 ? "down" : "mixed"
f_brAdd(float[] v, string[] n, string nm, float x) =>
    if not na(x)
        array.push(v, x)
        array.push(n, nm)
    true
// arm_h4: sort by price (stable), then keep a level only if it is at least MERGE_ATR (0.05) x ATR
// from every level already kept; then the side's candidates beyond GAP_ATR (0.1) x ATR, nearest first.
f_brSplit(float[] v, string[] n, float p, float a, int dir, float[] ov, string[] on) =>
    float[] sv = array.new_float()
    string[] sn = array.new_string()
    for [k, x] in v
        int pos = 0
        for e in sv
            pos += e <= x ? 1 : 0
        array.insert(sv, pos, x)
        array.insert(sn, pos, array.get(n, k))
    float[] kv = array.new_float()
    string[] kn = array.new_string()
    for [k, x] in sv
        bool near = false
        for w in kv
            near := near or math.abs(x - w) < 0.05 * a
        if not near
            array.push(kv, x)
            array.push(kn, array.get(sn, k))
    for [k, x] in kv
        if dir > 0 and x > p + 0.1 * a
            array.push(ov, x)
            array.push(on, array.get(kn, k))
        if dir < 0 and x < p - 0.1 * a
            array.unshift(ov, x)
            array.unshift(on, array.get(kn, k))
    true
// arm_h4.side: trigger = nearest; TP1 / TP2 = the next levels at least MIN_TP_R (1) stop beyond
// the trigger, else FALLBACK_R (2) stops; stop = trigger -/+ regSLMult x ATR; R:R = |TP1 - trigger| / stop.
f_brSide(float[] v, string[] n, float p, float a, float d, int dir) =>
    float[] lv = array.new_float()
    string[] ln = array.new_string()
    f_brSplit(v, n, p, a, dir, lv, ln)
    float tv = na
    string tn = ""
    float f1 = na
    string n1 = "2R"
    float f2 = na
    string n2 = ""
    for [k, x] in lv
        if k == 0
            tv := x
            tn := array.get(ln, 0)
        else if dir * (x - tv) >= d
            if na(f1)
                f1 := x
                n1 := array.get(ln, k)
            else if na(f2)
                f2 := x
                n2 := array.get(ln, k)
    float t1 = na(f1) ? tv + dir * 2.0 * d : f1
    [tv, tn, tv - dir * d, t1, n1, na(f2) ? t1 : f2, na(f2) ? n1 : n2, math.abs(t1 - tv) / d]
// site nextLevels: nearest level strictly beyond p on side dir; with `after`, at least 0.01 beyond it.
f_brNear(float[] v, string[] n, float p, int dir, float after) =>
    float bx = na
    string bn = ""
    for [k, x] in v
        if dir * (x - p) > 0 and (na(after) or dir * (x - after) >= 0.01) and (na(bx) or dir * (x - bx) < 0)
            bx := x
            bn := array.get(n, k)
    [bx, bn]

// ---- last liquidity taken: the engine's own sweep (liqSweepBull / liqSweepBear), confirmed bars.
// Pool named as on the site: the PDH/PWH (PDL/PWL) the wick went through, closest to the wick; else the month.
var float brSwPx = na
var int brSwDir = 0
var int brSwBar = na
var int brSwT = na
var string brSwPool = ""
var float brSwLvl = na
if barstate.isconfirmed and (liqSweepBull or liqSweepBear)
    bool _dn = liqSweepBear
    brSwDir := _dn ? -1 : 1
    brSwPx := _dn ? high : low
    brSwBar := bar_index
    brSwT := time
    brSwPool := _dn ? "PMH" : "PML"
    brSwLvl := _dn ? poolPmH : poolPmL
    bool _first = true
    for [k, x] in array.from(_dn ? poolPdH : poolPdL, _dn ? poolPwH : poolPwL)
        if not na(x) and (_dn ? brSwPx >= x : brSwPx <= x) and (_first or math.abs(brSwPx - x) < math.abs(brSwPx - brSwLvl))
            brSwPool := (k == 0 ? "PD" : "PW") + (_dn ? "H" : "L")
            brSwLvl := x
            _first := false

// ---- the playbook is built at the close of a bar and applies to the next (arm_h4 docstring) ----
var float[] brV = array.new_float()
var string[] brN = array.new_string()
var float[] brNv = array.new_float()
var string[] brNn = array.new_string()
var float brSp = na
var float brSa = na
var float brSd = na
var int brSnap = na
var string brFired = ""
if barstate.isconfirmed and bar_index >= last_bar_index - 2
    // arm_h4.evaluate: this bar trades the playbook of the previous bar (sell first, then buy)
    if brSnap == bar_index - 1 and brSa > 0
        [sT, sN, sS, s1, s1n, s2, s2n, sR] = f_brSide(brV, brN, brSp, brSa, brSd, -1)
        [bT, bN, bS, b1, b1n, b2, b2n, bR] = f_brSide(brV, brN, brSp, brSa, brSd, 1)
        bool fS = not na(sT) and close < sT and close > s1
        bool fB = not fS and not na(bT) and close > bT and close < b1
        if fS or fB
            brFired := (fS ? "▼ SELL " : "▲ BUY ") + "fired " + str.format_time(time, "dd MMM HH:mm", "UTC") + " UTC at " + f_brP(close) + ": stop " + f_brP(fS ? sS : bS) + " · TP1 " + f_brP(fS ? s1 : b1) + ((fS ? s2 : b2) != (fS ? s1 : b1) ? " · TP2 " + f_brP(fS ? s2 : b2) : "")
            if brAlert
                alert("XAUUSD " + timeframe.period + " playbook " + brFired + " (MT5) | info, not a DECISION", alert.freq_once_per_bar_close)
    array.clear(brV)
    array.clear(brN)
    array.clear(brNv)
    array.clear(brNn)
    f_brAdd(brV, brN, "PDH", poolPdH)
    f_brAdd(brV, brN, "PDL", poolPdL)
    f_brAdd(brV, brN, "PWH", poolPwH)
    f_brAdd(brV, brN, "PWL", poolPwL)
    f_brAdd(brV, brN, "PMH", poolPmH)
    f_brAdd(brV, brN, "PML", poolPmL)
    f_brAdd(brV, brN, "EQH", poolEqH)
    f_brAdd(brV, brN, "EQL", poolEqL)
    f_brAdd(brV, brN, "Day high", cdh)
    f_brAdd(brV, brN, "Day low", cdl)
    for [k, x] in brV
        array.push(brNv, x)
        array.push(brNn, array.get(brN, k))
    f_brAdd(brNv, brNn, "Swing high", swingActiveResistance)
    f_brAdd(brNv, brNn, "Swing low", swingActiveSupport)
    f_brAdd(brV, brN, "Internal high", activeResistance)
    f_brAdd(brV, brN, "Internal low", activeSupport)
    f_brAdd(brV, brN, "VAH", vahPrice)
    f_brAdd(brV, brN, "VAL", valPrice)
    f_brAdd(brV, brN, "POC", vpocPrice)
    brSp := close
    brSa := adaptiveATR
    brSd := regSLMult * adaptiveATR
    brSnap := bar_index

// v67: one position mapping for both tables (identical for every option; Hidden keeps the grid's old bottom_right)
f_brPos(string p) => p == "Middle Right" ? position.middle_right : p == "Bottom Right" ? position.bottom_right : p == "Bottom Left" ? position.bottom_left : p == "Top Left" ? position.top_left : position.top_right
var table brT = table.new(f_brPos(brPos), 2, 13, bgcolor=color.new(#0B0F14, 5), border_width=1, border_color=color.new(#2A3340, 0))
// v55: the text size is the global brSz (v52 declared an `sz` parameter that no call passed: CE10165)
f_brC(table t, int r, string k, string v, color col) =>
    table.cell(t, 0, r, k, text_color=color.new(#D1D4DC, 0), text_size=brSz, text_halign=text.align_left)
    table.cell(t, 1, r, v, text_color=col, text_size=brSz, text_halign=text.align_left)
if barstate.islast
    color cU = color.new(#26A69A, 0)
    color cD = color.new(#EF5350, 0)
    color cW = color.new(#FFA726, 0)
    color cT = color.new(#D1D4DC, 0)
    float px = close
    bool up = bullScore >= bearScore
    bool lean = math.abs(bullScore - bearScore) >= 5
    int prim = lean ? (up ? 1 : -1) : 0
    string bias = bullScore >= 62 ? "BULL" : bearScore >= 62 ? "BEAR" : rangeScore >= 62 ? "RANGE" : bullScore > bearScore and bullScore > rangeScore ? "BULL-ISH" : bearScore > bullScore and bearScore > rangeScore ? "BEAR-ISH" : "NEUTRAL"
    bool bU = str.contains(bias, "BULL")
    bool bD = str.contains(bias, "BEAR")
    string h4 = f_brHtf(htf4hScore)
    string h1d = f_brHtf(htf1dScore)
    string sess = inLondon and inNY ? "London/NY" : inNY ? "New York" : inLondon ? "London" : inAsian ? "Asia" : "off-hours"
    f_brC(brT, 0, "MARKET BRIEF " + timeframe.period, "display only · prices MT5\nthe Master's DECISION rules", cT)
    f_brC(brT, 1, "TREND", bias + ((bU and h4 == "down" and h1d == "down") or (bD and h4 == "up" and h1d == "up") ? "  · against the 4H and 1D trend" : "") + "\nprice " + (close > ema200 ? "above" : "below") + " EMA200\nstructure " + (bullStructActive ? "bullish " + bullStructType + " (" + f_brAgo(bullStructAge) + ")" : bearStructActive ? "bearish " + bearStructType + " (" + f_brAgo(bearStructAge) + ")" : "no active break") + "\n4H " + h4 + " · 1D " + h1d + " · " + str.lower(mktRegime), bU ? cU : bD ? cD : cT)
    if not brCompact
        f_brC(brT, 2, "HEADING", (lean ? (up ? "Leaning up" : "Leaning down") : "No clear lean") + "\nL " + str.tostring(bullScore, "#") + "% · S " + str.tostring(bearScore, "#") + "% · R " + str.tostring(rangeScore, "#") + "%\nreach PDH " + str.tostring(pdhReachScore, "#") + "% vs PDL " + str.tostring(pdlReachScore, "#") + "%\nengine scores, not a forecast", prim > 0 ? cU : prim < 0 ? cD : cT)
    if not brCompact
        f_brC(brT, 3, "LIQ TAKEN", na(brSwBar) ? "none in view" : (brSwDir < 0 ? "Buy-side @ " : "Sell-side @ ") + f_brP(brSwPx) + "\nwick through " + brSwPool + " " + f_brP(brSwLvl) + "\nclosed back " + (brSwDir < 0 ? "below" : "above") + "\n" + str.format_time(brSwT, "dd MMM HH:mm", "UTC") + " UTC · " + f_brAgo(bar_index - brSwBar), brSwDir < 0 ? cD : brSwDir > 0 ? cU : cT)
    int dir = up ? 1 : -1
    [tX, tN] = f_brNear(brNv, brNn, px, dir, float(na))
    [nX, nN] = f_brNear(brNv, brNn, px, dir, tX)
    [oX, oN] = f_brNear(brNv, brNn, px, -dir, float(na))
    if not brCompact
        f_brC(brT, 4, "TARGET", na(tX) ? "no liquidity level on that side" : tN + " " + f_brP(tX) + " (" + f_brD(tX - px) + ")" + (na(nX) ? "" : " · then " + nN + " " + f_brP(nX)) + (na(oX) ? "" : "\nopposite liquidity: " + oN + " " + f_brP(oX) + " (" + f_brD(oX - px) + ")"), up ? cU : cD)
    [sT, sN, sS, s1, s1n, s2, s2n, sR] = f_brSide(brV, brN, brSp, brSa, brSd, -1)
    [bT, bN, bS, b1, b1n, b2, b2n, bR] = f_brSide(brV, brN, brSp, brSa, brSd, 1)
    bool sig = _confDirLabel == "BUY" or _confDirLabel == "SELL"
    bool pbOK = not na(sT) or not na(bT)
    bool bs = bullBiasScore >= bearBiasScore
    bool[] g = array.from(bs ? bullTrend : bearTrend, not (bs ? htfBearScoreGate : htfBullScoreGate), recentBars, sessionQuality >= 30, not inNewsWindow, not _ddBreach, bs ? bullStructActive or displacementUp : bearStructActive or displacementDown)
    string[] gn = array.from("Trend", "HTF not against", "Fresh bar", "Session", "No news", "No DD", "Trigger bar")
    string gl = ""
    string need = ""
    int gp = 0
    for [k, ok] in g
        gp += ok ? 1 : 0
        gl += (k == 4 ? "\n" : k > 0 ? " " : "\n") + (ok ? "✓" : "✗") + array.get(gn, k)
        need += ok ? "" : (need == "" ? "" : " + ") + array.get(gn, k)
    // site/app.js doNow, same order: signal > risk lock > playbook (unless its live record is losing, v90) > WAIT > no trade
    // (brief_trace.py runs both)
    string doNow = sig ? _confDirLabel + " now" : _confDirLabel == "RISK LOCK" ? "Stop · risk lock" : pbOK and not h4Losing ? "Wait for a trigger" : _confDirLabel == "WAIT" ? "Stay flat · wait" : "No trade"
    f_brC(brT, 5, "DO NOW", doNow + (sig ? "\nenter with the Master's MT5 plan" : " · DECISION " + _confDirLabel) + (sig or not pbOK ? "" : "\n" + (h4Losing ? "levels only (losing H4 record):\n" : "") + (na(sT) ? "" : "sell below " + f_brP(sT)) + (na(sT) or na(bT) ? "" : "\n") + (na(bT) ? "" : "buy above " + f_brP(bT)) + "\n(on a " + timeframe.period + " close)") + (sig ? "" : rangeDominant ? "\nengine: ranging, no side has an edge" : need == "" ? "\nall 7 gates pass, blocked by\n" + (_confDirLabel == "RISK LOCK" ? "the risk lock" : _confDirLabel == "WARMUP" ? "the statistics warm-up" : "the TQ floor / negative EV / calibration veto") : "\nengine waits for: " + need) + (sessionQuality < 30 ? "\n" + sess + " session\n(the engine trades London / NY)" : ""), sig ? (_confDirLabel == "BUY" ? cU : cD) : cW)
    f_brC(brT, 6, "▼ SELL" + (prim < 0 ? " (lean)" : ""), sig or na(sT) ? "—" : "close < " + f_brP(sT) + " " + sN + (px < sT ? " · price through it: fires if this bar closes here" : " · away " + f_brD(sT - px)) + "\nstop " + f_brP(sS) + " · R:R 1:" + str.tostring(sR, "0.0") + "\nTP1 " + s1n + " " + f_brP(s1) + (s2 != s1 ? "\nTP2 " + s2n + " " + f_brP(s2) : "") + "\n(" + timeframe.period + " close, not yet triggered)", cD)
    f_brC(brT, 7, "▲ BUY" + (prim > 0 ? " (lean)" : ""), sig or na(bT) ? "—" : "close > " + f_brP(bT) + " " + bN + (px > bT ? " · price through it: fires if this bar closes here" : " · away " + f_brD(bT - px)) + "\nstop " + f_brP(bS) + " · R:R 1:" + str.tostring(bR, "0.0") + "\nTP1 " + b1n + " " + f_brP(b1) + (b2 != b1 ? "\nTP2 " + b2n + " " + f_brP(b2) : "") + "\n(" + timeframe.period + " close, not yet triggered)", cU)
    f_brC(brT, 8, "GATES", (bs ? "▲ " : "▼ ") + str.tostring(gp) + "/7" + gl, gp == 7 ? (bs ? cU : cD) : cT)
    if not brCompact
        f_brC(brT, 9, "PLAYBOOK", (brFired != "" ? "last: " + brFired + "\n" : "") + "conditional, not an entry;\nH4 live " + brTf + ": " + (brH4N > 0 ? "N " + str.tostring(brH4N) + (na(brH4T) ? "" : " t " + str.tostring(brH4T, "#.##")) : "no record typed in") + (h4Losing ? " LOSING:\nlevels, not entries" : "") + " (" + brH4Asof + ")\nthis panel can trail the Master\nfor a few bars: the Master rules", cW)
    // v57: the engine cross-check and data feeds, MOVED here from the Master (token room for its phone card);
    // same engine (diag_parity.py), so the same values the Master's cross-check line showed; the schema text is the
    // Master's v56 `schemaLine` wording exactly (the twin's own migState words it differently). moved_check.py holds it.
    if not brCompact
        f_brC(brT, 10, "ENGINE", _xT + " " + _xS + " " + _xL + " " + _xM + " " + _xQ + "\nTQ " + str.tostring(tradeQuality) + "/100" + tqBasis + " · C " + str.tostring(confidenceScore) + "/100" + (vaPos != "—" ? "\nVA" + vaPos + " " + str.tostring(int(vaRatio)) + "% · " : "\n") + structStr + (riskLockStr != "" ? "\n" + riskLockStr : "") + (not na(vixD) ? "\nVIX " + str.tostring(vixD, "#.#") : "") + (climaxUp ? " · CLIMAX▲" : climaxDown ? " · CLIMAX▼" : ""), cT)
        f_brC(brT, 11, "DATA", gcState + " · " + oiState + cotState + curveState + "\nGC:" + f_brSt(GC_STATUS) + " OI:" + f_brSt(OI_STATUS) + " 2Y:" + f_brSt(US2Y_STATUS) + " COT:" + f_brSt(COT_STATUS) + "\nBUILD v" + str.tostring(SCHEMA_BUILD) + (migPct >= 99.5 ? "  SCHEMA_V2 CLEAN" : migV2Count == 0 ? "  V1 100%" : "  MIXED_SCHEMA V1 " + str.tostring(int(100.0 - migPct)) + "% V2 " + str.tostring(int(migPct)) + "%"), cT)
        // v67: the stats engine's twelve values the Brief computed but never showed, as the Master's SIGNAL cell
        f_brC(brT, 12, "STATS", "EV " + (na(__el) ? "—" : (__el > 0 ? "+" : "") + str.tostring(__ev, "#.#")) + " · PF " + (na(__pf) ? "—" : str.tostring(__pf, "#.##")) + (__cg != "N/A" ? "\nCal" + __cg + (not na(__cb) ? "/B" + str.tostring(__cb, "#.##") : "") : "") + (__in >= 10 ? " IS" + f_brI(__iw) + "% n" + f_brI(__in) + (__iw - __ow > 15 ? " !FIT" : "") : "") + (oMatch >= 30 ? str.format("\nedge S/H/L/M/C {0}/{1}/{2}/{3}/{4}", f_brI(__fs), f_brI(__fh), f_brI(__fl), f_brI(__fm), f_brI(__fc)) : ""), cT)

// ---- v53 GOLD ARROWS: every arrowed indicator in its own cell, coloured by what it means FOR GOLD ----
// d > 0 supports gold UP (green ▲, ▲▲ strong), d < 0 supports gold DOWN (red ▼), 0 neutral (grey ≈), na no data (—).
// Macro arrows are the IMPACT on gold, as in the Master (F-A54): DXY / yields / TIPS falling = ▲; the
// second line says what the market itself did. Weak correlation (|r| <= 0.25) = ≈, as the Master prints it.
var table brG = table.new(f_brPos(brGPos == "Hidden" ? "Bottom Right" : brGPos), 4, 9, bgcolor=color.new(#0B0F14, 5), border_width=1, border_color=color.new(#2A3340, 0))
// GD-BEGIN gold drivers: byte-identical in the Brief and Visuals (v66, macro_check.py E). Display only: no vote,
// no weight, no gate. It reads goldRetM / _wM / _fM / macroTF / y2Symbol / safeDiv, which each file defines as the
// engine does (Visuals copies those lines from the Master; macro_check.py E and inputs_check.py hold them equal).
f_brS(bool up, bool dn) => up ? 1.0 : dn ? -1.0 : 0.0
f_brM(bool v, bool up, bool dn, float r) => v ? f_brS(up, dn) * (math.abs(r) > 0.5 ? 2.0 : math.abs(r) > 0.25 ? 1.0 : 0.0) : na
f_brMv(bool v, bool rise, bool fall) => not v ? "no data" : rise ? "rising" : fall ? "falling" : "flat"
// ---- v65 (option 4): five more gold drivers, DISPLAY ONLY: no vote, no weight, no gate, the DECISION is unchanged.
// Read as the engine reads DXY: close[1], EMA10 / EMA20 of it, lookahead_on (the last COMPLETED bar, F-A41), and
// "rising" = close > EMA10 > EMA20. Impact on gold: USDJPY / real yield / 2Y falling = up; oil / breakeven rising = up.
// USDJPY and oil also carry the same-bar correlation with gold (macroTF, the v64 pairing, F-A64), which scales the
// arrow as for DXY (|r| <= 0.25 = neutral). The real yield and breakeven are DAILY series (FRED): direction only.
brJpySym = input.symbol("OANDA:USDJPY", "USDJPY symbol (blank = off)", group="GOLD DRIVERS (display only)")
brOilSym = input.symbol("OANDA:WTICOUSD", "Oil (WTI) symbol (blank = off)", group="GOLD DRIVERS (display only)")
brRySym = input.symbol("FRED:DFII10", "Real 10Y yield, daily (blank = off)", group="GOLD DRIVERS (display only)", tooltip="10-year TIPS yield. Daily, published with a lag: shown as the day's direction, no intraday correlation.")
brBeSym = input.symbol("FRED:T10YIE", "10Y breakeven inflation, daily (blank = off)", group="GOLD DRIVERS (display only)", tooltip="10Y nominal minus TIPS yield = the market's inflation expectation. Daily.")
// v70: written out (TradingView expands every helper call): each line is what the v69 helper call expanded to,
// same values; refactor_check.py executes old and new side by side.
[brJc, brJf, brJs] = request.security(brJpySym != "" ? brJpySym : syminfo.tickerid, macroTF, [close[1], ta.ema(close[1], 10), ta.ema(close[1], 20)], barmerge.gaps_off, barmerge.lookahead_on, ignore_invalid_symbol=true)
[brOc, brOf, brOs] = request.security(brOilSym != "" ? brOilSym : syminfo.tickerid, macroTF, [close[1], ta.ema(close[1], 10), ta.ema(close[1], 20)], barmerge.gaps_off, barmerge.lookahead_on, ignore_invalid_symbol=true)
[brRc, brRf, brRs] = request.security(brRySym != "" ? brRySym : syminfo.tickerid, "D", [close[1], ta.ema(close[1], 10), ta.ema(close[1], 20)], barmerge.gaps_off, barmerge.lookahead_on, ignore_invalid_symbol=true)
[brBc, brBf, brBs] = request.security(brBeSym != "" ? brBeSym : syminfo.tickerid, "D", [close[1], ta.ema(close[1], 10), ta.ema(close[1], 20)], barmerge.gaps_off, barmerge.lookahead_on, ignore_invalid_symbol=true)
[br2c, br2f, br2s] = request.security(y2Symbol != "" ? y2Symbol : syminfo.tickerid, macroTF, [close[1], ta.ema(close[1], 10), ta.ema(close[1], 20)], barmerge.gaps_off, barmerge.lookahead_on, ignore_invalid_symbol=true)
bool brJv = brJpySym != "" and not na(brJc) and not na(brJf) and not na(brJs)
bool brOv = brOilSym != "" and not na(brOc) and not na(brOf) and not na(brOs)
bool brRv = brRySym != "" and not na(brRc) and not na(brRf) and not na(brRs)
bool brBv = brBeSym != "" and not na(brBc) and not na(brBf) and not na(brBs)
bool br2v = y2Symbol != "" and not na(br2c) and not na(br2f) and not na(br2s)
bool brJu = brJc > brJf and brJf > brJs
bool brJn = brJc < brJf and brJf < brJs
bool brOu = brOc > brOf and brOf > brOs
bool brOn = brOc < brOf and brOf < brOs
bool brRu = brRc > brRf and brRf > brRs
bool brRn = brRc < brRf and brRf < brRs
bool brBu = brBc > brBf and brBf > brBs
bool brBn = brBc < brBf and brBf < brBs
bool br2u = br2c > br2f and br2f > br2s
bool br2n = br2c < br2f and br2f < br2s
// same-bar correlation with gold over the macroTF-bar window (goldRetM / _wM / _fM), every bar; shown only when valid
float brJr = ta.correlation(goldRetM, not na(brJc[1]) ? safeDiv(brJc, brJc[1]) - 1 : na, _wM)
float brJR = brJv and _fM ? brJr : na
float brOr = ta.correlation(goldRetM, not na(brOc[1]) ? safeDiv(brOc, brOc[1]) - 1 : na, _wM)
float brOR = brOv and _fM ? brOr : na
// each driver's arrow (d: > 0 supports gold up) and its line of text
float brJd = f_brM(brJv, brJn, brJu, nz(brJR))
string brJh = "yen-dollar " + f_brMv(brJv, brJu, brJn) + (na(brJR) ? "" : " r" + str.tostring(brJR, "#.##"))
float brOd = f_brM(brOv, brOu, brOn, nz(brOR))
string brOh = "WTI " + f_brMv(brOv, brOu, brOn) + (na(brOR) ? "" : " r" + str.tostring(brOR, "#.##"))
float brRd = brRv ? f_brS(brRn, brRu) : na
string brRh = (brRv ? str.tostring(brRc, "#.##") + "% " : "") + f_brMv(brRv, brRu, brRn) + " · daily"
float brBd = brBv ? f_brS(brBu, brBn) : na
string brBh = (brBv ? str.tostring(brBc, "#.##") + "% " : "") + f_brMv(brBv, brBu, brBn) + " · daily"
float br2d = br2v ? f_brS(br2n, br2u) : na
string br2h = (br2v ? str.tostring(br2c, "#.##") + "% " : "") + f_brMv(br2v, br2u, br2n) + " · Fed path"
// GD-END
// v68: f_brA / f_brT (one table.cell, called 28 times) became the loop in the grid block below; same cells.
// v70: the grid's drawing as a function called once (it was this if-block's body, unchanged): it keeps ~900 tokens
// out of the main body, which TradingView limits separately (CE10295; the Brief's main body is near the limit).
f_brGrid() =>
    table.cell(brG, 0, 0, "GOLD ARROWS · green = supports gold UP · red = supports gold DOWN · grey = neutral", text_color=color.new(#D1D4DC, 0), text_size=brSz)
    table.merge_cells(brG, 0, 0, 3, 0)
    // v68: the grid's cells as data -- name, arrow (d > 0 supports gold up) and text, in cell order; ONE table.cell
    // below draws them all, exactly as the 28 f_brA / f_brT calls did (TradingView expands every call: 28 copies of the
    // cell code cost ~4,000 compiled tokens). Cell 23 is the CLIMAX cell, drawn after the loop in amber.
    string[] gN = array.new<string>()
    float[] gD = array.new<float>()
    string[] gH = array.new<string>()
    array.push(gN, "TREND")
    array.push(gD, f_brS(bullTrend, bearTrend))
    array.push(gH, "engine trend gate")
    array.push(gN, "STRUCT")
    array.push(gD, f_brS(bullStructActive, bearStructActive))
    array.push(gH, bullStructActive ? bullStructType : bearStructActive ? bearStructType : "none active")
    array.push(gN, "BIAS")
    array.push(gD, math.abs(bullScore - bearScore) < 5 ? 0.0 : f_brS(bullScore > bearScore, bearScore > bullScore))
    array.push(gH, "L " + str.tostring(bullScore, "#") + " / S " + str.tostring(bearScore, "#"))
    array.push(gN, "LIQ")
    array.push(gD, f_brS(evLiqBull > evLiqBear + 3, evLiqBear > evLiqBull + 3))
    array.push(gH, "liquidity draw")
    array.push(gN, "EMA200")
    array.push(gD, f_brS(close > ema200, close < ema200))
    array.push(gH, close > ema200 ? "price above" : "price below")
    array.push(gN, "VWAP")
    array.push(gD, f_brS(close > vwapVal, close < vwapVal))
    array.push(gH, close > vwapVal ? "price above" : "price below")
    array.push(gN, "VALUE")
    array.push(gD, f_brS(close > vahPrice, close < valPrice))
    array.push(gH, close > vahPrice ? "above VAH" : close < valPrice ? "below VAL" : "inside value")
    array.push(gN, "MTF")
    array.push(gD, f_brS(mtfConfluenceScore > 20, mtfConfluenceScore < -20))
    array.push(gH, "confluence " + str.tostring(mtfConfluenceScore, "#"))
    array.push(gN, "5M")
    array.push(gD, htf5mAvailable ? f_brS(htf5mBull, htf5mBear) : na)
    array.push(gH, htf5mAvailable ? "" : "no data on this TF")
    array.push(gN, "15M")
    array.push(gD, htf15mAvailable ? f_brS(htf15mBull, htf15mBear) : na)
    array.push(gH, htf15mAvailable ? "" : "no data on this TF")
    array.push(gN, "1H")
    array.push(gD, htf1hAvailable ? f_brS(htf1hBull, htf1hBear) : na)
    array.push(gH, htf1hAvailable ? "" : "no data on this TF")
    array.push(gN, "4H")
    array.push(gD, htf4hAvailable ? f_brS(htf4hBull, htf4hBear) : na)
    array.push(gH, htf4hAvailable ? "" : "no data on this TF")
    array.push(gN, "1D")
    array.push(gD, htf1dAvailable ? f_brS(htf1dScore >= 60, htf1dScore <= 40) : na)
    array.push(gH, htf1dAvailable ? "" : "no data on this TF")
    array.push(gN, "CVD")
    array.push(gD, f_brS(cvdBull, cvdEma20 < cvdEma100))
    array.push(gH, "volume delta")
    array.push(gN, "DISPL")
    array.push(gD, f_brS(displacementUp, displacementDown))
    array.push(gH, "displacement")
    array.push(gN, "RSI DIV")
    array.push(gD, f_brS(bullRsiDiv, bearRsiDiv))
    array.push(gH, "divergence")
    array.push(gN, "DXY")
    array.push(gD, f_brM(dxyValid, dxyBear, dxyBull, avgCorrDXY))
    array.push(gH, "dollar " + f_brMv(dxyValid, dxyBull, dxyBear))
    array.push(gN, "10Y")
    array.push(gD, f_brM(yieldValid, yieldFalling, yieldRising, avgCorrYld))
    array.push(gH, "yields " + f_brMv(yieldValid, yieldRising, yieldFalling))
    array.push(gN, "TIPS")
    array.push(gD, f_brM(tipsValid, tipsFalling, tipsRising, avgCorrTIPS))
    array.push(gH, _tipsOn ? "real yield " + f_brMv(tipsValid, tipsRising, tipsFalling) : "off: same feed as 10Y")
    array.push(gN, "EUR")
    array.push(gD, f_brM(eurusdValid, eurusdBull, eurusdBear, avgCorrEUR))
    array.push(gH, "EURUSD " + f_brMv(eurusdValid, eurusdBull, eurusdBear) + (dxyValid ? " · confirms DXY" : " · USD vote"))
    array.push(gN, "XAG")
    array.push(gD, f_brM(silverValid, silverClose > silverEMA, silverClose < silverEMA, avgCorrSlv))
    array.push(gH, "silver " + f_brMv(silverValid, silverClose > silverEMA, silverClose < silverEMA))
    array.push(gN, "SPX")
    array.push(gD, spxValid ? f_brS(spxBull, spxBear) : na)
    array.push(gH, "stocks " + f_brMv(spxValid, spxBull, spxBear))
    array.push(gN, "MACRO")
    array.push(gD, f_brS(macroStrengthScore >= 15, macroStrengthScore <= -15))
    array.push(gH, "score " + str.tostring(macroStrengthScore))
    // cell 23: the CLIMAX cell, drawn below in amber (a placeholder keeps the indices)
    array.push(gN, "")
    array.push(gD, na)
    array.push(gH, "")
    array.push(gN, "USDJPY")
    array.push(gD, brJd)
    array.push(gH, brJh)
    array.push(gN, "OIL")
    array.push(gD, brOd)
    array.push(gH, brOh)
    array.push(gN, "REAL YLD")
    array.push(gD, brRd)
    array.push(gH, brRh)
    array.push(gN, "BREAKEVEN")
    array.push(gD, brBd)
    array.push(gH, brBh)
    array.push(gN, "US 2Y")
    array.push(gD, br2d)
    array.push(gH, br2h)
    for [k, nm] in gN
        if k != 23
            float d = array.get(gD, k)
            table.cell(brG, k % 4, 1 + int(k / 4), nm + " " + (na(d) ? "—" : d >= 2 ? "▲▲" : d > 0 ? "▲" : d <= -2 ? "▼▼" : d < 0 ? "▼" : "≈") + "\n" + array.get(gH, k), text_color=na(d) ? color.new(#787B86, 0) : d > 0 ? color.new(#26A69A, 0) : d < 0 ? color.new(#EF5350, 0) : color.new(#B2B5BE, 0), text_size=brSz, text_halign=text.align_left)
    table.cell(brG, 1, 8, "v65: these five are display only\n(no vote, weight or gate)", text_color=color.new(#787B86, 0), text_size=brSz)
    table.merge_cells(brG, 1, 8, 3, 8)
    // a volume climax is exhaustion either way (the engine scores it as exhaustion, not as a side): amber, not green/red
    table.cell(brG, 3, 6, "CLIMAX " + (climaxUp ? "▲" : climaxDown ? "▼" : "·") + "\n" + (climaxUp or climaxDown ? "exhaustion risk" : "none"), text_color=climaxUp or climaxDown ? color.new(#FFA726, 0) : color.new(#B2B5BE, 0), text_size=brSz, text_halign=text.align_left)
if barstate.islast and brGPos != "Hidden"
    f_brGrid()
plot(na, "brief", display = display.none)
// DIAG-END
