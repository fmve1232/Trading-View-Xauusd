# Copy to .env and fill in. NEVER commit .env (section 66).
# Every value here is a placeholder; none is a working credential.

ENVIRONMENT=development

# PAPER or LIVE. Defaults to PAPER when unset. An unrecognised value raises
# rather than defaulting, so a typo stops the deploy (section 65).
EXECUTION_MODE=PAPER

# Postgres / Supabase. Server-side only -- never exposed to frontend JS.
DATABASE_URL=

# Provider NAMES, resolved through the registry. No provider ships with this
# repository yet, so resolution will fail until an adapter is written.
MARKET_PROVIDER=
NEWS_PROVIDER=
MACRO_PROVIDER=

# Provider credentials. Keep them here, out of source, out of the frontend.
MARKET_PROVIDER_API_KEY=
NEWS_PROVIDER_API_KEY=
MACRO_PROVIDER_API_KEY=
