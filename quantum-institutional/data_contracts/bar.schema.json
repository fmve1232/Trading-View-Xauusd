{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/fmve1232/quantum-institutional/data_contracts/bar.schema.json",
  "title": "Bar",
  "description": "One OHLCV bar. event_time is the bar OPEN, left-aligned, UTC.",
  "type": "object",
  "required": ["symbol", "timeframe", "event_time", "open", "high", "low", "close", "volume_type", "source"],
  "additionalProperties": false,
  "properties": {
    "symbol": { "type": "string" },
    "timeframe": { "enum": ["1m","3m","5m","15m","30m","1H","2H","4H","6H","12H","1D","1W"] },
    "event_time": { "type": "string", "format": "date-time", "description": "Bar open, UTC" },
    "open": { "type": "number" },
    "high": { "type": "number" },
    "low": { "type": "number" },
    "close": { "type": "number" },
    "volume": {
      "type": ["number", "null"],
      "minimum": 0,
      "description": "null means ABSENT, not zero"
    },
    "volume_type": { "enum": ["TICK","EXCHANGE","FUTURES","OTC_ESTIMATE","NONE"] },
    "source": { "type": "string" },
    "quality": { "enum": ["OK","DEGRADED","STALE","INVALID","OFFLINE"], "default": "OK" }
  }
}
